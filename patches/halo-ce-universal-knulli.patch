+		open_air_frame(&state, &step, TRUE, &velocity, &frame);
+		NEAR(state.velocity.i, 0.f);
+		NEAR(velocity.i, 0.f);
+		vehicle_riding_record(&state, &step, NULL, FALSE, &zero, &up, &base, FALSE, &velocity);

+/* source with its uniforms, blocks and samplers placed (the samplers texN at
+binding N): a program needs nothing asked of it once linked (program_build).
+Each declaration holds "uniform ", so one pass over the places it is finds
+where each declaration first is and each sampler, and the sizes program_build
+needs (shader_count); the source is then copied once with them replaced, and
+the placed uniforms it uses noted */
+static char *explicit_layouts(const char *source, struct lazy_shader *shader)
+{
+	/* a sampler texN's placement, at binding N */
+#define SAMPLER_LAYOUT(n) "layout(binding = " #n ") "
+	static const char sampler_layouts[10][sizeof(SAMPLER_LAYOUT(0))] =
+	{
+		SAMPLER_LAYOUT(0), SAMPLER_LAYOUT(1), SAMPLER_LAYOUT(2), SAMPLER_LAYOUT(3), SAMPLER_LAYOUT(4),
+		SAMPLER_LAYOUT(5), SAMPLER_LAYOUT(6), SAMPLER_LAYOUT(7), SAMPLER_LAYOUT(8), SAMPLER_LAYOUT(9)
+	};
+#undef SAMPLER_LAYOUT
+	struct
+	{
+		const char *at;
+		unsigned long skip;
+		const char *placed;
+		unsigned long length;
+	} edits[placement_count + 16];
+	const char *end = source + strlen(source), *cursor, *at;
+	struct xgpu_text text;
+	unsigned long count = 0, index, found = 0;
+	BOOL samplers = TRUE;
+
+	for (at = strstr(source, "uniform "); at && count < sizeof(edits) / sizeof(edits[0]) - 1;
+		at = strstr(at + 8, "uniform "))
+	{
+		for (index = 0; index < placement_count; index++)
+		{
+			const char *start = at - uniform_at[index];
+
+			if (!(found >> index & 1) && (unsigned long)(at - source) >= uniform_at[index] &&
+				!strncmp(start, explicit_placements[index].declaration, declaration_lengths[index]))
+			{
+				found |= 1UL << index;
+				edits[count].at = start;
+				edits[count].skip = declaration_lengths[index];
+				edits[count].placed = explicit_placements[index].placed;
+				edits[count].length = placed_lengths[index];
+				count++;
+				break;
+			}
+		}
+		/* "uniform <sampler type> texN;", up to the first that is not */
+		if (samplers && !strncmp(at + 8, "sampler", 7))
+		{
+			const char *name = strstr(at, " tex");
+
+			if (!name || name[4] < '0' || name[4] > '9' || name[5] != ';')
+				samplers = FALSE;
+			else
+			{
+				edits[count].at = at;
+				edits[count].skip = 0;
+				edits[count].placed = sampler_layouts[name[4] - '0'];
+				edits[count].length = sizeof(sampler_layouts[0]) - 1;
+				count++;
+			}
+		}
+		shader_count(shader, at, at > source && at[-1] == '\n');
+	}
+	/* kept for the session: allocated once, at the size the edits make */
+	text.capacity = (unsigned long)(end - source) + 1;
+	for (index = 0; index < count; index++)
+		text.capacity += edits[index].length - edits[index].skip;
+	text.buffer = malloc(text.capacity);
+	text.length = 0;
+	cursor = source;
+	for (index = 0; index < count; index++)
+	{
+		if (edits[index].at < cursor)
+			continue;
+		xgpu_text_put(&text, cursor, (unsigned long)(edits[index].at - cursor));
+		xgpu_text_put(&text, edits[index].placed, edits[index].length);
+		cursor = edits[index].at + edits[index].skip;
+	}
+	xgpu_text_put(&text, cursor, (unsigned long)(end - cursor));
+	shader->uses = names_used(text.buffer, placed_uniforms, _placed_count);
+	return text.buffer;
+}

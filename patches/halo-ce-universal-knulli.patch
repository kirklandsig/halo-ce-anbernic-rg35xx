+static void instance_flush(void)
+{
+	struct program_entry *entry;
+	unsigned long alignment = device.uniform_alignment ? device.uniform_alignment : 16;
+	unsigned long low_offset, high_offset, pixel_offset, index;
+	unsigned long long mask = instances.low_mask;

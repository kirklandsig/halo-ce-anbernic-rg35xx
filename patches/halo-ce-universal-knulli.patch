diff --git a/tools/harness/tests/lobby_intake.c b/tools/harness/tests/lobby_intake.c
new file mode 100644
index 00000000..37f096e1
--- /dev/null
+++ b/tools/harness/tests/lobby_intake.c
@@ -0,0 +1,108 @@
+#include "harness.h"
+
+/* The server browser's intake (port/linux/src/p2p_lobby.c, listing_wanted):
+which listings heard take a place in the queue, and a broker's burst on
+subscribing (its kept slots, most of them games long gone) leaving every live
+game a place */
+#include "config.inc"
+#include "under_test.inc"
+
+/* a listing as a host makes it (listing_make), its signature zeroes: the
+intake does not check it */
+static int make(unsigned char *bytes, int version, int flags, long age)
+{
+	int size = 0;
+	unsigned long when = (unsigned long)(time(NULL) - age);
+	const char *texts[3] = { "a game", "bloodgulch", "slayer" };
+	int text;
+
+	bytes[size++] = 'H';
+	bytes[size++] = 'L';
+	bytes[size++] = LISTING_FORMAT;
+	bytes[size++] = (unsigned char)(version >> 8);
+	bytes[size++] = (unsigned char)version;
+	bytes[size++] = (unsigned char)flags;
+	memset(bytes + size, 0, 4);
+	size += 4;
+	bytes[size++] = (unsigned char)(when >> 24);
+	bytes[size++] = (unsigned char)(when >> 16);
+	bytes[size++] = (unsigned char)(when >> 8);
+	bytes[size++] = (unsigned char)when;
+	memset(bytes + size, 7, P2P_KEY_SIZE);
+	size += P2P_KEY_SIZE;
+	memset(bytes + size, 9, P2P_TOKEN_SIZE);
+	size += P2P_TOKEN_SIZE;
+	bytes[size++] = 1;
+	bytes[size++] = 16;
+	bytes[size++] = 2;
+	for (text = 0; text < 3; text++)
+	{
+		int length = (int)strlen(texts[text]);
+
+		bytes[size++] = (unsigned char)length;
+		memcpy(bytes + size, texts[text], (size_t)length);
+		size += length;
+	}
+	memset(bytes + size, 0, STAMP_SIZE + P2P_SIGNATURE_SIZE);
+	return size + STAMP_SIZE + P2P_SIGNATURE_SIZE;
+}
+
+static int wanted(int version, int flags, long age, int retained)
+{
+	unsigned char bytes[MAXIMUM_LISTING_SIZE];
+	int size = make(bytes, version, flags, age);
+
+	return listing_wanted(bytes, size, retained);
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc == 2 ? argv[1] : "";
+	const int current = HALO_PORT_NETWORK_VERSION;
+
+	CASE("filter")
+	{
+		CHECK(wanted(current, _listing_open, 0, 0), "a live game of this version");
+		CHECK(wanted(current, _listing_open, 120, 1), "a kept slot of two minutes ago");
+		CHECK(wanted(current, _listing_closed, 60, 1), "a host's recent tombstone (it ends a game)");
+		CHECK(!wanted(current, _listing_open, RETAINED_WINDOW + 60, 1), "a kept slot of a game long gone");
+		/* (the port takes a live listing whatever its time, as before) */
+		CHECK(wanted(current, _listing_open, 2 * RETAINED_WINDOW, 0), "a live listing, its host's clock behind");
+		CHECK(!wanted(current - 1, _listing_open, 0, 0), "an older version's");
+		CHECK(!wanted(current + 1, _listing_open, 0, 0), "a newer version's");
+		CHECK(!listing_wanted((const unsigned char *)"HL", 2, 0), "a short message");
+	}
+	else CASE("burst")
+	{
+		/* a public broker's kept slots, as test.mosquitto.org sent them on
+		2026-10-24 (about 1,450, some 70 live): this version's games long
+		gone, older versions' hosts still running and long gone, a few
+		newer ones; the live games spread among them */
+		int heard, queued = 0, live_queued = 0;
+
+		for (heard = 0; heard < 1470; heard++)
+		{
+			int live = heard % 21 == 20;
+			int is_wanted;
+
+			if (live)
+				is_wanted = wanted(current, _listing_open, heard % 7, 1);
+			else if (heard % 3 == 0)
+				is_wanted = wanted(current, _listing_open, 86400 * (1 + heard % 30), 1);
+			else if (heard % 3 == 1)
+				is_wanted = wanted(current - 1 - heard % 20, _listing_open, heard % 2 ? 30 : 86400, 1);
+			else
+				is_wanted = wanted(heard % 50 ? current - 3 : current + 1, _listing_open, 5, 1);
+			if (is_wanted && queued < MAXIMUM_QUEUED)
+			{
+				queued++;
+				live_queued += live;
+			}
+		}
+		CHECK(live_queued == 70, "%d of the 70 live games had a place in the queue (%d places taken)",
+			live_queued, queued);
+	}
+	else
+		return 2;
+	return 0;
+}
diff --git a/tools/harness/tests/network_actor_seat.c b/tools/harness/tests/network_actor_seat.c
new file mode 100644
index 00000000..dff7cd1b
--- /dev/null
+++ b/tools/harness/tests/network_actor_seat.c
@@ -0,0 +1,197 @@
+/* idle seated actors' actual publisher and serializer, with transport captured */
+#include "harness.h"
+#include <math.h>
+typedef unsigned short word;
+typedef struct { real i, j; } real_vector2d;
+struct distributed_message_header { byte header[8]; };
+#define csmemset memset
+#define PIN(value, low, high) ((value) < (low) ? (low) : (value) > (high) ? (high) : (value))
+#define SET_FLAG(flags, bit, value) ((flags) = (value) ? (flags) | FLAG(bit) : (flags) & ~FLAG(bit))
+#define NO_IMPULSE 255
+#define NO_TEAM 255
+#define ONE_SHOT_CONTROL_FLAGS 0
+#define NUMBER_OF_UNIT_CONTROL_FLAGS 16
+#define DISTRIBUTED_UNIT_SCALE 32767.f
+#define DISTRIBUTED_VELOCITY_SCALE 1024.f
+#define _unit_running_blindly_bit 0
+#define _unit_active_camouflaged_bit 1
+#define _unit_super_camouflaged_bit 2
+#define _object_dead_bit 0
+#define _object_mask_unit 1
+#define _distributed_message_actor_states 1
+#define DATAGRAM_ENTRIES(type) 8
+#include "actor_seat_types.inc"
+struct unit_datum
+{
+	struct
+	{
+		long parent_object_index;
+		unsigned long damage_flags;
+		short owner_team_index;
+		real_point3d position;
+		real_vector3d translational_velocity, forward, up;
+	} object;
+	struct
+	{
+		long player_index;
+		short parent_seat_index;
+		unsigned long flags, control_flags;
+		real active_camouflage, primary_trigger, run_blindly_angle;
+		short persistent_control_timer;
+	} unit;
+};
+struct damage_network_state
+{
+	boolean shield_depleted, shield_charging, shield_over_charging;
+	real body_vitality, shield_vitality;
+};
+static struct host_actor host_actors[MAXIMUM_NETWORK_ACTORS];
+static short host_actor_count;
+static struct unit_datum units[MAXIMUM_NETWORK_ACTORS];
+static boolean present[MAXIMUM_NETWORK_ACTORS];
+static long now;
+static short machine_count = 1;
+static short period = 1;
+static long sent[HALO_PORT_MAXIMUM_NETWORK_MACHINES];
+static struct distributed_actor_state last_state;
+static boolean check_full_seats;
+static boolean riding_enabled;
+static boolean vehicle_riding_enabled(void) { return riding_enabled; }
+static struct unit_datum *unit_get(long index)
+{
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(index);
+	CHECK(slot < MAXIMUM_NETWORK_ACTORS && present[slot], "accessed an absent unit");
+	return &units[slot];
+}
+static void *object_try_and_get_and_verify_type(long index, long mask)
+{
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(index);
+	return slot < MAXIMUM_NETWORK_ACTORS && present[slot] ? &units[slot] : NULL;
+}
+static void damage_get_network_state(long index, struct damage_network_state *state) { memset(state, 0, sizeof(*state)); }
+static word distributed_vitality_pack(real value) { return 0; }
+static short distributed_angle_pack(real value) { return 0; }
+static void angles_pack(real_vector3d const *vector, short *angles) { angles[0] = angles[1] = 0; }
+static void distributed_vector_pack(real_vector3d const *vector, real scale, struct distributed_vector *result) { memset(result, 0, sizeof(*result)); }
+static short distributed_client_machines(long *indices, short maximum)
+{
+	short index;
+	CHECK(machine_count <= maximum, "client list exceeds publisher capacity");
+	for (index = 0; index < machine_count; index++) indices[index] = index;
+	return machine_count;
+}
+static long game_time_get(void) { return now; }
+static void host_send_damage(void) { }
+static short network_objects_send_period(long machine, real_point3d const *position) { return period; }
+static void distributed_send_to_machine(long machine, void const *data, short type, short count, word size)
+{
+	struct distributed_actor_state_message const *message = data;
+	short index;
+	CHECK(count > 0 && count <= 8 && type == _distributed_message_actor_states, "invalid actor-state batch");
+	CHECK(size == sizeof(message->header) + count * sizeof(message->states[0]), "wrong wire size");
+	for (index = 0; index < count; index++)
+	{
+		last_state = message->states[index];
+		if (check_full_seats)
+		{
+			CHECK(TEST_FLAG(last_state.flags, _distributed_actor_rides_bit) &&
+				last_state.vehicle_index == 5000 && last_state.seat_index == 2,
+				"full-capacity publisher lost a seat");
+		}
+	}
+	sent[machine] += count;
+}
+#include "actor_seat_under_test.inc"
+static void seed(short count)
+{
+	short index;
+	memset(host_actors, 0, sizeof(host_actors));
+	memset(units, 0, sizeof(units));
+	memset(present, 0, sizeof(present));
+	memset(sent, 0, sizeof(sent));
+	host_actor_count = count;
+	for (index = 0; index < count; index++)
+	{
+		host_actors[index].unit_index = 0x10000 + index;
+		host_actors[index].impulse = NONE;
+		host_actors[index].speech_sound = NONE;
+		host_actors[index].user_animation_graph = NONE;
+		present[index] = TRUE;
+		units[index].unit.player_index = NONE;
+		units[index].unit.parent_seat_index = 2;
+		units[index].object.parent_object_index = 5000;
+	}
+}
+int main(int argc, char **argv)
+{
+	char const *case_name = argc > 1 ? argv[1] : "";
+	short index;
+	CASE("actor-seat-idle-riding-off")
+	{
+		seed(1);
+		riding_enabled = FALSE;
+		host_actors[0].noted = TRUE;
+		network_actors_host_tick();
+		CHECK(sent[0] == 1 && host_actor_count == 1, "riding off dropped fresh controls");
+		CHECK(!host_actors[0].noted, "test accidentally supplies fresh controls");
+		network_actors_host_tick();
+		CHECK(sent[0] == 1 && host_actor_count == 0, "riding off retained an idle seated actor");
+		seed(1);
+		units[0].unit.flags = FLAG(_unit_running_blindly_bit);
+		network_actors_host_tick();
+		CHECK(sent[0] == 1 && host_actor_count == 1, "riding off dropped a fleeing actor");
+		return 0;
+	}
+	CASE("actor-seat-idle-published")
+	{
+		riding_enabled = TRUE;
+		seed(1);
+		host_actors[0].noted = TRUE;
+		network_actors_host_tick();
+		CHECK(sent[0] == 1, "initial control did not publish");
+		for (now = 1; now <= 5; now++)
+		{
+			CHECK(!host_actors[0].noted, "test accidentally supplies fresh controls");
+			network_actors_host_tick();
+			CHECK(sent[0] == now + 1 && host_actor_count == 1,
+				"seated actor without fresh control stopped publishing its seat");
+			CHECK(last_state.unit_index == 0x10000 && last_state.vehicle_index == 5000 &&
+				last_state.seat_index == 2 && TEST_FLAG(last_state.flags, _distributed_actor_rides_bit),
+				"idle actor's wire entry lost its salted unit, vehicle, seat or riding flag");
+		}
+		/* (retention must survive a tick on which distance scheduling skips the send) */
+		period = 4;
+		now = 6;
+		network_actors_host_tick();
+		CHECK(sent[0] == 6 && host_actor_count == 1, "idle actor bypassed scheduling or was dropped");
+		now = 8;
+		network_actors_host_tick();
+		CHECK(sent[0] == 7, "idle actor did not publish on its next scheduled tick");
+		/* (the old non-seated, invalid and dead-unit filters still apply) */
+		period = 1;
+		seed(5);
+		units[0].unit.parent_seat_index = NONE;
+		units[1].object.parent_object_index = NONE;
+		units[2].object.damage_flags = FLAG(_object_dead_bit);
+		present[3] = FALSE;
+		units[4].unit.player_index = 0;
+		network_actors_host_tick();
+		CHECK(host_actor_count == 0 && sent[0] == 0, "idle retention kept invalid or unseated actors");
+		seed(1);
+		units[0].object.parent_object_index = NONE;
+		units[0].unit.parent_seat_index = NONE;
+		units[0].unit.flags = FLAG(_unit_running_blindly_bit);
+		network_actors_host_tick();
+		CHECK(host_actor_count == 1 && sent[0] == 1, "running-blindly retention changed");
+		/* (the largest tables still publish all seats, with no extra per-client scan) */
+		seed(MAXIMUM_NETWORK_ACTORS);
+		machine_count = HALO_PORT_MAXIMUM_NETWORK_MACHINES;
+		check_full_seats = TRUE;
+		network_actors_host_tick();
+		CHECK(host_actor_count == MAXIMUM_NETWORK_ACTORS, "full actor table was pruned");
+		for (index = 0; index < machine_count; index++)
+			CHECK(sent[index] == MAXIMUM_NETWORK_ACTORS, "full-capacity client lost actor states");
+		return 0;
+	}
+	return 2;
+}
diff --git a/tools/harness/tests/network_deck.c b/tools/harness/tests/network_deck.c
new file mode 100644
index 00000000..175039a5
--- /dev/null
+++ b/tools/harness/tests/network_deck.c
@@ -0,0 +1,311 @@
+/*
+NETWORK_DECK.C (test)
+
+The deck part of a unit's state on the wire (port/linux/game/
+network_distributed.c's distributed_unit_state_write and _read, and
+vehicle_riding.c's checks of it), taken from the sources by
+test_network_deck.py, against a fake count of a vehicle's nodes: written
+and read back whole, refused whole with the rest of the state read on, a
+value not finite never written, and a state with a part this version does
+not know, or a deck part where no place is, refused.
+*/
+
+#include "harness.h"
+#include <math.h>
+typedef unsigned short word;
+typedef struct { real i, j; } real_vector2d;
+#define csmemset memset
+#define csmemcpy memcpy
+#define SET_FLAG(v, b, on) ((v) = (on) ? ((v) | FLAG(b)) : ((v) & ~FLAG(b)))
+#include "types.inc"
+
+/* the vehicle the parts name, with three nodes; any other index is no
+vehicle on this machine (deleted, its slot reused, or another object) */
+#define VEHICLE 0x10000001
+static int node_count_asked;
+
+short biped_riding_vehicle_node_count(long vehicle_index)
+{
+	node_count_asked++;
+	return vehicle_index == VEHICLE ? 3 : NONE;
+}
+
+/* (the scripted pose validation: this fixture sends none) */
+static boolean distributed_scripted_pose_valid(struct distributed_unit_state const *state) { return TRUE; }
+#include "under_test.inc"
+
+#define NEAR(a, b) CHECK(fabs((double)(a) - (double)(b)) < .001, "%s: %g, not %g", #a, (double)(a), (double)(b))
+/* where the deck part starts in living(): after the player, flags and
+parts, the unit, and the placed parts (no seat, up straight up) */
+#define DECK_AT (3 + 4 + 12 + 6 + 6)
+
+/* a living, placed player riding VEHICLE's node 2 */
+static struct distributed_unit_state living(void)
+{
+	struct distributed_unit_state state;
+
+	memset(&state, 0, sizeof(state));
+	state.player_index = 1;
+	state.flags = FLAG(_distributed_unit_alive_bit) | FLAG(_distributed_unit_placed_bit);
+	state.killing_player_index = NO_PLAYER;
+	state.unit_index = 0x20000002;
+	state.vehicle_index = NONE;
+	state.seat_index = NONE;
+	state.position.x = 10.f;
+	state.position.y = 20.f;
+	state.position.z = 30.f;
+	state.up.k = (short)DISTRIBUTED_UNIT_SCALE;
+	state.body_vitality = state.shield_vitality = 16384;
+	state.deck_present = TRUE;
+	state.deck.vehicle_index = VEHICLE;
+	state.deck.node_index = 2;
+	state.deck.ticks = 60;
+	state.deck.place.x = 1.5f;
+	state.deck.place.y = -.25f;
+	state.deck.place.z = .75f;
+	state.deck.velocity.i = .125f;
+	state.deck.velocity.j = -.0625f;
+	state.deck.velocity.k = .5f;
+	return state;
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc > 1 ? argv[1] : "";
+	struct distributed_unit_state state;
+	struct distributed_unit_state decoded;
+	struct vehicle_riding_deck empty;
+	byte buffer[DISTRIBUTED_UNIT_STATE_MAXIMUM_SIZE + 2];
+	word size;
+
+	memset(&empty, 0, sizeof(empty));
+	CASE("deck-standing-verdict")
+	{
+		struct vehicle_riding_state riding;
+		struct vehicle_riding_vehicle vehicle;
+		struct vehicle_riding_cabin cabin;
+		real_point3d base = { 1.f, 0.f, .5f };
+		real_vector3d world = { 0.f, 0.f, 0.f };
+		short verdict;
+
+		memset(&riding, 0, sizeof(riding));
+		memset(&vehicle, 0, sizeof(vehicle));
+		memset(&cabin, 0, sizeof(cabin));
+		vehicle.object_index = VEHICLE;
+		vehicle.node_index = NONE;
+		vehicle.forward.i = vehicle.body_forward.i = 1.f;
+		vehicle.up.k = vehicle.body_up.k = 1.f;
+		riding.ticks = 60;
+		riding.object_index = VEHICLE;
+		riding.node_index = NONE;
+		cabin.unit_index = 0x20000002;
+		cabin.vehicle_index = VEHICLE;
+		/* a standing rider's verdict, made by the writer, through the wire and back: the same 28 bytes, falling clear */
+		for (verdict = _vehicle_riding_enclosure_open; verdict <= _vehicle_riding_enclosure_enclosed; verdict++)
+		{
+			cabin.standing = verdict;
+			state = living();
+			CHECK(vehicle_riding_deck_make(&riding, &vehicle, &base, &world, NULL, &cabin, &state.deck),
+				"a standing rider's part refused");
+			size = distributed_unit_state_write(&state, TRUE, buffer);
+			CHECK(size == DECK_AT + DISTRIBUTED_DECK_SIZE + 4, "a rider's state of %d bytes", (int)size);
+			CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size && decoded.deck_present,
+				"a standing verdict's part lost");
+			CHECK(decoded.deck.ticks == 60 && (decoded.deck.flags >> VEHICLE_RIDING_DECK_VERDICT_SHIFT) == verdict &&
+				!TEST_FLAG(decoded.deck.flags, _vehicle_riding_deck_falling_bit), "verdict %d riding: flags %u", verdict,
+				(unsigned)decoded.deck.flags);
+		}
+		return 0;
+	}
+	CASE("deck-roundtrip")
+	{
+		short verdict;
+
+		CHECK(DISTRIBUTED_DECK_SIZE == 28, "a deck part of %d bytes", (int)DISTRIBUTED_DECK_SIZE);
+		CHECK(DISTRIBUTED_UNIT_STATE_MAXIMUM_SIZE == 122, "a state of at most %d bytes",
+			(int)DISTRIBUTED_UNIT_STATE_MAXIMUM_SIZE);
+		/* every part a living state has: one byte under the most, in the buffer
+		the message loops give it (the guard bytes either side kept) */
+		state = living();
+		state.vehicle_index = 0x10010002;
+		state.seat_index = 1;
+		state.up.i = 100;
+		state.up.k = 32000;
+		state.flags |= FLAG(_distributed_unit_predicted_bit);
+		state.predicted_time = 123;
+		state.current_body_damage = state.recent_shield_damage = 7;
+		state.powerup_durations[0] = 9;
+		state.unit_flags = 1;
+		state.active_camouflage = 5;
+		state.scripted_pose = TRUE;
+		memset(buffer, 0xA5, sizeof(buffer));
+		size = distributed_unit_state_write(&state, TRUE, buffer + 1);
+		CHECK(size == DISTRIBUTED_UNIT_STATE_MAXIMUM_SIZE - 1, "a full living state of %d bytes", (int)size);
+		CHECK(buffer[0] == 0xA5 && buffer[DISTRIBUTED_UNIT_STATE_MAXIMUM_SIZE + 1] == 0xA5, "past the buffer");
+		CHECK(distributed_unit_state_read(buffer + 1, buffer + 1 + size, &decoded) == size, "not read back whole");
+		CHECK(decoded.deck_present && decoded.deck.vehicle_index == VEHICLE && decoded.deck.node_index == 2 &&
+			decoded.deck.ticks == 60 && decoded.deck.flags == 0, "the deck's vehicle, node, ticks or flags");
+		NEAR(decoded.deck.place.x, 1.5f);
+		NEAR(decoded.deck.place.y, -.25f);
+		NEAR(decoded.deck.place.z, .75f);
+		NEAR(decoded.deck.velocity.i, .125f);
+		NEAR(decoded.deck.velocity.j, -.0625f);
+		NEAR(decoded.deck.velocity.k, .5f);
+		NEAR(decoded.deck.peak, 0.f);
+		CHECK(decoded.predicted_time == 123 && decoded.position.x == 10.f && decoded.powerup_durations[0] == 9 &&
+			decoded.active_camouflage == 5, "the parts after the deck misread");
+		/* in the air: falling and each verdict as they were, the air frame and the peak */
+		for (verdict = 0; verdict <= 2; verdict++)
+		{
+			state = living();
+			state.deck.ticks = 40;
+			state.deck.flags = (byte)(FLAG(_vehicle_riding_deck_falling_bit) | (verdict << VEHICLE_RIDING_DECK_VERDICT_SHIFT));
+			state.deck.velocity.i = .25f;
+			state.deck.velocity.j = .375f;
+			state.deck.velocity.k = -.125f;
+			state.deck.peak = .5f;
+			size = distributed_unit_state_write(&state, TRUE, buffer);
+			CHECK(size == DECK_AT + DISTRIBUTED_DECK_SIZE + 4, "a jumper's state of %d bytes", (int)size);
+			CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size && decoded.deck_present,
+				"a jumper's part lost");
+			CHECK(decoded.deck.ticks == 40 && decoded.deck.flags == state.deck.flags, "verdict %d: flags %u", verdict,
+				(unsigned)decoded.deck.flags);
+			NEAR(decoded.deck.velocity.j, .375f);
+			NEAR(decoded.deck.peak, .5f);
+		}
+		/* a peak past what 16 bits carry comes back as the most they do */
+		state.deck.peak = 40.f;
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size && decoded.deck_present,
+			"a large peak's part lost");
+		NEAR(decoded.deck.peak, 32767.f/1024.f);
+		/* without the part: 28 bytes fewer, and none read */
+		state.deck_present = FALSE;
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		CHECK(size == DECK_AT + 4, "a state with no part of %d bytes", (int)size);
+		CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size && !decoded.deck_present &&
+			!memcmp(&decoded.deck, &empty, sizeof(empty)), "a part read where none was");
+		return 0;
+	}
+	CASE("deck-truncate")
+	{
+		word cut;
+
+		state = living();
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		for (cut = 0; cut < size; cut++)
+		{
+			CHECK(distributed_unit_state_read(buffer, buffer + cut, &decoded) == 0, "cut at %d read", (int)cut);
+		}
+		return 0;
+	}
+	CASE("deck-invalid-whole")
+	{
+		short fault;
+
+		for (fault = 0; fault < 11; fault++)
+		{
+			long index = fault == 0 ? 0x10020003 : 0x20000001;
+			short node = fault == 2 ? 3 : -2;
+			real value = fault == 4 ? NAN : INFINITY;
+			short peak = -1;
+			byte byte_value = fault == 6 ? 0 : fault == 7 ? 61 : fault == 8 ? 6 : 8;
+
+			state = living();
+			size = distributed_unit_state_write(&state, TRUE, buffer);
+			CHECK(!memcmp(buffer + DECK_AT, &state.deck.vehicle_index, 4), "the part is not where this case writes");
+			/* no such vehicle; a reused slot (another identifier); a node past the
+			vehicle's, or below 0; a place not finite; no window, too long a
+			window; a verdict of 3; another flag; a peak below 0 */
+			if (fault <= 1)
+				memcpy(buffer + DECK_AT, &index, 4);
+			else if (fault <= 3)
+				memcpy(buffer + DECK_AT + 4, &node, 2);
+			else if (fault <= 5)
+				memcpy(buffer + DECK_AT + 6 + (fault == 4 ? 0 : 8), &value, 4);
+			else if (fault <= 7)
+				buffer[DECK_AT + 24] = byte_value;
+			else if (fault <= 9)
+				buffer[DECK_AT + 25] = byte_value;
+			else
+				memcpy(buffer + DECK_AT + 26, &peak, 2);
+			CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size, "fault %d: the state's bytes lost", fault);
+			CHECK(!decoded.deck_present && !memcmp(&decoded.deck, &empty, sizeof(empty)), "fault %d: a part kept in pieces", fault);
+			CHECK(decoded.position.x == 10.f && decoded.body_vitality == 16384, "fault %d: the rest of the state lost", fault);
+		}
+		return 0;
+	}
+	CASE("deck-cabin-bit")
+	{
+		byte flags[3] = { FLAG(_vehicle_riding_deck_cabin_bit) | (2 << VEHICLE_RIDING_DECK_VERDICT_SHIFT),
+			FLAG(_vehicle_riding_deck_cabin_bit), 0x10 | (1 << VEHICLE_RIDING_DECK_VERDICT_SHIFT) };
+		short fault;
+
+		/* a jump's part with the bit, falling and a verdict beside it: the same 28 bytes, flags as they were */
+		state = living();
+		state.deck.ticks = 40;
+		state.deck.flags = (byte)(FLAG(_vehicle_riding_deck_falling_bit) | (1 << VEHICLE_RIDING_DECK_VERDICT_SHIFT) |
+			FLAG(_vehicle_riding_deck_cabin_bit));
+		state.deck.peak = .5f;
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		CHECK(size == DECK_AT + DISTRIBUTED_DECK_SIZE + 4, "a part with the bit of %d bytes", (int)size);
+		CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size && decoded.deck_present,
+			"a part with the bit lost");
+		CHECK(decoded.deck.flags == state.deck.flags && TEST_FLAG(decoded.deck.flags, _vehicle_riding_deck_falling_bit) &&
+			((decoded.deck.flags >> VEHICLE_RIDING_DECK_VERDICT_SHIFT) & VEHICLE_RIDING_DECK_VERDICT_MASK) ==
+			_vehicle_riding_enclosure_open, "flags %u", (unsigned)decoded.deck.flags);
+		/* at ticks 60, with no verdict, or with a bit from 4 up: dropped whole, the rest of the state read on */
+		for (fault = 0; fault < 3; fault++)
+		{
+			state = living();
+			state.deck.ticks = fault == 0 ? 60 : 40;
+			state.deck.flags = fault == 0 ? (byte)(1 << VEHICLE_RIDING_DECK_VERDICT_SHIFT) : 0;
+			size = distributed_unit_state_write(&state, TRUE, buffer);
+			CHECK(size == DECK_AT + DISTRIBUTED_DECK_SIZE + 4, "fault %d: a part of %d bytes", fault, (int)size);
+			buffer[DECK_AT + 25] = flags[fault];
+			CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size,
+				"fault %d: the state's bytes lost", fault);
+			CHECK(!decoded.deck_present && !memcmp(&decoded.deck, &empty, sizeof(empty)), "fault %d: a part kept", fault);
+			CHECK(decoded.position.x == 10.f && decoded.body_vitality == 16384, "fault %d: the rest lost", fault);
+		}
+		return 0;
+	}
+	CASE("deck-zero-salt")
+	{
+		long index = 0x00000001;
+
+		state = living();
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		memcpy(buffer + DECK_AT, &index, 4);
+		node_count_asked = 0;
+		CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == size && !decoded.deck_present,
+			"an identifier of 0 resolved");
+		CHECK(node_count_asked == 0, "an identifier of 0 looked up");
+		return 0;
+	}
+	CASE("deck-not-finite")
+	{
+		state = living();
+		state.deck.velocity.j = NAN;
+		CHECK(distributed_unit_state_write(&state, TRUE, buffer) == DECK_AT + 4, "a velocity not finite written");
+		state = living();
+		state.deck.ticks = 40;
+		state.deck.peak = INFINITY;
+		CHECK(distributed_unit_state_write(&state, TRUE, buffer) == DECK_AT + 4, "a peak not finite written");
+		return 0;
+	}
+	CASE("deck-grammar")
+	{
+		state = living();
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		/* seated (not placed), and dead: no place for the part to be read after */
+		buffer[1] &= (byte)~FLAG(_distributed_unit_placed_bit);
+		CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == 0, "a deck part read with no place");
+		size = distributed_unit_state_write(&state, TRUE, buffer);
+		buffer[1] &= (byte)~FLAG(_distributed_unit_alive_bit);
+		CHECK(distributed_unit_state_read(buffer, buffer + size, &decoded) == 0, "a deck part read on a dead state");
+		return 0;
+	}
+	fprintf(stderr, "unknown case: %s\n", case_name);
+	return 2;
+}
diff --git a/tools/harness/tests/resting_state_scan.c b/tools/harness/tests/resting_state_scan.c
new file mode 100644
index 00000000..65afa16f
--- /dev/null
+++ b/tools/harness/tests/resting_state_scan.c
@@ -0,0 +1,132 @@
+/* a resting vehicle must not be starved by the resting-state budget */
+#include "harness.h"
+typedef unsigned short word;
+#include "config.inc"
+#define MIN(a,b) ((a) < (b) ? (a) : (b))
+#define MAXIMUM_ENTRIES_PER_MESSAGE 4
+#define DATAGRAM_ENTRIES(type) 4
+#define OWN_VEHICLE_PERIOD_TICKS 1
+#define VEHICLE_PREDICTION_REFERENCE_TICKS 60
+#define MAXIMUM_TRACKED_PLAYERS 1
+#define SET_FLAG(v,b,s) ((v)=(s)?((v)|FLAG(b)):((v)&~FLAG(b)))
+enum { _object_at_rest_bit, _distributed_object_predicted_bit, _distributed_message_object_states };
+struct distributed_object_state { long object_index; real_point3d position; unsigned long flags; short time; };
+struct distributed_object_state_message { word header; struct distributed_object_state states[4]; };
+static struct object_datum { struct { unsigned long flags; } object; } objects[MAXIMUM_TRACKED_OBJECTS];
+static boolean present[MAXIMUM_TRACKED_OBJECTS], enabled;
+static long visits[MAXIMUM_TRACKED_OBJECTS], order[MAXIMUM_TRACKED_OBJECTS + 4], order_count;
+static long objects_host_told_count, objects_host_resting_cursor, clock_tick, inspected;
+static boolean objects_host_state_moving[MAXIMUM_TRACKED_OBJECTS];
+static long objects_host_rest_times[MAXIMUM_TRACKED_OBJECTS];
+static struct {
+    short count;
+    long indices[1];
+    struct { short vehicle_count; long vehicle_indices[1]; short vehicle_player_indices[1]; } machines[1];
+} objects_host_viewers;
+static struct { long accepted_vehicle_index, accepted_host_time, accepted_time; } objects_host_vehicle_predictions[1];
+static long game_time_get(void) { return clock_tick; }
+static boolean vehicle_riding_enabled(void) { return enabled; }
+static long distributed_host_placed_object(long index)
+{
+    CHECK(index >= 0 && index < objects_host_told_count, "scan outside pool: %ld", index);
+    inspected++;
+    return present[index] ? index : NONE;
+}
+static struct object_datum *object_get(long index) { return &objects[index]; }
+static void distributed_state_from_object(long index, struct distributed_object_state *state)
+{
+    memset(state, 0, sizeof(*state)); state->object_index = index;
+}
+static short distributed_host_object_period(short machine, real_point3d const *p) { return 1; }
+static void distributed_send_to_machine(long machine, struct distributed_object_state_message const *message,
+    short kind, short count, word size)
+{
+    short i;
+    for (i = 0; i < count; i++)
+    {
+        long index = message->states[i].object_index;
+        CHECK(index >= 0 && index < objects_host_told_count, "sent outside pool");
+        visits[index]++;
+        CHECK(order_count < MAXIMUM_TRACKED_OBJECTS + 4, "unbounded state count");
+        order[order_count++] = index;
+    }
+}
+#include "under_test.inc"
+
+static void setup(long count, long cursor)
+{
+    long i;
+    memset(present, 0, sizeof(present)); memset(visits, 0, sizeof(visits));
+    memset(objects_host_state_moving, 0, sizeof(objects_host_state_moving));
+    for (i = 0; i < MAXIMUM_TRACKED_OBJECTS; i++)
+    {
+        objects_host_rest_times[i] = NONE;
+        objects[i].object.flags = FLAG(_object_at_rest_bit);
+    }
+    objects_host_told_count = count; objects_host_resting_cursor = cursor;
+    objects_host_viewers.count = 1;
+    order_count = inspected = 0; enabled = TRUE; clock_tick = 100;
+}
+static void send_tick(void)
+{
+    long before = order_count;
+    distributed_host_send_states(); clock_tick++;
+    CHECK(order_count - before <= RESTING_STATES_PER_TICK, "resting budget exceeded");
+}
+int main(int argc, char **argv)
+{
+    char const *case_name = argv[1];
+    long i, tick, count;
+    CASE("sparse-hulls")
+    {
+        setup(114, 71);
+        present[0] = present[2] = present[113] = TRUE;
+        for (i = 60; i < 96; i++) present[i] = TRUE;
+        for (tick = 0; tick < 10; tick++) send_tick();
+        CHECK(visits[0] && visits[2], "rested hulls starved: slot 0 sent %ld, slot 2 sent %ld", visits[0], visits[2]);
+        for (i = 0; i < 114; i++) CHECK(!present[i] || visits[i], "rested object %ld starved", i);
+        return 0;
+    }
+    CASE("all-rested")
+    {
+        setup(10, 2);
+        for (i = 0; i < 10; i++) present[i] = TRUE;
+        for (tick = 0; tick < 3; tick++) send_tick();
+        for (i = 0; i < 10; i++) CHECK(visits[i], "rested object %ld starved", i);
+        return 0;
+    }
+    CASE("maximum-pool")
+    {
+        count = MAXIMUM_TRACKED_OBJECTS; setup(count, count - 2);
+        for (i = 0; i < count; i++) present[i] = TRUE;
+        for (tick = 0; tick < (count + RESTING_STATES_PER_TICK - 1) / RESTING_STATES_PER_TICK; tick++) send_tick();
+        for (i = 0; i < count; i++) CHECK(visits[i] == 1, "maximum pool object %ld sent %ld times", i, visits[i]);
+        CHECK(inspected <= tick * count + count, "scan exceeded one pool per tick plus its selected objects");
+        return 0;
+    }
+    CASE("sparse-maximum-pool")
+    {
+        setup(MAXIMUM_TRACKED_OBJECTS, 0); present[MAXIMUM_TRACKED_OBJECTS - 1] = TRUE;
+        send_tick();
+        CHECK(visits[MAXIMUM_TRACKED_OBJECTS - 1] == 1, "sparse hull repeated within one scan");
+        CHECK(inspected == 2 * MAXIMUM_TRACKED_OBJECTS, "sparse scan must visit each slot once per pass: %ld", inspected);
+        return 0;
+    }
+    CASE("empty-pool")
+    {
+        setup(0, 0); send_tick();
+        CHECK(!order_count && !inspected, "empty pool visited or sent objects");
+        return 0;
+    }
+    CASE("riding-off-original")
+    {
+        static long const original[] = { 2, 4, 7, 1, 2, 4, 7, 1 };
+        setup(10, 2); enabled = FALSE;
+        for (i = 0; i < 10; i++) present[i] = TRUE;
+        send_tick(); send_tick();
+        CHECK(order_count == 8, "legacy state count changed");
+        for (i = 0; i < 8; i++) CHECK(order[i] == original[i], "riding off changed send %ld: %ld", i, order[i]);
+        return 0;
+    }
+    return 2;
+}
diff --git a/tools/harness/tests/retried_inventories.c b/tools/harness/tests/retried_inventories.c
new file mode 100644
index 00000000..384b411d
--- /dev/null
+++ b/tools/harness/tests/retried_inventories.c
@@ -0,0 +1,256 @@
+#include "harness.h"
+#include <math.h>
+
+typedef unsigned short word;
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#include "config.inc"
+
+/* A client's world: the host's objects, each here or not yet (the stream
+makes them, and can trail the host's inventories, which go as datagrams);
+units that carry weapons of one magazine. */
+#define OBJECT_COUNT 256
+#define OBJECT(n) (0x10000L | (n))
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) (&((type *)(block)->address)[index])
+struct tag_block { long count; void *address; };
+struct weapon_magazine_definition { short rounds_total_initial, rounds_total_maximum, rounds_loaded_maximum; };
+struct weapon_definition { struct { struct tag_block magazines; } weapon; };
+struct weapon_magazine { short rounds_total, rounds_loaded; };
+struct weapon_datum { long definition_index; struct { struct weapon_magazine magazines[2]; real age; } weapon; };
+struct unit_datum
+{
+	struct { unsigned long damage_flags; } object;
+	struct
+	{
+		long player_index;
+		long weapon_object_indices[MAXIMUM_WEAPONS_PER_UNIT];
+		short current_weapon_index, desired_weapon_index;
+		char grenade_counts[NUMBER_OF_UNIT_GRENADE_TYPES];
+		short grenade_throw_state, current_grenade_index, desired_grenade_index;
+	} unit;
+};
+struct player_datum { short local_player_index; };
+static struct { boolean here; short type; } objects[OBJECT_COUNT];
+static struct unit_datum units[OBJECT_COUNT];
+static struct weapon_datum weapons[OBJECT_COUNT];
+static struct weapon_magazine_definition magazine_definition = {0, 500, 100};
+static struct weapon_definition weapon_definition = {{{1, &magazine_definition}}};
+static struct player_datum player;
+static long now;
+
+static boolean here(long index)
+{
+	return index != NONE && (index >> 16) == 1 && (index & 0xFFFF) < OBJECT_COUNT && objects[index & 0xFFFF].here;
+}
+static boolean network_objects_client_has(long index) { return here(index); }
+static void *object_try_and_get_and_verify_type(long index, unsigned long mask)
+{
+	if (!here(index) || !TEST_FLAG(mask, objects[index & 0xFFFF].type))
+		return NULL;
+	return objects[index & 0xFFFF].type == _object_type_weapon ? (void *)&weapons[index & 0xFFFF] : (void *)&units[index & 0xFFFF];
+}
+static struct unit_datum *unit_get(long index)
+{
+	CHECK(object_try_and_get_and_verify_type(index, _object_mask_unit), "not a unit here: %lx", index);
+	return &units[index & 0xFFFF];
+}
+static struct weapon_datum *weapon_try_and_get(long index) { return object_try_and_get_and_verify_type(index, _object_mask_weapon); }
+static struct weapon_definition *weapon_definition_get(long index) { return &weapon_definition; }
+static long game_time_get(void) { return now; }
+static struct player_datum *player_get(long index) { return &player; }
+static boolean distributed_player_is_local(long player_index) { return FALSE; }
+static boolean distributed_client_own_settled(long time) { return TRUE; }
+static void distributed_client_release_item(long index, boolean dropped) {}
+static void unit_network_drop_weapon(long unit_index, short slot) { unit_get(unit_index)->unit.weapon_object_indices[slot] = NONE; }
+static void unit_network_add_weapon(long unit_index, long weapon_index, short slot)
+{
+	unit_get(unit_index)->unit.weapon_object_indices[slot] = weapon_index;
+}
+struct distributed_own_inventory;
+static void distributed_client_note_own_inventory(struct distributed_own_inventory *own, long unit_index, boolean compare) {}
+#include "under_test.inc"
+
+/* the stream makes one of the host's objects here: a unit carrying nothing,
+or a weapon */
+static void arrive(long index, short type)
+{
+	struct unit_datum *unit = &units[index & 0xFFFF];
+	short slot;
+
+	objects[index & 0xFFFF].here = TRUE;
+	objects[index & 0xFFFF].type = type;
+	memset(unit, 0, sizeof(*unit));
+	unit->unit.player_index = NONE;
+	unit->unit.current_weapon_index = NONE;
+	unit->unit.current_grenade_index = NONE;
+	for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+		unit->unit.weapon_object_indices[slot] = NONE;
+}
+
+/* the host's inventory of a unit carrying two weapons (NONE: none) */
+static struct distributed_inventory carrying(long unit_index, long first, long second, char grenades)
+{
+	struct distributed_inventory inventory;
+	short slot;
+
+	memset(&inventory, 0, sizeof(inventory));
+	inventory.unit_index = unit_index;
+	inventory.grenade_counts[0] = grenades;
+	inventory.current_weapon_index = 0;
+	for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+	{
+		inventory.weapon_indices[slot] = slot == 0 ? first : slot == 1 ? second : NONE;
+		inventory.rounds_total[slot][0] = (short)(100 * (slot + 1));
+		inventory.rounds_loaded[slot][0] = (short)(10 * (slot + 1));
+	}
+	return inventory;
+}
+
+/* the host's inventory comes, as network_objects_handle_inventories takes it */
+static void receive(struct distributed_inventory inventory)
+{
+	distributed_client_apply_inventory(&inventory);
+}
+
+static boolean kept(long unit_index)
+{
+	short index;
+
+	for (index = 0; index < objects_client_retried_inventory_count; index++)
+	{
+		if (objects_client_retried_inventories[index].inventory.unit_index == unit_index)
+			return TRUE;
+	}
+	return FALSE;
+}
+
+static long held(long unit_index, short slot) { return unit_get(unit_index)->unit.weapon_object_indices[slot]; }
+
+static void reset(void)
+{
+	memset(objects, 0, sizeof(objects));
+	memset(&player, 0, sizeof(player));
+	memset(objects_client_retried_inventories, 0, sizeof(objects_client_retried_inventories));
+	objects_client_retried_inventory_count = 0;
+	now = 1000;
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argv[1];
+	long unit = OBJECT(1), first = OBJECT(2), second = OBJECT(3);
+	short index;
+
+	reset();
+	/* a player spawned: its inventory comes before its unit and its weapon,
+	is kept, and is applied in full the tick they have all come */
+	CASE("unit-late")
+	{
+		receive(carrying(unit, first, NONE, 3));
+		CHECK(kept(unit) && objects_client_retried_inventory_count == 1, "unit-late: not kept");
+		arrive(first, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(kept(unit), "unit-late: let go of before its unit came");
+		arrive(unit, _object_type_biped);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(held(unit, 0) == first, "unit-late: its weapon not given once it came");
+		CHECK(units[1].unit.grenade_counts[0] == 3 && weapons[2].weapon.magazines[0].rounds_total == 100 &&
+			weapons[2].weapon.magazines[0].rounds_loaded == 10, "unit-late: its grenades or rounds not given");
+		CHECK(!kept(unit) && objects_client_retried_inventory_count == 0, "unit-late: kept once applied");
+	}
+	/* its unit here, one of its weapons not: what is here is given at once,
+	the rest once it comes */
+	CASE("weapon-late")
+	{
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		receive(carrying(unit, first, second, 2));
+		CHECK(held(unit, 0) == first && held(unit, 1) == NONE, "weapon-late: what is here not given at once");
+		CHECK(kept(unit), "weapon-late: not kept for the weapon to come");
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(kept(unit) && held(unit, 1) == NONE, "weapon-late: applied before its weapon came");
+		arrive(second, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(held(unit, 1) == second && weapons[3].weapon.magazines[0].rounds_total == 200,
+			"weapon-late: the weapon not given once it came");
+		CHECK(!kept(unit), "weapon-late: kept once applied");
+	}
+	/* a unit's newer inventory takes its older one's place */
+	CASE("newest")
+	{
+		receive(carrying(unit, first, NONE, 1));
+		now++;
+		receive(carrying(unit, first, NONE, 4));
+		CHECK(objects_client_retried_inventory_count == 1, "newest: %d kept of one unit", objects_client_retried_inventory_count);
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(units[1].unit.grenade_counts[0] == 4, "newest: not the newest applied");
+	}
+	/* the list full: one more takes the oldest's place, and a kept unit's
+	newer one its own */
+	CASE("full")
+	{
+		for (index = 0; index < MAXIMUM_CLIENT_RETRIED_INVENTORIES; index++)
+		{
+			now++;
+			receive(carrying(OBJECT(17 + index), NONE, NONE, 1));
+		}
+		CHECK(objects_client_retried_inventory_count == MAXIMUM_CLIENT_RETRIED_INVENTORIES,
+			"full: %d kept of %d", objects_client_retried_inventory_count, MAXIMUM_CLIENT_RETRIED_INVENTORIES);
+		now++;
+		receive(carrying(OBJECT(200), NONE, NONE, 1));
+		CHECK(!kept(OBJECT(17)) && kept(OBJECT(18)) && kept(OBJECT(200)), "full: not the oldest's place taken");
+		now++;
+		receive(carrying(OBJECT(201), NONE, NONE, 1));
+		CHECK(!kept(OBJECT(18)) && kept(OBJECT(19)) && kept(OBJECT(201)), "full: not the next oldest's taken");
+		now++;
+		receive(carrying(OBJECT(19), NONE, NONE, 2));
+		CHECK(kept(OBJECT(19)) && kept(OBJECT(20)), "full: a kept unit's newer one took another's place");
+		CHECK(objects_client_retried_inventory_count == MAXIMUM_CLIENT_RETRIED_INVENTORIES, "full: %d kept",
+			objects_client_retried_inventory_count);
+	}
+	/* a unit's whole inventory, come once all it names is here: its kept one
+	is let go of, and never applied over it */
+	CASE("forget")
+	{
+		long other = OBJECT(6);
+
+		receive(carrying(unit, first, NONE, 1));
+		receive(carrying(other, NONE, NONE, 1));
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		receive(carrying(unit, first, NONE, 5));
+		CHECK(!kept(unit) && kept(other) && objects_client_retried_inventory_count == 1, "forget: not let go of");
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(units[1].unit.grenade_counts[0] == 5, "forget: the older applied over the newer");
+	}
+	/* let go of EMPTY_INVENTORY_TICKS after the newest of its unit's came,
+	and not applied when its unit comes after */
+	CASE("expiry")
+	{
+		long newest = now + EMPTY_INVENTORY_TICKS / 2;
+
+		receive(carrying(unit, first, NONE, 1));
+		now = newest;
+		receive(carrying(unit, first, NONE, 1));
+		now = newest + EMPTY_INVENTORY_TICKS - 1;
+		distributed_client_apply_retried_inventories();
+		CHECK(kept(unit), "expiry: let go of %d ticks after the newest", EMPTY_INVENTORY_TICKS - 1);
+		now = newest + EMPTY_INVENTORY_TICKS;
+		distributed_client_apply_retried_inventories();
+		CHECK(!kept(unit), "expiry: kept %d ticks after the newest", EMPTY_INVENTORY_TICKS);
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(held(unit, 0) == NONE, "expiry: applied after it was let go of");
+	}
+	return 0;
+}
diff --git a/tools/harness/tests/rider_pass.c b/tools/harness/tests/rider_pass.c
new file mode 100644
index 00000000..48f01039
--- /dev/null
+++ b/tools/harness/tests/rider_pass.c
@@ -0,0 +1,214 @@
+/*
+RIDER_PASS.C (test)
+
+objects.c's update loops over a fake object list: a biped in a vehicle's
+window updates after the main loop, so it always comes after its vehicle;
+the counts give each carry the vehicle's updates it spans.
+test_rider_pass.py takes the code (under_test.inc) and the enums
+(enums.inc) from the sources.
+*/
+
+#include "harness.h"
+#include "enums.inc"
+
+#define DATUM_INDEX_NEW(i, s) ((long)(((unsigned long)(unsigned short)(s) << 16) | (unsigned short)(i)))
+#define SHORT_BITS 16
+
+struct object_header_datum
+{
+	short identifier;
+	byte flags;
+	byte type;
+};
+
+struct object_datum
+{
+	struct { long parent_object_index, next_object_index; } object;
+	struct { long player_index; } unit;
+};
+
+enum { OBJECTS = MAXIMUM_OBJECTS_PER_MAP };
+static struct data_array *object_header_data;
+static struct object_datum objects[OBJECTS];
+static long *object_update_counts;
+/* the riding switch, and how often the pass reads it */
+static boolean riding_enabled = TRUE;
+static long enabled_reads;
+static boolean vehicle_riding_enabled(void)
+{
+	enabled_reads++;
+	return riding_enabled;
+}
+#define object_get(index) (&objects[DATUM_INDEX_TO_ABSOLUTE_INDEX(index)])
+#define unit_get(index) object_get(index)
+
+static struct object_header_datum *object_header_try_and_get(long index)
+{
+	struct object_header_datum *header = datum_get(object_header_data, index);
+
+	return header->identifier && header->identifier == (short)(index >> 16) ? header : NULL;
+}
+
+#include "under_test.inc"
+
+/* the world: slot 0 a player's biped, slot 1 its vehicle, slot 2 an AI */
+static long rider, vehicle, actor;
+static long order[MAXIMUM_OBJECTS_PER_MAP];
+static int order_count;
+static boolean rider_deferred, actor_deferred;
+static boolean all_deferred;
+static boolean rider_dies, deactivate_rider, attach_rider;
+
+static long object_new(byte type, long player_index)
+{
+	long index = datum_new(object_header_data);
+	struct object_header_datum *header = datum_get(object_header_data, index);
+
+	header->flags = FLAG(_object_header_active_bit);
+	header->type = type;
+	object_get(index)->object.parent_object_index = NONE;
+	object_get(index)->unit.player_index = player_index;
+	return index;
+}
+
+static long deferred_calls;
+
+static boolean deferred(long object_index)
+{
+	deferred_calls++;
+	return all_deferred || (object_index == rider ? rider_deferred : object_index == actor ? actor_deferred : FALSE);
+}
+
+static boolean update(long object_index)
+{
+	order[order_count++] = object_index;
+	object_count_update(object_index);
+	if (object_index == vehicle && rider_dies)
+		rider_deferred = FALSE;
+	if (object_index == vehicle && deactivate_rider)
+		((struct object_header_datum *)datum_get(object_header_data, rider))->flags = 0;
+	if (object_index == vehicle && attach_rider)
+		object_get(rider)->object.parent_object_index = vehicle;
+	return TRUE;
+}
+
+static void world(void)
+{
+	object_header_data = game_state_data_new("object", OBJECTS, sizeof(struct object_header_datum));
+	/* (one slot past the end, to see a count written there) */
+	object_update_counts = calloc(MAXIMUM_OBJECTS_PER_MAP + 1, sizeof(long));
+	rider = object_new(_object_type_biped, 0);
+	vehicle = object_new(_object_type_vehicle, NONE);
+	actor = object_new(_object_type_biped, NONE);
+	order_count = 0;
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc > 1 ? argv[1] : "";
+
+	world();
+	CASE("capacity")
+	{
+		long index;
+
+		/* one more deferred object than the list holds: the one that does not fit updates in the main loop, ahead of the list */
+		for (index = 3; index <= HALO_PORT_MAXIMUM_NETWORK_PLAYERS; index++)
+			object_new(_object_type_biped, NONE);
+		all_deferred = TRUE;
+		objects_update_passes(FALSE, deferred, update);
+		CHECK(order_count == HALO_PORT_MAXIMUM_NETWORK_PLAYERS + 1, "not every deferred object updated past capacity");
+		CHECK(DATUM_INDEX_TO_ABSOLUTE_INDEX(order[0]) == HALO_PORT_MAXIMUM_NETWORK_PLAYERS,
+			"the overflow rider did not update in the main loop");
+		for (index = 0; index < HALO_PORT_MAXIMUM_NETWORK_PLAYERS; index++)
+			CHECK(DATUM_INDEX_TO_ABSOLUTE_INDEX(order[index + 1]) == index, "list order changed at %ld", index);
+		for (index = 0; index <= HALO_PORT_MAXIMUM_NETWORK_PLAYERS; index++)
+			CHECK(object_update_count(order[index]) == 1, "an object was not updated exactly once");
+		return 0;
+	}
+	CASE("after-vehicle")
+	{
+		long before;
+		short tick;
+
+		/* riding, the tick it leaves, the tick it lands back: deferred in each */
+		rider_deferred = TRUE;
+		for (tick = 0; tick < 3; tick++)
+		{
+			before = object_update_count(vehicle);
+			order_count = 0;
+			objects_update_passes(FALSE, deferred, update);
+			CHECK(order_count == 3 && order[2] == rider, "the rider not after its vehicle");
+			CHECK(object_update_count(vehicle) - before == 1, "n = %ld", object_update_count(vehicle) - before);
+		}
+		/* not deferred: datum order */
+		rider_deferred = FALSE;
+		order_count = 0;
+		objects_update_passes(FALSE, deferred, update);
+		CHECK(order[0] == rider && order[1] == vehicle, "not in datum order");
+		return 0;
+	}
+	CASE("off-no-deferred-calls")
+	{
+		/* riding off: nothing is a rider, so the callback is never asked and every object updates in datum order */
+		riding_enabled = FALSE;
+		rider_deferred = TRUE;
+		actor_deferred = TRUE;
+		objects_update_passes(FALSE, deferred, update);
+		CHECK(deferred_calls == 0, "deferred asked %ld times", deferred_calls);
+		CHECK(enabled_reads == 1, "the switch read %ld times, not once", enabled_reads);
+		CHECK(order_count == 3 && order[0] == rider && order[1] == vehicle && order[2] == actor, "not updated in datum order");
+		return 0;
+	}
+	CASE("dies-between-loops")
+	{
+		rider_deferred = TRUE;
+		rider_dies = TRUE;
+		objects_update_passes(FALSE, deferred, update);
+		CHECK(order_count == 3 && order[2] == rider, "a rider that died in between not updated");
+		return 0;
+	}
+	CASE("deactivated-between-loops")
+	{
+		rider_deferred = TRUE;
+		deactivate_rider = TRUE;
+		objects_update_passes(FALSE, deferred, update);
+		CHECK(order_count == 2, "a deactivated rider updated");
+		return 0;
+	}
+	CASE("parented-between-loops")
+	{
+		/* entered a seat during the vehicle's update: a child, updated by its parent */
+		rider_deferred = TRUE;
+		attach_rider = TRUE;
+		objects_update_passes(FALSE, deferred, update);
+		CHECK(order_count == 2, "a rider that became a child updated alone");
+		return 0;
+	}
+	CASE("double-speed")
+	{
+		/* an odd tick: the player updates, the vehicle and the AI not; a deferred
+		biped without a player not either */
+		rider_deferred = TRUE;
+		actor_deferred = TRUE;
+		objects_update_passes(TRUE, deferred, update);
+		CHECK(order_count == 1 && order[0] == rider, "%d updated", order_count);
+		return 0;
+	}
+	CASE("counts")
+	{
+		long *counts = object_update_counts;
+
+		object_count_update(DATUM_INDEX_NEW(MAXIMUM_OBJECTS_PER_MAP, 1));
+		CHECK(counts[MAXIMUM_OBJECTS_PER_MAP] == 0, "counted past the end");
+		object_update_counts = NULL;
+		object_count_update(vehicle);
+		CHECK(object_update_count(vehicle) == 0, "a count without counts");
+		object_update_counts = counts;
+		object_count_update(vehicle);
+		CHECK(object_update_count(vehicle) == 1, "not counted");
+		return 0;
+	}
+	fprintf(stderr, "unknown case: %s\n", case_name);
+	return 2;
+}
diff --git a/tools/harness/tests/riding_camera.c b/tools/harness/tests/riding_camera.c
new file mode 100644
index 00000000..9b10a6b5
--- /dev/null
+++ b/tools/harness/tests/riding_camera.c
@@ -0,0 +1,138 @@
+/*
+RIDING_CAMERA.C (test)
+
+The desktop direct camera's turn against the drawn vehicle, and the dead
+player whose last kept turn no longer changes. The real camera and vector
+turn are taken from their port files by test_riding_camera.py.
+*/
+
+#include "harness.h"
+#include <math.h>
+
+#define MAXIMUM_LOCAL_PLAYERS 2
+#define _director_perspective_first_person 0
+#define _object_dead_bit 0
+struct observer_result { real_vector3d forward, up; };
+struct object_datum
+{
+	struct { long parent_object_index; unsigned long damage_flags; } object;
+};
+static struct object_datum unit;
+static struct observer_result direct_cameras[MAXIMUM_LOCAL_PLAYERS];
+static real fraction, kept[2];
+static real_vector3d facing;
+static boolean direct_enabled = TRUE;
+static long turn_calls;
+#define config_changes() 0UL
+#define config_boolean(name) direct_enabled
+#define director_get_perspective(index) _director_perspective_first_person
+#define director_inhibited_facing(index) FALSE
+#define cinematic_in_progress() FALSE
+#define player_control_get_unit_index(index) 7
+#define object_get(index) (&unit)
+#define player_control_get_facing_direction(index, output) (*(output) = facing)
+#define render_interpolation_fraction() fraction
+#define vehicle_riding_kept_dyaw(index) kept[index]
+static void observer_up_from_forward(real_vector3d const *forward, real_vector3d *up)
+{
+	up->i = -forward->k * forward->i;
+	up->j = -forward->k * forward->j;
+	up->k = forward->i * forward->i + forward->j * forward->j;
+}
+
+#include "under_test.inc"
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc > 1 ? argv[1] : "";
+	struct observer_result observer;
+	struct observer_result const *drawn;
+	short index;
+
+	memset(&observer, 0, sizeof(observer));
+	unit.object.parent_object_index = NONE;
+	facing.i = 0.f;
+	facing.j = 0.8f;
+	facing.k = 0.6f;
+	kept[0] = 1.5707963267948966f;
+	kept[1] = -1.5707963267948966f;
+	CASE("smooth")
+	{
+		for (index = 0; index <= 4; index++)
+		{
+			real angle = index * 1.5707963267948966f / 4.f;
+
+			fraction = index / 4.f;
+			drawn = render_interpolation_direct_camera(0, &observer);
+			CHECK(fabs(drawn->forward.i - 0.8f*cos(angle)) < 0.000001f,
+				"wrong drawn x at fraction %g: %g", fraction, drawn->forward.i);
+			CHECK(fabs(drawn->forward.j - 0.8f*sin(angle)) < 0.000001f,
+				"wrong drawn y at fraction %g: %g", fraction, drawn->forward.j);
+			CHECK(drawn->forward.k == 0.6f, "vehicle changed pitch");
+		}
+		return 0;
+	}
+	CASE("dead")
+	{
+		unit.object.damage_flags = FLAG(_object_dead_bit);
+		fraction = 0.f;
+		drawn = render_interpolation_direct_camera(0, &observer);
+		CHECK(drawn->forward.i == facing.i && drawn->forward.j == facing.j &&
+			drawn->forward.k == facing.k, "dead player's frozen turn was undone");
+		return 0;
+	}
+	CASE("players")
+	{
+		fraction = 0.f;
+		drawn = render_interpolation_direct_camera(1, &observer);
+		CHECK(fabs(drawn->forward.i + 0.8f) < 0.000001f &&
+			fabs(drawn->forward.j) < 0.000001f, "used another player's kept turn");
+		return 0;
+	}
+	CASE("parented")
+	{
+		unit.object.parent_object_index = 9;
+		CHECK(render_interpolation_direct_camera(0, &observer) == &observer,
+			"changed a seated player's camera");
+		return 0;
+	}
+	CASE("no-turn")
+	{
+		kept[0] = 0.f;
+		drawn = render_interpolation_direct_camera(0, &observer);
+		CHECK(drawn->forward.i == facing.i && drawn->forward.j == facing.j &&
+			drawn->forward.k == facing.k, "changed facing without a kept turn");
+		return 0;
+	}
+	CASE("render-turn-zero-skipped")
+	{
+		static real const components[] = { .1f, -.3f, .8f, -.6f, 1.5f, -2.25f, 1e-20f, -1e20f };
+		short a, b, c, f;
+
+		kept[0] = 0.f;
+		for (a = 0; a < 8; a++)
+			for (b = 0; b < 8; b++)
+				for (c = 0; c < 8; c++)
+					for (f = 0; f <= 4; f++)
+					{
+						struct observer_result expected;
+
+						facing.i = components[a];
+						facing.j = components[b];
+						facing.k = components[c];
+						fraction = f / 4.f;
+						turn_calls = 0;
+						drawn = render_interpolation_direct_camera(0, &observer);
+						CHECK(turn_calls == 0, "turned by zero %ld times", turn_calls);
+						expected.forward = facing;
+						vehicle_riding_turn_vector(&expected.forward, -(1.0f - fraction)*kept[0]);
+						observer_up_from_forward(&expected.forward, &expected.up);
+						CHECK(!memcmp(&drawn->forward, &expected.forward, sizeof(expected.forward)) &&
+							!memcmp(&drawn->up, &expected.up, sizeof(expected.up)),
+							"skipped turn differs at %d %d %d %d", a, b, c, f);
+					}
+		return 0;
+	}
+	fprintf(stderr, "unknown case: %s\n", case_name);
+	return 2;
+}

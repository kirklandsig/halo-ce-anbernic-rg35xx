+
+/* the pixel shader of an instanced program: its constants read from the
+instance's copy in a uniform block (binding 2), at the instance the vertex
+shader passes on; 0 if the shader does not declare them as expected */
+static GLuint fragment_instanced_shader(struct fragment_entry *fragment)
+{
+	static const char declarations[] = "uniform vec4 ps_c0[8];\nuniform vec4 ps_c1[8];\n"
+		"uniform vec4 ps_final_c0;\nuniform vec4 ps_final_c1;\n";
+	static const char *const names[4][2] =
+	{
+		{ "ps_c0[", "xip[xipb + " }, { "ps_c1[", "xip[xipb + 8 + " },
+		{ "ps_final_c0", "xip[xipb + 16]" }, { "ps_final_c1", "xip[xipb + 17]" }
+	};
+	struct xgpu_text text = { 0 };
+	const char *cursor, *found;
+	char *source;
+
+	if (fragment->instanced_tried)
+		return fragment->instanced_shader;
+	fragment->instanced_tried = TRUE;
+	source = nv2a_pixel_shader_to_glsl(&fragment->key);
+	found = strstr(source, declarations);
+	if (!found)
+	{
+		free(source);
+		return 0;
+	}
+	xgpu_text_put(&text, source, (unsigned long)(found - source));
+	xgpu_text_append(&text, "layout(std140) uniform instance_pixel_constants { vec4 xip[%d]; };\n"
+		"flat in highp int xInstance;\n#define xipb (xInstance * %d)\n", INSTANCE_PIXEL_CONSTANTS * XGPU_INSTANCES,

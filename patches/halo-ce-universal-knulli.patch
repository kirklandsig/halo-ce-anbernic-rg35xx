+/* ---------- instanced model draws
+
+Once the models are sorted (rasterizer_xbox_models.c), several marines' same
+part come one after another: the same draw with other constants, each
+costing the Mali driver some 17 us. A draw of a two-block program
+(XGPU_CONSTANT_SPLIT) with its indices in the mirror is held here instead of
+drawn, and the next draws that are the same draw join it. They are drawn as
+instances of the program's instanced variant, each reading its own copy of
+the vertex constants and of the pixel shader's constants (the change colours
+differ from marine to marine) from uniform blocks: the vertex shader through
+gl_InstanceID (XGPU_OUTPUT_INSTANCED), the pixel shader through the index the
+vertex shader passes on (fragment_instanced_shader). Their other uniforms
+must be the same.
+
+prepare_draw binds nothing of a draw that may be held (its program, its
+constants, its uniforms); instance_flush binds the instanced program's. As
+with the quad batch, a GL call draws the held draws first
+(guest_gl_before_call): a draw that joins has made none, so the GL state is
+still theirs. If the draw being prepared had bound its program and constants
+already, they are put back. A draw left by itself is drawn with its own
+program when that is known between draws (the next draw is of other
+geometry): the instanced shaders read the constants from memory, which
+costs the GPU more. debug.instance_models = false draws each by itself. */
+
+/* ps_c0[8], ps_c1[8], ps_final_c0 and ps_final_c1, in that order */
+#define INSTANCE_PIXEL_CONSTANTS 18
+
+static struct
+{
+	BOOL pending;
+	/* the draw's program, and its instanced variant that draws them */
+	struct program_entry *entry, *instanced;
+	/* what the first draw was called with, and prepare_draw chose */
+	const WORD *index_data;
+	D3DPRIMITIVETYPE primitive_type;
+	struct vertex_shader_object *declaration, *program_object;
+	unsigned long outputs;
+	/* the low registers the program reads that differ between the draws */
+	unsigned long long low_mask;
+	GLenum mode;
+	unsigned long minimum, maximum, index_count, index_offset;
+	GLint base_vertex;
+	/* the high registers each draw's nodes fill */
+	unsigned long extent;
+	/* the first draw's other uniforms, the same for all but the pixel constants */
+	struct draw_uniforms uniforms;
+	unsigned long uniforms_serial;
+	/* the first draw's constant serials, for drawing it by itself */
+	unsigned long low_version, high_version;
+	unsigned long count;
+	float low[XGPU_INSTANCES][XGPU_CONSTANT_SPLIT][4];
+	/* the draws' high registers, extent registers apart */
+	float high[XGPU_INSTANCE_HIGH_REGISTERS][4];
+	float pixel[XGPU_INSTANCES][INSTANCE_PIXEL_CONSTANTS][4];

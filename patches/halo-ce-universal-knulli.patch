+#ifdef HALO_ANDROID
+/* The shadow targets' textures, for the Mali port's shadows in two passes
+(rasterizer_xbox_shadows.c): each shadow of a frame has a pair of its own,
+and consecutive frames draw into different pairs.
+Slot 0 is the pair made at start-up; the others are made when first used. */
+#define SHADOW_TARGET_SLOTS 48 /* 16 shadows in each of 3 frames */
+
+boolean rasterizer_shadow_targets_select(short slot)
+{
+	static struct
+	{
+		D3DTexture *primary_texture;
+		D3DSurface *primary;
+		D3DTexture *secondary_texture;
+		D3DSurface *secondary;
+	} slots[SHADOW_TARGET_SLOTS];
+
+	if (slot < 0 || slot >= SHADOW_TARGET_SLOTS)
+		return FALSE;
+	if (!slots[0].primary)
+	{
+		slots[0].primary_texture = global_d3d_texture_shadow_primary;
+		slots[0].primary = global_d3d_surface_shadow_primary;
+		slots[0].secondary_texture = global_d3d_texture_shadow_secondary;
+		slots[0].secondary = global_d3d_surface_shadow_secondary;
+	}
+	if (!slots[slot].primary)
+	{
+		static boolean failed[SHADOW_TARGET_SLOTS];
+		D3DTexture *primary_texture = NULL, *secondary_texture = NULL;
+		D3DSurface *primary = NULL, *secondary = NULL;
+
+		/* (a slot that could not be made is not tried again) */
+		if (failed[slot])
+			return FALSE;
+		if (IDirect3DDevice8_CreateTexture(global_d3d_device, RASTERIZER_TARGET_SHADOW_PRIMARY_SIZE,
+				RASTERIZER_TARGET_SHADOW_PRIMARY_SIZE, 1, D3DUSAGE_RENDERTARGET, D3DFMT_R5G6B5, D3DPOOL_DEFAULT,
+				&primary_texture) < 0 ||
+			IDirect3DTexture8_GetSurfaceLevel(primary_texture, 0, &primary) < 0 ||
+			IDirect3DDevice8_CreateTexture(global_d3d_device, RASTERIZER_TARGET_SHADOW_SECONDARY_SIZE,
+				RASTERIZER_TARGET_SHADOW_SECONDARY_SIZE, 1, D3DUSAGE_RENDERTARGET, D3DFMT_R5G6B5, D3DPOOL_DEFAULT,
+				&secondary_texture) < 0 ||
+			IDirect3DTexture8_GetSurfaceLevel(secondary_texture, 0, &secondary) < 0)
+		{
+			/* what was made goes again */
+			if (secondary)
+				IDirect3DSurface8_Release(secondary);
+			if (secondary_texture)
+				IDirect3DTexture8_Release(secondary_texture);
+			if (primary)
+				IDirect3DSurface8_Release(primary);
+			if (primary_texture)
+				IDirect3DTexture8_Release(primary_texture);
+			failed[slot] = TRUE;
+			return FALSE;
+		}
+		slots[slot].primary_texture = primary_texture;
+		slots[slot].primary = primary;
+		slots[slot].secondary_texture = secondary_texture;
+		slots[slot].secondary = secondary;
+	}
+	global_d3d_texture_shadow_primary = slots[slot].primary_texture;
+	global_d3d_surface_shadow_primary = slots[slot].primary;
+	global_d3d_texture_shadow_secondary = slots[slot].secondary_texture;
+	global_d3d_surface_shadow_secondary = slots[slot].secondary;
+	return TRUE;
+}

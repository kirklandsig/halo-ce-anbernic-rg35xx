+/* ---------- programs made for the guest (d3d8_gl.c, program_build)
+
+The guest names a program (a name the GL thread reserved) and draws with it
+at once; the program is made here: from the driver's binary that an earlier
+build kept in cache_path, or else compiled and linked, and its binary kept
+there. The shaders' uniforms, blocks and samplers are where their sources
+put them, so nothing about the program is asked for afterwards. On the
+Knulli host threads of their own make it, while the GL thread skips the
+draws made with it (host_glthread.c), so that neither the game's thread nor
+the GL thread waits for it; elsewhere it is made before those draws. A
+shader is compiled once, for every program that uses it (the Knulli host's
+compilers share them: the list is looked up and added to under a lock, the
+compile made outside it). */
+static struct
+{
+	unsigned long long hash;
+	GLenum type;
+	GLuint shader;
+} *built_shaders;
+static size_t built_shader_count, built_shader_capacity;
+static pthread_mutex_t built_shader_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* whether the shader was built, and what: 0 if it failed to compile (under
+the lock) */
+static int built_shader_find(GLenum type, unsigned long long hash, GLuint *shader)
+{
+	size_t index;
+
+	for (index = 0; index < built_shader_count; index++)
+	{
+		if (built_shaders[index].hash == hash && built_shaders[index].type == type)
+		{
+			*shader = built_shaders[index].shader;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static GLuint built_shader(GLenum type, const char *source, unsigned long long hash)
+{
+	GLuint shader, found;
+	GLint status = 0;
+	int built;
+
+	pthread_mutex_lock(&built_shader_lock);
+	built = built_shader_find(type, hash, &found);
+	pthread_mutex_unlock(&built_shader_lock);
+	if (built)
+		return found;
+	shader = glCreateShader(type);
+	glShaderSource(shader, 1, &source, NULL);
+	glCompileShader(shader);
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+	if (!status)
+	{
+		char log[4096];
+
+		glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+		host_logf(HOST_LOG_WARN, "cannot compile a %s shader: %s\n%s", type == GL_VERTEX_SHADER ? "vertex" : "fragment",
+			log, source);
+		glDeleteShader(shader);
+		shader = 0;
+	}
+	pthread_mutex_lock(&built_shader_lock);
+	/* (another compiler's, built meanwhile, is the one kept) */
+	if (built_shader_find(type, hash, &found))
+	{
+		pthread_mutex_unlock(&built_shader_lock);
+		if (shader)
+			glDeleteShader(shader);
+		return found;
+	}
+	if (built_shader_count == built_shader_capacity)
+	{
+		size_t capacity = built_shader_capacity ? built_shader_capacity * 2 : 256;
+		void *grown = realloc(built_shaders, capacity * sizeof(*built_shaders));
+
+		/* (without memory it is not kept: compiled again when next asked for) */
+		if (!grown)
+		{
+			pthread_mutex_unlock(&built_shader_lock);
+			return shader;
+		}
+		built_shaders = grown;
+		built_shader_capacity = capacity;
+	}
+	built_shaders[built_shader_count].hash = hash;
+	built_shaders[built_shader_count].type = type;
+	built_shaders[built_shader_count].shader = shader;
+	built_shader_count++;
+	pthread_mutex_unlock(&built_shader_lock);
+	return shader;
+}
+
+/* milliseconds, for the build logs */
+static double build_clock(void)
+{
+	return host_monotonic_ns() / 1e6;
+}
+
+/* the program from the driver's binary that an earlier build kept in
+cache_path: whether it loaded (a binary that does not is removed) */
+int host_gl_program_load(uint32_t program, const char *cache_path)
+{
+	GLint status = 0;
+	FILE *file;
+	unsigned int header[2];
+	void *binary;
+	double start = build_clock();
+
+	if (!*cache_path || (file = fopen(cache_path, "rb")) == NULL)
+		return 0;
+	if (fread(header, sizeof(header), 1, file) == 1 && header[1] && header[1] < 16u * 1024 * 1024 &&
+		(binary = malloc(header[1])) != NULL)
+	{
+		if (fread(binary, header[1], 1, file) == 1)
+		{
+			glProgramBinary(program, (GLenum)header[0], binary, (GLsizei)header[1]);
+			glGetProgramiv(program, GL_LINK_STATUS, &status);
+		}
+		free(binary);
+	}
+	fclose(file);
+	/* a binary of another driver's, or damaged */
+	if (!status)
+		remove(cache_path);
+	else if (build_clock() - start > 5.0)
+		host_logf(HOST_LOG_INFO, "program %u loaded from its binary in %.1f ms", program, build_clock() - start);
+	return status != 0;
+}

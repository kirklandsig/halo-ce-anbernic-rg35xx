+/* the names a source uses: a bit for each that appears again after its
+declaration, as an identifier of its own, found in one pass over the
+source's identifiers */
+struct used_name
+{
+	const char *name;
+	unsigned long length;
+};
+#define USED_NAME(name) { name, sizeof(name) - 1 }
+
+/* the characters of identifiers: 1, those that may begin one; 2, those that
+may follow */
+static const unsigned char identifier_characters[256] =
+{
+	['0' ... '9'] = 2, ['A' ... 'Z'] = 3, ['a' ... 'z'] = 3, ['_'] = 3,
+};
+
+static unsigned long names_used(const char *source, const struct used_name *names, unsigned long count)
+{
+	/* the names of each length, a bit for each (names are shorter than 32) */
+	unsigned long by_length[32] = { 0 }, uses = 0, index;
+	unsigned char seen[32] = { 0 };
+	const unsigned char *cursor = (const unsigned char *)source;
+
+	for (index = 0; index < count; index++)
+		by_length[names[index].length] |= 1UL << index;
+	while (*cursor)
+	{
+		const unsigned char *start = cursor;
+		unsigned long length, candidates;
+
+		if (!(identifier_characters[*cursor] & 1))
+		{
+			cursor++;
+			continue;
+		}
+		while (identifier_characters[*cursor] & 2)
+			cursor++;
+		length = (unsigned long)(cursor - start);
+		for (candidates = length < 32 ? by_length[length] : 0; candidates; candidates &= candidates - 1)
+		{
+			index = (unsigned long)__builtin_ctzl(candidates);
+			if (names[index].name[0] == *start && !memcmp(names[index].name, start, length) && ++seen[index] == 2)
+				uses |= 1UL << index;
+		}
+	}
+	return uses;
+}

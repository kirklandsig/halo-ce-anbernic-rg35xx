+			buffer[length++] = (char)va_arg(arguments, int);
+			format = percent + 2;
+			continue;
+		case 'd':
+			_ltoa(va_arg(arguments, int), number, 10);
+			break;
+		case 'u':
+			_ultoa(va_arg(arguments, unsigned int), number, 10);
+			break;
+		case 'l':
+			if (percent[2] == 'd')

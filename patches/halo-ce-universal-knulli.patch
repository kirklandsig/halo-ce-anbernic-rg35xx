+}
+
+short bots_skill(void)
+{
+	char const *name = config_string("bots.skill");
+	short skill;
+
+	for (skill = 0; skill < NUMBER_OF_BOTS_SKILLS; skill++)
+	{
+		if (!strcmp(name, bots_skills[skill].name))
+			return skill;
+	}
+	return _bots_skill_normal;

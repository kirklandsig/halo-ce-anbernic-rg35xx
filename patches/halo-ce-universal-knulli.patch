+	for (index = 0; index < placement_count; index++)
+	{
+		const char *declaration = explicit_placements[index].declaration;
+
+		declaration_lengths[index] = strlen(declaration);
+		placed_lengths[index] = strlen(explicit_placements[index].placed);
+		uniform_at[index] = (unsigned long)(strstr(declaration, "uniform ") - declaration);
+	}

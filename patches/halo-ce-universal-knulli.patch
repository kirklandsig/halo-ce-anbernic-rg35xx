+
+/* where the cache keeps a program's binary, or "" with no cache */
+static void program_cache_path(unsigned long long key, char *path, size_t size)
+{
+	const char *folder = program_cache_folder();
+
+	*path = 0;
+	if (*folder && key)
+		snprintf(path, size, "%s/%016llx.bin", folder, key);

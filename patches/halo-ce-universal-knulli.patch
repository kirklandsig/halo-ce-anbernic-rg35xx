+			xgpu_text_put(&text, cursor, strlen(cursor));
+			break;
+		}
+		xgpu_text_put(&text, cursor, (unsigned long)(next - cursor));
+		xgpu_text_put(&text, names[which][1], strlen(names[which][1]));
+		cursor = next + strlen(names[which][0]);
+	}

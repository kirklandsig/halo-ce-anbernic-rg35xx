+
+/* ---------- buffers mapped once
+
+With GL_EXT_buffer_storage the renderer's streaming buffers are mapped for
+good when they are made (host_gl_buffer_persistent), and a write into one is
+a copy: mapping and unmapping for each write cost Mali's driver about 8 us a
+call, some 450 calls a frame. host_gl_wait_frame still releases a buffer
+only once the GPU is done with the frame that last used it. */
+
+#define PERSISTENT_BUFFERS 8
+
+static struct
+{
+	GLuint buffer;
+	unsigned char *mapping;
+	uint32_t size;
+} persistent_buffers[PERSISTENT_BUFFERS];
+static int persistent_buffer_count;
+
+/* where a thread other than the one making the GL calls may write size
+bytes at offset of a buffer mapped for good, if it is one; the GL calls'
+thread flushes them (host_gl_buffer_flush) */
+unsigned char *host_gl_buffer_mapping(uint32_t buffer, uint32_t offset, uint32_t size)
+{
+	int count = __atomic_load_n(&persistent_buffer_count, __ATOMIC_ACQUIRE), index;
+
+	for (index = 0; index < count; index++)
+	{
+		if (persistent_buffers[index].buffer == buffer)
+			return (uint64_t)offset + size <= persistent_buffers[index].size ? persistent_buffers[index].mapping + offset :
+				NULL;
+	}
+	return NULL;
+}
+
+/* makes what was written into the buffer bound to target visible to the GPU */
+void host_gl_buffer_flush(uint32_t target, uint32_t offset, uint32_t size)
+{
+	glFlushMappedBufferRange(target, offset, size);
+}
+
+static GLenum buffer_binding(uint32_t target)
+{
+	switch (target)
+	{
+	case GL_ARRAY_BUFFER: return GL_ARRAY_BUFFER_BINDING;
+	case GL_ELEMENT_ARRAY_BUFFER: return GL_ELEMENT_ARRAY_BUFFER_BINDING;
+	default: return 0;
+	}
+}
+
+/* where to write size bytes at offset of the buffer bound to target, if it
+is mapped for good */
+static unsigned char *persistent_mapping(uint32_t target, uint32_t offset, uint32_t size)
+{
+	GLenum binding = buffer_binding(target);
+	GLint buffer = 0;
+
+	if (!binding)
+		return NULL;
+	glGetIntegerv(binding, &buffer);
+	return host_gl_buffer_mapping((uint32_t)buffer, offset, size);
+}
+
+/* gives the buffer bound to target size bytes of storage: mapped for good
+where the driver can (the writes are then copies), or ordinary storage */
+void host_gl_buffer_persistent(uint32_t target, uint32_t size)
+{
+	typedef void (GL_APIENTRY *buffer_storage_function)(GLenum, GLsizeiptr, const void *, GLbitfield);
+	static buffer_storage_function buffer_storage;
+	static int looked;
+	GLenum binding = buffer_binding(target);
+	GLint buffer = 0;
+
+	if (!looked)
+	{
+		looked = 1;
+		if (host_gl_has_extension("GL_EXT_buffer_storage"))
+			buffer_storage = (buffer_storage_function)eglGetProcAddress("glBufferStorageEXT");
+		if (!buffer_storage)
+			buffer_storage = (buffer_storage_function)host_gl_resolve("glBufferStorageEXT");
+		host_logf(HOST_LOG_INFO, "buffer storage: extension %d, function %p",
+			host_gl_has_extension("GL_EXT_buffer_storage"), (void *)buffer_storage);
+	}
+	if (binding)
+		glGetIntegerv(binding, &buffer);
+	if (buffer_storage && buffer && persistent_buffer_count < PERSISTENT_BUFFERS)
+	{
+		/* GL_MAP_PERSISTENT_BIT_EXT, and flushed by hand: a coherent mapping
+		is uncached memory on Mali, where a 3 KB copy took some 6 us */
+		GLbitfield flags = GL_MAP_WRITE_BIT | GL_MAP_READ_BIT | 0x0040;
+		void *mapping;
+
+		while (glGetError() != GL_NO_ERROR)
+			;
+		buffer_storage(target, size, NULL, flags);
+		flags |= GL_MAP_FLUSH_EXPLICIT_BIT;
+		{
+			GLenum error = glGetError();
+
+			if (error != GL_NO_ERROR)
+				host_logf(HOST_LOG_WARN, "buffer %d: glBufferStorageEXT error %04x", buffer, error);
+			else
+			{
+				mapping = glMapBufferRange(target, 0, size, flags);
+				if (!mapping)
+					host_logf(HOST_LOG_WARN, "buffer %d: mapping failed, error %04x", buffer, glGetError());
+				if (mapping)
+				{
+					host_logf(HOST_LOG_INFO, "buffer %d mapped for good (%u bytes)", buffer, size);
+					persistent_buffers[persistent_buffer_count].buffer = (GLuint)buffer;
+					persistent_buffers[persistent_buffer_count].mapping = mapping;
+					persistent_buffers[persistent_buffer_count].size = size;
+					/* (the entry complete before it is counted, for
+					host_gl_buffer_mapping on another thread) */
+					__atomic_store_n(&persistent_buffer_count, persistent_buffer_count + 1, __ATOMIC_RELEASE);
+				}
+				return;
+			}
+		}
+	}
+	glBufferData(target, size, NULL, GL_STREAM_DRAW);
+}
+
+void host_gl_buffer_write(uint32_t target, uint32_t offset, uint32_t size, const void *data);
+
+/* ---------- programs made for the guest (d3d8_gl.c, program_build)
+
+The guest names a program (a name the GL thread reserved) and draws with it
+at once; the program is made here: from the driver's binary that an earlier
+build kept in cache_path, or else compiled and linked, and its binary kept
+there. The shaders' uniforms, blocks and samplers are where their sources
+put them, so nothing about the program is asked for afterwards. On the
+Knulli host threads of their own make it, while the GL thread skips the
+draws made with it (host_glthread.c), so that neither the game's thread nor
+the GL thread waits for it; elsewhere it is made before those draws. A
+shader is compiled once, for every program that uses it. */
+static struct
+{
+	unsigned long long hash;
+	GLenum type;
+	GLuint shader;
+} *built_shaders;
+static size_t built_shader_count, built_shader_capacity;
+
+static GLuint built_shader(GLenum type, const char *source, unsigned long long hash)
+{
+	size_t index;
+	GLuint shader;
+	GLint status = 0;
+
+	for (index = 0; index < built_shader_count; index++)
+	{
+		if (built_shaders[index].hash == hash && built_shaders[index].type == type)
+			return built_shaders[index].shader;
+	}
+	shader = glCreateShader(type);
+	glShaderSource(shader, 1, &source, NULL);
+	glCompileShader(shader);
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
+	if (!status)
+	{
+		char log[4096];
+
+		glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+		host_logf(HOST_LOG_WARN, "cannot compile a %s shader: %s\n%s", type == GL_VERTEX_SHADER ? "vertex" : "fragment",
+			log, source);
+		glDeleteShader(shader);
+		shader = 0;
+	}
+	if (built_shader_count == built_shader_capacity)
+	{
+		built_shader_capacity = built_shader_capacity ? built_shader_capacity * 2 : 256;
+		built_shaders = realloc(built_shaders, built_shader_capacity * sizeof(*built_shaders));
+	}
+	built_shaders[built_shader_count].hash = hash;
+	built_shaders[built_shader_count].type = type;
+	built_shaders[built_shader_count].shader = shader;
+	built_shader_count++;
+	return shader;
+}
+
+/* milliseconds, for the build logs */
+static double build_clock(void)
+{
+	return host_monotonic_ns() / 1e6;
+}
+
+/* the program from the driver's binary that an earlier build kept in
+cache_path: whether it loaded (a binary that does not is removed) */
+int host_gl_program_load(uint32_t program, const char *cache_path)
+{
+	GLint status = 0;
+	FILE *file;
+	unsigned int header[2];
+	void *binary;
+	double start = build_clock();
+
+	if (!*cache_path || (file = fopen(cache_path, "rb")) == NULL)
+		return 0;
+	if (fread(header, sizeof(header), 1, file) == 1 && header[1] && header[1] < 16u * 1024 * 1024 &&
+		(binary = malloc(header[1])) != NULL)
+	{
+		if (fread(binary, header[1], 1, file) == 1)
+		{
+			glProgramBinary(program, (GLenum)header[0], binary, (GLsizei)header[1]);
+			glGetProgramiv(program, GL_LINK_STATUS, &status);
+		}
+		free(binary);
+	}
+	fclose(file);
+	/* a binary of another driver's, or damaged */
+	if (!status)
+		remove(cache_path);
+	else if (build_clock() - start > 5.0)
+		host_logf(HOST_LOG_INFO, "program %u loaded from its binary in %.1f ms", program, build_clock() - start);
+	return status != 0;
+}
+
+/* the program compiled and linked, and its binary kept in cache_path:
+whether it linked */
+int host_gl_program_compile(uint32_t program, const char *cache_path, const char *vertex_source, long long vertex_hash,
+	const char *fragment_source, long long fragment_hash)
+{
+	double start = build_clock();
+	GLuint vertex = built_shader(GL_VERTEX_SHADER, vertex_source, (unsigned long long)vertex_hash);
+	GLuint fragment = built_shader(GL_FRAGMENT_SHADER, fragment_source, (unsigned long long)fragment_hash);
+	GLint status = 0;
+	FILE *file;
+
+	if (!vertex || !fragment)
+		return 0;
+	glProgramParameteri(program, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
+	glAttachShader(program, vertex);
+	glAttachShader(program, fragment);
+	glLinkProgram(program);
+	glGetProgramiv(program, GL_LINK_STATUS, &status);
+	glDetachShader(program, vertex);
+	glDetachShader(program, fragment);
+	if (!status)
+	{
+		char log[4096];
+
+		glGetProgramInfoLog(program, sizeof(log), NULL, log);
+		host_logf(HOST_LOG_WARN, "cannot link shader program %u: %s", program, log);
+		return 0;
+	}
+	if (*cache_path)
+	{
+		GLint length = 0;
+		GLsizei written = 0;
+		GLenum format = 0;
+		void *binary;
+
+		glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &length);
+		if (length > 0 && (binary = malloc((size_t)length)) != NULL)
+		{
+			char temporary[640];
+
+			glGetProgramBinary(program, length, &written, &format, binary);
+			snprintf(temporary, sizeof(temporary), "%s.part", cache_path);
+			if (written > 0 && (file = fopen(temporary, "wb")) != NULL)
+			{
+				unsigned int header[2] = { (unsigned int)format, (unsigned int)written };
+				int complete = fwrite(header, sizeof(header), 1, file) == 1 &&
+					fwrite(binary, (size_t)written, 1, file) == 1;
+
+				if (fclose(file) == 0 && complete)
+					rename(temporary, cache_path);
+				else
+					remove(temporary);
+			}
+			free(binary);
+		}
+	}
+	host_logf(HOST_LOG_INFO, "program %u compiled and linked in %.1f ms", program, build_clock() - start);
+	return 1;
+}
+
+void host_gl_program_build(uint32_t program, const char *cache_path, const char *vertex_source, long long vertex_hash,
+	const char *fragment_source, long long fragment_hash)
+{
+	if (!host_gl_program_load(program, cache_path))
+		host_gl_program_compile(program, cache_path, vertex_source, vertex_hash, fragment_source, fragment_hash);
+}

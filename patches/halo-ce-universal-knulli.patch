+++ b/port/linux/src/dpad_controls.h
@@ -0,0 +1,72 @@
+/* dpad_controls.h: the D-pad's controls on a controller without a right
+stick (input.dpad_controls, xinput_sdl.c), apart from SDL so that they can
+be tested on their own */
+
+#ifndef DPAD_CONTROLS_H
+#define DPAD_CONTROLS_H
+
+/* what the D-pad does in a game */
+enum
+{
+	/* the game's own: it walks and strafes, as the left stick */
+	_dpad_controls_none,
+	/* it is the right stick (a controller with a left stick alone) */
+	_dpad_controls_aim,
+	/* up and down walk, left and right turn; with the left shoulder held,
+	up and down look and left and right strafe (a controller without
+	sticks) */
+	_dpad_controls_walk_and_turn
+};
+
+/* the game's joystick presets (input_abstraction.c), numbered alike: which
+stick walks, strafes, turns and looks */
+enum
+{
+	_dpad_preset_default,
+	_dpad_preset_southpaw,
+	_dpad_preset_legacy,
+	_dpad_preset_legacy_southpaw
+};
+
+/* the buttons the controls take, down or not */
+struct dpad_controls_buttons
+{
+	int up, down, left, right;
+	int left_shoulder;
+	int a, b;
+};
+
+/* what they make of them: the sticks' values (-32767 to 32767, up and
+right positive; 0 for none), and the buttons the controller reports (the
+D-pad itself only with _dpad_controls_none) */
+struct dpad_controls_result
+{
+	short left_x, left_y, right_x, right_y;
+	/* the left shoulder as the white button (the flashlight) */
+	int white;
+	/* A and B as themselves (jump, melee) or, with the left shoulder held,
+	as the stick clicks (crouch, zoom), which these controllers lack */
+	int a, b;
+	int left_thumb, right_thumb;
+};
+
+/* a controller's left shoulder over its polls: a press used with nothing
+else is the flashlight once it is let go */
+struct dpad_controls_state
+{
+	int held;
+	/* a D-pad direction, A or B pressed while it is held, or the press
+	began while the controls were off: no flashlight when it is let go */
+	int used;
+	/* the D-pad's directions, A and B down at the last poll, as bits */
+	unsigned previous;
+	unsigned long long held_since;
+	unsigned long long white_until;
+};
+
+/* one poll at now (milliseconds), with the controller's joystick preset */
+void dpad_controls(struct dpad_controls_state *state, int mode, int preset,
+	struct dpad_controls_buttons const *buttons, unsigned long long now,
+	struct dpad_controls_result *result);
+
+#endif

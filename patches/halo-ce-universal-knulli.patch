+		cabin.jump = _vehicle_riding_enclosure_open;
+		vehicle_riding_deck_make(&state, &vehicle, &base, &world, &air, &cabin, &deck);
+		CHECK(deck.flags == (FLAG(_vehicle_riding_deck_falling_bit) | (1 << VEHICLE_RIDING_DECK_VERDICT_SHIFT) |

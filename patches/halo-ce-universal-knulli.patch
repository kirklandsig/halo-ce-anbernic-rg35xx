+	device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;
+	low_offset = stream_upload(instances.low[0], sizeof(instances.low[0]));
+	device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;
+	high_offset = stream_upload(instances.high, instances.count * instances.extent * sizeof(instances.high[0]));
+	device.stream_offset = (device.stream_offset + alignment - 1) / alignment * alignment;

+++ b/tools/harness/tests/coop_gate.c
@@ -0,0 +1,98 @@
+#include "harness.h"
+#include <string.h>
+
+typedef unsigned short word;
+#define SET_FLAG(f,b,v) ((f)=(v)?(f)|(1U<<(b)):(f)&~(1U<<(b)))
+#define MAX_PLAYERS 128
+#include "list_header.inc"
+static struct object_list_header_datum headers[8];
+static int used[8], fail_allocate;
+static struct {long value,next;} refs[2048];
+static int references;
+static void *object_list_header_data,*object_list_data;
+#define object_list_header_get(i) (&headers[(i)])
+#define datum_new gate_datum_new
+static long gate_datum_new(void *data){int i;if(fail_allocate)return NONE;for(i=0;i<8;i++)if(!used[i]){used[i]=1;return i;}return NONE;}
+static void reference_list_add(void *data,long *head,long object){long p=references++;CHECK(p<2048,"fixture references");refs[p].value=object;refs[p].next=*head;*head=p;}
+static long object_list_get_first(long list,long *ref){if(list==NONE)return NONE;*ref=headers[list].first_reference_index;if(*ref==NONE)return NONE;long v=refs[*ref].value;*ref=refs[*ref].next;return v;}
+static long object_list_get_next(long list,long *ref){if(*ref==NONE)return NONE;long v=refs[*ref].value;*ref=refs[*ref].next;return v;}
+static short object_list_count(long list){return list==NONE?0:headers[list].count;}
+#include "lists.inc"
+
+static int host=TRUE,waiting=TRUE,ignore_players,teleports,rollbacks,failures,bad_place,crowded,side_effects;
+static int player_count;
+struct data_iterator {int index;};
+struct player_datum {long unit_index;};
+static struct player_datum people[MAX_PLAYERS];
+static struct {real_point3d position;} objects[MAX_PLAYERS+1];
+static void *player_data;
+static long data_next_index(void *data,long previous){return previous+1<player_count?previous+1:NONE;}
+static struct player_datum *player_get(long i){CHECK(i>=0&&i<player_count,"invalid player");return &people[i];}
+static boolean coop_scripts_host(void){return host;}
+static long player_index_from_unit_index(long index){int i;for(i=0;i<player_count;i++)if(people[i].unit_index==index)return i;return NONE;}
+static real_point3d *object_get_origin(long i,real_point3d *p){*p=objects[i].position;return p;}
+static void object_set_position(long i,real_point3d const *p,void *forward,void *up){objects[i].position=*p;rollbacks++;}
+static boolean scenario_trigger_volume_test_object(short volume,long i){return objects[i].position.x>10&&objects[i].position.x<20;}
+static boolean player_position_switches_bsp(real_point3d const *p){return p->y>50;}
+static void biped_fix_ignore_players(boolean value){ignore_players=value;}
+static boolean player_teleport(long p,long anchor,real_point3d const *point){
+ long u=people[p].unit_index;teleports++;CHECK(u!=NONE,"teleport dead player");
+ if(failures){if(side_effects)objects[u].position.x=25;return FALSE;}
+ if(crowded&&!ignore_players)return FALSE;
+ objects[u].position=*point;
+ if(bad_place==1)objects[u].position.x=25;
+ if(bad_place==2)objects[u].position.y=100;
+ return TRUE;
+}
+static boolean hs_runtime_waiting_on_call(void){return waiting;}
+#include "players.inc"
+#include "gather.inc"
+/* The original volume implementation is compiled too, including ALL of an
+empty list; provenance must preserve that behavior for AI lists. */
+#define MAXIMUM_TRIGGER_VOLUMES_PER_SCENARIO 256
+#define VALID_INDEX(i,n) ((unsigned)(i)<(n))
+#define BIT_VECTOR_SET_FLAG(bits,i,value) ((void)0)
+#define _error_silent 0
+#define error(...) ((void)0)
+#include "volume.inc"
+#include "gate.inc"
+static void reset(int count){int i;memset(used,0,sizeof(used));memset(headers,0,sizeof(headers));memset(objects,0,sizeof(objects));references=0;fail_allocate=0;host=waiting=TRUE;ignore_players=teleports=rollbacks=failures=bad_place=crowded=side_effects=0;player_count=count;for(i=0;i<count;i++){people[i].unit_index=i;objects[i].position.x=i?1:15;}}
+static boolean gate(long list){boolean r=hs_trigger_volume_test_objects_all(107,list);CHECK(!ignore_players,"collision override leaked");return r;}
+static int all_inside(void){int i;for(i=0;i<player_count;i++)if(people[i].unit_index!=NONE&&!scenario_trigger_volume_test_object(107,people[i].unit_index))return FALSE;return TRUE;}
+int main(int argc,char **argv){char const *name=argc>1?argv[1]:"";long list;int n;
+ CHECK(sizeof(struct object_list_header_datum)==12,"checkpoint ABI changed");
+ if(!strcmp(name,"crowds")||!strcmp(name,"refused")||!strcmp(name,"outside")||!strcmp(name,"bsp-result")){
+  for(n=2;n<=128;n*=2){reset(n);list=hs_players();failures=!strcmp(name,"refused");bad_place=!strcmp(name,"outside")?1:!strcmp(name,"bsp-result")?2:0;crowded=!strcmp(name,"crowds");side_effects=TRUE;
+   CHECK(gate(list)==(!failures&&!bad_place),"unsafe result for %d players",n);
+   CHECK(all_inside()==(!failures&&!bad_place),"incorrect final positions");
+   CHECK(teleports<=2*(n-1),"unbounded placement search");
+   if(failures||bad_place){for(int i=1;i<n;i++)CHECK(objects[i].position.x==1&&objects[i].position.y==0,"bad placement not rolled back");CHECK(rollbacks==2*(n-1),"missing rollback");failures=bad_place=0;CHECK(gate(list)&&all_inside(),"failed gate did not retry");}
+  }
+ }else if(!strcmp(name,"one-player")){
+  reset(1);list=hs_players();CHECK(gate(list)&&!teleports,"one-player host changed");objects[0].position.x=1;CHECK(!gate(list)&&!teleports,"one player outside passed gate");
+ }else if(!strcmp(name,"empty")){
+  reset(4);for(n=0;n<4;n++)people[n].unit_index=NONE;
+  list=hs_players();CHECK(object_list_is_players(list),"empty players lost provenance");CHECK(!gate(list)&&!teleports,"empty players advanced gate");
+  long ai=object_list_new();CHECK(gate(ai)&&!teleports,"empty AI semantics changed");
+  waiting=FALSE;CHECK(gate(list),"non-waiting empty ALL semantics changed");
+  waiting=TRUE;host=FALSE;CHECK(gate(list),"local/client empty ALL semantics changed");
+ }else if(!strcmp(name,"allocation")){
+  reset(2);fail_allocate=1;list=hs_players();CHECK(list==NONE&&!gate(list)&&!teleports,"allocation failure opened gate");
+ }else if(!strcmp(name,"lifetime")){
+  reset(0);list=hs_players();CHECK(object_list_is_players(list),"mark failed");used[list]=0;
+  long recycled=object_list_new();CHECK(recycled==list&&!object_list_is_players(recycled),"provenance survived slot reuse");
+  object_list_mark_players(recycled);object_list_add(recycled,MAX_PLAYERS);CHECK(!object_list_is_players(recycled),"changed list retained provenance");
+ }else if(!strcmp(name,"contexts")){
+  reset(2);list=hs_players();waiting=FALSE;CHECK(gate(list)&&!teleports,"if/not test moved players or lost ANY semantics");
+  waiting=TRUE;host=FALSE;CHECK(!gate(list)&&!teleports,"non-host gathered players");
+  objects[1].position.x=15;CHECK(gate(list),"non-host ALL changed");
+ }else if(!strcmp(name,"mixed")){
+  reset(2);list=hs_players();object_list_add(list,MAX_PLAYERS);CHECK(!gate(list)&&!teleports,"mixed AI/player list gathered");
+ }else if(!strcmp(name,"no-arrival")){
+  reset(3);objects[0].position.x=1;list=hs_players();CHECK(!gate(list)&&!teleports,"gathered with nobody inside");
+ }else if(!strcmp(name,"bsp-anchor")){
+  reset(3);objects[0].position.y=100;list=hs_players();CHECK(!gate(list)&&!teleports,"used a loading-zone anchor");
+  objects[1].position.x=15;CHECK(gate(list)&&all_inside(),"did not choose a safe second anchor");
+ }else return 2;
+ return 0;
+}
diff --git a/tools/harness/tests/coop_host_looping_sounds.c b/tools/harness/tests/coop_host_looping_sounds.c
new file mode 100644
index 00000000..32eaa979
--- /dev/null
+++ b/tools/harness/tests/coop_host_looping_sounds.c
@@ -0,0 +1,273 @@
+/* A co-op host's script looping sounds (network_coop.c's
+host_send_looping_sounds and network_coop_note_sound, with game_sound.c's
+scripted looping sounds). A host that draws nothing (a dedicated server)
+never renders its sounds, so one that plays once (fake impulse: a
+cutscene's) never ends there by itself: it is ended once it has had the time
+to play, and is not resent near that end, so that no client starts it again. */
+#include "harness.h"
+
+typedef unsigned short word;
+#define MAX(a,b) ((a)>(b)?(a):(b))
+#define PIN(x,lo,hi) ((x)<(lo)?(lo):(x)>(hi)?(hi):(x))
+#define SET_FLAG(f,b,v) ((f)=(v)?(f)|(1U<<(b)):(f)&~(1U<<(b)))
+#define TICKS_PER_SECOND 30
+#define SOUND_DEFINITION_TAG 0x736e6421UL
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) (&((type *)(block)->address)[(index)])
+
+struct tag_block_definition;
+#include "types.inc"
+void network_coop_note_sound(short kind,long definition_index,long object_index,real scale);
+void scripted_looping_sound_stop(long sound_index);
+
+/* the map's sounds: how long each plays in milliseconds, its linked permutations together
+(coop_sound_sync.c's coop_sound_sync_sound_milliseconds, test_coop_sound_sync.py) */
+enum {SHORT_SOUND=0,LONG_SOUND=1,NO_LENGTH=2,HUGE_SOUND=3,SOUNDS=4};
+struct sound_definition {long milliseconds;};
+static struct sound_definition sounds[SOUNDS];
+static long coop_sound_sync_sound_milliseconds(long index)
+{
+ CHECK(index>=0&&index<SOUNDS,"no such sound %ld",index);
+ return sounds[index].milliseconds;
+}
+
+/* the map's looping sounds: 0 plays once (a cutscene's: a 10 s start and a
+60 s loop), 1 is music that loops, 2 plays once with sounds of no length,
+3 plays once with a sound longer than any could be */
+enum {ONCE=0,MUSIC=1,ONCE_NO_LENGTH=2,ONCE_HUGE=3,DEFINITIONS=4};
+static struct looping_sound_definition definitions[DEFINITIONS];
+static struct looping_sound_track tracks[DEFINITIONS];
+static struct looping_sound_definition *looping_sound_definition_get(long index)
+{
+ CHECK(index>=0&&index<DEFINITIONS,"no such looping sound %ld",index);
+ return &definitions[index];
+}
+
+/* the playing looping sounds (game_sound.c's data) */
+struct game_looping_sound_datum {long definition_index;unsigned long flags;real scale;boolean used;};
+enum {_game_looping_sound_unattached_bit,_game_looping_sound_scripted_bit,_game_looping_sound_alternate_bit,
+ _game_looping_sound_unattached_stop_bit,_game_looping_sound_unattached_stop_fixed_fadeout_bit};
+static struct game_looping_sound_datum playing[8];
+static long game_looping_sound_new(long object_index,long definition_index,char const *marker,long node)
+{
+ long index;
+ (void)object_index;(void)marker;(void)node;
+ for(index=0;index<8;index++)
+ {
+  if(!playing[index].used)
+  {
+   memset(&playing[index],0,sizeof(playing[index]));
+   playing[index].used=TRUE;playing[index].definition_index=definition_index;
+   return index;
+  }
+ }
+ return NONE;
+}
+static struct game_looping_sound_datum *game_looping_sound_get(long index)
+{
+ CHECK(index>=0&&index<8&&playing[index].used,"no such playing sound %ld",index);
+ return &playing[index];
+}
+static void scripted_music_stop_all(void){}
+
+/* the host's world: its clock, whether it draws, its resends and the events it sends */
+static long now;
+static long game_time_get(void){return now;}
+boolean debug_no_drawing;
+static struct {boolean refresh;} host_resend;
+static struct distributed_coop_event sent[1024];
+static int sent_count,queue_full;
+static struct distributed_coop_event *event_new(byte kind)
+{
+ struct distributed_coop_event *event;
+ if(queue_full||sent_count==1024)return NULL;
+ event=&sent[sent_count++];
+ memset(event,0,sizeof(*event));
+ event->kind=kind;event->object_index=NONE;event->tag_index=NONE;event->target=NONE;
+ return event;
+}
+
+#include "under_test.inc"
+
+static void setup(void)
+{
+ int index;
+ memset(sounds,0,sizeof(sounds));memset(definitions,0,sizeof(definitions));memset(tracks,0,sizeof(tracks));
+ memset(playing,0,sizeof(playing));
+ sounds[SHORT_SOUND].milliseconds=10000;
+ sounds[LONG_SOUND].milliseconds=60000;
+ sounds[HUGE_SOUND].milliseconds=0x7fffffffL;
+ for(index=0;index<DEFINITIONS;index++)
+ {
+  definitions[index].runtime_scripting_sound_index=NONE;
+  definitions[index].tracks.count=1;definitions[index].tracks.address=&tracks[index];
+  tracks[index].start_sound.index=NONE;tracks[index].loop_sound.index=NONE;tracks[index].stop_sound.index=NONE;
+  tracks[index].alternate_loop_sound.index=NONE;tracks[index].alternate_stop_sound.index=NONE;
+ }
+ tracks[ONCE].start_sound.index=SHORT_SOUND;tracks[ONCE].loop_sound.index=LONG_SOUND;
+ tracks[MUSIC].loop_sound.index=LONG_SOUND;
+ tracks[ONCE_NO_LENGTH].loop_sound.index=NO_LENGTH;
+ tracks[ONCE_HUGE].loop_sound.index=HUGE_SOUND;
+ SET_FLAG(definitions[ONCE].flags,_looping_sound_fake_impulse_sound_bit,TRUE);
+ SET_FLAG(definitions[ONCE_NO_LENGTH].flags,_looping_sound_fake_impulse_sound_bit,TRUE);
+ SET_FLAG(definitions[ONCE_HUGE].flags,_looping_sound_fake_impulse_sound_bit,TRUE);
+ now=1000;debug_no_drawing=TRUE;host_resend.refresh=FALSE;sent_count=0;queue_full=FALSE;
+ host_looping_sound_count=0;
+}
+
+static boolean is_playing(long definition_index){return definitions[definition_index].runtime_scripting_sound_index!=NONE;}
+
+/* the events of a type for a sound sent since index from */
+static int sent_of(int from,int type,long definition_index)
+{
+ int index,count=0;
+ for(index=from;index<sent_count;index++)
+  if(sent[index].type==type&&sent[index].tag_index==definition_index)count++;
+ return count;
+}
+
+/* the last event of a type for a sound, or NULL */
+static struct distributed_coop_event const *last_sent(int type,long definition_index)
+{
+ int index;
+ for(index=sent_count-1;index>=0;index--)
+  if(sent[index].type==type&&sent[index].tag_index==definition_index)return &sent[index];
+ return NULL;
+}
+
+/* the host's ticks from now to the tick at (now is then the tick after),
+a resend every two seconds as host_resend_update makes them */
+static void run_to(long at)
+{
+ for(;now<=at;now++)
+ {
+  host_resend.refresh=now%(2*TICKS_PER_SECOND)==0;
+  host_send_looping_sounds();
+ }
+ host_resend.refresh=FALSE;
+}
+
+int main(int argc,char **argv)
+{
+ char const *name=argc>1?argv[1]:"";
+ setup();
+ if(!strcmp(name,"length"))
+ {
+  /* the longest a sound that plays once can take: start and loop, 70 s */
+  CHECK(looping_sound_play_once_ticks(ONCE)==70*TICKS_PER_SECOND,"%ld ticks",looping_sound_play_once_ticks(ONCE));
+  CHECK(looping_sound_play_once_ticks(MUSIC)==0,"music that loops was given a length");
+  CHECK(looping_sound_play_once_ticks(ONCE_NO_LENGTH)==0,"sounds of no length were given one");
+  tracks[ONCE].alternate_loop_sound.index=LONG_SOUND;tracks[ONCE].loop_sound.index=SHORT_SOUND;
+  CHECK(looping_sound_play_once_ticks(ONCE)==70*TICKS_PER_SECOND,"the longer alternate loop was not taken");
+  CHECK(looping_sound_play_once_ticks(ONCE_HUGE)==60*60*TICKS_PER_SECOND,"a map's huge length was %ld ticks",
+   looping_sound_play_once_ticks(ONCE_HUGE));
+ }
+ else if(!strcmp(name,"ended"))
+ {
+  /* a dedicated server: the cutscene's sound ends once it has had the time to play, its stop sent to the clients */
+  long start=now;
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  CHECK(is_playing(ONCE)&&host_looping_sound_count==1,"fixture: the scripts' start did not play");
+  run_to(start+70*TICKS_PER_SECOND);
+  CHECK(is_playing(ONCE),"ended before it could have played out");
+  run_to(start+72*TICKS_PER_SECOND+1);
+  CHECK(!is_playing(ONCE)&&host_looping_sound_count==0,"never ended: the clients would hear it again and again");
+  CHECK(sent_of(0,_coop_sound_looping_stop,ONCE)>=1,"its end was not sent to the clients");
+ }
+ else if(!strcmp(name,"not-resent-near-end"))
+ {
+  /* resent while it plays (for a joiner), but not in the margin before its end, when a client's copy may have ended */
+  long start=now;
+  int from;
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  run_to(start+68*TICKS_PER_SECOND-1);
+  CHECK(sent_of(0,_coop_sound_looping_start,ONCE)>=30,"resent %d times while it played",
+   sent_of(0,_coop_sound_looping_start,ONCE));
+  /* (none in the 2 s before its 70 s, nor after) */
+  from=sent_count;
+  run_to(start+72*TICKS_PER_SECOND+1);
+  CHECK(sent_of(from,_coop_sound_looping_start,ONCE)==0,"resent %d times in the 2 s before its end",
+   sent_of(from,_coop_sound_looping_start,ONCE));
+ }
+ else if(!strcmp(name,"drawing-host"))
+ {
+  /* a host that draws renders its sounds, which end there as they always have: never ended early here */
+  long start=now;
+  debug_no_drawing=FALSE;
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  run_to(start+600*TICKS_PER_SECOND);
+  CHECK(is_playing(ONCE),"a drawing host ended a sound its sound system plays");
+ }
+ else if(!strcmp(name,"music"))
+ {
+  /* music that loops plays until the scripts stop it, resent all along */
+  long start=now;
+  int from;
+  scripted_looping_sound_start(MUSIC,NONE,1.0f);
+  run_to(start+600*TICKS_PER_SECOND-1);
+  CHECK(is_playing(MUSIC),"looping music was ended");
+  from=sent_count;
+  run_to(start+602*TICKS_PER_SECOND);
+  CHECK(sent_of(from,_coop_sound_looping_start,MUSIC)>=1,"looping music stopped being resent");
+ }
+ else if(!strcmp(name,"no-length"))
+ {
+  /* a sound that plays once whose sounds give no length is left as before */
+  long start=now;
+  scripted_looping_sound_start(ONCE_NO_LENGTH,NONE,1.0f);
+  run_to(start+600*TICKS_PER_SECOND);
+  CHECK(is_playing(ONCE_NO_LENGTH),"a sound of no length was ended at once");
+ }
+ else if(!strcmp(name,"started-again"))
+ {
+  /* the scripts start it again while it plays: its time counts from the new start */
+  long start=now;
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  run_to(start+50*TICKS_PER_SECOND);
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  start=now;
+  run_to(start+60*TICKS_PER_SECOND);
+  CHECK(is_playing(ONCE),"the new start was ended on the old one's time");
+  run_to(start+73*TICKS_PER_SECOND);
+  CHECK(!is_playing(ONCE),"the new start never ended");
+ }
+ else if(!strcmp(name,"queue-full"))
+ {
+  /* its end comes when no event can be sent: ended and taken out all the same, with no endless loop */
+  long start=now;
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  scripted_looping_sound_start(MUSIC,NONE,1.0f);
+  run_to(start+72*TICKS_PER_SECOND-1);
+  CHECK(is_playing(ONCE),"fixture: ended before the queue filled");
+  queue_full=TRUE;
+  run_to(start+73*TICKS_PER_SECOND);
+  CHECK(!is_playing(ONCE)&&host_looping_sound_count==1&&is_playing(MUSIC),
+   "with the queue full: %d listed, once playing %d",host_looping_sound_count,is_playing(ONCE));
+ }
+ else if(!strcmp(name,"resent-time"))
+ {
+  /* the resends of one that plays once say how long ago it started, for a machine that joins during it */
+  long start=now;
+  struct distributed_coop_event const *event;
+  scripted_looping_sound_start(ONCE,NONE,1.0f);
+  event=last_sent(_coop_sound_looping_start,ONCE);
+  CHECK(event&&event->target==NONE,"the scripts' start said it began %ld ms ago",event?event->target:0);
+  run_to(start+30*TICKS_PER_SECOND);
+  event=last_sent(_coop_sound_looping_start,ONCE);
+  CHECK(event&&event->target>=28000&&event->target<=30000,"a resend 30 s in said %ld ms",event?event->target:0);
+  /* (resends fall on even seconds of the game's time: the last before now) */
+  CHECK(event->target==((now-1)/(2*TICKS_PER_SECOND)*(2*TICKS_PER_SECOND)-start)*1000/TICKS_PER_SECOND,
+   "a resend said %ld ms, not its tick's",event->target);
+  /* music that loops starts from its beginning everywhere, as it always has */
+  scripted_looping_sound_start(MUSIC,NONE,1.0f);
+  start=now;
+  run_to(start+10*TICKS_PER_SECOND);
+  event=last_sent(_coop_sound_looping_start,MUSIC);
+  CHECK(event&&event->target==NONE,"music that loops was resent with %ld ms",event?event->target:0);
+ }
+ else
+ {
+  fprintf(stderr,"unknown case %s\n",name);
+  return 2;
+ }
+ return 0;
+}
diff --git a/tools/harness/tests/coop_looping_sounds.c b/tools/harness/tests/coop_looping_sounds.c
new file mode 100644
index 00000000..728ea083
--- /dev/null
+++ b/tools/harness/tests/coop_looping_sounds.c
@@ -0,0 +1,209 @@
+/* A co-op client's script looping sounds, from the host's sound events
+(network_coop.c's client_apply_sound) and game_sound.c's scripted looping
+sounds. A sound that plays once (fake impulse: a cutscene's) and has played
+out on the client is not started again by the host's resends. */
+#include "harness.h"
+
+typedef unsigned short word;
+#define PIN(x,lo,hi) ((x)<(lo)?(lo):(x)>(hi)?(hi):(x))
+#define SET_FLAG(f,b,v) ((f)=(v)?(f)|(1U<<(b)):(f)&~(1U<<(b)))
+#define SOUND_DEFINITION_TAG 0x736e6421UL
+#define LOOPING_SOUND_DEFINITION_TAG 0x6c736e64UL
+#define MAXIMUM_LOOPING_SOUNDS 32
+#define CLIENT_SCRIPT_SOUND_COUNT 16
+
+#include "types.inc"
+struct looping_sound_definition {unsigned long flags;long runtime_scripting_sound_index;};
+
+/* the map's looping sounds: 0 plays once (fake impulse), 1 is music that loops */
+enum {ONCE=0,MUSIC=1,DEFINITIONS=2};
+static struct looping_sound_definition definitions[DEFINITIONS];
+static struct looping_sound_definition *looping_sound_definition_get(long index)
+{
+ CHECK(index>=0&&index<DEFINITIONS,"no such looping sound %ld",index);
+ return &definitions[index];
+}
+static boolean distributed_tag_of_group(long tag_index,unsigned long group)
+{
+ return group==LOOPING_SOUND_DEFINITION_TAG&&tag_index>=0&&tag_index<DEFINITIONS;
+}
+static boolean network_objects_client_has(long object_index){(void)object_index;return FALSE;}
+
+/* the playing looping sounds (game_sound.c's data) */
+struct game_looping_sound_datum {long definition_index;unsigned long flags;real scale;boolean used;};
+enum {_game_looping_sound_unattached_bit,_game_looping_sound_scripted_bit,_game_looping_sound_alternate_bit,
+ _game_looping_sound_unattached_stop_bit,_game_looping_sound_unattached_stop_fixed_fadeout_bit};
+static struct game_looping_sound_datum playing[8];
+static int starts[DEFINITIONS],full;
+static long game_looping_sound_new(long object_index,long definition_index,char const *marker,long node)
+{
+ long index;
+ (void)object_index;(void)marker;(void)node;
+ if(full)return NONE;
+ for(index=0;index<8;index++)
+ {
+  if(!playing[index].used)
+  {
+   memset(&playing[index],0,sizeof(playing[index]));
+   playing[index].used=TRUE;playing[index].definition_index=definition_index;
+   starts[definition_index]++;
+   return index;
+  }
+ }
+ return NONE;
+}
+static struct game_looping_sound_datum *game_looping_sound_get(long index)
+{
+ CHECK(index>=0&&index<8&&playing[index].used,"no such playing sound %ld",index);
+ return &playing[index];
+}
+static void network_coop_note_sound(short kind,long definition_index,long object_index,real scale)
+{(void)kind;(void)definition_index;(void)object_index;(void)scale;}
+
+/* coop_sound_sync.c's: the host's time for each sound, as the client was told it */
+static long synced[DEFINITIONS];
+static int sync_begins;
+static void coop_sound_sync_begin(long definition_index,long elapsed_milliseconds)
+{
+ CHECK(definition_index>=0&&definition_index<DEFINITIONS,"synced no such sound %ld",definition_index);
+ synced[definition_index]=elapsed_milliseconds;sync_begins++;
+}
+static void coop_sound_sync_end(long definition_index)
+{
+ CHECK(definition_index>=0&&definition_index<DEFINITIONS,"ended no such sound %ld",definition_index);
+ synced[definition_index]=NONE;
+}
+static void scripted_music_stop_all(void){}
+
+/* as game_sound.c's update when a fake impulse sound's permutations have all played */
+static void play_out(long definition_index)
+{
+ struct looping_sound_definition *definition=&definitions[definition_index];
+ long index=definition->runtime_scripting_sound_index;
+ CHECK(index!=NONE,"sound %ld is not playing to play out",definition_index);
+ definition->runtime_scripting_sound_index=NONE;
+ playing[index].used=FALSE;
+}
+static boolean is_playing(long definition_index){return definitions[definition_index].runtime_scripting_sound_index!=NONE;}
+
+/* the client's impulse sounds, which these cases don't send */
+static struct {long definition_indices[CLIENT_SCRIPT_SOUND_COUNT];short next;} client_script_sounds;
+static void scripted_sound_new(long tag,long object,real scale){(void)tag;(void)object;(void)scale;}
+
+#include "under_test.inc"
+
+/* (target: the host's milliseconds since it started it, NONE for just now) */
+static void send_at(int type,long definition_index,long target)
+{
+ struct distributed_coop_event event;
+ memset(&event,0,sizeof(event));
+ event.kind=0;event.type=(byte)type;event.tag_index=definition_index;event.object_index=NONE;event.reals[0]=1.0f;
+ event.target=target;
+ client_apply_sound(&event);
+}
+static void send(int type,long definition_index){send_at(type,definition_index,NONE);}
+/* the host's two-second resend, or the one when a machine joins */
+static void resend(long definition_index){send(_coop_sound_looping_start,definition_index);}
+
+static void setup(void)
+{
+ int index;
+ memset(definitions,0,sizeof(definitions));
+ for(index=0;index<DEFINITIONS;index++)definitions[index].runtime_scripting_sound_index=NONE;
+ SET_FLAG(definitions[ONCE].flags,_looping_sound_fake_impulse_sound_bit,TRUE);
+ memset(playing,0,sizeof(playing));memset(starts,0,sizeof(starts));full=FALSE;
+ client_looping_sounds.count=0;
+ for(index=0;index<DEFINITIONS;index++)synced[index]=NONE;
+ sync_begins=0;
+}
+
+int main(int argc,char **argv)
+{
+ char const *name=argc>1?argv[1]:"";
+ setup();
+ if(!strcmp(name,"played-out"))
+ {
+  /* the cutscene's sound starts, plays to its end here, and the host, whose copy never ends, resends it */
+  send(_coop_sound_looping_start,ONCE);
+  CHECK(is_playing(ONCE)&&starts[ONCE]==1,"the host's start did not start it");
+  play_out(ONCE);
+  resend(ONCE);resend(ONCE);resend(ONCE);
+  CHECK(!is_playing(ONCE)&&starts[ONCE]==1,"played out, then started again %d times by the resends",starts[ONCE]-1);
+ }
+ else if(!strcmp(name,"playing"))
+ {
+  send(_coop_sound_looping_start,ONCE);
+  resend(ONCE);resend(ONCE);
+  CHECK(is_playing(ONCE)&&starts[ONCE]==1,"a resend restarted a sound still playing");
+ }
+ else if(!strcmp(name,"started-again"))
+ {
+  /* the scripts start it again: the host sends a stop, then a start */
+  send(_coop_sound_looping_start,ONCE);play_out(ONCE);
+  send(_coop_sound_looping_stop,ONCE);send(_coop_sound_looping_start,ONCE);
+  CHECK(is_playing(ONCE)&&starts[ONCE]==2,"the scripts' new start was refused");
+  play_out(ONCE);resend(ONCE);
+  CHECK(!is_playing(ONCE)&&starts[ONCE]==2,"the second playing restarted after it ended");
+ }
+ else if(!strcmp(name,"late-joiner"))
+ {
+  /* a client that joins after the start hears it from the resend that comes with its join */
+  resend(ONCE);
+  CHECK(is_playing(ONCE)&&starts[ONCE]==1,"the join's resend did not start it");
+  play_out(ONCE);resend(ONCE);
+  CHECK(!is_playing(ONCE)&&starts[ONCE]==1,"the joiner's copy restarted after it ended");
+ }
+ else if(!strcmp(name,"music"))
+ {
+  /* music that loops, lost here some other way, is started again as before */
+  send(_coop_sound_looping_start,MUSIC);play_out(MUSIC);resend(MUSIC);
+  CHECK(is_playing(MUSIC)&&starts[MUSIC]==2,"music lost here was not started again");
+  CHECK(client_looping_sounds.count==0,"music was remembered as played out");
+ }
+ else if(!strcmp(name,"no-room"))
+ {
+  /* a start that found no room is tried again by the next resend */
+  full=TRUE;send(_coop_sound_looping_start,ONCE);
+  CHECK(!is_playing(ONCE),"fixture: a start with no room played");
+  full=FALSE;resend(ONCE);
+  CHECK(is_playing(ONCE)&&starts[ONCE]==1,"a start that found no room was never tried again");
+ }
+ else if(!strcmp(name,"stopped"))
+ {
+  /* the host stops it while it plays: stopped here and forgotten */
+  send(_coop_sound_looping_start,ONCE);send(_coop_sound_looping_stop,ONCE);
+  CHECK(!is_playing(ONCE)&&client_looping_sounds.count==0,"the host's stop left it playing or remembered");
+ }
+ else if(!strcmp(name,"joined-during"))
+ {
+  /* a client that joins 40 s into the cutscene's sound starts it from there */
+  send_at(_coop_sound_looping_start,ONCE,40000);
+  CHECK(is_playing(ONCE)&&synced[ONCE]==40000,"the host's 40 s became %ld",synced[ONCE]);
+  CHECK(sync_begins==1,"the time was given %d times for one start",sync_begins);
+  /* the resends while it plays change nothing */
+  send_at(_coop_sound_looping_start,ONCE,42000);
+  CHECK(synced[ONCE]==40000&&sync_begins==1,"a resend while it played moved it to %ld",synced[ONCE]);
+  /* and the host's stop forgets it */
+  send(_coop_sound_looping_stop,ONCE);
+  CHECK(synced[ONCE]==NONE,"the host's stop kept its time");
+ }
+ else if(!strcmp(name,"music-time"))
+ {
+  /* music that loops starts at its beginning, whatever time a host sends */
+  send_at(_coop_sound_looping_start,MUSIC,40000);
+  CHECK(is_playing(MUSIC)&&synced[MUSIC]==NONE,"music that loops was given the time %ld",synced[MUSIC]);
+ }
+ else if(!strcmp(name,"just-started"))
+ {
+  /* the scripts' own start, or an older host's resend: from its beginning */
+  synced[ONCE]=12345;
+  send(_coop_sound_looping_start,ONCE);
+  CHECK(is_playing(ONCE)&&synced[ONCE]==NONE,"a start with no time kept the time %ld",synced[ONCE]);
+ }
+ else
+ {
+  fprintf(stderr,"unknown case %s\n",name);
+  return 2;
+ }
+ return 0;
+}
diff --git a/tools/harness/tests/coop_script_players.c b/tools/harness/tests/coop_script_players.c
new file mode 100644
index 00000000..57112ae8
--- /dev/null
+++ b/tools/harness/tests/coop_script_players.c
@@ -0,0 +1,262 @@
+#include "harness.h"
+#include <ctype.h>
+typedef unsigned short word;
+#define NUMBEROF(a) (sizeof(a) / sizeof((a)[0]))
+struct player_datum
+{
+	long unit_index;
+};
+struct data_iterator
+{
+	int slot;
+};
+static struct player_datum people[128];
+static int occupied[128], host = TRUE, list_count, calls[128];
+static long ref_head;
+static struct data_array *player_data, *object_list_data;
+static long data_next_index(struct data_array *data, long previous)
+{
+	int i;
+	for (i = previous + 1; i < 128; i++)
+		if (occupied[i])
+			return i;
+	return NONE;
+}
+static struct player_datum *player_get(long i)
+{
+	return &people[i];
+}
+static void data_iterator_new(struct data_iterator *it, struct data_array *data)
+{
+	it->slot = NONE;
+}
+static struct player_datum *data_iterator_next(struct data_iterator *it)
+{
+	it->slot = data_next_index(player_data, it->slot);
+	return it->slot == NONE ? NULL : &people[it->slot];
+}
+static boolean coop_scripts_host(void)
+{
+	return host;
+}
+static void reference_list_port_full(struct data_array *data)
+{
+	CHECK(FALSE, "fixture full");
+}
+static void data_delete_all(struct data_array *data)
+{
+	memset(data->data, 0, data->maximum_count * data->size);
+	data->count = 0;
+}
+#include "reference.inc"
+static long object_list_new(void)
+{
+	list_count++;
+	ref_head = NONE;
+	return 0;
+}
+static void object_list_add(long list, long unit)
+{
+	reference_list_add(object_list_data, &ref_head, unit);
+}
+static void object_list_mark_players(long list) {}
+static void object_list_delete(long list)
+{
+	data_delete_all(object_list_data);
+}
+#include "followers.inc"
+#include "players.inc"
+static long player_index_from_unit_index(long unit)
+{
+	int i;
+	for (i = 0; i < 128; i++)
+		if (occupied[i] && people[i].unit_index == unit)
+			return i;
+	return NONE;
+}
+static boolean coop_scripts_unit_near(long unit, real_point3d const *p)
+{
+	return TRUE;
+}
+static boolean player_position_switches_bsp(real_point3d const *p)
+{
+	return FALSE;
+}
+static real_point3d *object_get_origin(long unit, real_point3d *p)
+{
+	memset(p, 0, sizeof(*p));
+	return p;
+}
+static boolean coop_scripts_arrive_at(long player, real_point3d const *p, long const *arrived,
+									  short count)
+{
+	calls[player]++;
+	return TRUE;
+}
+static void unit_scripting_suspended(long unit, boolean value)
+{
+	calls[player_index_from_unit_index(unit)]++;
+}
+static struct
+{
+	struct
+	{
+		long parent_object_index;
+	} object;
+} objects[128];
+#define object_get(unit) (&objects[player_index_from_unit_index(unit)])
+static void unit_scripting_exit_vehicle(long unit)
+{
+	calls[player_index_from_unit_index(unit)]++;
+}
+static char *strlwr(char *p)
+{
+	char *s = p;
+	while (*s)
+	{
+		*s = tolower((unsigned char)*s);
+		s++;
+	}
+	return p;
+}
+static void vehicle_scripting_load_magic(long vehicle, char const *seat, long list)
+{
+	struct data_reference *r = datum_get(object_list_data, ref_head);
+	CHECK(!strcmp(seat, "p-rider"), "seat prefix changed");
+	calls[player_index_from_unit_index(r->datum_index)]++;
+}
+static void player_add_equipment(long unit, short profile, boolean reset)
+{
+	calls[player_index_from_unit_index(unit)]++;
+}
+#include "actions.inc"
+static int script_units(long *units)
+{
+	int n = 0;
+	long ref;
+	hs_players();
+	for (ref = ref_head; ref != NONE;)
+	{
+		struct data_reference *r = datum_get(object_list_data, ref);
+		units[n++] = r->datum_index;
+		ref = r->next_reference_index;
+	}
+	object_list_delete(0);
+	return n;
+}
+static void verify(void)
+{
+	long named[128], followers[130];
+	int n = script_units(named), i, j, count;
+	for (i = 0; i < n; i++)
+	{
+		memset(followers, 0x55, sizeof(followers));
+		count = players_following(named[i], followers, 128);
+		CHECK(count == (i == 0 && n > 2 ? n - 2 : 0),
+			  "script player %d, %d live units: %d followers", i, n, count);
+		for (j = 0; j < count; j++)
+			CHECK(followers[j] == named[j + 2], "follower %d disagrees with hs_players", j);
+	}
+	CHECK(!players_following(NONE, followers, 128), "NONE has followers");
+	CHECK(!players_following(123456, followers, 128), "nonplayer has followers");
+}
+static void reset(int count)
+{
+	int i;
+	memset(occupied, 0, sizeof(occupied));
+	memset(calls, 0, sizeof(calls));
+	host = TRUE;
+	for (i = 0; i < count; i++)
+	{
+		occupied[i] = 1;
+		people[i].unit_index = 1000 + 13 * i;
+		objects[i].object.parent_object_index = 555;
+	}
+	data_delete_all(object_list_data);
+}
+int main(int argc, char **argv)
+{
+	char const *name = argc > 1 ? argv[1] : "";
+	int n, i;
+	long units[128], out[128];
+	real_point3d destination = {1, 2, 3};
+	object_list_data = game_state_data_new("test refs", 128, sizeof(struct data_reference));
+	if (!strcmp(name, "counts"))
+	{
+		for (n = 0; n <= 128; n++)
+		{
+			reset(n);
+			verify();
+		}
+	}
+	else if (!strcmp(name, "gaps"))
+	{
+		reset(128);
+		for (i = 0; i < 128; i++)
+		{
+			if (i % 3 == 0)
+				occupied[i] = 0;
+			if (i % 5 == 0)
+				people[i].unit_index = NONE;
+		}
+		verify();
+	}
+	else if (!strcmp(name, "respawn"))
+	{
+		reset(12);
+		for (i = 11; i >= 0; i--)
+		{
+			people[i].unit_index = NONE;
+			verify();
+			people[i].unit_index = 9000 + i;
+			verify();
+			occupied[i] = 0;
+			verify();
+		}
+	}
+	else if (!strcmp(name, "bounded"))
+	{
+		reset(12);
+		n = script_units(units);
+		for (i = 0; i <= n; i++)
+		{
+			out[i] = 123456;
+			CHECK(players_following(units[0], out, i) == (i < n - 2 ? i : n - 2),
+				  "capacity ignored");
+			CHECK(out[i] == 123456, "output overrun");
+		}
+	}
+	else if (!strcmp(name, "nonhost"))
+	{
+		reset(12);
+		n = script_units(units);
+		host = FALSE;
+		CHECK(!players_following(units[0], out, 128), "nonhost followers");
+	}
+	else
+	{
+		reset(12);
+		n = script_units(units);
+		if (!strcmp(name, "teleport"))
+			coop_scripts_teleport_followers(units[0], &destination);
+		else if (!strcmp(name, "suspend"))
+			coop_scripts_suspend_followers(units[0], TRUE);
+		else if (!strcmp(name, "exit"))
+		{
+			objects[player_index_from_unit_index(units[4])].object.parent_object_index = 556;
+			coop_scripts_exit_followers(units[0], 555);
+		}
+		else if (!strcmp(name, "board"))
+			coop_scripts_board_followers(units[0], 555, "P-RiderLF");
+		else if (!strcmp(name, "equipment"))
+			coop_scripts_player_add_equipment(units[0], 2, TRUE);
+		else
+			CHECK(FALSE, "unknown case");
+		for (i = 0; i < n; i++)
+			CHECK(calls[player_index_from_unit_index(units[i])] ==
+					  ((i >= 2 && (!strcmp(name, "exit") ? i != 4 : TRUE)) ||
+					   (i == 0 && !strcmp(name, "equipment"))),
+				  "wrong action recipient %d", i);
+	}
+	return 0;
+}
diff --git a/tools/harness/tests/coop_sound_sync.c b/tools/harness/tests/coop_sound_sync.c
new file mode 100644
index 00000000..9ccba6c3
--- /dev/null
+++ b/tools/harness/tests/coop_sound_sync.c
@@ -0,0 +1,395 @@
+/* A co-op client that joins during a looping sound that plays once (a
+cutscene's) starts it where the host has reached (coop_sound_sync.c): the
+host's time walked through the parts the client's sound manager is about to
+play, to a permutation of a linked chain and a block's start into it. */
+#include "harness.h"
+#include <math.h>
+
+typedef unsigned short word;
+#define MIN(a,b) ((a)<(b)?(a):(b))
+#define MAX(a,b) ((a)>(b)?(a):(b))
+#define PIN(x,lo,hi) ((x)<(lo)?(lo):(x)>(hi)?(hi):(x))
+#define VALID_INDEX(i,c) ((i)>=0&&(i)<(c))
+#define SET_FLAG(f,b,v) ((f)=(v)?(f)|(1U<<(b)):(f)&~(1U<<(b)))
+#define TAG_BLOCK_GET_ELEMENT(b,i,t) (&((t *)(b)->address)[i])
+#define csmemset memset
+
+#include "types.inc"
+
+/* the client's sound tags: one looping sound, the scripts' instance of it 7,
+its start and loop sounds */
+enum {LOOPING=3,START_SOUND=10,LOOP_SOUND=11,SCRIPTS_INSTANCE=7,PERMUTATIONS=96};
+static struct looping_sound_definition looping;
+static struct looping_sound_track track;
+static struct sound_definition sounds[2];
+static struct sound_pitch_range ranges[2];
+static struct sound_permutation permutations[2][PERMUTATIONS];
+static struct looping_sound_definition *looping_sound_definition_get(long index)
+{
+ CHECK(index==LOOPING,"no such looping sound %ld",index);
+ return &looping;
+}
+static struct sound_definition *sound_definition_get(long index)
+{
+ CHECK(index==START_SOUND||index==LOOP_SOUND,"no such sound %ld",index);
+ return &sounds[index-START_SOUND];
+}
+static unsigned long sound_samples_per_second(short sample_rate)
+{
+ CHECK(sample_rate==0||sample_rate==1,"no such sample rate %d",sample_rate);
+ return sample_rate?44100:22050;
+}
+static unsigned long now;
+static unsigned long system_milliseconds(void){return now;}
+#define error(...) ((void)0)
+#define tag_get_name(...) "looping sound"
+
+#include "under_test.inc"
+
+enum {MONO=0,STEREO=1,NONE_COMPRESSION=0,XBOX_ADPCM=1,OGG=3,RATE_22=0,RATE_44=1};
+
+/* a block's start, within two blocks of the ideal byte (a map's permutation is whole blocks, so a little
+shorter than its nominal time) */
+static boolean near(long bytes,real ideal,long block)
+{
+ return bytes%block==0&&fabsf((real)bytes-ideal)<=2.f*block;
+}
+/* the ideal byte milliseconds into a sound of channels at rate, an Xbox ADPCM one's or uncompressed */
+static real ideal_adpcm(real milliseconds,long rate,long channels){return milliseconds*rate/1000.f/64.f*36.f*channels;}
+
+/* a sound of permutations so long each (milliseconds at pitch 1), each linked to the next when linked */
+static void sound(long index,short encoding,short compression,short sample_rate,boolean linked,int count,
+ long const *milliseconds)
+{
+ struct sound_definition *definition=&sounds[index-START_SOUND];
+ struct sound_pitch_range *range=&ranges[index-START_SOUND];
+ long channels=encoding==STEREO?2:1;
+ long rate=sample_rate?44100:22050;
+ int permutation;
+
+ memset(definition,0,sizeof(*definition));memset(range,0,sizeof(*range));
+ definition->encoding=encoding;definition->compression=compression;definition->sample_rate=sample_rate;
+ SET_FLAG(definition->flags,_sound_definition_linked_permutations_bit,linked);
+ definition->pitch_ranges.count=1;definition->pitch_ranges.address=range;
+ range->permutations.count=count;range->permutations.address=permutations[index-START_SOUND];
+ range->actual_permutation_count=1;range->playback_rate=1.f;
+ definition->random_pitch_bounds.lower=definition->random_pitch_bounds.upper=1.f;
+ definition->zero_pitch_modifier=definition->one_pitch_modifier=1.f;
+ for(permutation=0;permutation<count;permutation++)
+ {
+  struct sound_permutation *p=&permutations[index-START_SOUND][permutation];
+  long frames=milliseconds[permutation]*rate/1000;
+
+  memset(p,0,sizeof(*p));
+  p->samples.size=compression==XBOX_ADPCM?frames/64*36*channels:frames*2*channels;
+  p->next_permutation_index=linked&&permutation+1<count?(short)(permutation+1):NONE;
+ }
+}
+
+static void setup(void)
+{
+ static long const ten_seconds[]={10000};
+
+ memset(&looping,0,sizeof(looping));memset(&track,0,sizeof(track));
+ looping.runtime_scripting_sound_index=SCRIPTS_INSTANCE;
+ looping.tracks.count=1;looping.tracks.address=&track;
+ sound(START_SOUND,MONO,XBOX_ADPCM,RATE_22,FALSE,1,ten_seconds);
+ sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,FALSE,1,ten_seconds);
+ now=1000;
+ coop_sound_sync_reset();
+}
+
+/* the sound manager about to play a part, its first permutation chosen as 0 at pitch */
+static short place_at(long instance,short part,long sound_index,short *permutation,real pitch,long datum)
+{
+ *permutation=0;
+ return coop_sound_sync_place(LOOPING,instance,0,part,sound_index,0,permutation,pitch,datum);
+}
+static short place(short part,long sound_index,short *permutation,long datum)
+{
+ return place_at(SCRIPTS_INSTANCE,part,sound_index,permutation,1.0f,datum);
+}
+static long offset(long datum,long sound_index,short permutation)
+{
+ return coop_sound_sync_take_offset(datum,&permutations[sound_index-START_SOUND][permutation]);
+}
+
+int main(int argc,char **argv)
+{
+ char const *name=argc>1?argv[1]:"";
+ short permutation;
+ short result;
+ long bytes;
+
+ setup();
+ if(!strcmp(name,"pcm"))
+ {
+  /* uncompressed stereo at 44 kHz, 4 s into a 10 s loop: 4 bytes a sample */
+  static long const ten_seconds[]={10000};
+  sound(LOOP_SOUND,STEREO,NONE_COMPRESSION,RATE_44,FALSE,1,ten_seconds);
+  coop_sound_sync_begin(LOOPING,4000);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  bytes=offset(100,LOOP_SOUND,0);
+  CHECK(result==_coop_sound_sync_play&&permutation==0,"result %d, permutation %d",result,permutation);
+  CHECK(bytes==4000L*44100/1000*4,"4 s in is byte %ld",bytes);
+ }
+ else if(!strcmp(name,"chain"))
+ {
+  /* Xbox ADPCM, mono at 22 kHz, three linked 2 s permutations: 5 s is 1 s into the third,
+  at the start of its block (36 bytes a 64 samples) */
+  static long const two_seconds[]={2000,2000,2000};
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,TRUE,3,two_seconds);
+  coop_sound_sync_begin(LOOPING,5000);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  bytes=offset(100,LOOP_SOUND,2);
+  CHECK(result==_coop_sound_sync_play&&permutation==2,"result %d, landed on permutation %d",result,permutation);
+  CHECK(near(bytes,ideal_adpcm(1000,22050,1),36),"1 s into it is byte %ld",bytes);
+ }
+ else if(!strcmp(name,"stereo-blocks"))
+ {
+  /* a stereo ADPCM block is twice a mono one's */
+  static long const ten_seconds[]={10000};
+  sound(LOOP_SOUND,STEREO,XBOX_ADPCM,RATE_44,FALSE,1,ten_seconds);
+  coop_sound_sync_begin(LOOPING,3000);
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  bytes=offset(100,LOOP_SOUND,0);
+  CHECK(near(bytes,ideal_adpcm(3000,44100,2),72),"3 s into stereo is byte %ld",bytes);
+ }
+ else if(!strcmp(name,"pitch"))
+ {
+  /* at twice the pitch, 2 s in is 4 s of samples */
+  static long const ten_seconds[]={10000};
+  sound(LOOP_SOUND,STEREO,NONE_COMPRESSION,RATE_44,FALSE,1,ten_seconds);
+  coop_sound_sync_begin(LOOPING,2000);
+  place_at(SCRIPTS_INSTANCE,_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,2.0f,100);
+  bytes=offset(100,LOOP_SOUND,0);
+  CHECK(bytes==4L*44100*4,"2 s in at pitch 2 is byte %ld",bytes);
+ }
+ else if(!strcmp(name,"start-skipped"))
+ {
+  /* 13 s after a 10 s start: the start does not play, and a 20 s loop starts 3 s in */
+  static long const twenty_seconds[]={20000};
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,FALSE,1,twenty_seconds);
+  coop_sound_sync_begin(LOOPING,13000);
+  result=place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_skip,"a start that has played out gave %d",result);
+  CHECK(offset(100,START_SOUND,0)==0,"the skipped start kept an offset");
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,101);
+  bytes=offset(101,LOOP_SOUND,0);
+  CHECK(result==_coop_sound_sync_play&&near(bytes,ideal_adpcm(3000,22050,1),36),"the loop gave %d from byte %ld",
+   result,bytes);
+ }
+ else if(!strcmp(name,"start-playing"))
+ {
+  /* 4 s into a 10 s start: the start plays from there (the loop follows it from its beginning) */
+  coop_sound_sync_begin(LOOPING,4000);
+  result=place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  bytes=offset(100,START_SOUND,0);
+  CHECK(result==_coop_sound_sync_play&&near(bytes,ideal_adpcm(4000,22050,1),36),"the start gave %d from byte %ld",
+   result,bytes);
+ }
+ else if(!strcmp(name,"fade-in-at-start"))
+ {
+  /* a loop that fades in with its start plays alongside it: 13 s is 13 s into it, a 20 s one */
+  static long const twenty_seconds[]={20000};
+  SET_FLAG(track.flags,COOP_SOUND_TRACK_FADE_IN_AT_START_BIT,TRUE);
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,FALSE,1,twenty_seconds);
+  coop_sound_sync_begin(LOOPING,13000);
+  place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,101);
+  bytes=offset(101,LOOP_SOUND,0);
+  CHECK(near(bytes,ideal_adpcm(13000,22050,1),36),"a loop alongside its start started from byte %ld",bytes);
+ }
+ else if(!strcmp(name,"finished"))
+ {
+  /* past the end of a linked loop: the sound has played out, and its stop does not play */
+  static long const two_seconds[]={2000,2000,2000};
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,TRUE,3,two_seconds);
+  coop_sound_sync_begin(LOOPING,7000);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_finished,"a loop that has played out gave %d",result);
+  coop_sound_sync_refreshed(LOOPING,SCRIPTS_INSTANCE,TRUE);
+  result=place(_coop_sound_sync_stop_part,LOOP_SOUND,&permutation,101);
+  CHECK(result==_coop_sound_sync_skip,"its stop gave %d",result);
+ }
+ else if(!strcmp(name,"repeat"))
+ {
+  /* a loop whose permutations are not linked repeats: 5.5 s round a 2 s one is 1.5 s in */
+  static long const two_seconds[]={2000};
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,FALSE,1,two_seconds);
+  coop_sound_sync_begin(LOOPING,5500);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  bytes=offset(100,LOOP_SOUND,0);
+  CHECK(result==_coop_sound_sync_play,"a repeating loop gave %d",result);
+  CHECK(near(bytes,ideal_adpcm(1500,22050,1),36),"5.5 s round it is byte %ld",bytes);
+ }
+ else if(!strcmp(name,"late"))
+ {
+  /* the time since the host's came counts too */
+  coop_sound_sync_begin(LOOPING,3000);
+  now+=1000;
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  bytes=offset(100,LOOP_SOUND,0);
+  CHECK(near(bytes,ideal_adpcm(4000,22050,1),36),"3 s and 1 s waiting is byte %ld",bytes);
+ }
+ else if(!strcmp(name,"just-started"))
+ {
+  /* no time, or the scripts' own start: from the beginning */
+  coop_sound_sync_begin(LOOPING,0);
+  result=place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,START_SOUND,0)==0,"a start with no time was placed");
+  coop_sound_sync_begin(LOOPING,NONE);
+  result=place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,START_SOUND,0)==0,"a start with time NONE was placed");
+ }
+ else if(!strcmp(name,"ended"))
+ {
+  /* the host's stop, or a new game, forgets it */
+  coop_sound_sync_begin(LOOPING,4000);
+  coop_sound_sync_end(LOOPING);
+  place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  CHECK(offset(100,START_SOUND,0)==0,"a stopped sound was placed");
+  coop_sound_sync_begin(LOOPING,4000);
+  coop_sound_sync_reset();
+  place(_coop_sound_sync_start_part,START_SOUND,&permutation,100);
+  CHECK(offset(100,START_SOUND,0)==0,"a sound of the last game was placed");
+ }
+ else if(!strcmp(name,"placed"))
+ {
+  /* a refresh that started nothing (no listener heard it yet) leaves it to be placed */
+  coop_sound_sync_begin(LOOPING,4000);
+  coop_sound_sync_refreshed(LOOPING,SCRIPTS_INSTANCE,FALSE);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,LOOP_SOUND,0)>0,"a refresh that started nothing ended the placing");
+  /* after the refresh that started it nothing more is placed (a pitch range's crossfade starts at the beginning) */
+  coop_sound_sync_refreshed(LOOPING,SCRIPTS_INSTANCE,TRUE);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,101);
+  CHECK(result==_coop_sound_sync_play&&offset(101,LOOP_SOUND,0)==0,"a part after the first refresh was placed");
+ }
+ else if(!strcmp(name,"other-instance"))
+ {
+  /* another instance of the same looping sound (an object's) starts as it always has */
+  coop_sound_sync_begin(LOOPING,4000);
+  result=place_at(SCRIPTS_INSTANCE+1,_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,1.0f,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,LOOP_SOUND,0)==0,"an instance not the scripts' was placed");
+  coop_sound_sync_refreshed(LOOPING,SCRIPTS_INSTANCE+1,TRUE);
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,101);
+  CHECK(offset(101,LOOP_SOUND,0)>0,"another instance's refresh ended the scripts' placing");
+ }
+ else if(!strcmp(name,"unknown-compression"))
+ {
+  /* a compression whose time is not known here starts at the beginning */
+  static long const ten_seconds[]={10000};
+  sound(LOOP_SOUND,MONO,OGG,RATE_22,FALSE,1,ten_seconds);
+  coop_sound_sync_begin(LOOPING,4000);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,LOOP_SOUND,0)==0,"an Ogg sound was placed");
+ }
+ else if(!strcmp(name,"taken-once"))
+ {
+  /* the offset is the sound's first permutation's, taken once */
+  coop_sound_sync_begin(LOOPING,4000);
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  CHECK(coop_sound_sync_take_offset(101,&permutations[1][0])==0,"another sound took the offset");
+  CHECK(coop_sound_sync_take_offset(100,&permutations[0][0])==0,"another permutation took the offset");
+  CHECK(coop_sound_sync_take_offset(100,&permutations[1][0])==0,"the offset outlived a wrong permutation");
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,102);
+  CHECK(offset(102,LOOP_SOUND,0)>0&&offset(102,LOOP_SOUND,0)==0,"the offset was not taken exactly once");
+ }
+ else if(!strcmp(name,"hostile"))
+ {
+  /* what a host sends, and what a map holds, cannot run past a sound's samples or loop for ever */
+  static long const two_seconds[]={2000,2000,2000};
+  int pitch;
+  real const pitches[]={0.0f,-1.0f,0.0001f,1e30f,(real)NAN,(real)INFINITY};
+
+  coop_sound_sync_begin(LOOPING,0x7fffffffL);
+  place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  bytes=offset(100,LOOP_SOUND,0);
+  CHECK(bytes>=0&&bytes<permutations[1][0].samples.size&&bytes%36==0,"a huge time gave byte %ld",bytes);
+  for(pitch=0;pitch<(int)(sizeof(pitches)/sizeof(pitches[0]));pitch++)
+  {
+   coop_sound_sync_begin(LOOPING,4000);
+   result=place_at(SCRIPTS_INSTANCE,_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,pitches[pitch],100);
+   bytes=offset(100,LOOP_SOUND,0);
+   CHECK(result!=_coop_sound_sync_skip&&bytes>=0&&bytes<permutations[1][0].samples.size,
+    "pitch %g gave %d from byte %ld",pitches[pitch],result,bytes);
+  }
+  /* a linked chain that comes back on itself */
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,TRUE,3,two_seconds);
+  permutations[1][2].next_permutation_index=0;
+  coop_sound_sync_begin(LOOPING,1000000);
+  result=place(_coop_sound_sync_loop_part,LOOP_SOUND,&permutation,100);
+  CHECK(result==_coop_sound_sync_play,"a chain round on itself gave %d",result);
+  /* a permutation past the range, and no such range */
+  coop_sound_sync_begin(LOOPING,4000);
+  permutation=PERMUTATIONS+5;
+  result=coop_sound_sync_place(LOOPING,SCRIPTS_INSTANCE,0,_coop_sound_sync_loop_part,LOOP_SOUND,0,&permutation,1.f,100);
+  CHECK(result==_coop_sound_sync_play&&permutation==PERMUTATIONS+5,"a bad permutation gave %d, %d",result,permutation);
+  permutation=0;
+  result=coop_sound_sync_place(LOOPING,SCRIPTS_INSTANCE,0,_coop_sound_sync_loop_part,LOOP_SOUND,NONE,&permutation,1.f,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,LOOP_SOUND,0)==0,"no range was placed");
+  result=coop_sound_sync_place(LOOPING,SCRIPTS_INSTANCE,9,_coop_sound_sync_loop_part,LOOP_SOUND,0,&permutation,1.f,100);
+  CHECK(result==_coop_sound_sync_play&&offset(100,LOOP_SOUND,0)==0,"a track past the sound's was placed");
+ }
+ else if(!strcmp(name,"length"))
+ {
+  /* a cutscene's music: 86 linked permutations of 1.3 s and a last of 0.7 s, nearly two minutes (its
+  tag's longest_permutation_length, 1485, is one permutation's) */
+  static long parts[87];
+  int part;
+  long length;
+  for(part=0;part<86;part++)parts[part]=1321;
+  parts[86]=724;
+  sound(LOOP_SOUND,STEREO,XBOX_ADPCM,RATE_44,TRUE,87,parts);
+  sounds[1].longest_permutation_length=1485;
+  length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+  CHECK(length>=113000&&length<=114400,"the music's time was %ld ms",length);
+  /* a loop not linked plays its longest permutation, picked at random */
+  {
+   static long const three[]={2000,5000,3000};
+   sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,FALSE,3,three);
+   ranges[1].actual_permutation_count=3;
+   length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+   CHECK(length>=4900&&length<=5000,"the longest of three not linked was %ld ms",length);
+  }
+  /* at its slowest pitch: the random pitch's lower bound, half, makes it twice as long */
+  sounds[1].random_pitch_bounds.lower=0.5f;
+  length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+  CHECK(length>=9800&&length<=10000,"at half pitch it was %ld ms",length);
+  /* a compression whose time is not known here: the tag's longest permutation, for each linked one */
+  {
+   static long const two_seconds[]={2000,2000,2000};
+   sound(LOOP_SOUND,MONO,OGG,RATE_22,TRUE,3,two_seconds);
+   sounds[1].longest_permutation_length=2500;
+   length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+   CHECK(length==7500,"three Ogg permutations were %ld ms",length);
+  }
+ }
+ else if(!strcmp(name,"length-hostile"))
+ {
+  /* a chain round on itself, a map's huge length and no sound end, an hour at most */
+  static long const two_seconds[]={2000,2000,2000};
+  long length;
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,TRUE,3,two_seconds);
+  permutations[1][2].next_permutation_index=0;
+  length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+  CHECK(length>0&&length<=7000,"a chain round on itself was %ld ms",length);
+  sound(LOOP_SOUND,MONO,OGG,RATE_22,TRUE,3,two_seconds);
+  sounds[1].longest_permutation_length=0x7fffffffL;
+  length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+  CHECK(length==60*60*1000,"a huge length was %ld ms",length);
+  sounds[1].random_pitch_bounds.lower=-3.f;sounds[1].zero_pitch_modifier=0.f;ranges[1].playback_rate=(real)NAN;
+  sound(LOOP_SOUND,MONO,XBOX_ADPCM,RATE_22,TRUE,3,two_seconds);
+  sounds[1].random_pitch_bounds.lower=-3.f;sounds[1].zero_pitch_modifier=0.f;ranges[1].playback_rate=(real)NAN;
+  length=coop_sound_sync_sound_milliseconds(LOOP_SOUND);
+  CHECK(length>0&&length<=60*60*1000,"pitches a map breaks gave %ld ms",length);
+  CHECK(coop_sound_sync_sound_milliseconds(NONE)==0,"no sound has a time");
+ }
+ else
+ {
+  fprintf(stderr,"unknown case %s\n",name);
+  return 2;
+ }
+ return 0;
+}
diff --git a/tools/harness/tests/elevator_carry.c b/tools/harness/tests/elevator_carry.c
new file mode 100644
index 00000000..1fd097ac
--- /dev/null
+++ b/tools/harness/tests/elevator_carry.c
@@ -0,0 +1,49 @@
+#include "harness.h"
+#include <math.h>
+enum {_machine_is_elevator_bit=2, _object_mask_biped=1};
+#define NUMBEROF(a) (sizeof(a)/sizeof((a)[0]))
+struct fake_object {
+    struct { real_point3d position, bounding_sphere_center; int location; real bounding_sphere_radius; } object;
+    struct { real_point3d elevator_position; } machine;
+    struct { long elevator_object_index; } biped;
+};
+struct fake_definition {struct {unsigned flags; short elevator_node_index;} machine;};
+struct fake_matrix {real_point3d position;};
+#define machine_datum fake_object
+#define biped_datum fake_object
+#define machine_definition fake_definition
+#define real_matrix4x3 struct fake_matrix
+static struct fake_object platform, rider, stranger;
+static struct fake_definition definition;
+static struct fake_matrix node;
+static struct fake_object *machine_get(long i) {return &platform;}
+static struct fake_definition *machine_definition_get(long i) {return &definition;}
+/* The production function reads the definition index too. */
+#define definition_index object.location
+static struct fake_matrix *object_get_node_matrix(long i, int n) {return &node;}
+static short objects_in_sphere(long a,long b,void *l,void *p,real r,long *out,int count) {out[0]=1;out[1]=3;return 2;}
+static struct fake_object *biped_get(long i) {return i==1 ? &rider : &stranger;}
+static void add_vectors3d(real_vector3d const *a,real_vector3d const *b,real_vector3d *c) {c->i=a->i+b->i;c->j=a->j+b->j;c->k=a->k+b->k;}
+static void object_translate(long i,real_point3d const *p,void *unused) {biped_get(i)->object.position=*p;}
+#include "under_test.inc"
+int main(int argc,char **argv) {
+    char const *case_name=argc>1?argv[1]:"";
+    real_point3d before={0,0,10};
+    real old_step=.1f,new_step=.1f;
+    definition.machine.flags=FLAG(_machine_is_elevator_bit);definition.machine.elevator_node_index=0;
+    rider.biped.elevator_object_index=2;stranger.biped.elevator_object_index=4;
+    rider.object.position.z=stranger.object.position.z=10;
+    if (!strcmp(case_name,"down")) old_step=new_step=-.1f;
+    if (!strcmp(case_name,"start")) {old_step=0;new_step=.1f;}
+    if (!strcmp(case_name,"stop")) new_step=0;
+    if (!strcmp(case_name,"reverse")) {old_step=-.1f;new_step=.1f;}
+    if (!strcmp(case_name,"snap")) {old_step=.1f;new_step=-4;}
+    if (!strcmp(case_name,"door")) definition.machine.flags=0;
+    platform.machine.elevator_position.z=before.z-old_step;
+    node.position.z=before.z+new_step;
+    machine_move_elevator_riders(2,&before);
+    if (!strcmp(case_name,"door")) CHECK(rider.object.position.z==10,"door carried a rider");
+    else CHECK(fabsf(rider.object.position.z-node.position.z)<.00001f,"%s: rider %f floor %f",case_name,rider.object.position.z,node.position.z);
+    CHECK(stranger.object.position.z==10,"another elevator's rider was moved");
+    return 0;
+}
diff --git a/tools/harness/tests/elevator_correction.c b/tools/harness/tests/elevator_correction.c
new file mode 100644
index 00000000..7b4fffaa
--- /dev/null
+++ b/tools/harness/tests/elevator_correction.c
@@ -0,0 +1,96 @@
+/* Production reconciliation in a small world. Delays are 3/6 ticks at 30 Hz;
+the host and client platforms may have different phases, including snaps.
+The apply stub implements the production position tolerance, not collision. */
+#include "harness.h"
+#include <math.h>
+typedef unsigned short word;
+typedef struct { real i, j; } real_vector2d;
+enum { _distributed_unit_predicted_bit = 0, OWN_POSITION_TICKS = 64,
+    _object_mask_biped = 1, _object_mask_machine = 2, _biped_airborne_bit = 0 };
+struct player_datum { short local_player_index; };
+struct fake_object {
+    long mask;
+    struct { real_point3d position, bounding_sphere_center; real_vector3d translational_velocity; } object;
+    struct { unsigned flags; long support_surface_index, elevator_object_index; char elevator_ticks; } biped;
+};
+#define biped_datum fake_object
+#define device_datum fake_object
+#define object_datum fake_object
+static struct fake_object objects[4];
+static struct fake_object *object_get(long i) { return &objects[i]; }
+static void *object_try_and_get_and_verify_type(long i, long mask) {
+    return i > 0 && i < 4 && (objects[i].mask & mask) ? &objects[i] : NULL;
+}
+static long now;
+static long game_time_get(void) { return now; }
+static boolean network_coop_active(void) { return TRUE; }
+static long scenario_leaf_index_from_point(real_point3d const *p) { return 0; }
+#include "config.inc"
+static struct distributed_own_position distributed_own_positions[1][64];
+static real distributed_own_round_trip;
+/* (the latency meter's timing of the host's echo: not under test) */
+static void distributed_note_own_round_trip(long time) { (void)time; }
+/* (the riding words of distributed_correct_own_unit: this fixture has no vehicle window, so none is taken) */
+struct vehicle_riding_claim *vehicle_riding_player_claim(short player_index) { return NULL; }
+static boolean distributed_own_episode_current(struct player_datum const *p, long u, struct distributed_unit_state const *s) { return FALSE; }
+static boolean distributed_own_window_current(struct player_datum const *p, long u, struct distributed_unit_state const *s) { return FALSE; }
+static boolean distributed_deck_whole(struct distributed_unit_state const *s) { return FALSE; }
+static boolean distributed_correct_own_unechoed_rider(long u, struct distributed_unit_state const *s) { return FALSE; }
+static void biped_riding_cabin_host(long u, struct vehicle_riding_deck const *d, boolean b) {}
+static void biped_riding_air_verdict_host(long u, struct vehicle_riding_deck const *d, boolean b) {}
+static boolean biped_riding_deck(long u, struct vehicle_riding_deck *d) { return FALSE; }
+static boolean biped_riding_get_state(long u, struct vehicle_riding_state *s) { return FALSE; }
+static short biped_riding_vehicle_node_count(long v) { return NONE; }
+static void biped_riding_drop(long u) {}
+static void biped_riding_rebase(long u) {}
+static boolean biped_riding_take_deck(long u, struct vehicle_riding_deck const *d) { return FALSE; }
+static boolean biped_riding_air_take(long u, struct vehicle_riding_deck const *d) { return FALSE; }
+static boolean biped_riding_deck_position(long u, struct vehicle_riding_deck const *d, real_point3d *p) { return FALSE; }
+static boolean biped_riding_frame_velocity(long u, struct vehicle_riding_deck const *d, real_point3d const *b, real_vector3d *v) { return FALSE; }
+static boolean biped_riding_vehicle(long v, short n, struct vehicle_riding_vehicle *out) { return FALSE; }
+static boolean biped_riding_air_correct(long u, real_vector3d const *d, real peak, short verdict) { return FALSE; }
+static void biped_get_physics_pill(long u, real_point3d *base, real *h, real *w) {}
+boolean vehicle_riding_deck_valid(struct vehicle_riding_deck const *d, short nodes) { return FALSE; }
+boolean vehicle_riding_claim_grace(struct vehicle_riding_claim *c, long ov, short on, long hv, short hn, short g) { return FALSE; }
+static long distributed_own_windows[1], distributed_own_air_episodes[1];
+static long game_connection(void) { return 0; }
+#define _game_connection_network_client 1
+static boolean network_objects_reconcile(long i, real_point3d const *p, real_vector3d const *f, real_vector3d const *u,
+    real_vector3d const *v, real_vector3d const *av, real blend, short kind) { return FALSE; }
+#define RIDING_TICKS 60
+static boolean distributed_apply_state(long i, struct distributed_unit_state const *s,
+    real_point3d const *p, real_vector3d const *velocity, real tolerance, real b, real speed, real fall) {
+    real dx = p->x - objects[i].object.position.x, dy = p->y - objects[i].object.position.y,
+        dz = p->z - objects[i].object.position.z;
+    if (dx*dx + dy*dy + dz*dz > tolerance*tolerance) objects[i].object.position = *p;
+    return TRUE;
+}
+#include "under_test.inc"
+int main(int argc, char **argv) {
+    char const *case_name = argc > 1 ? argv[1] : "";
+    struct player_datum p = {0};
+    struct distributed_unit_state s;
+    struct distributed_own_position *own = &distributed_own_positions[0][100 & 63];
+    boolean protected = !strncmp(case_name,"100ms",5) || !strncmp(case_name,"200ms",5);
+    long delay = !strncmp(case_name,"100ms",5) ? 3 : 6;
+    memset(&s, 0, sizeof(s)); s.position.z = 10; s.flags = 1; s.predicted_time = 100;
+    objects[1].mask = _object_mask_biped; objects[2].mask = objects[3].mask = _object_mask_machine;
+    objects[1].biped.support_surface_index = 1; objects[1].biped.elevator_ticks = 60;
+    objects[1].biped.elevator_object_index = 2; objects[1].object.position.z = 10;
+    own->time = 100; own->unit_index = 1; own->position.z = 13.2f; own->elevator_index = 2;
+    now = 100 + delay;
+    if (strstr(case_name,"-up")) {own->position.z=10; s.position.z=13.2f;}
+    if (!strcmp(case_name,"jump")) objects[1].biped.flags = FLAG(_biped_airborne_bit);
+    if (!strcmp(case_name,"walk-off")) objects[1].biped.elevator_ticks = 59;
+    if (!strcmp(case_name,"other-elevator")) objects[1].biped.elevator_object_index = 3;
+    if (!strcmp(case_name,"on-foot")) own->elevator_index = NONE;
+    if (!strcmp(case_name,"teleport")) s.position.x = 10;
+    if (!strcmp(case_name,"far")) s.position.z = -10;
+    if (!strcmp(case_name,"unpredicted")) {s.flags = 0; s.position.z = 0;}
+    if (!strcmp(case_name,"no-history")) {own->time = NONE; s.position.z = 0;}
+    distributed_correct_own_unit(&p,1,&s);
+    if (protected) CHECK(fabsf(objects[1].object.position.z-10) < .0001f,
+        "%ld ms echo placed the rider at %f under its floor", delay*1000/30, objects[1].object.position.z);
+    else CHECK(objects[1].object.position.z < 7, "%s wrongly suppressed an ordinary correction", case_name);
+    return 0;
+}

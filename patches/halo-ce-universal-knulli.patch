diff --git a/port/android/guest/runtime/guest_string.c b/port/android/guest/runtime/guest_string.c
new file mode 100644
index 00000000..4e20b92a
--- /dev/null
+++ b/port/android/guest/runtime/guest_string.c
@@ -0,0 +1,64 @@
+/*
+GUEST_STRING.C
+
+memcmp and memcpy for the guest, eight bytes at a time. musl has no
+assembly versions of them for arm64_32, and its C versions go a byte (memcmp)
+or four bytes (memcpy) at a time. The renderer compares state of a few
+hundred bytes per draw (shader keys, uniform inputs), which made musl's
+memcmp about 6% of the game's thread on the Cortex-A53.
+
+These are found before libguestc.a's, whose memcmp.o and memcpy.o are then
+not linked. no_builtin keeps clang from turning the loops back into calls to
+the functions themselves.
+*/
+
+#include <string.h>
+#include <stdint.h>
+
+/* AArch64 loads and stores need no alignment */
+typedef uint64_t __attribute__((aligned(1), may_alias)) unaligned_u64;
+
+__attribute__((no_builtin)) int memcmp(const void *left, const void *right, size_t size)
+{
+	const unsigned char *l = left, *r = right;
+
+	for (; size >= 8; size -= 8, l += 8, r += 8)
+	{
+		uint64_t a = *(const unaligned_u64 *)l, b = *(const unaligned_u64 *)r;
+
+		if (a != b)
+		{
+			/* little-endian: the lowest byte that differs is the first */
+			unsigned int shift = (unsigned int)__builtin_ctzll(a ^ b) & ~7u;
+
+			return (int)((a >> shift) & 0xff) - (int)((b >> shift) & 0xff);
+		}
+	}
+	for (; size && *l == *r; size--, l++, r++)
+		;
+	return size ? *l - *r : 0;
+}
+
+__attribute__((no_builtin)) void *memcpy(void *restrict destination, const void *restrict source, size_t size)
+{
+	unsigned char *d = destination;
+	const unsigned char *s = source;
+
+	for (; size >= 16; size -= 16, d += 16, s += 16)
+	{
+		uint64_t a = ((const unaligned_u64 *)s)[0], b = ((const unaligned_u64 *)s)[1];
+
+		((unaligned_u64 *)d)[0] = a;
+		((unaligned_u64 *)d)[1] = b;
+	}
+	if (size >= 8)
+	{
+		*(unaligned_u64 *)d = *(const unaligned_u64 *)s;
+		size -= 8;
+		d += 8;
+		s += 8;
+	}
+	for (; size; size--)
+		*d++ = *s++;
+	return destination;
+}

+		platform_log("draw callers: %lu draws a frame", total / frames);
+		qsort(draw_callers, DRAW_CALLER_SLOTS, sizeof(draw_callers[0]), draw_caller_compare);
+		for (index = 0; index < 24 && draw_callers[index].draws; index++)
+		{
+			platform_log("draw callers:   %08lx %6.1f draws %8.0f vertices", draw_callers[index].address,
+				(double)draw_callers[index].draws / frames, (double)draw_callers[index].vertices / frames);
+		}
+		memset(draw_callers, 0, sizeof(draw_callers));
+		first_frame = device.frame;
+	}

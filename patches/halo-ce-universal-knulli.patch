diff --git a/source/rasterizer/xbox/rasterizer_xbox_models.c b/source/rasterizer/xbox/rasterizer_xbox_models.c
index b7eecb48..f1e6c3be 100644
--- a/source/rasterizer/xbox/rasterizer_xbox_models.c
+++ b/source/rasterizer/xbox/rasterizer_xbox_models.c
@@ -558,6 +558,317 @@ void rasterizer_model_ambient_reflection_tint(
 
 /* ---------- private code */
 
+#ifdef HALO_ANDROID
+/* ---------- models drawn sorted by shader (the Mali port)
+
+The game draws each object's parts in turn, so that consecutive draws mostly
+change shader program, textures and vertex format: on Mali-G31 a draw after a
+change of program costs the driver several times one that changes only
+constants, and a frame of a busy scene is some 300 model draws, many of them
+the same parts of the same models (a squad of marines). Between
+_rasterizer_models_begin and _rasterizer_models_end, the objects that can be
+drawn in any order (opaque, not the sky, the first-person weapon or an
+effect) are kept instead of drawn: their parameters, their node matrices
+copied, and their parts' draws. At the end, or before an object that must be
+drawn in place, the kept draws are sorted by shader, permutation and
+geometry and drawn through the same functions (debug.sort_models). */
+
+#include <stdlib.h>
+
+int xgpu_sort_models(void); /* port/linux/src/d3d8_gl.c */
+
+#define DEFERRED_MODEL_OBJECTS 512
+#define DEFERRED_MODEL_DRAWS 2048
+#define DEFERRED_MODEL_NODES 8192
+
+static void model_begin_now(struct rasterizer_model_begin_parameters const *parameters,
+	boolean do_not_change_z_stencil_states);
+static void model_end_now(void);
+static void model_draw_now(struct shader *shader, short shader_permutation_index,
+	struct triangle_buffer const *triangle_buffer, long dynamic_triangle_buffer_index, long triangle_count,
+	struct vertex_buffer const *vertex_buffer, long dynamic_vertex_buffer_index);
+
+static struct
+{
+	struct rasterizer_model_begin_parameters parameters;
+	boolean do_not_change_z_stencil_states;
+} deferred_objects[DEFERRED_MODEL_OBJECTS];
+
+static struct deferred_model_draw
+{
+	struct shader *shader;
+	struct triangle_buffer const *triangle_buffer;
+	struct vertex_buffer const *vertex_buffer;
+	long dynamic_triangle_buffer_index;
+	long triangle_count;
+	long dynamic_vertex_buffer_index;
+	long order;
+	short object;
+	short shader_permutation_index;
+} deferred_draws[DEFERRED_MODEL_DRAWS];
+
+static real_matrix4x3 deferred_nodes[DEFERRED_MODEL_NODES];
+static long deferred_draw_count = 0;
+static long deferred_node_count = 0;
+static short deferred_object_count = 0;
+static short current_deferred_object = NONE;
+static boolean models_deferring = FALSE;
+/* the kept object's parameters as its caller passed them, valid until its end */
+static struct rasterizer_model_begin_parameters const *deferred_object_source = NULL;
+/* debug.draw_callers >= 3: how the sorting fares */
+static unsigned long sort_statistics[5]; /* phases, kept draws, flushes, drawn in place: transparent, decal */
+void platform_log(const char *format, ...);
+int xgpu_debug_draw_callers(void);
+static boolean deferred_object_do_not_change_z_stencil_states = FALSE;
+/* which faces model_draw_now draws of a two-sided model shader: both (as the
+game does), or only the front or only the back pass (models_flush) */
+enum
+{
+	_model_draw_both_sides,
+	_model_draw_front_side,
+	_model_draw_back_side
+};
+static short model_draw_sides = _model_draw_both_sides;
+
+static struct transparent_geometry_group *model_transparent_submit_now(struct shader *shader,
+	short shader_permutation_index, struct triangle_buffer const *triangle_buffer,
+	long dynamic_triangle_buffer_index, long triangle_count, struct vertex_buffer const *vertex_buffer,
+	long dynamic_vertex_buffer_index, real_point3d const *centroid, struct render_sort_filth *sort_filth);
+
+static int deferred_draw_compare(
+	void const *a,
+	void const *b)
+{
+	struct deferred_model_draw const *first = a, *second = b;
+
+	if (first->shader != second->shader)
+		return (unsigned long)first->shader < (unsigned long)second->shader ? -1 : 1;
+	if (first->shader_permutation_index != second->shader_permutation_index)
+		return first->shader_permutation_index < second->shader_permutation_index ? -1 : 1;
+	if (first->vertex_buffer != second->vertex_buffer)
+		return (unsigned long)first->vertex_buffer < (unsigned long)second->vertex_buffer ? -1 : 1;
+	if (first->triangle_buffer != second->triangle_buffer)
+		return (unsigned long)first->triangle_buffer < (unsigned long)second->triangle_buffer ? -1 : 1;
+	return first->order < second->order ? -1 : first->order > second->order ? 1 : 0;
+}
+
+/* whether a run of the same part of several objects is drawn a side at a
+time: a two-sided model shader, drawn as usual by every object */
+static boolean deferred_run_by_sides(
+	long first,
+	long end)
+{
+	struct shader *shader = deferred_draws[first].shader;
+	long index;
+
+	if (end - first < 2 || shader->base.type != _shader_type_model ||
+		!TEST_FLAG(((struct shader_model_definition *)shader)->model.flags, _shader_model_two_sided_bit))
+	{
+		return FALSE;
+	}
+	for (index = first; index < end; index++)
+	{
+		if (deferred_objects[deferred_draws[index].object].parameters.effect.type != _render_model_effect_type_none)
+			return FALSE;
+	}
+	return TRUE;
+}
+
+/* draws the kept draws, sorted. The same part of several objects comes as a
+run; a two-sided part is drawn as the front faces of every object, then the
+back faces of every object, rather than both faces object by object: the
+renderer then sees the same draw several times in a row, and draws them as
+instances (d3d8_gl.c). They are opaque, so the order does not change the
+picture. */
+static void models_flush(
+	void)
+{
+	long index, end;
+	short drawn_object = NONE;
+
+	current_deferred_object = NONE;
+	sort_statistics[1] += deferred_draw_count;
+	if (deferred_draw_count)
+	{
+		sort_statistics[2]++;
+		qsort(deferred_draws, (size_t)deferred_draw_count, sizeof(deferred_draws[0]), deferred_draw_compare);
+		for (index = 0; index < deferred_draw_count; index = end)
+		{
+			struct deferred_model_draw const *first = &deferred_draws[index];
+			short side, sides;
+			long member;
+
+			for (end = index + 1; end < deferred_draw_count && deferred_draws[end].shader == first->shader &&
+				deferred_draws[end].shader_permutation_index == first->shader_permutation_index &&
+				deferred_draws[end].vertex_buffer == first->vertex_buffer &&
+				deferred_draws[end].triangle_buffer == first->triangle_buffer; end++)
+			{
+			}
+			sides = deferred_run_by_sides(index, end) ? 2 : 1;
+			for (side = 0; side < sides; side++)
+			{
+				model_draw_sides = sides == 1 ? _model_draw_both_sides :
+					side == 0 ? _model_draw_front_side : _model_draw_back_side;
+				for (member = index; member < end; member++)
+				{
+					struct deferred_model_draw const *draw = &deferred_draws[member];
+
+					if (draw->object != drawn_object)
+					{
+						if (drawn_object != NONE)
+						{
+							model_end_now();
+						}
+						model_begin_now(&deferred_objects[draw->object].parameters,
+							deferred_objects[draw->object].do_not_change_z_stencil_states);
+						drawn_object = draw->object;
+					}
+					model_draw_now(draw->shader, draw->shader_permutation_index, draw->triangle_buffer,
+						draw->dynamic_triangle_buffer_index, draw->triangle_count, draw->vertex_buffer,
+						draw->dynamic_vertex_buffer_index);
+				}
+			}
+			model_draw_sides = _model_draw_both_sides;
+		}
+		if (drawn_object != NONE)
+		{
+			model_end_now();
+		}
+	}
+	deferred_draw_count = 0;
+	deferred_node_count = 0;
+	deferred_object_count = 0;
+	current_deferred_object = NONE;
+
+	return;
+}
+
+/* whether an object can be drawn in any order among the others */
+static boolean model_deferrable(
+	struct rasterizer_model_begin_parameters const *parameters)
+{
+	return models_deferring && !local_sky_flag &&
+		!TEST_FLAG(parameters->geometry_flags, _rasterizer_geometry_first_person_bit) &&
+		parameters->effect.type != _render_model_effect_type_modifier &&
+		!(parameters->effect.type == _render_model_effect_type_active_camouflage &&
+			parameters->effect.intensity > 0.0f);
+}
+
+void _rasterizer_model_begin(
+	struct rasterizer_model_begin_parameters const *parameters,
+	boolean do_not_change_z_stencil_states)
+{
+	if (rasterizer_debug_options.draw_models && model_deferrable(parameters) &&
+		parameters->skinning.node_matrix_count >= 0 &&
+		parameters->skinning.node_matrix_count <= DEFERRED_MODEL_NODES)
+	{
+		short node_count = parameters->skinning.node_matrices ? parameters->skinning.node_matrix_count : 0;
+
+		if (deferred_object_count == DEFERRED_MODEL_OBJECTS ||
+			deferred_node_count + node_count > DEFERRED_MODEL_NODES)
+		{
+			models_flush();
+		}
+		current_deferred_object = deferred_object_count++;
+		deferred_object_source = parameters;
+		deferred_object_do_not_change_z_stencil_states = do_not_change_z_stencil_states;
+		deferred_objects[current_deferred_object].parameters = *parameters;
+		deferred_objects[current_deferred_object].do_not_change_z_stencil_states = do_not_change_z_stencil_states;
+		if (node_count)
+		{

+		state.ticks = 30;
+		state.falling = 1;
+		vehicle.updates++;
+		CHECK(vehicle_riding_snapshot_step(&state, &vehicle, &base, 1.4f, .2f, FALSE, ANY_LIMIT, &step), "dropped");

 }
diff --git a/tools/harness/tests/fire_origins.c b/tools/harness/tests/fire_origins.c
new file mode 100644
index 00000000..ce879ce3
--- /dev/null
+++ b/tools/harness/tests/fire_origins.c
@@ -0,0 +1,98 @@
+#include "harness.h"
+#include <math.h>
+/* network_damage.c's fire origins: where a client's players' shots leave from
+when not from their units' cameras (a VR build's hand), which the host's line
+of sight check also looks from. Machine 1 has players 0 and 2, machine 2 has
+player 3; player 5 is in no game. Local players: 0 is player 0, 1 none. */
+#define MAXIMUM_TRACKED_PLAYERS 16
+#define MAXIMUM_LOCAL_PLAYERS 4
+#define csmemcpy memcpy
+#define csmemset memset
+typedef unsigned short word;
+typedef struct { short size; } message_header;
+enum { _distributed_message_fire_origins = 92 };
+enum { _distributed_to_clients, _distributed_to_host };
+static long now = 300;
+static long game_time_get(void) { return now; }
+static int players[MAXIMUM_TRACKED_PLAYERS] = { 1, 0, 1, 1 };
+static void *distributed_player(short player_index)
+{
+ return player_index >= 0 && player_index < MAXIMUM_TRACKED_PLAYERS && players[player_index] ? &players[player_index] : NULL;
+}
+static boolean distributed_machine_has_player(long machine_index, short player_index)
+{
+ return (machine_index == 1 && (player_index == 0 || player_index == 2)) || (machine_index == 2 && player_index == 3);
+}
+static long local_player_get_player_index(short local_player_index) { return local_player_index == 0 ? 0 : NONE; }
+static byte distributed_player_to_byte(long player_index) { return (byte)player_index; }
+#include "under_test.inc"
+/* what the client sent */
+static int sends, sent_type, sent_count, sent_to;
+static struct distributed_fire_origin sent[MAXIMUM_LOCAL_PLAYERS];
+static void distributed_send(void const *message, byte type, short count, unsigned short size, int to)
+{
+ sends++; sent_type = type; sent_count = count; sent_to = to;
+ memcpy(sent, (byte const *)message + sizeof(struct distributed_message_header), count * sizeof(*sent));
+ (void)size;
+}
+#include "under_test_send.inc"
+static real wanted_i = 0.25f;
+static boolean source_answer = TRUE;
+static boolean source(short local_player_index, real_vector3d *offset)
+{
+ offset->i = wanted_i; offset->j = -0.1f; offset->k = 0.05f;
+ return local_player_index == 0 && source_answer;
+}
+static void entry(struct distributed_fire_origin *origin, byte player_index, real i)
+{
+ real_vector3d offset = { i, 0.0f, 0.0f };
+ memset(origin, 0, sizeof(*origin));
+ origin->player_index = player_index;
+ distributed_vector_pack(&offset, FIRE_ORIGIN_SCALE, &origin->offset);
+}
+int main(int argc, char **argv)
+{
+ const char *case_name = argc > 1 ? argv[1] : "";
+ struct distributed_fire_origin origins[2];
+ short index;
+ for (index = 0; index < MAXIMUM_TRACKED_PLAYERS; index++)
+  damage_fire_origins[index].time = NONE;
+ CASE("own") {
+  entry(&origins[0], 2, 0.3f);
+  network_damage_handle_fire_origins(1, origins, 1);
+  CHECK(damage_fire_origins[2].time == now, "a player of the machine's own, %ld", damage_fire_origins[2].time);
+  CHECK(fabsf(damage_fire_origins[2].offset.i - 0.3f) < 0.001f, "where from, %f", damage_fire_origins[2].offset.i);
+ } else CASE("foreign") {
+  entry(&origins[0], 3, 0.3f);
+  entry(&origins[1], 5, 0.3f);
+  network_damage_handle_fire_origins(1, origins, 2);
+  CHECK(damage_fire_origins[3].time == NONE, "another machine's player");
+  CHECK(damage_fire_origins[5].time == NONE, "a player in no game");
+  entry(&origins[0], 200, 0.3f);
+  network_damage_handle_fire_origins(1, origins, 1);
+ } else CASE("reach") {
+  entry(&origins[0], 0, 0.45f);
+  entry(&origins[1], 2, 0.39f);
+  network_damage_handle_fire_origins(1, origins, 2);
+  CHECK(damage_fire_origins[0].time == NONE, "further than a player reaches");
+  CHECK(damage_fire_origins[2].time == now, "within reach");
+ } else CASE("send") {
+  network_damage_set_fire_origin_source(NULL);
+  distributed_send_fire_origins();
+  CHECK(sends == 0, "a build whose shots leave from the camera sends nothing");
+  network_damage_set_fire_origin_source(source);
+  distributed_send_fire_origins();
+  CHECK(sends == 1 && sent_type == _distributed_message_fire_origins && sent_to == _distributed_to_host,
+   "to the host, %d", sends);
+  CHECK(sent_count == 1 && sent[0].player_index == 0, "the local player's, %d", sent_count);
+  CHECK(sent[0].offset.i == (short)(0.25f * FIRE_ORIGIN_SCALE + 0.5f), "where from, %d", sent[0].offset.i);
+  source_answer = FALSE;
+  distributed_send_fire_origins();
+  CHECK(sends == 1, "none when from the camera");
+  source_answer = TRUE;
+  wanted_i = 0.5f;
+  distributed_send_fire_origins();
+  CHECK(sends == 1, "none further than a player reaches");
+ } else return 2;
+ return 0;
+}
diff --git a/tools/harness/tests/game_modes.c b/tools/harness/tests/game_modes.c
new file mode 100644
index 00000000..8dbe4fde
--- /dev/null
+++ b/tools/harness/tests/game_modes.c
@@ -0,0 +1,239 @@
+#include "harness.h"
+#include <wchar.h>
+#include "enums.inc"
+/* OpenCE's gametypes (port/linux/game/game_modes.c, infection.c, gun_game.c):
+a gametype's options kept in range, the modes each game engine and teams
+allow, Infection's round result and the state a client takes, and Gun Game's
+list of weapons. */
+typedef unsigned short word;
+#define VALID_INDEX(index, count) ((index) >= 0 && (index) < (count))
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#define NUMBEROF(array) ((long)(sizeof(array) / sizeof((array)[0])))
+#define csmemset memset
+#define HALO_PORT_MAXIMUM_NETWORK_PLAYERS 4
+#define INFECTION_MAXIMUM_SCORE 1000000
+#include "structures.inc"
+
+/* Gun Game's world: the map's weapons, the host or a client, the draw */
+static struct game_variant_options options;
+static boolean map_has[NUMBER_OF_LOADOUT_WEAPONS];
+static boolean client;
+static short draws;
+static struct { byte levels[8]; short level_count; } gun_game;
+static struct game_variant_options const *game_variant_options_get(void){return &options;}
+static long game_engine_loadout_weapon_definition(byte weapon){return map_has[weapon]?100+weapon:NONE;}
+static boolean network_game_distributed_client(void){return client;}
+/* (the draw: the first of the range each time, so each weapon from the last
+swaps with the first) */
+static short local_random_range(short lower,short upper){draws++;(void)upper;return lower;}
+/* Hardcore's world: a killer's unit, the host or a client */
+enum { _object_dead_bit = 0, _object_shield_depleted_bit, _object_shield_charging_bit };
+#define SET_FLAG(flags, bit, value) ((value) ? ((flags) |= FLAG(bit)) : ((flags) &= ~FLAG(bit)))
+struct player_datum { long unit_index; };
+struct unit_datum { struct { real body_vitality, shield_vitality, maximum_shield_vitality; long damage_flags; } object; };
+static struct player_datum killer_player = { 7 };
+static struct unit_datum killer_unit;
+static boolean hardcore=TRUE;
+static boolean game_modes_hardcore(void){return hardcore;}
+static struct player_datum *player_try_and_get(long index){return index==1?&killer_player:NULL;}
+static struct unit_datum *unit_try_and_get(long index){return index==7?&killer_unit:NULL;}
+#include "under_test.inc"
+
+static void wounded_killer(real body,real shield)
+{
+ memset(&killer_unit,0,sizeof(killer_unit));
+ killer_unit.object.body_vitality=body;killer_unit.object.shield_vitality=shield;
+ killer_unit.object.maximum_shield_vitality=1.0f;
+ SET_FLAG(killer_unit.object.damage_flags,_object_shield_depleted_bit,TRUE);
+ hardcore=TRUE;client=FALSE;
+}
+
+static void map_with_every_weapon(void)
+{
+ for(int weapon=0;weapon<NUMBER_OF_LOADOUT_WEAPONS;weapon++) map_has[weapon]=weapon>=_loadout_weapon_assault_rifle;
+}
+
+static struct distributed_infection_state valid_state(void)
+{
+ struct distributed_infection_state state;
+ memset(&state,0,sizeof(state));
+ state.game_number=3;state.revision=5;state.phase=_distributed_infection_active;state.winner=NONE;
+ state.players[0].identity=11;state.players[0].role=_distributed_infection_role_human;state.players[0].score=2;
+ state.players[1].identity=12;state.players[1].role=_distributed_infection_role_zombie;
+ return state;
+}
+
+int main(int argc,char **argv)
+{
+ const char *case_name=argc>1?argv[1]:"";
+ CASE("sanitize_defaults") {
+  /* (a gametype saved before OpenCE's: every byte 0) */
+  memset(&options,0,sizeof(options));
+  game_modes_options_sanitize(&options);
+  CHECK(options.mode==_game_mode_none&&!options.hardcore,"no mode");
+  CHECK(options.infection_initial_zombies==1&&options.infection_zombie_speed==150&&
+   options.infection_skull_damage==200&&options.infection_respawn_time==5,"Infection's defaults");
+  CHECK(options.infection_countdown==0,"a countdown of 0 is one");
+ } else CASE("options_default") {
+  memset(&options,0xAA,sizeof(options));
+  game_modes_options_default(&options);
+  CHECK(options.mode==_game_mode_none&&!options.hardcore,"no mode, not Hardcore");
+  CHECK(options.infection_countdown==10&&options.infection_zombie_shields&&options.gun_game_melee_demotes,
+   "a countdown, zombies' shields, melee demotes");
+  CHECK(options.time_limit==(short)0xAAAA,"the game type's own options left alone");
+  game_modes_options_sanitize(&options);
+  CHECK(options.infection_countdown==10&&options.infection_zombie_speed==150,"the defaults are in range");
+ } else CASE("hardcore_restore") {
+  wounded_killer(0.25f,0.0f);
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==1.0f&&killer_unit.object.shield_vitality==1.0f,"health and shields restored");
+  CHECK(!TEST_FLAG(killer_unit.object.damage_flags,_object_shield_depleted_bit),"the shields no longer depleted");
+  wounded_killer(0.5f,2.0f);
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.shield_vitality==2.0f,"an overshield kept");
+ } else CASE("hardcore_no_restore") {
+  wounded_killer(0.25f,0.0f);hardcore=FALSE;
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"not Hardcore");
+  wounded_killer(0.25f,0.0f);
+  game_modes_player_killed(1,2,TRUE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a betrayal");
+  game_modes_player_killed(1,1,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a suicide");
+  game_modes_player_killed(NONE,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"no killer");
+  client=TRUE;
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a client's copy of the kill");
+  client=FALSE;
+  SET_FLAG(killer_unit.object.damage_flags,_object_dead_bit,TRUE);
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a killer already dead");
+ } else CASE("sanitize_range") {
+  /* (another machine's, or a file's, out of range) */
+  memset(&options,0xFF,sizeof(options));
+  game_modes_options_sanitize(&options);
+  CHECK(options.mode==_game_mode_none,"an unknown mode is none");
+  CHECK(options.hardcore==TRUE&&options.infection_zombie_shields==TRUE&&options.gun_game_melee_demotes==TRUE,
+   "booleans are 0 or 1");
+  CHECK(options.infection_initial_zombies==1&&options.infection_zombie_speed==150&&options.infection_skull_damage==200&&
+   options.infection_respawn_time==5&&options.infection_countdown==10,"out of range: the defaults");
+  CHECK(options.gun_game_order==_gun_game_order_strongest_first,"an unknown order");
+  for(int index=0;index<(int)sizeof(options.reserved);index++) CHECK(options.reserved[index]==0,"reserved cleared");
+ } else CASE("sanitize_keeps") {
+  memset(&options,0,sizeof(options));
+  options.mode=_game_mode_infection;options.infection_initial_zombies=16;options.infection_zombie_speed=200;
+  options.infection_skull_damage=100;options.infection_respawn_time=30;options.infection_countdown=30;
+  options.gun_game_order=_gun_game_order_random;
+  game_modes_options_sanitize(&options);
+  CHECK(options.mode==_game_mode_infection&&options.infection_initial_zombies==16&&options.infection_zombie_speed==200&&
+   options.infection_skull_damage==100&&options.infection_respawn_time==30&&options.infection_countdown==30&&
+   options.gun_game_order==_gun_game_order_random,"values in range are kept");
+ } else CASE("variant_mode") {
+  struct game_variant variant;
+  memset(&variant,0,sizeof(variant));memset(&options,0,sizeof(options));
+  variant.game_engine_index=game_engine_slayer;
+  options.mode=_game_mode_swat;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_swat,"SWAT, free for all");
+  variant.universal_variant.teams=TRUE;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_swat,"SWAT, teams");
+  options.mode=_game_mode_infection;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_infection,"Infection on teams");
+  variant.universal_variant.teams=FALSE;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_none,"no Infection without teams");
+  options.mode=_game_mode_gun_game;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_gun_game,"Gun Game, free for all");
+  variant.universal_variant.teams=TRUE;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_none,"no Gun Game on teams");
+  variant.universal_variant.teams=FALSE;variant.game_engine_index=game_engine_ctf;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_none,"Slayer's modes only");
+  CHECK(game_modes_variant_mode(NULL,&options)==_game_mode_none&&game_modes_variant_mode(&variant,NULL)==_game_mode_none,
+   "none without a gametype");
+ } else CASE("round_result") {
+  long limit=300*30;
+  CHECK(infection_round_result(3,1,0,limit)==NONE,"humans and zombies left");
+  CHECK(infection_round_result(0,4,10,limit)==1,"no human left: the zombies");
+  CHECK(infection_round_result(2,1,limit,limit)==0,"the time out: the humans");
+  CHECK(infection_round_result(0,4,limit,limit)==1,"the last human turned as the time runs out: the zombies");
+  CHECK(infection_round_result(2,1,limit*10,0)==NONE,"no time limit");
+  CHECK(infection_round_result(3,0,10,limit)==0,"every zombie gone: the humans");
+  CHECK(infection_round_result(0,0,10,limit)==2,"everyone gone: no one");
+ } else CASE("state_valid") {
+  struct distributed_infection_state state=valid_state();
+  CHECK(infection_state_valid(&state,3,5),"a state of the game, as new");
+  CHECK(!infection_state_valid(&state,4,0),"another game's");
+  CHECK(!infection_state_valid(&state,3,6),"older than the client's");
+  state=valid_state();state.phase=_distributed_infection_finished+1;
+  CHECK(!infection_state_valid(&state,3,0),"an unknown phase");
+  state=valid_state();state.winner=1;
+  CHECK(!infection_state_valid(&state,3,0),"a winner before the round is over");
+  state.phase=_distributed_infection_finished;
+  CHECK(infection_state_valid(&state,3,0),"a winner after");
+  state.winner=2;
+  CHECK(!infection_state_valid(&state,3,0),"no third side");
+  state=valid_state();state.players[2].role=_distributed_infection_role_zombie+1;
+  CHECK(!infection_state_valid(&state,3,0),"an unknown role");
+  state=valid_state();state.players[2].role=_distributed_infection_role_human;
+  CHECK(!infection_state_valid(&state,3,0),"a role with no player");
+  state=valid_state();state.players[0].score=-1;
+  CHECK(!infection_state_valid(&state,3,0),"a negative score");
+  state=valid_state();state.players[0].score=INFECTION_MAXIMUM_SCORE+1;
+  CHECK(!infection_state_valid(&state,3,0),"a score too large");
+  state=valid_state();state.players[1].reserved[1]=1;
+  CHECK(!infection_state_valid(&state,3,0),"reserved bytes set");
+ } else CASE("gun_game_order") {
+  map_with_every_weapon();memset(&options,0,sizeof(options));
+  options.gun_game_order=_gun_game_order_strongest_first;
+  gun_game_levels_build();
+  CHECK(gun_game.level_count==8,"every weapon: %d",gun_game.level_count);
+  CHECK(gun_game.levels[0]==_loadout_weapon_rocket_launcher&&gun_game.levels[7]==_loadout_weapon_pistol,
+   "the rocket launcher first, the pistol last");
+  options.gun_game_order=_gun_game_order_weakest_first;
+  gun_game_levels_build();
+  CHECK(gun_game.levels[0]==_loadout_weapon_pistol&&gun_game.levels[7]==_loadout_weapon_rocket_launcher,
+   "the pistol first");
+ } else CASE("gun_game_missing") {
+  map_with_every_weapon();memset(&options,0,sizeof(options));
+  map_has[_loadout_weapon_shotgun]=FALSE;map_has[_loadout_weapon_needler]=FALSE;
+  gun_game_levels_build();
+  CHECK(gun_game.level_count==6,"the map's weapons only: %d",gun_game.level_count);
+  for(int level=0;level<gun_game.level_count;level++)
+   CHECK(gun_game.levels[level]!=_loadout_weapon_shotgun&&gun_game.levels[level]!=_loadout_weapon_needler,"none missing");
+ } else CASE("gun_game_random") {
+  map_with_every_weapon();memset(&options,0,sizeof(options));
+  options.gun_game_order=_gun_game_order_random;draws=0;
+  gun_game_levels_build();
+  CHECK(draws==7&&gun_game.level_count==8,"the host draws the order");
+  CHECK(gun_game.levels[0]!=_loadout_weapon_rocket_launcher,"in another order");
+  client=TRUE;draws=0;
+  gun_game_levels_build();
+  CHECK(draws==0&&gun_game.level_count==8,"a client draws nothing, its list as long");
+  client=FALSE;
+ } else CASE("kind") {
+  struct game_variant variant;
+  memset(&variant,0,sizeof(variant));memset(&options,0,sizeof(options));
+  variant.game_engine_index=game_engine_slayer;variant.universal_variant.teams=TRUE;
+  CHECK(game_modes_kind(&variant,&options)==0,"a stock gametype has no kind");
+  CHECK(game_modes_kind_name(game_engine_slayer,0,TRUE)==NULL,"named by its engine");
+  options.mode=_game_mode_infection;options.hardcore=TRUE;
+  CHECK(game_modes_kind(&variant,&options)==(_game_mode_infection|0x80),"Infection, Hardcore");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_slayer,game_modes_kind(&variant,&options),FALSE),
+   L"HARDCORE INFECTION"),"in full");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_slayer,game_modes_kind(&variant,&options),TRUE),L"HC INFECTION"),
+   "abbreviated");
+  options.mode=_game_mode_gun_game;
+  CHECK(game_modes_kind(&variant,&options)==0x80,"a mode the teams do not allow is none");
+  variant.game_engine_index=game_engine_ctf;options.mode=_game_mode_none;
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_ctf,game_modes_kind(&variant,&options),TRUE),L"HC CTF"),"HC CTF");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_slayer,_game_mode_swat,TRUE),L"SWAT"),"SWAT");
+ } else CASE("kind_untrusted") {
+  CHECK(game_modes_kind_name(game_engine_ctf,_game_mode_swat,TRUE)==NULL,"a mode of CTF is none");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_oddball,_game_mode_infection|0x80,TRUE),L"HC ODDBALL"),
+   "Hardcore kept, the mode not");
+  CHECK(game_modes_kind_name(game_engine_slayer,0x7F,TRUE)==NULL,"a mode this build does not know");
+  CHECK(game_modes_kind_name(game_engine_none,0x80,TRUE)==NULL,"no engine (co-op)");
+  CHECK(game_modes_kind_name(99,0x80,TRUE)==NULL,"an engine this build does not know");
+ } else return 2;
+ return 0;
+}
diff --git a/tools/harness/tests/gun_game_weapon_empty.c b/tools/harness/tests/gun_game_weapon_empty.c
new file mode 100644
index 00000000..e0f7a67b
--- /dev/null
+++ b/tools/harness/tests/gun_game_weapon_empty.c
@@ -0,0 +1,98 @@
+/*
+GUN_GAME_WEAPON_EMPTY.C (test)
+
+The real gun_game_weapon_empty (port/linux/game/gun_game.c): Gun Game gives a
+player a new weapon of their level when theirs is spent. Halo CE's plasma
+rifle and plasma pistol have a magazine block that holds no rounds (every
+count 0: they run on a battery), so a check that looks only at the
+magazines takes them for spent from the start, and gun_game_equip replaces
+them on every update: they never fire. Weapons here are a plasma rifle (one
+magazine holding nothing), a pistol (12 loaded, 120 carried at most) and a
+weapon with no magazines at all. test_gun_game_weapon_empty.py takes the
+code (under_test.inc).
+*/
+
+#include "harness.h"
+
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define NUMBEROF(array) ((long)(sizeof(array) / sizeof((array)[0])))
+
+struct tag_block { long count; void *address; };
+struct weapon_magazine_definition { short rounds_total_maximum; short rounds_loaded_maximum; };
+struct weapon_definition { struct { struct tag_block magazines; } weapon; };
+struct weapon_magazine { short rounds_total; short rounds_loaded; };
+struct weapon_datum
+{
+	long definition_index;
+	struct { real age; struct weapon_magazine magazines[2]; } weapon;
+};
+
+enum { PLASMA_RIFLE, PISTOL, NO_MAGAZINES, NUMBER_OF_DEFINITIONS };
+
+static struct weapon_magazine_definition battery_magazine = { 0, 0 };
+static struct weapon_magazine_definition pistol_magazine = { 120, 12 };
+static struct weapon_definition definitions[NUMBER_OF_DEFINITIONS] =
+{
+	{ { { 1, &battery_magazine } } },
+	{ { { 1, &pistol_magazine } } },
+	{ { { 0, NULL } } },
+};
+static struct weapon_datum held;
+
+#define weapon_try_and_get(index) ((index) == NONE ? NULL : &held)
+#define weapon_definition_get(index) (&definitions[index])
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) (&((type *)(block)->address)[index])
+
+#include "under_test.inc"
+
+static void hold(long definition_index, real age, short loaded, short total)
+{
+	memset(&held, 0, sizeof(held));
+	held.definition_index = definition_index;
+	held.weapon.age = age;
+	held.weapon.magazines[0].rounds_loaded = loaded;
+	held.weapon.magazines[0].rounds_total = total;
+}
+
+int main(int argc, char **argv)
+{
+	const char *case_name = argc > 1 ? argv[1] : "";
+
+	CASE("battery-full")
+	{
+		/* a plasma rifle as it is given: its magazine block holds nothing, its battery is full */
+		hold(PLASMA_RIFLE, 0.0f, 0, 0);
+		CHECK(!gun_game_weapon_empty(0), "a full plasma rifle is taken for spent");
+		hold(PLASMA_RIFLE, 0.6f, 0, 0);
+		CHECK(!gun_game_weapon_empty(0), "a plasma rifle with battery left is taken for spent");
+		return 0;
+	}
+	CASE("battery-spent")
+	{
+		hold(PLASMA_RIFLE, 1.0f, 0, 0);
+		CHECK(gun_game_weapon_empty(0), "a plasma rifle with a dead battery is not spent");
+		return 0;
+	}
+	CASE("rounds")
+	{
+		/* a weapon whose magazine holds rounds: spent when none is loaded or carried, whatever its age */
+		hold(PISTOL, 0.0f, 5, 0);
+		CHECK(!gun_game_weapon_empty(0), "a pistol with rounds loaded is taken for spent");
+		hold(PISTOL, 0.0f, 0, 24);
+		CHECK(!gun_game_weapon_empty(0), "a pistol with rounds carried is taken for spent");
+		hold(PISTOL, 0.0f, 0, 0);
+		CHECK(gun_game_weapon_empty(0), "a dry pistol is not spent");
+		return 0;
+	}
+	CASE("no-magazines")
+	{
+		hold(NO_MAGAZINES, 0.5f, 0, 0);
+		CHECK(!gun_game_weapon_empty(0), "a weapon without magazines, battery left, is taken for spent");
+		hold(NO_MAGAZINES, 1.0f, 0, 0);
+		CHECK(gun_game_weapon_empty(0), "a weapon without magazines and a dead battery is not spent");
+		CHECK(!gun_game_weapon_empty(NONE), "no weapon is taken for a spent one");
+		return 0;
+	}
+	fprintf(stderr, "no case %s\n", case_name);
+	return 2;
+}
diff --git a/tools/harness/tests/lobby_intake.c b/tools/harness/tests/lobby_intake.c
new file mode 100644
index 00000000..37f096e1
--- /dev/null
+++ b/tools/harness/tests/lobby_intake.c
@@ -0,0 +1,108 @@
+#include "harness.h"
+
+/* The server browser's intake (port/linux/src/p2p_lobby.c, listing_wanted):
+which listings heard take a place in the queue, and a broker's burst on
+subscribing (its kept slots, most of them games long gone) leaving every live
+game a place */
+#include "config.inc"
+#include "under_test.inc"
+
+/* a listing as a host makes it (listing_make), its signature zeroes: the
+intake does not check it */
+static int make(unsigned char *bytes, int version, int flags, long age)
+{
+	int size = 0;
+	unsigned long when = (unsigned long)(time(NULL) - age);
+	const char *texts[3] = { "a game", "bloodgulch", "slayer" };
+	int text;
+
+	bytes[size++] = 'H';
+	bytes[size++] = 'L';
+	bytes[size++] = LISTING_FORMAT;
+	bytes[size++] = (unsigned char)(version >> 8);
+	bytes[size++] = (unsigned char)version;
+	bytes[size++] = (unsigned char)flags;
+	memset(bytes + size, 0, 4);
+	size += 4;
+	bytes[size++] = (unsigned char)(when >> 24);
+	bytes[size++] = (unsigned char)(when >> 16);
+	bytes[size++] = (unsigned char)(when >> 8);
+	bytes[size++] = (unsigned char)when;
+	memset(bytes + size, 7, P2P_KEY_SIZE);
+	size += P2P_KEY_SIZE;
+	memset(bytes + size, 9, P2P_TOKEN_SIZE);
+	size += P2P_TOKEN_SIZE;
+	bytes[size++] = 1;
+	bytes[size++] = 16;
+	bytes[size++] = 2;
+	for (text = 0; text < 3; text++)
+	{
+		int length = (int)strlen(texts[text]);
+
+		bytes[size++] = (unsigned char)length;
+		memcpy(bytes + size, texts[text], (size_t)length);
+		size += length;
+	}
+	memset(bytes + size, 0, STAMP_SIZE + P2P_SIGNATURE_SIZE);
+	return size + STAMP_SIZE + P2P_SIGNATURE_SIZE;
+}
+
+static int wanted(int version, int flags, long age, int retained)
+{
+	unsigned char bytes[MAXIMUM_LISTING_SIZE];
+	int size = make(bytes, version, flags, age);
+
+	return listing_wanted(bytes, size, retained);
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc == 2 ? argv[1] : "";
+	const int current = HALO_PORT_NETWORK_VERSION;
+
+	CASE("filter")
+	{
+		CHECK(wanted(current, _listing_open, 0, 0), "a live game of this version");
+		CHECK(wanted(current, _listing_open, 120, 1), "a kept slot of two minutes ago");
+		CHECK(wanted(current, _listing_closed, 60, 1), "a host's recent tombstone (it ends a game)");
+		CHECK(!wanted(current, _listing_open, RETAINED_WINDOW + 60, 1), "a kept slot of a game long gone");
+		/* (the port takes a live listing whatever its time, as before) */
+		CHECK(wanted(current, _listing_open, 2 * RETAINED_WINDOW, 0), "a live listing, its host's clock behind");
+		CHECK(!wanted(current - 1, _listing_open, 0, 0), "an older version's");
+		CHECK(!wanted(current + 1, _listing_open, 0, 0), "a newer version's");
+		CHECK(!listing_wanted((const unsigned char *)"HL", 2, 0), "a short message");
+	}
+	else CASE("burst")
+	{
+		/* a public broker's kept slots, as test.mosquitto.org sent them on
+		2026-10-24 (about 1,450, some 70 live): this version's games long
+		gone, older versions' hosts still running and long gone, a few
+		newer ones; the live games spread among them */
+		int heard, queued = 0, live_queued = 0;
+
+		for (heard = 0; heard < 1470; heard++)
+		{
+			int live = heard % 21 == 20;
+			int is_wanted;
+
+			if (live)
+				is_wanted = wanted(current, _listing_open, heard % 7, 1);
+			else if (heard % 3 == 0)
+				is_wanted = wanted(current, _listing_open, 86400 * (1 + heard % 30), 1);
+			else if (heard % 3 == 1)
+				is_wanted = wanted(current - 1 - heard % 20, _listing_open, heard % 2 ? 30 : 86400, 1);
+			else
+				is_wanted = wanted(heard % 50 ? current - 3 : current + 1, _listing_open, 5, 1);
+			if (is_wanted && queued < MAXIMUM_QUEUED)
+			{
+				queued++;
+				live_queued += live;
+			}
+		}
+		CHECK(live_queued == 70, "%d of the 70 live games had a place in the queue (%d places taken)",
+			live_queued, queued);
+	}
+	else
+		return 2;
+	return 0;
+}
diff --git a/tools/harness/tests/retried_inventories.c b/tools/harness/tests/retried_inventories.c
new file mode 100644
index 00000000..384b411d
--- /dev/null
+++ b/tools/harness/tests/retried_inventories.c
@@ -0,0 +1,256 @@
+#include "harness.h"
+#include <math.h>
+
+typedef unsigned short word;
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#include "config.inc"
+
+/* A client's world: the host's objects, each here or not yet (the stream
+makes them, and can trail the host's inventories, which go as datagrams);
+units that carry weapons of one magazine. */
+#define OBJECT_COUNT 256
+#define OBJECT(n) (0x10000L | (n))
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) (&((type *)(block)->address)[index])
+struct tag_block { long count; void *address; };
+struct weapon_magazine_definition { short rounds_total_initial, rounds_total_maximum, rounds_loaded_maximum; };
+struct weapon_definition { struct { struct tag_block magazines; } weapon; };
+struct weapon_magazine { short rounds_total, rounds_loaded; };
+struct weapon_datum { long definition_index; struct { struct weapon_magazine magazines[2]; real age; } weapon; };
+struct unit_datum
+{
+	struct { unsigned long damage_flags; } object;
+	struct
+	{
+		long player_index;
+		long weapon_object_indices[MAXIMUM_WEAPONS_PER_UNIT];
+		short current_weapon_index, desired_weapon_index;
+		char grenade_counts[NUMBER_OF_UNIT_GRENADE_TYPES];
+		short grenade_throw_state, current_grenade_index, desired_grenade_index;
+	} unit;
+};
+struct player_datum { short local_player_index; };
+static struct { boolean here; short type; } objects[OBJECT_COUNT];
+static struct unit_datum units[OBJECT_COUNT];
+static struct weapon_datum weapons[OBJECT_COUNT];
+static struct weapon_magazine_definition magazine_definition = {0, 500, 100};
+static struct weapon_definition weapon_definition = {{{1, &magazine_definition}}};
+static struct player_datum player;
+static long now;
+
+static boolean here(long index)
+{
+	return index != NONE && (index >> 16) == 1 && (index & 0xFFFF) < OBJECT_COUNT && objects[index & 0xFFFF].here;
+}
+static boolean network_objects_client_has(long index) { return here(index); }
+static void *object_try_and_get_and_verify_type(long index, unsigned long mask)
+{
+	if (!here(index) || !TEST_FLAG(mask, objects[index & 0xFFFF].type))
+		return NULL;
+	return objects[index & 0xFFFF].type == _object_type_weapon ? (void *)&weapons[index & 0xFFFF] : (void *)&units[index & 0xFFFF];
+}
+static struct unit_datum *unit_get(long index)
+{
+	CHECK(object_try_and_get_and_verify_type(index, _object_mask_unit), "not a unit here: %lx", index);
+	return &units[index & 0xFFFF];
+}
+static struct weapon_datum *weapon_try_and_get(long index) { return object_try_and_get_and_verify_type(index, _object_mask_weapon); }
+static struct weapon_definition *weapon_definition_get(long index) { return &weapon_definition; }
+static long game_time_get(void) { return now; }
+static struct player_datum *player_get(long index) { return &player; }
+static boolean distributed_player_is_local(long player_index) { return FALSE; }
+static boolean distributed_client_own_settled(long time) { return TRUE; }
+static void distributed_client_release_item(long index, boolean dropped) {}
+static void unit_network_drop_weapon(long unit_index, short slot) { unit_get(unit_index)->unit.weapon_object_indices[slot] = NONE; }
+static void unit_network_add_weapon(long unit_index, long weapon_index, short slot)
+{
+	unit_get(unit_index)->unit.weapon_object_indices[slot] = weapon_index;
+}
+struct distributed_own_inventory;
+static void distributed_client_note_own_inventory(struct distributed_own_inventory *own, long unit_index, boolean compare) {}
+#include "under_test.inc"
+
+/* the stream makes one of the host's objects here: a unit carrying nothing,
+or a weapon */
+static void arrive(long index, short type)
+{
+	struct unit_datum *unit = &units[index & 0xFFFF];
+	short slot;
+
+	objects[index & 0xFFFF].here = TRUE;
+	objects[index & 0xFFFF].type = type;
+	memset(unit, 0, sizeof(*unit));
+	unit->unit.player_index = NONE;
+	unit->unit.current_weapon_index = NONE;
+	unit->unit.current_grenade_index = NONE;
+	for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+		unit->unit.weapon_object_indices[slot] = NONE;
+}
+
+/* the host's inventory of a unit carrying two weapons (NONE: none) */
+static struct distributed_inventory carrying(long unit_index, long first, long second, char grenades)
+{
+	struct distributed_inventory inventory;
+	short slot;
+
+	memset(&inventory, 0, sizeof(inventory));
+	inventory.unit_index = unit_index;
+	inventory.grenade_counts[0] = grenades;
+	inventory.current_weapon_index = 0;
+	for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+	{
+		inventory.weapon_indices[slot] = slot == 0 ? first : slot == 1 ? second : NONE;
+		inventory.rounds_total[slot][0] = (short)(100 * (slot + 1));
+		inventory.rounds_loaded[slot][0] = (short)(10 * (slot + 1));
+	}
+	return inventory;
+}
+
+/* the host's inventory comes, as network_objects_handle_inventories takes it */
+static void receive(struct distributed_inventory inventory)
+{
+	distributed_client_apply_inventory(&inventory);
+}
+
+static boolean kept(long unit_index)
+{
+	short index;
+
+	for (index = 0; index < objects_client_retried_inventory_count; index++)
+	{
+		if (objects_client_retried_inventories[index].inventory.unit_index == unit_index)
+			return TRUE;
+	}
+	return FALSE;
+}
+
+static long held(long unit_index, short slot) { return unit_get(unit_index)->unit.weapon_object_indices[slot]; }
+
+static void reset(void)
+{
+	memset(objects, 0, sizeof(objects));
+	memset(&player, 0, sizeof(player));
+	memset(objects_client_retried_inventories, 0, sizeof(objects_client_retried_inventories));
+	objects_client_retried_inventory_count = 0;
+	now = 1000;
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argv[1];
+	long unit = OBJECT(1), first = OBJECT(2), second = OBJECT(3);
+	short index;
+
+	reset();
+	/* a player spawned: its inventory comes before its unit and its weapon,
+	is kept, and is applied in full the tick they have all come */
+	CASE("unit-late")
+	{
+		receive(carrying(unit, first, NONE, 3));
+		CHECK(kept(unit) && objects_client_retried_inventory_count == 1, "unit-late: not kept");
+		arrive(first, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(kept(unit), "unit-late: let go of before its unit came");
+		arrive(unit, _object_type_biped);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(held(unit, 0) == first, "unit-late: its weapon not given once it came");
+		CHECK(units[1].unit.grenade_counts[0] == 3 && weapons[2].weapon.magazines[0].rounds_total == 100 &&
+			weapons[2].weapon.magazines[0].rounds_loaded == 10, "unit-late: its grenades or rounds not given");
+		CHECK(!kept(unit) && objects_client_retried_inventory_count == 0, "unit-late: kept once applied");
+	}
+	/* its unit here, one of its weapons not: what is here is given at once,
+	the rest once it comes */
+	CASE("weapon-late")
+	{
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		receive(carrying(unit, first, second, 2));
+		CHECK(held(unit, 0) == first && held(unit, 1) == NONE, "weapon-late: what is here not given at once");
+		CHECK(kept(unit), "weapon-late: not kept for the weapon to come");
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(kept(unit) && held(unit, 1) == NONE, "weapon-late: applied before its weapon came");
+		arrive(second, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(held(unit, 1) == second && weapons[3].weapon.magazines[0].rounds_total == 200,
+			"weapon-late: the weapon not given once it came");
+		CHECK(!kept(unit), "weapon-late: kept once applied");
+	}
+	/* a unit's newer inventory takes its older one's place */
+	CASE("newest")
+	{
+		receive(carrying(unit, first, NONE, 1));
+		now++;
+		receive(carrying(unit, first, NONE, 4));
+		CHECK(objects_client_retried_inventory_count == 1, "newest: %d kept of one unit", objects_client_retried_inventory_count);
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(units[1].unit.grenade_counts[0] == 4, "newest: not the newest applied");
+	}
+	/* the list full: one more takes the oldest's place, and a kept unit's
+	newer one its own */
+	CASE("full")
+	{
+		for (index = 0; index < MAXIMUM_CLIENT_RETRIED_INVENTORIES; index++)
+		{
+			now++;
+			receive(carrying(OBJECT(17 + index), NONE, NONE, 1));
+		}
+		CHECK(objects_client_retried_inventory_count == MAXIMUM_CLIENT_RETRIED_INVENTORIES,
+			"full: %d kept of %d", objects_client_retried_inventory_count, MAXIMUM_CLIENT_RETRIED_INVENTORIES);
+		now++;
+		receive(carrying(OBJECT(200), NONE, NONE, 1));
+		CHECK(!kept(OBJECT(17)) && kept(OBJECT(18)) && kept(OBJECT(200)), "full: not the oldest's place taken");
+		now++;
+		receive(carrying(OBJECT(201), NONE, NONE, 1));
+		CHECK(!kept(OBJECT(18)) && kept(OBJECT(19)) && kept(OBJECT(201)), "full: not the next oldest's taken");
+		now++;
+		receive(carrying(OBJECT(19), NONE, NONE, 2));
+		CHECK(kept(OBJECT(19)) && kept(OBJECT(20)), "full: a kept unit's newer one took another's place");
+		CHECK(objects_client_retried_inventory_count == MAXIMUM_CLIENT_RETRIED_INVENTORIES, "full: %d kept",
+			objects_client_retried_inventory_count);
+	}
+	/* a unit's whole inventory, come once all it names is here: its kept one
+	is let go of, and never applied over it */
+	CASE("forget")
+	{
+		long other = OBJECT(6);
+
+		receive(carrying(unit, first, NONE, 1));
+		receive(carrying(other, NONE, NONE, 1));
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		receive(carrying(unit, first, NONE, 5));
+		CHECK(!kept(unit) && kept(other) && objects_client_retried_inventory_count == 1, "forget: not let go of");
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(units[1].unit.grenade_counts[0] == 5, "forget: the older applied over the newer");
+	}
+	/* let go of EMPTY_INVENTORY_TICKS after the newest of its unit's came,
+	and not applied when its unit comes after */
+	CASE("expiry")
+	{
+		long newest = now + EMPTY_INVENTORY_TICKS / 2;
+
+		receive(carrying(unit, first, NONE, 1));
+		now = newest;
+		receive(carrying(unit, first, NONE, 1));
+		now = newest + EMPTY_INVENTORY_TICKS - 1;
+		distributed_client_apply_retried_inventories();
+		CHECK(kept(unit), "expiry: let go of %d ticks after the newest", EMPTY_INVENTORY_TICKS - 1);
+		now = newest + EMPTY_INVENTORY_TICKS;
+		distributed_client_apply_retried_inventories();
+		CHECK(!kept(unit), "expiry: kept %d ticks after the newest", EMPTY_INVENTORY_TICKS);
+		arrive(unit, _object_type_biped);
+		arrive(first, _object_type_weapon);
+		now++;
+		distributed_client_apply_retried_inventories();
+		CHECK(held(unit, 0) == NONE, "expiry: applied after it was let go of");
+	}
+	return 0;
+}
diff --git a/tools/harness/tests/shield_effects.c b/tools/harness/tests/shield_effects.c
new file mode 100644
index 00000000..e1a8f369
--- /dev/null
+++ b/tools/harness/tests/shield_effects.c
@@ -0,0 +1,76 @@
+#include "harness.h"
+#include "enums.inc"
+/* The shield effects of a network game (port/linux/game/network_shield_effects.c):
+the host's choice for every machine, read from network.shield_effects, or
+"players", each machine's own settings; the host's message a client takes,
+checked whole. */
+typedef unsigned short word;
+typedef word message_header;
+#define GET_MESSAGE_TYPE(message) (((message) >> 2) & 3)
+struct distributed_message_header { message_header header; byte type; byte count; long game_time; };
+static char const *setting = "stock";
+static unsigned long changes = 1;
+static short connection = _game_connection_local;
+static boolean unreliable;
+static char const *config_string(char const *name){(void)name;return setting;}
+static unsigned long config_changes(void){return changes;}
+static short game_connection(void){return connection;}
+static boolean network_connection_last_read_was_unreliable(void){return unreliable;}
+#include "under_test.inc"
+
+/* the host's message, as shield_effects_message_make makes it, from the host's stream */
+static struct shield_effects_message message_of(word effects)
+{
+ struct shield_effects_message message;
+ memset(&message,0,sizeof(message));
+ message.header.header=2<<2;message.header.type=_distributed_message_shield_effects;message.header.count=1;
+ message.effects=effects;
+ return message;
+}
+
+static void take(struct shield_effects_message message)
+{
+ network_shield_effects_handle_message(NONE,(word const *)&message,sizeof(message));
+}
+
+int main(int argc,char **argv)
+{
+ const char *case_name=argc>1?argv[1]:"";
+ CASE("offline") {
+  setting="light_show";changes++;
+  CHECK(network_shield_effects()==NONE,"offline: each player's own settings");
+ } else CASE("host") {
+  connection=_game_connection_network_server;
+  setting="stock";changes++;
+  CHECK(network_shield_effects()==_shield_effects_stock,"the default: stock, for everyone");
+  setting="light_show_overshield";changes++;
+  CHECK(network_shield_effects()==_shield_effects_light_show_overshield,"the host's choice");
+  setting="players";changes++;
+  CHECK(network_shield_effects()==NONE,"players: the host draws its own settings'");
+  setting="nonsense";changes++;
+  CHECK(network_shield_effects()==_shield_effects_stock,"an unknown value: stock");
+ } else CASE("client") {
+  connection=_game_connection_network_client;
+  network_shield_effects_reset();
+  CHECK(network_shield_effects()==_shield_effects_stock,"stock until the host's choice arrives");
+  take(message_of(_shield_effects_glow));
+  CHECK(network_shield_effects()==_shield_effects_glow,"the host's choice");
+  take(message_of(_shield_effects_players));
+  CHECK(network_shield_effects()==NONE,"players: the client draws its own settings'");
+ } else CASE("client_untrusted") {
+  struct shield_effects_message message;
+  connection=_game_connection_network_client;
+  network_shield_effects_reset();
+  take(message_of(_shield_effects_glow));
+  take(message_of(NUMBER_OF_SHIELD_EFFECTS));
+  CHECK(network_shield_effects()==_shield_effects_glow,"a value past the last refused");
+  message=message_of(_shield_effects_players);message.reserved=1;take(message);
+  CHECK(network_shield_effects()==_shield_effects_glow,"reserved bytes set refused");
+  unreliable=TRUE;take(message_of(_shield_effects_players));unreliable=FALSE;
+  CHECK(network_shield_effects()==_shield_effects_glow,"an unreliable read refused");
+  message=message_of(_shield_effects_players);
+  network_shield_effects_handle_message(3,(word const *)&message,sizeof(message));
+  CHECK(network_shield_effects()==_shield_effects_glow,"another machine than the host refused");
+ } else return 2;
+ return 0;
+}
diff --git a/tools/harness/tests/stale_player_damage.c b/tools/harness/tests/stale_player_damage.c
index 22eadb79..ea0aee8b 100644
--- a/tools/harness/tests/stale_player_damage.c
+++ b/tools/harness/tests/stale_player_damage.c
@@ -71,6 +71,8 @@ static boolean distributed_damage_is_recoil(struct damage_data const *damage, lo
 static void damage_replay_player_effect(long index, struct damage_data *damage, real amount) { }
 static boolean network_objects_client_has(long index) { return TRUE; }
 static boolean static_target(long index) { return FALSE; }
+/* (no static targets here, so no damage is one's own: test_static_target) */
+static boolean static_target_damage(struct damage_data const *damage) { return FALSE; }
 static void distributed_damage_from_data(struct damage_data const *damage, struct damage_data *result) { *result = *damage; }
 static void object_get_origin(long index, real_point3d *point) { memset(point, 0, sizeof(*point)); }

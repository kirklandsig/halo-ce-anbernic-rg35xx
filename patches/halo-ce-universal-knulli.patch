+		memset(&rays, 0, sizeof(rays));
+		rays.valid = TRUE;
+		rays.ceiling = TRUE;
+		rays.ceiling_distance = .8f;
+		rays.floor = TRUE;
+		rays.floor_distance = .3f;
+		CHECK(vehicle_riding_cabin_hit(&rays, 1.f, .6f), "a roof within a jump over a floor: open");

+++ b/tools/harness/tests/game_modes.c
@@ -0,0 +1,239 @@
+#include "harness.h"
+#include <wchar.h>
+#include "enums.inc"
+/* OpenCE's gametypes (port/linux/game/game_modes.c, infection.c, gun_game.c):
+a gametype's options kept in range, the modes each game engine and teams
+allow, Infection's round result and the state a client takes, and Gun Game's
+list of weapons. */
+typedef unsigned short word;
+#define VALID_INDEX(index, count) ((index) >= 0 && (index) < (count))
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#define NUMBEROF(array) ((long)(sizeof(array) / sizeof((array)[0])))
+#define csmemset memset
+#define HALO_PORT_MAXIMUM_NETWORK_PLAYERS 4
+#define INFECTION_MAXIMUM_SCORE 1000000
+#include "structures.inc"
+
+/* Gun Game's world: the map's weapons, the host or a client, the draw */
+static struct game_variant_options options;
+static boolean map_has[NUMBER_OF_LOADOUT_WEAPONS];
+static boolean client;
+static short draws;
+static struct { byte levels[8]; short level_count; } gun_game;
+static struct game_variant_options const *game_variant_options_get(void){return &options;}
+static long game_engine_loadout_weapon_definition(byte weapon){return map_has[weapon]?100+weapon:NONE;}
+static boolean network_game_distributed_client(void){return client;}
+/* (the draw: the first of the range each time, so each weapon from the last
+swaps with the first) */
+static short local_random_range(short lower,short upper){draws++;(void)upper;return lower;}
+/* Hardcore's world: a killer's unit, the host or a client */
+enum { _object_dead_bit = 0, _object_shield_depleted_bit, _object_shield_charging_bit };
+#define SET_FLAG(flags, bit, value) ((value) ? ((flags) |= FLAG(bit)) : ((flags) &= ~FLAG(bit)))
+struct player_datum { long unit_index; };
+struct unit_datum { struct { real body_vitality, shield_vitality, maximum_shield_vitality; long damage_flags; } object; };
+static struct player_datum killer_player = { 7 };
+static struct unit_datum killer_unit;
+static boolean hardcore=TRUE;
+static boolean game_modes_hardcore(void){return hardcore;}
+static struct player_datum *player_try_and_get(long index){return index==1?&killer_player:NULL;}
+static struct unit_datum *unit_try_and_get(long index){return index==7?&killer_unit:NULL;}
+#include "under_test.inc"
+
+static void wounded_killer(real body,real shield)
+{
+ memset(&killer_unit,0,sizeof(killer_unit));
+ killer_unit.object.body_vitality=body;killer_unit.object.shield_vitality=shield;
+ killer_unit.object.maximum_shield_vitality=1.0f;
+ SET_FLAG(killer_unit.object.damage_flags,_object_shield_depleted_bit,TRUE);
+ hardcore=TRUE;client=FALSE;
+}
+
+static void map_with_every_weapon(void)
+{
+ for(int weapon=0;weapon<NUMBER_OF_LOADOUT_WEAPONS;weapon++) map_has[weapon]=weapon>=_loadout_weapon_assault_rifle;
+}
+
+static struct distributed_infection_state valid_state(void)
+{
+ struct distributed_infection_state state;
+ memset(&state,0,sizeof(state));
+ state.game_number=3;state.revision=5;state.phase=_distributed_infection_active;state.winner=NONE;
+ state.players[0].identity=11;state.players[0].role=_distributed_infection_role_human;state.players[0].score=2;
+ state.players[1].identity=12;state.players[1].role=_distributed_infection_role_zombie;
+ return state;
+}
+
+int main(int argc,char **argv)
+{
+ const char *case_name=argc>1?argv[1]:"";
+ CASE("sanitize_defaults") {
+  /* (a gametype saved before OpenCE's: every byte 0) */
+  memset(&options,0,sizeof(options));
+  game_modes_options_sanitize(&options);
+  CHECK(options.mode==_game_mode_none&&!options.hardcore,"no mode");
+  CHECK(options.infection_initial_zombies==1&&options.infection_zombie_speed==150&&
+   options.infection_skull_damage==200&&options.infection_respawn_time==5,"Infection's defaults");
+  CHECK(options.infection_countdown==0,"a countdown of 0 is one");
+ } else CASE("options_default") {
+  memset(&options,0xAA,sizeof(options));
+  game_modes_options_default(&options);
+  CHECK(options.mode==_game_mode_none&&!options.hardcore,"no mode, not Hardcore");
+  CHECK(options.infection_countdown==10&&options.infection_zombie_shields&&options.gun_game_melee_demotes,
+   "a countdown, zombies' shields, melee demotes");
+  CHECK(options.time_limit==(short)0xAAAA,"the game type's own options left alone");
+  game_modes_options_sanitize(&options);
+  CHECK(options.infection_countdown==10&&options.infection_zombie_speed==150,"the defaults are in range");
+ } else CASE("hardcore_restore") {
+  wounded_killer(0.25f,0.0f);
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==1.0f&&killer_unit.object.shield_vitality==1.0f,"health and shields restored");
+  CHECK(!TEST_FLAG(killer_unit.object.damage_flags,_object_shield_depleted_bit),"the shields no longer depleted");
+  wounded_killer(0.5f,2.0f);
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.shield_vitality==2.0f,"an overshield kept");
+ } else CASE("hardcore_no_restore") {
+  wounded_killer(0.25f,0.0f);hardcore=FALSE;
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"not Hardcore");
+  wounded_killer(0.25f,0.0f);
+  game_modes_player_killed(1,2,TRUE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a betrayal");
+  game_modes_player_killed(1,1,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a suicide");
+  game_modes_player_killed(NONE,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"no killer");
+  client=TRUE;
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a client's copy of the kill");
+  client=FALSE;
+  SET_FLAG(killer_unit.object.damage_flags,_object_dead_bit,TRUE);
+  game_modes_player_killed(1,2,FALSE);
+  CHECK(killer_unit.object.body_vitality==0.25f,"a killer already dead");
+ } else CASE("sanitize_range") {
+  /* (another machine's, or a file's, out of range) */
+  memset(&options,0xFF,sizeof(options));
+  game_modes_options_sanitize(&options);
+  CHECK(options.mode==_game_mode_none,"an unknown mode is none");
+  CHECK(options.hardcore==TRUE&&options.infection_zombie_shields==TRUE&&options.gun_game_melee_demotes==TRUE,
+   "booleans are 0 or 1");
+  CHECK(options.infection_initial_zombies==1&&options.infection_zombie_speed==150&&options.infection_skull_damage==200&&
+   options.infection_respawn_time==5&&options.infection_countdown==10,"out of range: the defaults");
+  CHECK(options.gun_game_order==_gun_game_order_strongest_first,"an unknown order");
+  for(int index=0;index<(int)sizeof(options.reserved);index++) CHECK(options.reserved[index]==0,"reserved cleared");
+ } else CASE("sanitize_keeps") {
+  memset(&options,0,sizeof(options));
+  options.mode=_game_mode_infection;options.infection_initial_zombies=16;options.infection_zombie_speed=200;
+  options.infection_skull_damage=100;options.infection_respawn_time=30;options.infection_countdown=30;
+  options.gun_game_order=_gun_game_order_random;
+  game_modes_options_sanitize(&options);
+  CHECK(options.mode==_game_mode_infection&&options.infection_initial_zombies==16&&options.infection_zombie_speed==200&&
+   options.infection_skull_damage==100&&options.infection_respawn_time==30&&options.infection_countdown==30&&
+   options.gun_game_order==_gun_game_order_random,"values in range are kept");
+ } else CASE("variant_mode") {
+  struct game_variant variant;
+  memset(&variant,0,sizeof(variant));memset(&options,0,sizeof(options));
+  variant.game_engine_index=game_engine_slayer;
+  options.mode=_game_mode_swat;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_swat,"SWAT, free for all");
+  variant.universal_variant.teams=TRUE;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_swat,"SWAT, teams");
+  options.mode=_game_mode_infection;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_infection,"Infection on teams");
+  variant.universal_variant.teams=FALSE;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_none,"no Infection without teams");
+  options.mode=_game_mode_gun_game;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_gun_game,"Gun Game, free for all");
+  variant.universal_variant.teams=TRUE;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_none,"no Gun Game on teams");
+  variant.universal_variant.teams=FALSE;variant.game_engine_index=game_engine_ctf;
+  CHECK(game_modes_variant_mode(&variant,&options)==_game_mode_none,"Slayer's modes only");
+  CHECK(game_modes_variant_mode(NULL,&options)==_game_mode_none&&game_modes_variant_mode(&variant,NULL)==_game_mode_none,
+   "none without a gametype");
+ } else CASE("round_result") {
+  long limit=300*30;
+  CHECK(infection_round_result(3,1,0,limit)==NONE,"humans and zombies left");
+  CHECK(infection_round_result(0,4,10,limit)==1,"no human left: the zombies");
+  CHECK(infection_round_result(2,1,limit,limit)==0,"the time out: the humans");
+  CHECK(infection_round_result(0,4,limit,limit)==1,"the last human turned as the time runs out: the zombies");
+  CHECK(infection_round_result(2,1,limit*10,0)==NONE,"no time limit");
+  CHECK(infection_round_result(3,0,10,limit)==0,"every zombie gone: the humans");
+  CHECK(infection_round_result(0,0,10,limit)==2,"everyone gone: no one");
+ } else CASE("state_valid") {
+  struct distributed_infection_state state=valid_state();
+  CHECK(infection_state_valid(&state,3,5),"a state of the game, as new");
+  CHECK(!infection_state_valid(&state,4,0),"another game's");
+  CHECK(!infection_state_valid(&state,3,6),"older than the client's");
+  state=valid_state();state.phase=_distributed_infection_finished+1;
+  CHECK(!infection_state_valid(&state,3,0),"an unknown phase");
+  state=valid_state();state.winner=1;
+  CHECK(!infection_state_valid(&state,3,0),"a winner before the round is over");
+  state.phase=_distributed_infection_finished;
+  CHECK(infection_state_valid(&state,3,0),"a winner after");
+  state.winner=2;
+  CHECK(!infection_state_valid(&state,3,0),"no third side");
+  state=valid_state();state.players[2].role=_distributed_infection_role_zombie+1;
+  CHECK(!infection_state_valid(&state,3,0),"an unknown role");
+  state=valid_state();state.players[2].role=_distributed_infection_role_human;
+  CHECK(!infection_state_valid(&state,3,0),"a role with no player");
+  state=valid_state();state.players[0].score=-1;
+  CHECK(!infection_state_valid(&state,3,0),"a negative score");
+  state=valid_state();state.players[0].score=INFECTION_MAXIMUM_SCORE+1;
+  CHECK(!infection_state_valid(&state,3,0),"a score too large");
+  state=valid_state();state.players[1].reserved[1]=1;
+  CHECK(!infection_state_valid(&state,3,0),"reserved bytes set");
+ } else CASE("gun_game_order") {
+  map_with_every_weapon();memset(&options,0,sizeof(options));
+  options.gun_game_order=_gun_game_order_strongest_first;
+  gun_game_levels_build();
+  CHECK(gun_game.level_count==8,"every weapon: %d",gun_game.level_count);
+  CHECK(gun_game.levels[0]==_loadout_weapon_rocket_launcher&&gun_game.levels[7]==_loadout_weapon_pistol,
+   "the rocket launcher first, the pistol last");
+  options.gun_game_order=_gun_game_order_weakest_first;
+  gun_game_levels_build();
+  CHECK(gun_game.levels[0]==_loadout_weapon_pistol&&gun_game.levels[7]==_loadout_weapon_rocket_launcher,
+   "the pistol first");
+ } else CASE("gun_game_missing") {
+  map_with_every_weapon();memset(&options,0,sizeof(options));
+  map_has[_loadout_weapon_shotgun]=FALSE;map_has[_loadout_weapon_needler]=FALSE;
+  gun_game_levels_build();
+  CHECK(gun_game.level_count==6,"the map's weapons only: %d",gun_game.level_count);
+  for(int level=0;level<gun_game.level_count;level++)
+   CHECK(gun_game.levels[level]!=_loadout_weapon_shotgun&&gun_game.levels[level]!=_loadout_weapon_needler,"none missing");
+ } else CASE("gun_game_random") {
+  map_with_every_weapon();memset(&options,0,sizeof(options));
+  options.gun_game_order=_gun_game_order_random;draws=0;
+  gun_game_levels_build();
+  CHECK(draws==7&&gun_game.level_count==8,"the host draws the order");
+  CHECK(gun_game.levels[0]!=_loadout_weapon_rocket_launcher,"in another order");
+  client=TRUE;draws=0;
+  gun_game_levels_build();
+  CHECK(draws==0&&gun_game.level_count==8,"a client draws nothing, its list as long");
+  client=FALSE;
+ } else CASE("kind") {
+  struct game_variant variant;
+  memset(&variant,0,sizeof(variant));memset(&options,0,sizeof(options));
+  variant.game_engine_index=game_engine_slayer;variant.universal_variant.teams=TRUE;
+  CHECK(game_modes_kind(&variant,&options)==0,"a stock gametype has no kind");
+  CHECK(game_modes_kind_name(game_engine_slayer,0,TRUE)==NULL,"named by its engine");
+  options.mode=_game_mode_infection;options.hardcore=TRUE;
+  CHECK(game_modes_kind(&variant,&options)==(_game_mode_infection|0x80),"Infection, Hardcore");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_slayer,game_modes_kind(&variant,&options),FALSE),
+   L"HARDCORE INFECTION"),"in full");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_slayer,game_modes_kind(&variant,&options),TRUE),L"HC INFECTION"),
+   "abbreviated");
+  options.mode=_game_mode_gun_game;
+  CHECK(game_modes_kind(&variant,&options)==0x80,"a mode the teams do not allow is none");
+  variant.game_engine_index=game_engine_ctf;options.mode=_game_mode_none;
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_ctf,game_modes_kind(&variant,&options),TRUE),L"HC CTF"),"HC CTF");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_slayer,_game_mode_swat,TRUE),L"SWAT"),"SWAT");
+ } else CASE("kind_untrusted") {
+  CHECK(game_modes_kind_name(game_engine_ctf,_game_mode_swat,TRUE)==NULL,"a mode of CTF is none");
+  CHECK(!wcscmp(game_modes_kind_name(game_engine_oddball,_game_mode_infection|0x80,TRUE),L"HC ODDBALL"),
+   "Hardcore kept, the mode not");
+  CHECK(game_modes_kind_name(game_engine_slayer,0x7F,TRUE)==NULL,"a mode this build does not know");
+  CHECK(game_modes_kind_name(game_engine_none,0x80,TRUE)==NULL,"no engine (co-op)");
+  CHECK(game_modes_kind_name(99,0x80,TRUE)==NULL,"an engine this build does not know");
+ } else return 2;
+ return 0;
+}
diff --git a/tools/harness/tests/gun_game_weapon_empty.c b/tools/harness/tests/gun_game_weapon_empty.c
new file mode 100644
index 00000000..e0f7a67b
--- /dev/null
+++ b/tools/harness/tests/gun_game_weapon_empty.c
@@ -0,0 +1,98 @@
+/*
+GUN_GAME_WEAPON_EMPTY.C (test)
+
+The real gun_game_weapon_empty (port/linux/game/gun_game.c): Gun Game gives a
+player a new weapon of their level when theirs is spent. Halo CE's plasma
+rifle and plasma pistol have a magazine block that holds no rounds (every
+count 0: they run on a battery), so a check that looks only at the
+magazines takes them for spent from the start, and gun_game_equip replaces
+them on every update: they never fire. Weapons here are a plasma rifle (one
+magazine holding nothing), a pistol (12 loaded, 120 carried at most) and a
+weapon with no magazines at all. test_gun_game_weapon_empty.py takes the
+code (under_test.inc).
+*/
+
+#include "harness.h"
+
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define NUMBEROF(array) ((long)(sizeof(array) / sizeof((array)[0])))
+
+struct tag_block { long count; void *address; };
+struct weapon_magazine_definition { short rounds_total_maximum; short rounds_loaded_maximum; };
+struct weapon_definition { struct { struct tag_block magazines; } weapon; };
+struct weapon_magazine { short rounds_total; short rounds_loaded; };
+struct weapon_datum
+{
+	long definition_index;
+	struct { real age; struct weapon_magazine magazines[2]; } weapon;
+};
+
+enum { PLASMA_RIFLE, PISTOL, NO_MAGAZINES, NUMBER_OF_DEFINITIONS };
+
+static struct weapon_magazine_definition battery_magazine = { 0, 0 };
+static struct weapon_magazine_definition pistol_magazine = { 120, 12 };
+static struct weapon_definition definitions[NUMBER_OF_DEFINITIONS] =
+{
+	{ { { 1, &battery_magazine } } },
+	{ { { 1, &pistol_magazine } } },
+	{ { { 0, NULL } } },
+};
+static struct weapon_datum held;
+
+#define weapon_try_and_get(index) ((index) == NONE ? NULL : &held)
+#define weapon_definition_get(index) (&definitions[index])
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) (&((type *)(block)->address)[index])
+
+#include "under_test.inc"
+
+static void hold(long definition_index, real age, short loaded, short total)
+{
+	memset(&held, 0, sizeof(held));
+	held.definition_index = definition_index;
+	held.weapon.age = age;
+	held.weapon.magazines[0].rounds_loaded = loaded;
+	held.weapon.magazines[0].rounds_total = total;
+}
+
+int main(int argc, char **argv)
+{
+	const char *case_name = argc > 1 ? argv[1] : "";
+
+	CASE("battery-full")
+	{
+		/* a plasma rifle as it is given: its magazine block holds nothing, its battery is full */
+		hold(PLASMA_RIFLE, 0.0f, 0, 0);
+		CHECK(!gun_game_weapon_empty(0), "a full plasma rifle is taken for spent");
+		hold(PLASMA_RIFLE, 0.6f, 0, 0);
+		CHECK(!gun_game_weapon_empty(0), "a plasma rifle with battery left is taken for spent");
+		return 0;
+	}
+	CASE("battery-spent")
+	{
+		hold(PLASMA_RIFLE, 1.0f, 0, 0);
+		CHECK(gun_game_weapon_empty(0), "a plasma rifle with a dead battery is not spent");
+		return 0;
+	}
+	CASE("rounds")
+	{
+		/* a weapon whose magazine holds rounds: spent when none is loaded or carried, whatever its age */
+		hold(PISTOL, 0.0f, 5, 0);
+		CHECK(!gun_game_weapon_empty(0), "a pistol with rounds loaded is taken for spent");
+		hold(PISTOL, 0.0f, 0, 24);
+		CHECK(!gun_game_weapon_empty(0), "a pistol with rounds carried is taken for spent");
+		hold(PISTOL, 0.0f, 0, 0);
+		CHECK(gun_game_weapon_empty(0), "a dry pistol is not spent");
+		return 0;
+	}
+	CASE("no-magazines")
+	{
+		hold(NO_MAGAZINES, 0.5f, 0, 0);
+		CHECK(!gun_game_weapon_empty(0), "a weapon without magazines, battery left, is taken for spent");
+		hold(NO_MAGAZINES, 1.0f, 0, 0);
+		CHECK(gun_game_weapon_empty(0), "a weapon without magazines and a dead battery is not spent");
+		CHECK(!gun_game_weapon_empty(NONE), "no weapon is taken for a spent one");
+		return 0;
+	}
+	fprintf(stderr, "no case %s\n", case_name);
+	return 2;
+}
diff --git a/tools/harness/tests/host_take.c b/tools/harness/tests/host_take.c
new file mode 100644
index 00000000..8cfdf9d1
--- /dev/null
+++ b/tools/harness/tests/host_take.c
@@ -0,0 +1,2157 @@
+/* the host's real take path, bounds and riding helpers against salted objects */
+#include "harness.h"
+#include <math.h>
+#include <limits.h>
+#include <stddef.h>
+
+typedef unsigned short word;
+typedef struct { real i, j; } real_vector2d;
+#define MAXIMUM_TRACKED_PLAYERS 128
+#define TICKS_PER_SECOND 30
+#define MAX(a,b) ((a) > (b) ? (a) : (b))
+#define MIN(a,b) ((a) < (b) ? (a) : (b))
+#define csmemset memset
+#define _object_mask_biped 1
+#define _object_mask_device 2
+#define _object_mask_machine 2
+#define _biped_airborne_bit 0
+#define _game_connection_network_client 2
+#include "types.inc"
+
+enum { V = 0x10080, OTHER = 0x20081 };
+struct fake_object
+{
+    long mask;
+    long definition_index;
+    struct { real_point3d position; real_vector3d translational_velocity; long parent_object_index; } object;
+    struct { long elevator_object_index; long support_surface_index; char elevator_ticks; long flags; long airborne_ticks; } biped;
+    struct { long player_index; } unit;
+    struct { real position_velocity; } device;
+};
+#define object_datum fake_object
+#define biped_datum fake_object
+#define device_datum fake_object
+static struct fake_object objects[MAXIMUM_TRACKED_PLAYERS];
+static struct vehicle_riding_state riding[MAXIMUM_TRACKED_PLAYERS];
+static struct vehicle_riding_air host_air;
+static struct vehicle_riding_vehicle vehicles[2];
+static struct player_datum { long unit_index; real speed_multiplier; } players[MAXIMUM_TRACKED_PLAYERS];
+static struct game_globals_player_information
+{
+    real run_forward_speed, run_backward_speed, run_sideways_speed, double_speed_multiplier;
+} information = { 2.25f, 2.0f, 1.75f, 2.0f };
+static struct game_globals { struct { long count; } player_information; } fake_globals = { { 1 } };
+static struct biped_definition
+{
+    struct { real jump_velocity, collision_height_standing, collision_height_crouching; } biped;
+} fake_definition = { { 0.11f, 0.7f, 0.5f } };
+static real global_gravity = 0.0036f;
+static long game_time;
+static long reconcile_calls, rebase_calls, phase;
+static long apply_calls[MAXIMUM_TRACKED_PLAYERS], apply_phase[MAXIMUM_TRACKED_PLAYERS];
+static boolean distributed_rider_pass[MAXIMUM_TRACKED_PLAYERS];
+static boolean riding_applies = TRUE;
+static struct { long corrections; } distributed_statistics;
+static real vehicle_write;
+static real pill_offset = -0.1f;
+static boolean replay_frames;
+static struct vehicle_riding_vehicle replay_body, replay_node;
+real vehicle_riding_transition_leash(void) { return 0.25f; }
+static real_point3d const body_place = { -0.5f, 0.2f, 0.0f };
+
+#define object_get(i) (&objects[(i)])
+#define unit_get(i) object_get(i)
+#define game_time_get() game_time
+#define game_connection() 1
+#define game_players_are_double_speed() FALSE
+#define scenario_get_game_globals() (&fake_globals)
+#define biped_definition_get(i) (&fake_definition)
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) ((type *)checked_information((index)))
+static void *checked_information(long index)
+{
+    CHECK(index == 0 && fake_globals.player_information.count > index, "invalid tag element");
+    return &information;
+}
+static void *object_try_and_get_and_verify_type(long index, long mask)
+{
+    return index >= 0 && index < MAXIMUM_TRACKED_PLAYERS && (objects[index].mask & mask) ? &objects[index] : NULL;
+}
+static struct player_datum *distributed_player(short p) { return &players[p]; }
+static long distributed_living_unit(struct player_datum const *p) { return p->unit_index; }
+static long distributed_player_machine(short p) { return p; }
+static real rtt_ticks = 3.0f;
+static real distributed_machine_round_trip_ticks(long machine) { return rtt_ticks; }
+static boolean network_coop_player_has_structure_bsp(long p) { return TRUE; }
+static boolean distributed_point_valid(real_point3d const *p, real bound)
+{
+    return valid_real_point3d(p) && fabsf(p->x) <= bound && fabsf(p->y) <= bound && fabsf(p->z) <= bound;
+}
+static boolean distributed_axes_make_valid(real_vector3d *f, real_vector3d *u)
+{
+    return valid_real_vector3d(f) && valid_real_vector3d(u) && normalize3d(f) > 0.0f && normalize3d(u) > 0.0f;
+}
+#define UNIT_WORLD_BOUND 100000.0f
+static void distributed_vector_unpack(struct distributed_vector const *packed, real scale, real_vector3d *v)
+{
+    v->i = packed->i / scale; v->j = packed->j / scale; v->k = packed->k / scale;
+}
+static void biped_get_physics_pill(long unit, real_point3d *base, real *height, real *width)
+{
+    *base = objects[unit].object.position;
+    base->z += pill_offset;
+    *height = 0.7f; *width = 0.2f;
+}
+static boolean biped_riding_get_state(long unit, struct vehicle_riding_state *state)
+{
+    if (!riding_applies || unit < 0 || unit >= MAXIMUM_TRACKED_PLAYERS || !objects[unit].mask)
+        return FALSE;
+    *state = riding[unit];
+    return TRUE;
+}
+static short biped_riding_vehicle_node_count(long v)
+{
+    return v == vehicles[0].object_index || v == vehicles[1].object_index ? 3 : NONE;
+}
+static boolean biped_riding_vehicle(long v, short node, struct vehicle_riding_vehicle *out)
+{
+    long slot;
+    if (biped_riding_vehicle_node_count(v) == NONE || (node != NONE && (node < 0 || node >= 3)))
+        return FALSE;
+    if (replay_frames)
+    {
+        *out = node == NONE ? replay_body : replay_node;
+        out->object_index = v; out->node_index = node; out->origin = out->position;
+        return TRUE;
+    }
+    slot = v == vehicles[0].object_index ? 0 : 1;
+    *out = vehicles[slot];
+    out->origin = vehicles[slot].position;
+    out->node_index = node;
+    if (node == 2)
+    {
+        out->position.z += vehicles[slot].bounding_sphere_radius;
+        out->forward.i = cosf(0.3f); out->forward.j = sinf(0.3f);
+    }
+    return TRUE;
+}
+static boolean biped_riding_rebase(long unit);
+static struct vehicle_riding_cabin host_cabin;
+static boolean biped_riding_frame_velocity(long unit, struct vehicle_riding_deck const *deck, real_point3d const *base,
+    real_vector3d *velocity)
+{
+    if (riding[unit].ticks > 0 && riding[unit].object_index == deck->vehicle_index)
+        *velocity = riding[unit].velocity;
+    else
+        memset(velocity, 0, sizeof(*velocity));
+    return TRUE;
+}
+/* (what a fault that took the part into the host's own state would do) */
+static boolean biped_riding_take_deck(long unit, struct vehicle_riding_deck const *deck)
+{
+    riding[unit].ticks = deck->ticks;
+    riding[unit].falling = deck->flags & 1;
+    riding[unit].velocity = deck->velocity;
+    return TRUE;
+}
+enum { _network_vehicle_write_state };
+static boolean network_objects_reconcile(long unit, real_point3d const *p, real_vector3d const *f,
+    real_vector3d const *up, real_vector3d const *velocity, real_vector3d const *angular, real blend, short kind)
+{
+    boolean snap = distance_squared3d(&objects[unit].object.position, p) > blend * blend;
+    reconcile_calls++;
+    if (snap)
+        objects[unit].object.position = *p;
+    else
+    {
+        objects[unit].object.position.x += (p->x - objects[unit].object.position.x) * 0.5f;
+        objects[unit].object.position.y += (p->y - objects[unit].object.position.y) * 0.5f;
+        objects[unit].object.position.z += (p->z - objects[unit].object.position.z) * 0.5f;
+    }
+    if (velocity)
+        objects[unit].object.translational_velocity = *velocity;
+    return snap;
+}
+/* (MCC movement effects: none in this fixture) */
+static boolean mcc_script_effects_host_movement(void) { return FALSE; }
+#include "under_test.inc"
+
+static boolean biped_riding_rebase(long unit)
+{
+    struct vehicle_riding_vehicle v;
+    real_point3d base;
+    real height, width;
+    rebase_calls++;
+    if (!biped_riding_vehicle(riding[unit].object_index, riding[unit].node_index, &v))
+        return FALSE;
+    biped_get_physics_pill(unit, &base, &height, &width);
+    return vehicle_riding_rebase(&riding[unit], &v, &base);
+}
+static real_point3d to_world(real_point3d const *place)
+{
+    real_point3d p;
+    vehicle_riding_point_to_world(&vehicles[0].position, &vehicles[0].forward, &vehicles[0].up, place, &p);
+    return p;
+}
+static void host_tick_at(short p, real_point3d const *place)
+{
+    real_point3d base = to_world(place);
+    objects[p].object.position = base;
+    objects[p].object.position.z += 0.1f;
+    objects[p].object.translational_velocity = riding[p].velocity;
+    riding[p].body_position = vehicles[0].position;
+    riding[p].body_forward = vehicles[0].forward;
+    riding[p].body_up = vehicles[0].up;
+    riding[p].vehicle_position = vehicles[0].position;
+    riding[p].vehicle_forward = vehicles[0].forward;
+    riding[p].vehicle_up = vehicles[0].up;
+    riding[p].local_point = *place;
+}
+static void host_tick(short p) { host_tick_at(p, &body_place); }
+static void prediction(short p, real_point3d place)
+{
+    struct distributed_unit_state *s = &distributed_predictions[p].state;
+    distributed_predictions[p].valid = TRUE;
+    distributed_predictions[p].time = game_time;
+    distributed_predictions[p].taken_host_time = NONE;
+    s->player_index = p; s->unit_index = p;
+    s->deck_present = TRUE;
+    s->deck.vehicle_index = V; s->deck.node_index = NONE; s->deck.ticks = RIDING_TICKS;
+    s->deck.place = place;
+    s->position = to_world(&place);
+    s->position.x -= 1.0f;
+    s->position.z += 0.1f;
+    s->forward.i = (short)DISTRIBUTED_UNIT_SCALE;
+    s->up.k = (short)DISTRIBUTED_UNIT_SCALE;
+}
+static void setup(void)
+{
+    long p;
+    memset(objects, 0, sizeof(objects)); memset(riding, 0, sizeof(riding));
+    memset(&host_air, 0, sizeof(host_air));
+    memset(distributed_accepted, 0, sizeof(distributed_accepted));

diff --git a/port/linux/src/dpad_controls.c b/port/linux/src/dpad_controls.c
new file mode 100644
index 00000000..a37b6eb7
--- /dev/null
+++ b/port/linux/src/dpad_controls.c
@@ -0,0 +1,116 @@
+/* dpad_controls.c: the D-pad's controls on a controller without a right
+stick (dpad_controls.h; input.dpad_controls in port_config.c)
+
+Halo moves with the left stick and aims with the right, and walks and
+strafes with the D-pad too. A handheld without sticks (the RG35XX Plus, SP
+and 2024, the RG34XX) cannot aim, and one with a left stick alone (the
+RG40XX V) cannot either. On those, in a game:
+- with a left stick alone, the D-pad is the right stick;
+- without sticks, up and down walk and left and right turn; holding the left
+  shoulder, up and down look and left and right strafe, made into the
+  sticks that do those in the controller's joystick preset.
+Holding the left shoulder, A crouches and B zooms, the stick clicks such a
+controller lacks. The left shoulder pressed and let go with nothing else
+within a moment is the flashlight, its own job, once it is let go. */
+
+#include "dpad_controls.h"
+
+#include <string.h>
+
+/* a left shoulder held longer than this, with nothing else, is no flashlight */
+#define DPAD_CONTROLS_TAP_MS 400
+/* how long the flashlight's press lasts: some polls of the game's */
+#define DPAD_CONTROLS_WHITE_MS 100
+#define DPAD_CONTROLS_FULL 32767
+
+static short axis(int positive, int negative)
+{
+	return (short)(positive && !negative ? DPAD_CONTROLS_FULL : negative && !positive ? -DPAD_CONTROLS_FULL : 0);
+}
+
+/* the D-pad's directions, A and B as bits */
+static unsigned others_down(struct dpad_controls_buttons const *buttons)
+{
+	return (buttons->up ? 1u : 0) | (buttons->down ? 2u : 0) | (buttons->left ? 4u : 0) |
+		(buttons->right ? 8u : 0) | (buttons->a ? 16u : 0) | (buttons->b ? 32u : 0);
+}
+
+/* walking, strafing, turning and looking (forward, right, right, up
+positive) on the sticks that do them in the preset (input_abstraction.c:
+each stick's X turns or strafes to the right, its Y walks forward or looks
+up) */
+static void route(int preset, short walk, short strafe, short turn, short look,
+	struct dpad_controls_result *result)
+{
+	switch (preset)
+	{
+	case _dpad_preset_southpaw:
+		result->right_y = walk, result->right_x = strafe, result->left_x = turn, result->left_y = look;
+		break;
+	case _dpad_preset_legacy:
+		result->left_y = walk, result->right_x = strafe, result->left_x = turn, result->right_y = look;
+		break;
+	case _dpad_preset_legacy_southpaw:
+		result->right_y = walk, result->left_x = strafe, result->right_x = turn, result->left_y = look;
+		break;
+	default:
+		result->left_y = walk, result->left_x = strafe, result->right_x = turn, result->right_y = look;
+		break;
+	}
+}
+
+void dpad_controls(struct dpad_controls_state *state, int mode, int preset,
+	struct dpad_controls_buttons const *buttons, unsigned long long now,
+	struct dpad_controls_result *result)
+{
+	unsigned down = others_down(buttons);
+	short x = axis(buttons->right, buttons->left), y = axis(buttons->up, buttons->down);
+	int modifier = buttons->left_shoulder;
+
+	memset(result, 0, sizeof(*result));
+	if (mode == _dpad_controls_none)
+	{
+		/* (a press that goes on into a game is no flashlight) */
+		state->held = buttons->left_shoulder;
+		state->used = 1;
+		state->previous = down;
+		state->white_until = 0;
+		result->white = buttons->left_shoulder;
+		result->a = buttons->a;
+		result->b = buttons->b;
+		return;
+	}
+	/* the left shoulder: a modifier while held, the flashlight when tapped */
+	if (buttons->left_shoulder && !state->held)
+	{
+		state->held = 1;
+		state->used = 0;
+		state->held_since = now;
+	}
+	/* (one held from before, as the D-pad walking, leaves it a tap) */
+	if (buttons->left_shoulder && (down & ~state->previous))
+		state->used = 1;
+	state->previous = down;
+	if (!buttons->left_shoulder && state->held)
+	{
+		state->held = 0;
+		if (!state->used && now - state->held_since < DPAD_CONTROLS_TAP_MS)
+			state->white_until = now + DPAD_CONTROLS_WHITE_MS;
+	}
+	result->white = now < state->white_until;
+
+	result->a = buttons->a && !modifier;
+	result->b = buttons->b && !modifier;
+	result->left_thumb = buttons->a && modifier;
+	result->right_thumb = buttons->b && modifier;
+	if (mode == _dpad_controls_aim)
+	{
+		/* (the right stick itself: the preset says what it does) */
+		result->right_x = x;
+		result->right_y = y;
+	}
+	else if (modifier)
+		route(preset, 0, x, 0, y, result);
+	else
+		route(preset, y, 0, x, 0, result);
+}
diff --git a/port/linux/src/dpad_controls.h b/port/linux/src/dpad_controls.h
new file mode 100644
index 00000000..039b0cf1
--- /dev/null
+++ b/port/linux/src/dpad_controls.h
@@ -0,0 +1,72 @@
+/* dpad_controls.h: the D-pad's controls on a controller without a right
+stick (input.dpad_controls, xinput_sdl.c), apart from SDL so that they can
+be tested on their own */
+
+#ifndef DPAD_CONTROLS_H
+#define DPAD_CONTROLS_H
+
+/* what the D-pad does in a game */
+enum
+{
+	/* the game's own: it walks and strafes, as the left stick */
+	_dpad_controls_none,
+	/* it is the right stick (a controller with a left stick alone) */
+	_dpad_controls_aim,
+	/* up and down walk, left and right turn; with the left shoulder held,
+	up and down look and left and right strafe (a controller without
+	sticks) */
+	_dpad_controls_walk_and_turn
+};
+
+/* the game's joystick presets (input_abstraction.c), numbered alike: which
+stick walks, strafes, turns and looks */
+enum
+{
+	_dpad_preset_default,
+	_dpad_preset_southpaw,
+	_dpad_preset_legacy,
+	_dpad_preset_legacy_southpaw
+};
+
+/* the buttons the controls take, down or not */
+struct dpad_controls_buttons
+{
+	int up, down, left, right;
+	int left_shoulder;
+	int a, b;
+};
+
+/* what they make of them: the sticks' values (-32767 to 32767, up and
+right positive; 0 for none), and the buttons the controller reports (the
+D-pad itself only with _dpad_controls_none) */
+struct dpad_controls_result
+{
+	short left_x, left_y, right_x, right_y;
+	/* the left shoulder as the white button (the flashlight) */
+	int white;
+	/* A and B as themselves (jump, melee) or, with the left shoulder held,
+	as the stick clicks (crouch, zoom), which these controllers lack */
+	int a, b;
+	int left_thumb, right_thumb;
+};
+
+/* a controller's left shoulder over its polls: a press used with nothing
+else is the flashlight once it is let go */
+struct dpad_controls_state
+{
+	int held;
+	/* a D-pad direction, A or B pressed while it is held, or the press
+	began while the controls were off: no flashlight when it is let go */
+	int used;
+	/* the D-pad's directions, A and B down at the last poll, as bits */
+	unsigned previous;
+	unsigned long long held_since;
+	unsigned long long white_until;
+};
+
+/* one poll at now (milliseconds), with the controller's joystick preset */
+void dpad_controls(struct dpad_controls_state *state, int mode, int preset,
+	struct dpad_controls_buttons const *buttons, unsigned long long now,
+	struct dpad_controls_result *result);
+
+#endif

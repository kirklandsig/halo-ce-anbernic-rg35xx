+where each declaration first is and each sampler, and the sizes program_build
+needs (shader_count); the source is then copied once with them replaced, and
+the placed uniforms it uses noted */
+static char *explicit_layouts(const char *source, struct lazy_shader *shader)
+{
+	/* a sampler texN's placement, at binding N */
+#define SAMPLER_LAYOUT(n) "layout(binding = " #n ") "
+	static const char sampler_layouts[10][sizeof(SAMPLER_LAYOUT(0))] =
+	{
+		SAMPLER_LAYOUT(0), SAMPLER_LAYOUT(1), SAMPLER_LAYOUT(2), SAMPLER_LAYOUT(3), SAMPLER_LAYOUT(4),
+		SAMPLER_LAYOUT(5), SAMPLER_LAYOUT(6), SAMPLER_LAYOUT(7), SAMPLER_LAYOUT(8), SAMPLER_LAYOUT(9)
+	};
+#undef SAMPLER_LAYOUT
+	struct
+	{
+		const char *at;
+		unsigned long skip;
+		const char *placed;
+		unsigned long length;
+	} edits[placement_count + 16];
+	const char *end = source + strlen(source), *cursor, *at;
+	struct xgpu_text text;
+	unsigned long count = 0, index, found = 0;
+	BOOL samplers = TRUE;

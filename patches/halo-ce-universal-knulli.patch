diff --git a/port/linux/game/coop_sound_sync.c b/port/linux/game/coop_sound_sync.c
new file mode 100644
index 00000000..badc8169
--- /dev/null
+++ b/port/linux/game/coop_sound_sync.c
@@ -0,0 +1,513 @@
+/*
+COOP_SOUND_SYNC.C
+
+A co-op client that joins during a looping sound that plays once (a
+cutscene's music or dialogue: a fake impulse one) starts it where the host
+has reached, rather than from its beginning, out of step with the scene.
+
+The host's resent start says how long ago the host started it, in
+milliseconds (network_coop.c's host_send_looping_sounds: the event's
+target). Here that time is walked through the parts the client's sound
+manager is about to play (sound_manager.c's
+update_potentially_audible_looping_sound), track by track:
+	- a start sound that has played out is skipped, and its time taken from
+	  the loop's (unless the loop fades in at the start, with it),
+	- the part that is playing starts at the permutation of its linked chain
+	  the time falls in, a block's start into that permutation's samples
+	  (update_channel_for_looping_sound, dsound_port_queue_sound_from); a loop
+	  whose permutations are not linked repeats, so the time wraps around it,
+	- a loop whose chain has played out has the whole sound played out: it
+	  does not start, nor do its stop sounds.
+
+Each machine picks its pitches and permutations itself, as it always has,
+and the time is walked through the client's own, so the sound ends when it
+would have, had it started with the host's. A permutation whose samples'
+time is not known here (a compression other than none or Xbox ADPCM, which
+the channels play) starts at its beginning.
+
+Only the scripts' own instance of the sound is placed (the looping sound
+definition's runtime_scripting_sound_index), and only in the refresh that
+first starts something of it: a part started later (a pitch range's
+crossfade, an alternate) starts at its beginning, as it always has.
+*/
+
+#include "cseries.h"
+#include "cseries/cseries_windows.h"
+#include "cseries/errors.h"
+#include "sound/sound_definitions.h"
+#include "sound/sound_dsound.h"
+#include "tag_files/tag_files.h"
+#include "tag_files/tag_groups.h"
+#include "coop_sound_sync.h"
+
+/* ---------- constants */
+
+enum
+{
+	/* network_coop.c's MAXIMUM_LOOPING_SOUNDS */
+	MAXIMUM_COOP_SOUND_SYNCS = 32,
+	MAXIMUM_COOP_SOUND_OFFSETS = 16,
+	/* the most of the host's time taken: a day */
+	MAXIMUM_COOP_SOUND_SYNC_MILLISECONDS = 24 * 60 * 60 * 1000,
+	/* the most a permutation's time is taken as: an hour */
+	MAXIMUM_COOP_SOUND_PERMUTATION_MILLISECONDS = 60 * 60 * 1000,
+};
+
+/* a sound's encoding and compression, as its tag has them */
+enum
+{
+	COOP_SOUND_ENCODING_STEREO = 1,
+	COOP_SOUND_COMPRESSION_NONE = 0,
+	COOP_SOUND_COMPRESSION_XBOX_ADPCM = 1,
+	/* (sound_dsound_xbox.c's SOUND_COMPRESSED_BLOCK_SIZE, a channel's, and
+	SOUND_COMPRESSED_SAMPLES_PER_BLOCK) */
+	COOP_SOUND_ADPCM_BLOCK_BYTES = 36,
+	COOP_SOUND_ADPCM_BLOCK_SAMPLES = 64,
+	/* a 16-bit sample of each of the stream's two channels */
+	COOP_SOUND_PCM_BLOCK_BYTES = 4,
+	/* 22 and 44 kHz (sound_samples_per_second) */
+	COOP_SOUND_SAMPLE_RATES = 2,
+	/* sound_manager.c's _fade_in_at_start_bit: a track whose loop fades in
+	with its start sound, rather than after it */
+	COOP_SOUND_TRACK_FADE_IN_AT_START_BIT = 0,
+};
+
+/* the lowest pitch a time is worked out at */
+#define COOP_SOUND_MINIMUM_PITCH 0.01f
+
+/* ---------- globals */
+
+static struct coop_sound_sync
+{
+	/* NONE: unused */
+	long definition_index;
+	long elapsed_milliseconds;
+	/* (system_milliseconds when the host's time came) */
+	unsigned long received;
+	/* its first refresh is over: nothing more is placed */
+	boolean placed;
+	/* its loop had played out on the host: its stop sounds do not play */
+	boolean finished;
+	/* each track's start sound that was skipped, its time */
+	long start_milliseconds[MAXIMUM_TRACKS_PER_LOOPING_SOUND];
+} coop_sound_syncs[MAXIMUM_COOP_SOUND_SYNCS];
+
+/* sounds whose first permutation starts into its samples, till a channel
+takes them (coop_sound_sync_take_offset) */
+static struct
+{
+	long sound_index;
+	struct sound_permutation const *permutation;
+	long byte_offset;
+} coop_sound_offsets[MAXIMUM_COOP_SOUND_OFFSETS];
+static short coop_sound_next_offset;
+
+static boolean coop_sound_syncs_initialized;
+
+/* ---------- private code */
+
+static void coop_sound_syncs_initialize(
+	void)
+{
+	short index;
+
+	if (coop_sound_syncs_initialized)
+		return;
+	for (index = 0; index < MAXIMUM_COOP_SOUND_SYNCS; index++)
+		coop_sound_syncs[index].definition_index = NONE;
+	for (index = 0; index < MAXIMUM_COOP_SOUND_OFFSETS; index++)
+		coop_sound_offsets[index].sound_index = NONE;
+	coop_sound_next_offset = 0;
+	coop_sound_syncs_initialized = TRUE;
+}
+
+static struct coop_sound_sync *coop_sound_sync_find(
+	long looping_definition_index)
+{
+	short index;
+
+	if (!coop_sound_syncs_initialized || looping_definition_index == NONE)
+		return NULL;
+	for (index = 0; index < MAXIMUM_COOP_SOUND_SYNCS; index++)
+	{
+		if (coop_sound_syncs[index].definition_index == looping_definition_index)
+			return &coop_sound_syncs[index];
+	}
+	return NULL;
+}
+
+/* the host's time now: as it sent it, and since it came */
+static long coop_sound_sync_elapsed(
+	struct coop_sound_sync const *sync)
+{
+	unsigned long since = system_milliseconds() - sync->received;
+	long elapsed = sync->elapsed_milliseconds;
+
+	if (since > (unsigned long)(MAXIMUM_COOP_SOUND_SYNC_MILLISECONDS - elapsed))
+		return MAXIMUM_COOP_SOUND_SYNC_MILLISECONDS;
+	return elapsed + (long)since;
+}
+
+/* a permutation's sample frames (one sample of each of its channels), or 0
+for a compression whose time is not known here */
+static long coop_sound_permutation_frames(
+	struct sound_definition const *definition,
+	struct sound_permutation const *permutation)
+{
+	long channels = definition->encoding == COOP_SOUND_ENCODING_STEREO ? 2 : 1;
+	long size = permutation->samples.size;
+
+	if (size <= 0)
+		return 0;
+	if (definition->compression == COOP_SOUND_COMPRESSION_NONE)
+		return size / (2 * channels);
+	if (definition->compression == COOP_SOUND_COMPRESSION_XBOX_ADPCM)
+		return size / (COOP_SOUND_ADPCM_BLOCK_BYTES * channels) * COOP_SOUND_ADPCM_BLOCK_SAMPLES;
+	return 0;
+}
+
+/* the frames a permutation plays each second at played_pitch, or 0 */
+static real coop_sound_frames_per_second(
+	struct sound_definition const *definition,
+	real played_pitch)
+{
+	if (!VALID_INDEX(definition->sample_rate, COOP_SOUND_SAMPLE_RATES) ||
+		!(played_pitch >= COOP_SOUND_MINIMUM_PITCH))
+	{
+		return 0.f;
+	}
+	return (real)sound_samples_per_second(definition->sample_rate) * played_pitch;
+}
+
+/* how long a permutation plays at played_pitch, in milliseconds, or 0 when
+that is not known */
+static long coop_sound_permutation_milliseconds(
+	struct sound_definition const *definition,
+	struct sound_permutation const *permutation,
+	real played_pitch)
+{
+	real rate = coop_sound_frames_per_second(definition, played_pitch);
+	long frames = coop_sound_permutation_frames(definition, permutation);
+	real milliseconds;
+
+	if (rate <= 0.f || frames <= 0)
+		return 0;
+	milliseconds = (real)frames * 1000.f / rate;
+	if (milliseconds >= (real)MAXIMUM_COOP_SOUND_PERMUTATION_MILLISECONDS)
+		return MAXIMUM_COOP_SOUND_PERMUTATION_MILLISECONDS;
+	return MAX((long)milliseconds, 1);
+}
+
+/* the start of the block milliseconds into a permutation playing at
+played_pitch, in bytes into its samples (0: its beginning) */
+static long coop_sound_permutation_byte_offset(
+	struct sound_definition const *definition,
+	struct sound_permutation const *permutation,
+	real played_pitch,
+	long milliseconds)
+{
+	long channels = definition->encoding == COOP_SOUND_ENCODING_STEREO ? 2 : 1;
+	long frames = coop_sound_permutation_frames(definition, permutation);
+	real rate = coop_sound_frames_per_second(definition, played_pitch);
+	real into = (real)milliseconds * rate / 1000.f;
+	long offset;
+
+	if (frames <= 0 || rate <= 0.f || !(into > 0.f))
+		return 0;
+	if (into >= (real)frames)
+		into = (real)(frames - 1);
+	if (definition->compression == COOP_SOUND_COMPRESSION_XBOX_ADPCM)
+	{
+		offset = (long)into / COOP_SOUND_ADPCM_BLOCK_SAMPLES * COOP_SOUND_ADPCM_BLOCK_BYTES * channels;
+	}
+	else
+	{
+		offset = (long)into * 2 * channels;
+		offset -= offset % COOP_SOUND_PCM_BLOCK_BYTES;
+	}
+	return offset > 0 && offset < permutation->samples.size ? offset : 0;
+}
+
+/* a pitch a sound's tag gives, or 1 for none */
+static real coop_sound_pitch_or_one(
+	real pitch)
+{
+	return pitch > 0.f ? pitch : 1.f;
+}
+
+static void coop_sound_offset_note(
+	long sound_index,
+	struct sound_permutation const *permutation,
+	long byte_offset)
+{
+	short index;
+
+	for (index = 0; index < MAXIMUM_COOP_SOUND_OFFSETS; index++)
+	{
+		if (coop_sound_offsets[index].sound_index == sound_index)
+			break;
+	}
+	if (index == MAXIMUM_COOP_SOUND_OFFSETS)
+	{
+		index = coop_sound_next_offset;
+		coop_sound_next_offset = (short)((coop_sound_next_offset + 1) % MAXIMUM_COOP_SOUND_OFFSETS);
+	}
+	coop_sound_offsets[index].sound_index = sound_index;
+	coop_sound_offsets[index].permutation = permutation;
+	coop_sound_offsets[index].byte_offset = byte_offset;
+}
+
+/* (debug.txt: where a part was placed) */
+static void coop_sound_sync_log(
+	long looping_definition_index,
+	short track_index,
+	short part,
+	long elapsed,
+	char const *placement,
+	short permutation_index,
+	long byte_offset)
+{
+	error(_error_silent, "co-op: %s's track %d %s, %ld ms in: %s (permutation %d, byte %ld)",
+		tag_get_name(looping_definition_index), track_index,
+		part == _coop_sound_sync_start_part ? "start" : "loop", elapsed, placement, permutation_index, byte_offset);
+}
+
+/* ---------- public code */
+
+void coop_sound_sync_begin(
+	long looping_definition_index,
+	long elapsed_milliseconds)
+{
+	struct coop_sound_sync *sync;
+	short index;
+
+	coop_sound_syncs_initialize();
+	coop_sound_sync_end(looping_definition_index);
+	/* (just now: from its beginning, as it always started) */
+	if (looping_definition_index == NONE || elapsed_milliseconds <= 0)
+		return;
+	for (index = 0; index < MAXIMUM_COOP_SOUND_SYNCS; index++)
+	{
+		if (coop_sound_syncs[index].definition_index == NONE)
+			break;
+	}
+	if (index == MAXIMUM_COOP_SOUND_SYNCS)
+		return;
+	sync = &coop_sound_syncs[index];
+	csmemset(sync, 0, sizeof(*sync));
+	sync->definition_index = looping_definition_index;
+	sync->elapsed_milliseconds = MIN(elapsed_milliseconds, MAXIMUM_COOP_SOUND_SYNC_MILLISECONDS);
+	sync->received = system_milliseconds();
+}
+
+long coop_sound_sync_sound_milliseconds(
+	long sound_index)
+{
+	struct sound_definition *definition;
+	real slowest;
+	long longest = 0;
+	short range_index;
+
+	if (sound_index == NONE)
+		return 0;
+	definition = sound_definition_get(sound_index);
+	/* (sound_manager.c: its random pitch's lower bound, by the smaller of the
+	scale's modifiers, by a range's playback rate) */
+	slowest = coop_sound_pitch_or_one(definition->random_pitch_bounds.lower) *
+		coop_sound_pitch_or_one(MIN(definition->zero_pitch_modifier, definition->one_pitch_modifier));
+	for (range_index = 0; range_index < definition->pitch_ranges.count; range_index++)
+	{
+		struct sound_pitch_range *range =
+			TAG_BLOCK_GET_ELEMENT(&definition->pitch_ranges, range_index, struct sound_pitch_range);
+		real played_pitch = slowest * coop_sound_pitch_or_one(range->playback_rate);
+		short first;
+
+		/* (sound_definition_next_permutation: the first is one of the
+		actual ones, and a linked one is followed by its next, till NONE) */
+		for (first = 0; first < MAX(range->actual_permutation_count, 1) && first < range->permutations.count; first++)
+		{
+			long length = 0;
+			short index = first;
+			short count;
+
+			for (count = 0; count < range->permutations.count && VALID_INDEX(index, range->permutations.count); count++)
+			{
+				struct sound_permutation *permutation =
+					TAG_BLOCK_GET_ELEMENT(&range->permutations, index, struct sound_permutation);
+				long part = coop_sound_permutation_milliseconds(definition, permutation, played_pitch);
+
+				/* (one whose time is not known here: the longest the tag says one is) */
+				if (part <= 0)
+					part = PIN(definition->longest_permutation_length, 0, MAXIMUM_COOP_SOUND_PERMUTATION_MILLISECONDS);
+				length = MIN(length + part, MAXIMUM_COOP_SOUND_PERMUTATION_MILLISECONDS);
+				if (!TEST_FLAG(definition->flags, _sound_definition_linked_permutations_bit))
+					break;
+				index = permutation->next_permutation_index;
+			}
+			longest = MAX(longest, length);
+		}
+	}
+	return longest;
+}
+
+void coop_sound_sync_end(
+	long looping_definition_index)
+{
+	struct coop_sound_sync *sync = coop_sound_sync_find(looping_definition_index);
+
+	if (sync)
+		sync->definition_index = NONE;
+}
+
+void coop_sound_sync_reset(
+	void)
+{
+	coop_sound_syncs_initialized = FALSE;
+	coop_sound_syncs_initialize();
+}
+
+short coop_sound_sync_place(
+	long looping_definition_index,
+	long loop_identifier,
+	short track_index,
+	short part,
+	long definition_index,
+	short pitch_range_index,
+	short *permutation_index,
+	real played_pitch,
+	long sound_index)
+{
+	struct coop_sound_sync *sync = coop_sound_sync_find(looping_definition_index);
+	struct sound_definition *definition;
+	struct sound_pitch_range *range;
+	struct sound_permutation *permutation;
+	boolean linked;
+	long into;
+	long played = 0;
+	short index;
+	short count;
+
+	if (!sync || !VALID_INDEX(track_index, MAXIMUM_TRACKS_PER_LOOPING_SOUND) || definition_index == NONE ||
+		looping_sound_definition_get(looping_definition_index)->runtime_scripting_sound_index != loop_identifier)
+	{
+		return _coop_sound_sync_play;
+	}
+	if (part == _coop_sound_sync_stop_part)
+		return sync->finished ? _coop_sound_sync_skip : _coop_sound_sync_play;
+	if (sync->placed || (part != _coop_sound_sync_start_part && part != _coop_sound_sync_loop_part))
+		return _coop_sound_sync_play;
+	definition = sound_definition_get(definition_index);
+	if (!VALID_INDEX(pitch_range_index, definition->pitch_ranges.count))
+		return _coop_sound_sync_play;
+	range = TAG_BLOCK_GET_ELEMENT(&definition->pitch_ranges, pitch_range_index, struct sound_pitch_range);
+	if (!VALID_INDEX(*permutation_index, range->permutations.count))
+		return _coop_sound_sync_play;
+	into = coop_sound_sync_elapsed(sync);
+	if (part == _coop_sound_sync_loop_part)
+		into -= sync->start_milliseconds[track_index];
+	if (into <= 0)
+		return _coop_sound_sync_play;
+
+	/* (sound_definition_next_permutation: a linked permutation is followed by
+	its next, till NONE; at most each of the range's once, against a chain
+	that comes back on itself) */
+	linked = TEST_FLAG(definition->flags, _sound_definition_linked_permutations_bit);
+	index = *permutation_index;
+	for (count = 0; count < range->permutations.count; count++)
+	{
+		long length;
+		long byte_offset;
+		short next_index;
+
+		permutation = TAG_BLOCK_GET_ELEMENT(&range->permutations, index, struct sound_permutation);
+		length = coop_sound_permutation_milliseconds(definition, permutation, played_pitch);
+		if (length <= 0)
+			return _coop_sound_sync_play;
+		if (into < length)
+		{
+			byte_offset = coop_sound_permutation_byte_offset(definition, permutation, played_pitch, into);
+			*permutation_index = index;
+			if (byte_offset > 0)
+				coop_sound_offset_note(sound_index, permutation, byte_offset);
+			coop_sound_sync_log(looping_definition_index, track_index, part, played + into, "plays",
+				index, byte_offset);
+			return _coop_sound_sync_play;
+		}
+		into -= length;
+		played += length;
+		next_index = linked ? permutation->next_permutation_index : NONE;
+		if (!VALID_INDEX(next_index, range->permutations.count))
+		{
+			if (part == _coop_sound_sync_start_part)
+			{
+				struct looping_sound_definition *looping_definition =
+					looping_sound_definition_get(looping_definition_index);
+
+				/* (the loop starts once the start has played, or with it) */
+				if (VALID_INDEX(track_index, looping_definition->tracks.count) &&
+					!TEST_FLAG(TAG_BLOCK_GET_ELEMENT(&looping_definition->tracks, track_index,
+						struct looping_sound_track)->flags, COOP_SOUND_TRACK_FADE_IN_AT_START_BIT))
+				{
+					sync->start_milliseconds[track_index] = played;
+				}
+				coop_sound_sync_log(looping_definition_index, track_index, part, played + into, "played out",
+					index, 0);
+				return _coop_sound_sync_skip;
+			}
+			if (!linked)
+			{
+				/* (a loop of one permutation repeats it) */
+				byte_offset = coop_sound_permutation_byte_offset(definition, permutation, played_pitch,
+					into % length);
+				*permutation_index = index;
+				if (byte_offset > 0)
+					coop_sound_offset_note(sound_index, permutation, byte_offset);
+				coop_sound_sync_log(looping_definition_index, track_index, part, played + into, "repeats",
+					index, byte_offset);
+				return _coop_sound_sync_play;
+			}
+			sync->finished = TRUE;
+			coop_sound_sync_log(looping_definition_index, track_index, part, played + into, "has played out",
+				index, 0);
+			return _coop_sound_sync_finished;
+		}
+		index = next_index;
+	}
+	/* (a chain that comes back on itself: from where it was) */
+	return _coop_sound_sync_play;
+}
+
+void coop_sound_sync_refreshed(
+	long looping_definition_index,
+	long loop_identifier,
+	boolean started)
+{
+	struct coop_sound_sync *sync;
+
+	if (!started || (sync = coop_sound_sync_find(looping_definition_index)) == NULL || sync->placed)
+		return;
+	if (looping_sound_definition_get(looping_definition_index)->runtime_scripting_sound_index == loop_identifier)
+		sync->placed = TRUE;
+}
+
+long coop_sound_sync_take_offset(
+	long sound_index,
+	struct sound_permutation const *permutation)
+{
+	short index;
+
+	if (!coop_sound_syncs_initialized || sound_index == NONE)
+		return 0;
+	for (index = 0; index < MAXIMUM_COOP_SOUND_OFFSETS; index++)
+	{
+		if (coop_sound_offsets[index].sound_index == sound_index)
+		{
+			long byte_offset = coop_sound_offsets[index].permutation == permutation ?
+				coop_sound_offsets[index].byte_offset : 0;
+
+			coop_sound_offsets[index].sound_index = NONE;
+			return byte_offset;
+		}
+	}
+	return 0;
+}
diff --git a/port/linux/game/coop_sound_sync.h b/port/linux/game/coop_sound_sync.h
new file mode 100644
index 00000000..1e1f383e
--- /dev/null
+++ b/port/linux/game/coop_sound_sync.h
@@ -0,0 +1,56 @@
+/*
+COOP_SOUND_SYNC.H
+
+A co-op client that joins during a looping sound that plays once starts it
+where the host has reached (coop_sound_sync.c).
+*/
+#ifndef __COOP_SOUND_SYNC_H
+#define __COOP_SOUND_SYNC_H
+
+struct sound_permutation;
+
+/* which part of a looping sound's track (sound_manager.c's sound types) */
+enum coop_sound_sync_part
+{
+	_coop_sound_sync_start_part,
+	_coop_sound_sync_loop_part,
+	_coop_sound_sync_stop_part,
+};
+
+/* what a part about to play does (coop_sound_sync_place) */
+enum coop_sound_sync_placement
+{
+	/* it plays (from where it was placed) */
+	_coop_sound_sync_play,
+	/* it has played out on the host: it does not play, and the next part does */
+	_coop_sound_sync_skip,
+	/* the sound has played out on the host: nothing more of it plays */
+	_coop_sound_sync_finished,
+};
+
+/* the client (network_coop.c): the host's start of a looping sound that plays
+once, which it started elapsed_milliseconds before (0 or less: just now) */
+void coop_sound_sync_begin(long looping_definition_index, long elapsed_milliseconds);
+/* the most a sound plays, in milliseconds (the longest of its pitch ranges'
+first permutations, each with the linked ones that follow it, at its slowest
+pitch), an hour at most, or 0 for none */
+long coop_sound_sync_sound_milliseconds(long sound_index);
+/* the client: the host stopped it */
+void coop_sound_sync_end(long looping_definition_index);
+/* a new game */
+void coop_sound_sync_reset(void);
+
+/* sound_manager.c: a part of a looping sound's track about to play, its pitch
+range chosen, its first permutation (which this may move along its linked
+chain) and the pitch it plays at (the range's playback rate included) */
+short coop_sound_sync_place(long looping_definition_index, long loop_identifier, short track_index,
+	short part, long definition_index, short pitch_range_index, short *permutation_index, real played_pitch,
+	long sound_index);
+/* sound_manager.c: a looping sound's refresh is over; started, it has placed
+its parts (a refresh can start nothing: no listener hears it yet) */
+void coop_sound_sync_refreshed(long looping_definition_index, long loop_identifier, boolean started);
+/* sound_manager.c: how far into its samples a sound's first permutation
+starts (a block's start; 0: at its beginning) */
+long coop_sound_sync_take_offset(long sound_index, struct sound_permutation const *permutation);
+
+#endif
diff --git a/port/linux/game/game_modes.c b/port/linux/game/game_modes.c
new file mode 100644
index 00000000..5dd33049
--- /dev/null
+++ b/port/linux/game/game_modes.c
@@ -0,0 +1,449 @@
+/*
+GAME_MODES.C
+
+OpenCE's gametypes: SWAT, Infection and Gun Game, modes of Slayer, and
+Hardcore, rules over any game engine's. Which a gametype plays is in its PC
+options (game_engine.h's struct game_variant_options, from mode on), which a
+saved gametype keeps (playlist_profile.c), the network game carries to every
+machine (network_game_manager.h) and the game plays by
+(game_variant_options_get).
+
+- SWAT: no shields, and a shot to the head of any weapon kills (damage.c).
+  Its built-in gametype starts everyone with a pistol and an assault rifle,
+  with no weapons on the map, no grenades and no motion sensor.
+- Infection (infection.c): on teams. Humans are red, zombies blue; the host
+  chooses the first zombies after a countdown, a human killed joins them, and
+  the zombies win when no human is left, the humans when the time runs out.
+- Gun Game (gun_game.c): free for all. Each kill gives the killer the next
+  weapon of a list; a kill with the last wins.
+- Hardcore: no motion sensor, no aim assist, and a kill restores the
+  killer's health and shields.
+
+The built-in gametypes (game_modes_gametype) are written with the Xbox's
+default ones, after them, and the Select Gametype screen lists them in a bank
+of their own (menu_functions.c's OPENCE).
+*/
+
+#include "cseries.h"
+#include "game/game.h"
+#include "game/game_engine.h"
+#include "game/game_engine_playlist.h"
+#include "game/players.h"
+#include "networking/network_game_globals.h"
+#include "objects/objects.h"
+#include "units/units.h"
+#include "game_modes.h"
+#include "gun_game.h"
+#include "infection.h"
+
+#include <string.h>
+
+/* game_engine.c's values of the variant's (its enums goal_radar,
+game_engine_weapons and game_engine_vehicles) */
+enum
+{
+	GOAL_RADAR_NAV_POINT = 1,
+	WEAPON_SET_NO_GRENADES = 10,
+	VEHICLE_SET_NONE = 1
+};
+
+/* Infection's options when a gametype has none (game_modes_options_sanitize) */
+enum
+{
+	INFECTION_DEFAULT_INITIAL_ZOMBIES = 1,
+	INFECTION_DEFAULT_ZOMBIE_SPEED = 150,
+	INFECTION_DEFAULT_SKULL_DAMAGE = 200,
+	INFECTION_DEFAULT_RESPAWN_TIME = 5,
+	INFECTION_DEFAULT_COUNTDOWN = 10
+};
+
+enum
+{
+	_gametype_swat = 0,
+	_gametype_infection,
+	_gametype_gun_game,
+	_gametype_hardcore_slayer,
+	_gametype_hardcore_ctf,
+	_gametype_hardcore_oddball,
+	_gametype_hardcore_king,
+	NUMBER_OF_GAMETYPES
+};
+
+static struct
+{
+	/* debug.network_test's */
+	char const *name;
+	/* the gametype lists' */
+	wchar_t const *display_name;
+	/* the variant's own (11 characters at most: the lobby's and the server
+	browser's) */
+	wchar_t const *variant_name;
+} const game_modes_gametypes[NUMBER_OF_GAMETYPES] =
+{
+	{ "swat", L"SWAT", L"SWAT" },
+	{ "infection", L"Infection", L"Infection" },
+	{ "gun_game", L"Gun Game", L"Gun Game" },
+	{ "hardcore", L"Hardcore Slayer", L"Hardcore" },
+	{ "hardcore_ctf", L"Hardcore CTF", L"HC CTF" },
+	{ "hardcore_oddball", L"Hardcore Oddball", L"HC Oddball" },
+	{ "hardcore_king", L"Hardcore King", L"HC King" },
+};
+
+/* the kill being recorded is a melee's (game_modes_kill_by_melee) */
+static boolean game_modes_melee_kill;
+
+/* ---- the built-in gametypes */
+
+short game_modes_gametype_count(
+	void)
+{
+	return NUMBER_OF_GAMETYPES;
+}
+
+wchar_t const *game_modes_gametype_name(
+	short index)
+{
+	return VALID_INDEX(index, NUMBER_OF_GAMETYPES) ? game_modes_gametypes[index].display_name : L"";
+}
+
+/* a variant without a motion sensor: no players on it, and a goal (a flag,
+the ball, the hill) shown by its nav point instead */
+static void game_modes_no_motion_sensor(
+	struct game_variant *variant,
+	struct game_variant_options *options)
+{
+	SET_FLAG(variant->universal_variant.flags, _game_variant_draw_object_in_motion_sensor_bit, FALSE);
+	variant->universal_variant.goal_radar = GOAL_RADAR_NAV_POINT;
+	options->radar_players = _radar_players_none;
+}
+
+void game_modes_gametype(
+	short index,
+	struct game_variant *variant,
+	struct game_variant_options *options)
+{
+	struct game_variant temporary;
+
+	switch (index)
+	{
+	case _gametype_hardcore_ctf:
+		*variant = *build_game_variant_ctf(&temporary);
+		break;
+	case _gametype_hardcore_oddball:
+		*variant = *build_game_variant_team_oddball(&temporary);
+		break;
+	case _gametype_hardcore_king:
+		*variant = *build_game_variant_team_king(&temporary);
+		break;
+	case _gametype_gun_game:
+		*variant = *build_game_variant_slayer(&temporary);
+		break;
+	default:
+		*variant = *build_game_variant_team_slayer(&temporary);
+		break;
+	}
+	game_variant_options_default(variant, options);
+
+	switch (index)
+	{
+	case _gametype_swat:
+		options->mode = _game_mode_swat;
+		SET_FLAG(variant->universal_variant.flags, _game_variant_no_shields_bit, TRUE);
+		variant->universal_variant.weapon_set = WEAPON_SET_NO_GRENADES;
+		variant->universal_variant.vehicle_set = VEHICLE_SET_NONE;
+		variant->universal_variant.respawn_time = 150;
+		game_modes_no_motion_sensor(variant, options);
+		options->loadout = _loadout_custom;
+		options->primary_weapon = _loadout_weapon_pistol;
+		options->secondary_weapon = _loadout_weapon_assault_rifle;
+		options->no_map_weapons = TRUE;
+		break;
+	case _gametype_infection:
+		options->mode = _game_mode_infection;
+		variant->universal_variant.vehicle_set = VEHICLE_SET_NONE;
+		variant->universal_variant.respawn_time = INFECTION_DEFAULT_RESPAWN_TIME * TICKS_PER_SECOND;
+		variant->universal_variant.suicide_penalty = 0;
+		options->time_limit = 5;
+		options->friendly_fire = _friendly_fire_off;
+		break;
+	case _gametype_gun_game:
+		options->mode = _game_mode_gun_game;
+		variant->universal_variant.weapon_set = WEAPON_SET_NO_GRENADES;
+		variant->universal_variant.vehicle_set = VEHICLE_SET_NONE;
+		variant->universal_variant.respawn_time = 90;
+		variant->universal_variant.suicide_penalty = 0;
+		options->no_map_weapons = TRUE;
+		break;
+	default:
+		options->hardcore = TRUE;
+		options->friendly_fire = _friendly_fire_on;
+		game_modes_no_motion_sensor(variant, options);
+		break;
+	}
+	/* (each team's vehicles the variant's, as game_variant_options_default
+	gives them) */
+	options->vehicle_set[0] = options->vehicle_set[1] = (byte)variant->universal_variant.vehicle_set;
+	game_modes_options_sanitize(options);
+	csmemset(variant->human_readable_game_description, 0, sizeof(variant->human_readable_game_description));
+	if (VALID_INDEX(index, NUMBER_OF_GAMETYPES))
+	{
+		ustrncpy(variant->human_readable_game_description, game_modes_gametypes[index].variant_name,
+			NUMBEROF(variant->human_readable_game_description) - 1);
+	}
+}
+
+boolean game_modes_gametype_by_name(
+	char const *name,
+	struct game_variant *variant,
+	struct game_variant_options *options)
+{
+	short index;
+
+	for (index = 0; index < NUMBER_OF_GAMETYPES; index++)
+	{
+		if (!strcmp(name, game_modes_gametypes[index].name))
+		{
+			game_modes_gametype(index, variant, options);
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+
+/* ---- a gametype's options */
+
+void game_modes_options_default(
+	struct game_variant_options *options)
+{
+	options->mode = _game_mode_none;
+	options->hardcore = FALSE;
+	options->infection_initial_zombies = INFECTION_DEFAULT_INITIAL_ZOMBIES;
+	options->infection_zombie_speed = INFECTION_DEFAULT_ZOMBIE_SPEED;
+	options->infection_skull_damage = INFECTION_DEFAULT_SKULL_DAMAGE;
+	options->infection_respawn_time = INFECTION_DEFAULT_RESPAWN_TIME;
+	options->infection_countdown = INFECTION_DEFAULT_COUNTDOWN;
+	options->infection_zombie_shields = TRUE;
+	options->gun_game_order = _gun_game_order_strongest_first;
+	options->gun_game_melee_demotes = TRUE;
+	csmemset(options->reserved, 0, sizeof(options->reserved));
+}
+
+/* a byte option within its range, else its default */
+static byte game_modes_option(
+	byte value,
+	byte minimum,
+	byte maximum,
+	byte default_value)
+{
+	return value >= minimum && value <= maximum ? value : default_value;
+}
+
+void game_modes_options_sanitize(
+	struct game_variant_options *options)
+{
+	if (options->mode >= NUMBER_OF_GAME_MODES)
+		options->mode = _game_mode_none;
+	options->hardcore = options->hardcore != FALSE;
+	options->infection_initial_zombies = game_modes_option(options->infection_initial_zombies, 1, 16,
+		INFECTION_DEFAULT_INITIAL_ZOMBIES);
+	options->infection_zombie_speed = game_modes_option(options->infection_zombie_speed, 100, 200,
+		INFECTION_DEFAULT_ZOMBIE_SPEED);
+	options->infection_skull_damage = game_modes_option(options->infection_skull_damage, 100, 250,
+		INFECTION_DEFAULT_SKULL_DAMAGE);
+	options->infection_respawn_time = game_modes_option(options->infection_respawn_time, 1, 30,
+		INFECTION_DEFAULT_RESPAWN_TIME);
+	options->infection_countdown = game_modes_option(options->infection_countdown, 0, 30,
+		INFECTION_DEFAULT_COUNTDOWN);
+	options->infection_zombie_shields = options->infection_zombie_shields != FALSE;
+	if (options->gun_game_order >= NUMBER_OF_GUN_GAME_ORDERS)
+		options->gun_game_order = _gun_game_order_strongest_first;
+	options->gun_game_melee_demotes = options->gun_game_melee_demotes != FALSE;
+	csmemset(options->reserved, 0, sizeof(options->reserved));
+}
+
+short game_modes_variant_mode(
+	struct game_variant const *variant,
+	struct game_variant_options const *options)
+{
+	if (!variant || !options || variant->game_engine_index != game_engine_slayer)
+		return _game_mode_none;
+	switch (options->mode)
+	{
+	case _game_mode_swat:
+		return _game_mode_swat;
+	case _game_mode_infection:
+		return variant->universal_variant.teams ? _game_mode_infection : _game_mode_none;
+	case _game_mode_gun_game:
+		return !variant->universal_variant.teams ? _game_mode_gun_game : _game_mode_none;
+	}
+	return _game_mode_none;
+}
+
+byte game_modes_kind(
+	struct game_variant const *variant,
+	struct game_variant_options const *options)
+{
+	return (byte)(game_modes_variant_mode(variant, options) |
+		(options && options->hardcore ? GAME_MODES_KIND_HARDCORE : 0));
+}
+
+wchar_t const *game_modes_kind_name(
+	long game_engine_index,
+	byte kind,
+	boolean abbreviated)
+{
+	/* (each kind's name, and its name with Hardcore's, in full and short) */
+	static wchar_t const *const mode_names[NUMBER_OF_GAME_MODES][2][2] =
+	{
+		{ { NULL, NULL }, { NULL, NULL } },
+		{ { L"SWAT", L"SWAT" }, { L"HARDCORE SWAT", L"HC SWAT" } },
+		{ { L"INFECTION", L"INFECTION" }, { L"HARDCORE INFECTION", L"HC INFECTION" } },
+		{ { L"GUN GAME", L"GUN GAME" }, { L"HARDCORE GUN GAME", L"HC GUN GAME" } },
+	};
+	static wchar_t const *const hardcore_names[][2] =
+	{
+		{ NULL, NULL },
+		{ L"HARDCORE CTF", L"HC CTF" },
+		{ L"HARDCORE SLAYER", L"HC SLAYER" },
+		{ L"HARDCORE ODDBALL", L"HC ODDBALL" },
+		{ L"HARDCORE KING", L"HC KING" },
+		{ L"HARDCORE RACE", L"HC RACE" },
+	};
+	boolean hardcore = (kind & GAME_MODES_KIND_HARDCORE) != 0;
+	short mode = (short)(kind & ~GAME_MODES_KIND_HARDCORE);
+
+	/* (another machine's: a mode of Slayer only, and one this build knows) */
+	if (game_engine_index == game_engine_slayer && mode > _game_mode_none && mode < NUMBER_OF_GAME_MODES)
+		return mode_names[mode][hardcore][abbreviated != FALSE];
+	if (!hardcore || game_engine_index <= game_engine_none || game_engine_index >= (long)NUMBEROF(hardcore_names))
+		return NULL;
+	return hardcore_names[game_engine_index][abbreviated != FALSE];
+}
+
+wchar_t const *game_modes_variant_kind_name(
+	struct game_variant const *variant,
+	struct game_variant_options const *options)
+{
+	return variant && options ?
+		game_modes_kind_name(variant->game_engine_index, game_modes_kind(variant, options), FALSE) : NULL;
+}
+
+boolean game_modes_variant_is_opence(
+	struct game_variant const *variant,
+	struct game_variant_options const *options)
+{
+	return options && (options->hardcore || game_modes_variant_mode(variant, options) != _game_mode_none);
+}
+
+/* ---- the game being played */
+
+short game_modes_mode(
+	void)
+{
+	if (!game_engine_running())
+		return _game_mode_none;
+	return game_modes_variant_mode(game_engine_get_variant(), game_variant_options_get());
+}
+
+boolean game_modes_hardcore(
+	void)
+{
+	return game_engine_running() && game_variant_options_get()->hardcore;
+}
+
+struct game_engine *game_modes_engine(
+	struct game_engine *engine)
+{
+	switch (game_modes_mode())
+	{
+	case _game_mode_swat:
+		/* (SWAT is played without shields, whatever its variant's) */
+		SET_FLAG(game_engine_get_variant()->universal_variant.flags, _game_variant_no_shields_bit, TRUE);
+		break;
+	case _game_mode_infection:
+		return infection_engine_get(engine);
+	case _game_mode_gun_game:
+		return gun_game_engine_get(engine);
+	}
+	return engine;
+}
+
+void game_modes_postspawn(
+	long player_index)
+{
+	switch (game_modes_mode())
+	{
+	case _game_mode_infection:
+		infection_postspawn(player_index);
+		break;
+	case _game_mode_gun_game:
+		gun_game_postspawn(player_index);
+		break;
+	}
+}
+
+void game_modes_player_killed(
+	long killing_player_index,
+	long dead_player_index,
+	boolean friendly_fire)
+{
+	struct player_datum *killer;
+	struct unit_datum *unit;
+
+	/* Hardcore: the host restores the killer's health, and their shields
+	unless an overshield has them past full */
+	if (!game_modes_hardcore() || network_game_distributed_client() || friendly_fire ||
+		killing_player_index == NONE || killing_player_index == dead_player_index)
+	{
+		return;
+	}
+	killer = player_try_and_get(killing_player_index);
+	if (!killer || killer->unit_index == NONE)
+		return;
+	unit = unit_try_and_get(killer->unit_index);
+	if (!unit || TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+		return;
+	unit->object.body_vitality = 1.0f;
+	if (unit->object.maximum_shield_vitality > 0.0f && unit->object.shield_vitality < 1.0f)
+	{
+		unit->object.shield_vitality = 1.0f;
+		SET_FLAG(unit->object.damage_flags, _object_shield_depleted_bit, FALSE);
+		SET_FLAG(unit->object.damage_flags, _object_shield_charging_bit, FALSE);
+	}
+}
+
+void game_modes_kill_by_melee(
+	boolean melee)
+{
+	game_modes_melee_kill = melee;
+}
+
+boolean game_modes_killed_by_melee(
+	void)
+{
+	return game_modes_melee_kill;
+}
+
+boolean game_modes_headshot_kills(
+	long object_index,
+	boolean shot)
+{
+	struct unit_datum *unit;
+
+	if (!shot || game_modes_mode() != _game_mode_swat)
+		return FALSE;
+	unit = (struct unit_datum *)object_try_and_get_and_verify_type(object_index, _object_mask_biped);
+	return unit && unit->unit.player_index != NONE;
+}
+
+boolean game_modes_motion_sensor_hidden(
+	void)
+{
+	return game_modes_hardcore();
+}
+
+boolean game_modes_aim_assist_off(
+	void)
+{
+	return game_modes_hardcore();
+}
diff --git a/port/linux/game/game_modes.h b/port/linux/game/game_modes.h
new file mode 100644
index 00000000..52de452c
--- /dev/null
+++ b/port/linux/game/game_modes.h
@@ -0,0 +1,88 @@
+/* game_modes.h: OpenCE's gametypes (port/linux/game/game_modes.c)
+
+SWAT, Infection and Gun Game are modes of Slayer, and Hardcore is a set of
+rules over any game engine's: a gametype's PC options (game_engine.h's struct
+game_variant_options, from mode on) say which, so a saved gametype, the
+network game and the game all carry them. The built-in ones are written with
+the Xbox's default gametypes (playlist_profile.c), after them, and the
+Select Gametype screen lists them in a bank of their own, OPENCE. */
+#ifndef HALO_GAME_MODES_H
+#define HALO_GAME_MODES_H
+
+struct game_engine;
+struct game_variant;
+struct game_variant_options;
+
+/* the built-in gametypes' place among the default ones (the Xbox's 26 come
+first: playlist_profile.c checks it) */
+#define GAME_MODES_FIRST_DEFAULT_PLAYLIST_PROFILE 26
+
+/* ---- the built-in gametypes */
+
+short game_modes_gametype_count(void);
+/* its name in the gametype lists */
+wchar_t const *game_modes_gametype_name(short index);
+/* its variant and options */
+void game_modes_gametype(short index, struct game_variant *variant, struct game_variant_options *options);
+/* the one of that name (debug.network_test's: "swat", "infection",
+"gun_game", "hardcore", "hardcore_ctf" ...), FALSE if none is */
+boolean game_modes_gametype_by_name(char const *name, struct game_variant *variant,
+	struct game_variant_options *options);
+
+/* ---- a gametype's options */
+
+/* OpenCE's options at their defaults, with no mode (a gametype's that has
+none of its own: game_variant_options_default, and one saved before them) */
+void game_modes_options_default(struct game_variant_options *options);
+/* each of OpenCE's options in range (a file's or another machine's), its
+mode's own set to their defaults where none were given */
+void game_modes_options_sanitize(struct game_variant_options *options);
+/* the mode a gametype plays: its options' if its game engine and teams
+allow it (SWAT and Infection on teams, Gun Game free for all, all of them
+Slayer), else none */
+short game_modes_variant_mode(struct game_variant const *variant, struct game_variant_options const *options);
+/* the name the menus show for its kind of game ("INFECTION", "HARDCORE
+CTF"), NULL for a game engine's own ("SLAYER") */
+wchar_t const *game_modes_variant_kind_name(struct game_variant const *variant,
+	struct game_variant_options const *options);
+/* a game's kind in a byte, as its LAN advertisement and internet listing
+carry it to the server browser: the mode it plays (game_modes_variant_mode),
+and GAME_MODES_KIND_HARDCORE */
+#define GAME_MODES_KIND_HARDCORE 0x80
+byte game_modes_kind(struct game_variant const *variant, struct game_variant_options const *options);
+/* the name of a game engine's game of that kind, in full or abbreviated
+("HC CTF": the server browser's column), NULL for the game engine's own
+(another machine's kind: a mode of any game engine but Slayer, or one this
+build does not know, is none) */
+wchar_t const *game_modes_kind_name(long game_engine_index, byte kind, boolean abbreviated);
+/* whether a gametype is one of OpenCE's (a mode, or Hardcore) */
+boolean game_modes_variant_is_opence(struct game_variant const *variant, struct game_variant_options const *options);
+
+/* ---- the game being played */
+
+/* its mode (_game_mode_none with no game engine) */
+short game_modes_mode(void);
+/* whether it plays by Hardcore's rules */
+boolean game_modes_hardcore(void);
+/* the game engine a mode plays with: Infection's and Gun Game's are
+Slayer's with their own rules; SWAT's variant has no shields
+(game_engine_initialize) */
+struct game_engine *game_modes_engine(struct game_engine *engine);
+/* a player's spawn, after its starting equipment (game_engine_postspawn_player_update) */
+void game_modes_postspawn(long player_index);
+/* a player killed (game_engine_player_killed, after the game engine's):
+Hardcore's restore of the killer */
+void game_modes_player_killed(long killing_player_index, long dead_player_index, boolean friendly_fire);
+/* the kill being recorded is a melee's (damage.c, around
+game_statistics_record_kill) */
+void game_modes_kill_by_melee(boolean melee);
+boolean game_modes_killed_by_melee(void);
+/* a shot's hit on a player's head (a bullet's, a plasma bolt's, a needle's,
+not a melee's or an explosion's) kills at once (SWAT) */
+boolean game_modes_headshot_kills(long object_index, boolean shot);
+/* the motion sensor is not drawn (Hardcore) */
+boolean game_modes_motion_sensor_hidden(void);
+/* no aim assist: neither autoaim nor magnetism (Hardcore) */
+boolean game_modes_aim_assist_off(void);
+
+#endif
diff --git a/port/linux/game/gun_game.c b/port/linux/game/gun_game.c
new file mode 100644
index 00000000..4cc8caac
--- /dev/null
+++ b/port/linux/game/gun_game.c
@@ -0,0 +1,308 @@
+/*
+GUN_GAME.C
+
+Gun Game, a mode of free for all Slayer (game_modes.c). Everyone starts with
+the first weapon of a list and nothing else; each kill gives the killer the
+next, and a kill with the last wins. A player's level is their Slayer score
+(the kills less the suicides), so the scores the host sends its clients
+(game_engine_slayer_write_network_state) carry it, and the game ends as
+Slayer's does, at the score to win, which is the list's length.
+
+The list is those of the loadout weapons (game_engine.h's _loadout_weapon_*)
+the map has, the strongest first (the rocket launcher, the shotgun, the
+sniper rifle, the plasma rifle, the assault rifle, the needler, the plasma
+pistol, the pistol), the weakest first, or in an order the host draws for
+each game. Only the host gives weapons: a player's weapons go to every
+machine with their inventory (network_objects.c). No one picks up a
+weapon; a weapon emptied is replaced with a full one; and a melee kill can
+take the victim back a weapon (gun_game_melee_demotes).
+*/
+
+#include "cseries.h"
+#include "game/game.h"
+#include "game/game_engine.h"
+#include "game/game_engine_slayer.h"
+#include "game/players.h"
+#include "items/weapons.h"
+#include "items/weapon_definitions.h"
+#include "networking/network_game_globals.h"
+#include "objects/objects.h"
+#include "units/units.h"
+#include "game_modes.h"
+#include "gun_game.h"
+
+static byte const gun_game_strongest_first[] =
+{
+	_loadout_weapon_rocket_launcher,
+	_loadout_weapon_shotgun,
+	_loadout_weapon_sniper_rifle,
+	_loadout_weapon_plasma_rifle,
+	_loadout_weapon_assault_rifle,
+	_loadout_weapon_needler,
+	_loadout_weapon_plasma_pistol,
+	_loadout_weapon_pistol,
+};
+
+#define GUN_GAME_MAXIMUM_LEVELS NUMBEROF(gun_game_strongest_first)
+
+static struct
+{
+	struct game_engine engine;
+	struct game_engine slayer;
+	/* the map's list, its weapons as _loadout_weapon_* */
+	byte levels[GUN_GAME_MAXIMUM_LEVELS];
+	short level_count;
+	/* the host's: each player's unit given a level's weapon, and that level
+	(by absolute player index) */
+	long equipped_unit[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	short equipped_level[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	/* a weapon being given (gun_game_allow_pick_up allows it) */
+	boolean equipping;
+} gun_game;
+
+short gun_game_level_count(
+	void)
+{
+	return gun_game.level_count;
+}
+
+byte gun_game_level_weapon(
+	short level)
+{
+	return VALID_INDEX(level, gun_game.level_count) ? gun_game.levels[level] : _loadout_weapon_none;
+}
+
+/* a player's level: their score, within the list */
+static short gun_game_player_level(
+	long player_index)
+{
+	long score = gun_game.slayer.get_player_score(player_index, _get_score_individual);
+
+	return (short)PIN(score, 0, MAX(gun_game.level_count - 1, 0));
+}
+
+/* a weapon with no rounds left (none loaded nor carried), or a battery
+spent */
+static boolean gun_game_weapon_empty(
+	long weapon_index)
+{
+	struct weapon_datum *weapon = weapon_try_and_get(weapon_index);
+	struct weapon_definition *definition;
+	short magazine;
+	boolean holds_rounds = FALSE;
+
+	if (!weapon)
+		return FALSE;
+	definition = weapon_definition_get(weapon->definition_index);
+	if (definition->weapon.magazines.count <= 0)
+		return weapon->weapon.age >= 1.0f;
+	for (magazine = 0; magazine < MIN(definition->weapon.magazines.count, NUMBEROF(weapon->weapon.magazines));
+		magazine++)
+	{
+		struct weapon_magazine_definition const *magazine_definition =
+			TAG_BLOCK_GET_ELEMENT(&definition->weapon.magazines, magazine, struct weapon_magazine_definition);
+
+		/* (a battery weapon's magazine holds no rounds: the plasma rifle's and plasma pistol's) */
+		if (magazine_definition->rounds_loaded_maximum <= 0 && magazine_definition->rounds_total_maximum <= 0)
+			continue;
+		holds_rounds = TRUE;
+		if (weapon->weapon.magazines[magazine].rounds_loaded > 0 || weapon->weapon.magazines[magazine].rounds_total > 0)
+			return FALSE;
+	}
+	return holds_rounds ? TRUE : weapon->weapon.age >= 1.0f;
+}
+
+/* every weapon of a unit gone, the one in its hand too (which
+unit_delete_all_weapons keeps) */
+static void gun_game_delete_weapons(
+	long unit_index)
+{
+	struct unit_datum *unit = unit_get(unit_index);
+	short slot;
+	short other;
+
+	for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+	{
+		long weapon_index = unit->unit.weapon_object_indices[slot];
+
+		if (weapon_index == NONE)
+			continue;
+		/* (each deleted once, should two slots hold it) */
+		for (other = slot; other < MAXIMUM_WEAPONS_PER_UNIT; other++)
+		{
+			if (unit->unit.weapon_object_indices[other] == weapon_index)
+			{
+				unit->unit.weapon_object_indices[other] = NONE;
+				if (unit->unit.current_weapon_index == other)
+					unit->unit.current_weapon_index = NONE;
+				if (unit->unit.desired_weapon_index == other)
+					unit->unit.desired_weapon_index = NONE;
+			}
+		}
+		if (object_try_and_get(weapon_index))
+			object_delete(weapon_index);
+	}
+}
+
+/* the host gives a living player their level's weapon (their others gone),
+again when it is spent */
+static void gun_game_equip(
+	long player_index)
+{
+	struct player_datum *player = player_get(player_index);
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index);
+	struct unit_datum *unit;
+	short level;
+	long definition_index;
+	long weapon_index;
+	struct object_placement_data placement;
+
+	if (network_game_distributed_client() || !VALID_INDEX(slot, HALO_PORT_MAXIMUM_NETWORK_PLAYERS) ||
+		player->quit_out_of_game || player->unit_index == NONE || !gun_game.level_count)
+	{
+		return;
+	}
+	unit = unit_try_and_get(player->unit_index);
+	if (!unit || TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+		return;
+	level = gun_game_player_level(player_index);
+	if (gun_game.equipped_unit[slot] == player->unit_index && gun_game.equipped_level[slot] == level)
+	{
+		long current = VALID_INDEX(unit->unit.current_weapon_index, MAXIMUM_WEAPONS_PER_UNIT) ?
+			unit->unit.weapon_object_indices[unit->unit.current_weapon_index] : NONE;
+
+		if (current != NONE && !gun_game_weapon_empty(current))
+			return;
+	}
+	/* (no weapon in the hand: a grenade being thrown has it, so wait) */
+	if (unit->unit.grenade_throw_state != _unit_grenade_throw_idle)
+		return;
+	definition_index = game_engine_loadout_weapon_definition(gun_game.levels[level]);
+	if (definition_index == NONE)
+		return;
+	gun_game.equipping = TRUE;
+	gun_game_delete_weapons(player->unit_index);
+	object_placement_data_new(&placement, definition_index, NONE);
+	weapon_index = object_new(&placement);
+	if (weapon_index != NONE && !unit_add_weapon_to_inventory(player->unit_index, weapon_index, 2))
+	{
+		object_delete(weapon_index);
+		weapon_index = NONE;
+	}
+	gun_game.equipping = FALSE;
+	gun_game.equipped_unit[slot] = player->unit_index;
+	gun_game.equipped_level[slot] = level;
+}
+
+void gun_game_postspawn(
+	long player_index)
+{
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index);
+
+	if (VALID_INDEX(slot, HALO_PORT_MAXIMUM_NETWORK_PLAYERS))
+		gun_game.equipped_unit[slot] = NONE;
+	gun_game_equip(player_index);
+}
+
+/* the map's list, in the gametype's order */
+static void gun_game_levels_build(
+	void)
+{
+	short order = game_variant_options_get()->gun_game_order;
+	short index;
+
+	gun_game.level_count = 0;
+	for (index = 0; index < (short)GUN_GAME_MAXIMUM_LEVELS; index++)
+	{
+		byte weapon = gun_game_strongest_first[order == _gun_game_order_weakest_first ?
+			GUN_GAME_MAXIMUM_LEVELS - 1 - index : index];
+
+		if (game_engine_loadout_weapon_definition(weapon) != NONE)
+			gun_game.levels[gun_game.level_count++] = weapon;
+	}
+	/* (the host's draw: only the host gives weapons) */
+	if (order == _gun_game_order_random && !network_game_distributed_client())
+	{
+		for (index = gun_game.level_count - 1; index > 0; index--)
+		{
+			short other = (short)local_random_range(0, index + 1);
+			byte weapon = gun_game.levels[index];
+
+			gun_game.levels[index] = gun_game.levels[other];
+			gun_game.levels[other] = weapon;
+		}
+	}
+}
+
+static boolean gun_game_initialize_for_new_map(
+	void)
+{
+	gun_game_levels_build();
+	csmemset(gun_game.equipped_unit, 0xFF, sizeof(gun_game.equipped_unit));
+	csmemset(gun_game.equipped_level, 0xFF, sizeof(gun_game.equipped_level));
+	gun_game.equipping = FALSE;
+	/* (the game is won with a kill with the last weapon: every machine's
+	list is as long) */
+	if (gun_game.level_count)
+		game_engine_get_variant()->universal_variant.score_to_win = gun_game.level_count;
+	return gun_game.slayer.initialize_for_new_map ? gun_game.slayer.initialize_for_new_map() : TRUE;
+}
+
+static void gun_game_player_update_each_tick(
+	long player_index)
+{
+	if (gun_game.slayer.player_update_each_tick)
+		gun_game.slayer.player_update_each_tick(player_index);
+	gun_game_equip(player_index);
+}
+
+/* only the weapons given (and a weapon held, which readying it asks of) */
+static boolean gun_game_allow_pick_up(
+	long unit_index,
+	long weapon_index)
+{
+	struct unit_datum *unit = unit_try_and_get(unit_index);
+	short slot;
+
+	if (gun_game.equipping)
+		return TRUE;
+	for (slot = 0; unit && slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+	{
+		if (unit->unit.weapon_object_indices[slot] == weapon_index)
+			return TRUE;
+	}
+	return FALSE;
+}
+
+static void gun_game_player_killed_player(
+	long killing_player_index,
+	long killing_object_index,
+	long dead_player_index,
+	boolean friendly_fire)
+{
+	gun_game.slayer.player_killed_player(killing_player_index, killing_object_index, dead_player_index, friendly_fire);
+	if (network_game_distributed_client() || player_get(dead_player_index)->quit_out_of_game)
+		return;
+	/* a melee kill takes the victim back a weapon */
+	if (game_variant_options_get()->gun_game_melee_demotes && game_modes_killed_by_melee() && !friendly_fire &&
+		killing_player_index != NONE && killing_player_index != dead_player_index &&
+		gun_game.slayer.get_player_score(dead_player_index, _get_score_individual) > 0)
+	{
+		game_engine_slayer_adjust_score(dead_player_index, -1);
+	}
+	/* (a suicide at the first weapon leaves the score at 0) */
+	if (gun_game.slayer.get_player_score(dead_player_index, _get_score_individual) < 0)
+		game_engine_slayer_adjust_score(dead_player_index, 1);
+}
+
+struct game_engine *gun_game_engine_get(
+	struct game_engine const *slayer)
+{
+	gun_game.slayer = *slayer;
+	gun_game.engine = *slayer;
+	gun_game.engine.initialize_for_new_map = gun_game_initialize_for_new_map;
+	gun_game.engine.player_update_each_tick = gun_game_player_update_each_tick;
+	gun_game.engine.allow_pick_up = gun_game_allow_pick_up;
+	gun_game.engine.player_killed_player = gun_game_player_killed_player;
+	return &gun_game.engine;
+}
diff --git a/port/linux/game/gun_game.h b/port/linux/game/gun_game.h
new file mode 100644
index 00000000..e1cc301a
--- /dev/null
+++ b/port/linux/game/gun_game.h
@@ -0,0 +1,16 @@
+/* gun_game.h: Gun Game, a mode of free for all Slayer (port/linux/game/gun_game.c) */
+#ifndef HALO_GUN_GAME_H
+#define HALO_GUN_GAME_H
+
+struct game_engine;
+
+/* Slayer's engine with Gun Game's rules (game_modes_engine) */
+struct game_engine *gun_game_engine_get(struct game_engine const *slayer);
+/* a player spawned: their weapon (game_modes_postspawn) */
+void gun_game_postspawn(long player_index);
+/* the weapons of the map's list (each machine's alike), and a level's (a
+_loadout_weapon_*) */
+short gun_game_level_count(void);
+byte gun_game_level_weapon(short level);
+
+#endif
diff --git a/port/linux/game/infection.c b/port/linux/game/infection.c
new file mode 100644
index 00000000..344e1d5f
--- /dev/null
+++ b/port/linux/game/infection.c
@@ -0,0 +1,972 @@
+/*
+INFECTION.C
+
+Infection, a mode of team Slayer (game_modes.c). Humans are red and keep the
+gametype's equipment; zombies are blue, carry the Oddball skull and nothing
+else, and fight on foot, faster than humans, their skull's melee stronger.
+The round waits for two living players, counts down, and then the host
+chooses the first zombies (leaving at least one human). A human killed by a
+zombie, by themselves or by the world becomes a zombie (one killed by a
+teammate does not); a zombie respawns a zombie, and a player who joins late
+joins the zombies. The zombies win when no human is left, the humans when the
+round's time runs out. Each player scores a kill of the other side.
+
+Only the host decides: it chooses the zombies, turns the dead, gives the
+skulls and ends the round, and sends every client its state
+(struct distributed_infection_state, with the game type's:
+game_engine_write_network_state), which a client checks whole before taking.
+Each machine then sets each player's team, speed and shields by their role.
+
+Its options are the gametype's (game_engine.h's struct game_variant_options,
+infection_*). The rules and much of the code follow the Infection of pull
+request #420 by arisson2001rojas-design.
+*/
+
+#include "cseries.h"
+#include "game/game.h"
+#include "game/game_engine.h"
+#include "game/players.h"
+#include "math/real_math.h"
+#include "memory/data.h"
+#include "networking/network_game_globals.h"
+#include "networking/network_game_manager.h"
+#include "networking/network_server_manager.h"
+#include "objects/objects.h"
+#include "objects/object_definitions.h"
+#include "physics/collisions.h"
+#include "text/unicode.h"
+#include "units/units.h"
+#include "units/unit_definitions.h"
+#include "game_modes.h"
+#include "infection.h"
+#include "network_infection.h"
+
+void platform_log(char const *format, ...);
+
+/* a score past this is not a client's to take */
+#define INFECTION_MAXIMUM_SCORE 1000000
+
+static struct
+{
+	struct game_engine engine;
+	struct game_engine slayer;
+	struct distributed_infection_state state;
+	/* the host's, by absolute player index: the player of the slot, the unit
+	given its role's equipment, the unit counted dead, the skull given, and
+	the unit whose shields a zombie's role took (and their maximum) */
+	long participant[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	long equipped_unit[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	long killed_unit[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	long skull[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	long shield_unit[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	real shield_maximum[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	/* a skull being given (the pickup checks allow it) */
+	boolean equipping;
+	/* the map has no skull, or one could not be given: the round ends */
+	boolean missing_skull;
+} infection;
+
+/* ---- the players' roles */
+
+boolean infection_enabled(
+	void)
+{
+	return game_modes_mode() == _game_mode_infection;
+}
+
+/* a player's identity on every machine: their name and place in the game */
+static unsigned long infection_player_identity(
+	long player_index)
+{
+	struct network_player const *network_player = &player_get(player_index)->network_player_data;
+	unsigned long hash = 2166136261UL;
+	short index;
+
+	for (index = 0; index < NUMBEROF(network_player->name); index++)
+		hash = (hash ^ (word)network_player->name[index]) * 16777619UL;
+	hash = (hash ^ (byte)network_player->machine_index) * 16777619UL;
+	hash = (hash ^ (byte)network_player->controller_index) * 16777619UL;
+	hash = (hash ^ (byte)network_player->player_list_index) * 16777619UL;
+	return hash ? hash : 1;
+}
+
+/* a player's role, if the state has it for them (not one who left, whose
+slot another took) */
+static struct distributed_infection_player *infection_player(
+	long player_index)
+{
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index);
+
+	if (player_index == NONE || !VALID_INDEX(slot, HALO_PORT_MAXIMUM_NETWORK_PLAYERS) ||
+		!player_try_and_get(player_index) ||
+		infection.state.players[slot].identity != infection_player_identity(player_index))
+	{
+		return NULL;
+	}
+	return &infection.state.players[slot];
+}
+
+static boolean infection_weapon_is_skull(
+	long weapon_index)
+{
+	struct object_datum *object = object_try_and_get_and_verify_type(weapon_index, _object_mask_weapon);
+
+	return object && object->definition_index == get_ball_definition_index();
+}
+
+boolean infection_can_delete_skull(
+	long object_index)
+{
+	return infection_enabled() && infection_weapon_is_skull(object_index);
+}
+
+boolean infection_unit_is_zombie(
+	long unit_index)
+{
+	struct unit_datum *unit;
+	struct distributed_infection_player *role;
+
+	if (unit_index == NONE || !infection_enabled() || (unit = unit_try_and_get(unit_index)) == NULL)
+		return FALSE;
+	role = infection_player(unit->unit.player_index);
+	return role && role->role == _distributed_infection_role_zombie;
+}
+
+/* asked of a player's own drops only: a death, and the inventories the host
+sends, still take a skull away */
+boolean infection_allow_weapon_drop(
+	long unit_index,
+	long weapon_index)
+{
+	struct unit_datum *unit;
+	struct player_datum *player;
+
+	if (!infection_enabled() || infection.state.phase != _distributed_infection_active || infection.equipping ||
+		!infection_unit_is_zombie(unit_index))
+	{
+		return TRUE;
+	}
+	unit = unit_get(unit_index);
+	player = player_try_and_get(unit->unit.player_index);
+	if (!player || player->quit_out_of_game || player->unit_index != unit_index ||
+		TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+	{
+		return TRUE;
+	}
+	return !infection_weapon_is_skull(weapon_index);
+}
+
+/* a zombie's skull in the hand */
+static boolean infection_unit_holds_skull(
+	long unit_index)
+{
+	struct unit_datum *unit = unit_get(unit_index);
+
+	return VALID_INDEX(unit->unit.current_weapon_index, MAXIMUM_WEAPONS_PER_UNIT) &&
+		infection_weapon_is_skull(unit->unit.weapon_object_indices[unit->unit.current_weapon_index]);
+}
+
+real infection_melee_multiplier(
+	long unit_index)
+{
+	if (!infection_unit_is_zombie(unit_index) || infection.state.phase != _distributed_infection_active ||
+		!infection_unit_holds_skull(unit_index))
+	{
+		return 1.0f;
+	}
+	return game_variant_options_get()->infection_skull_damage / 100.0f;
+}
+
+/* a living human in a seat of a vehicle that is not hidden, whom a zombie
+holding its skull struck itself (not the vehicle: Slayer's melee hits the
+vehicle a rider is in) */
+boolean infection_melee_rider_target(
+	long attacker_index,
+	long target_index)
+{
+	struct unit_datum *target;
+	struct unit_datum *vehicle;
+	struct distributed_infection_player *role;
+	struct unit_definition *definition;
+	short seat;
+
+	if (!infection_unit_is_zombie(attacker_index) || infection.state.phase != _distributed_infection_active ||
+		!infection_unit_holds_skull(attacker_index))
+	{
+		return FALSE;
+	}
+	target = unit_try_and_get(target_index);
+	if (!target || target->object.type != _object_type_biped || TEST_FLAG(target->object.damage_flags, _object_dead_bit))
+		return FALSE;
+	role = infection_player(target->unit.player_index);
+	if (!role || role->role != _distributed_infection_role_human)
+		return FALSE;
+	vehicle = (struct unit_datum *)object_try_and_get_and_verify_type(target->object.parent_object_index,
+		_object_mask_vehicle);
+	if (!vehicle)
+		return FALSE;
+	definition = unit_definition_get(vehicle->definition_index);
+	seat = target->unit.parent_seat_index;
+	return VALID_INDEX(seat, definition->unit.seats.count) &&
+		!TEST_FLAG(TAG_BLOCK_GET_ELEMENT(&definition->unit.seats, seat, struct unit_seat)->flags,
+			_unit_seat_invisible_bit);
+}
+
+/* the host's check of a client's melee report on a rider: one of its own
+lines through the melee's cone (0.8 world units from the attacker's head,
+as the game's melee) reaches the rider, through the host's own world, not
+from a place the client says */
+boolean infection_melee_rider_visible(
+	long attacker_index,
+	long target_index,
+	real_vector3d const *direction)
+{
+	struct object_marker head;
+	real_vector3d facing = *direction;
+	real_vector3d perpendicular;
+	real_vector3d cross;
+	real_vector3d ray;
+	struct collision_result hit;
+	long outer;
+	long inner;
+
+	if (!infection_melee_rider_target(attacker_index, target_index) || normalize3d(&facing) <= 0.0f)
+		return FALSE;
+	object_get_marker_by_name(attacker_index, "head", &head, 1);
+	normalize3d(perpendicular3d(&facing, &perpendicular));
+	cross_product3d(&facing, &perpendicular, &cross);
+	for (outer = -2; outer <= 2; outer++)
+	{
+		for (inner = -2; inner <= 2; inner++)
+		{
+			ray.i = facing.i * 0.8f + (cross.i * inner + perpendicular.i * outer) * 0.1f;
+			ray.j = facing.j * 0.8f + (cross.j * inner + perpendicular.j * outer) * 0.1f;
+			ray.k = facing.k * 0.8f + (cross.k * inner + perpendicular.k * outer) * 0.1f;
+			if (collision_test_vector(_collision_test_for_projectiles_flags, &head.matrix.position, &ray,
+				attacker_index, &hit) && hit.type == _collision_result_object && hit.object_index == target_index)
+			{
+				return TRUE;
+			}
+		}
+	}
+	return FALSE;
+}
+
+/* ---- the host's round */
+
+static void infection_finish(
+	long winner)
+{
+	if (infection.state.phase == _distributed_infection_finished)
+		return;
+	infection.state.winner = winner;
+	infection.state.phase = _distributed_infection_finished;
+	infection.state.revision++;
+	platform_log("infection: finished, winner %ld", winner);
+	game_engine_end_game();
+}
+
+/* a unit's armour in its team's colour (a human turned while alive), as a
+spawn colours it; the colour channels a function drives (the shield's glow)
+are left to it */
+static void infection_color_unit(
+	struct unit_datum *unit,
+	long player_index)
+{
+	struct object_definition *definition = object_definition_get(unit->definition_index);
+	real_rgb_color color;
+	short channel;
+
+	game_engine_player_get_change_color(&color, player_index);
+	for (channel = 0; channel < NUMBER_OF_OBJECT_CHANGE_COLORS; channel++)
+	{
+		unit->object.base_change_colors[channel] = color;
+		if (channel < definition->object.change_colors.count)
+		{
+			struct object_change_color_definition *change_color = TAG_BLOCK_GET_ELEMENT(
+				&definition->object.change_colors, channel, struct object_change_color_definition);
+
+			if (change_color->scaled_by || change_color->darken_by)
+				continue;
+		}
+		unit->object.outgoing_change_colors[channel] = color;
+	}
+}
+
+/* a zombie without shields (the gametype's infection_zombie_shields): a
+shield capacity of 0, the game's own unshielded unit, which neither takes
+shield damage nor recharges; a human again (or the option on) gets the
+unit's capacity back, without healing its body */
+static void infection_apply_shields(
+	long slot,
+	long unit_index,
+	struct unit_datum *unit,
+	boolean disabled)
+{
+	if (infection.shield_unit[slot] != unit_index)
+		infection.shield_unit[slot] = NONE;
+	if (disabled)
+	{
+		if (infection.shield_unit[slot] == NONE)
+		{
+			infection.shield_unit[slot] = unit_index;
+			infection.shield_maximum[slot] = unit->object.maximum_shield_vitality;
+		}
+		unit->object.maximum_shield_vitality = 0.0f;
+		unit->object.shield_vitality = 0.0f;
+		SET_FLAG(unit->object.damage_flags, _object_shield_charging_bit, FALSE);
+		SET_FLAG(unit->object.damage_flags, _object_shield_over_charging_bit, FALSE);
+		SET_FLAG(unit->object.damage_flags, _object_shield_depleted_bit, TRUE);
+	}
+	else if (infection.shield_unit[slot] == unit_index)
+	{
+		unit->object.maximum_shield_vitality = infection.shield_maximum[slot];
+		infection.shield_unit[slot] = NONE;
+	}
+}
+
+void infection_reconcile_player(
+	long player_index)
+{
+	struct game_variant_options const *options = game_variant_options_get();
+	struct distributed_infection_player *role;
+	struct player_datum *player;
+	struct unit_datum *unit;
+	long team;
+
+	if (!infection_enabled() || (role = infection_player(player_index)) == NULL ||
+		role->role == _distributed_infection_role_none)
+	{
+		return;
+	}
+	player = player_get(player_index);
+	team = role->role == _distributed_infection_role_zombie ? 1 : 0;
+	player->team_index = team;
+	player->network_player_data.team_index = (char)team;
+	player->speed_multiplier = team ? options->infection_zombie_speed / 100.0f : 1.0f;
+	if (player->unit_index != NONE && (unit = unit_try_and_get(player->unit_index)) != NULL)
+	{
+		infection_apply_shields(DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index), player->unit_index, unit,
+			team && !options->infection_zombie_shields);
+		unit->object.owner_team_index = (short)team;
+		infection_color_unit(unit, player_index);
+		/* (a living zombie's grenades and powerups gone; a dead one's are its
+		body's, which drops them) */
+		if (team && !TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+		{
+			/* (a grenade being wound up when its thrower turned is not thrown:
+			the throw would find no grenade left) */
+			if (unit->unit.grenade_throw_state == _unit_grenade_throw_wind_up)
+				unit->unit.grenade_throw_state = _unit_grenade_throw_ending;
+			csmemset(unit->unit.grenade_counts, 0, sizeof(unit->unit.grenade_counts));
+			csmemset(player->powerup_durations, 0, sizeof(player->powerup_durations));
+		}
+	}
+	/* (and the host's game record, which the lobby and late joins read) */
+	if (!network_game_distributed_client())
+	{
+		struct network_game_server *server = global_network_game_server_get();
+		struct network_game *game = server ? network_game_server_get_game(server) : NULL;
+		long list_index = player->network_player_data.player_list_index;
+
+		if (game && VALID_INDEX(list_index, HALO_PORT_MAXIMUM_NETWORK_PLAYERS))
+			game->players[list_index].team_index = (char)team;
+	}
+}
+
+static void infection_delete_weapon(
+	long weapon_index)
+{
+	long slot;
+
+	for (slot = 0; slot < HALO_PORT_MAXIMUM_NETWORK_PLAYERS; slot++)
+	{
+		if (infection.skull[slot] == weapon_index)
+			infection.skull[slot] = NONE;
+	}
+	if (weapon_index != NONE && object_try_and_get(weapon_index))
+		object_delete(weapon_index);
+}
+
+static void infection_delete_skull(
+	long slot)
+{
+	infection_delete_weapon(infection.skull[slot]);
+	infection.skull[slot] = NONE;
+}
+
+/* a unit's weapons gone but the one kept (skulls only: a human's skull
+picked up), each deleted once */
+static void infection_strip_weapons(
+	long unit_index,
+	long keep,
+	boolean skulls_only)
+{
+	struct unit_datum *unit = unit_get(unit_index);
+	long removed[MAXIMUM_WEAPONS_PER_UNIT];
+	long count = 0;
+	long slot;
+	long previous;
+	long kept = NONE;
+
+	for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+	{
+		long weapon_index = unit->unit.weapon_object_indices[slot];
+
+		if (weapon_index == NONE)
+			continue;
+		if (weapon_index == keep && kept == NONE)
+		{
+			kept = slot;
+			continue;
+		}
+		if (skulls_only && !infection_weapon_is_skull(weapon_index))
+			continue;
+		unit->unit.weapon_object_indices[slot] = NONE;
+		if (unit->unit.current_weapon_index == slot)
+			unit->unit.current_weapon_index = NONE;
+		if (unit->unit.desired_weapon_index == slot)
+			unit->unit.desired_weapon_index = NONE;
+		if (weapon_index == keep)
+			continue;
+		for (previous = 0; previous < count && removed[previous] != weapon_index; previous++)
+		{
+		}
+		if (previous == count)
+			removed[count++] = weapon_index;
+	}
+	for (slot = 0; slot < count; slot++)
+		infection_delete_weapon(removed[slot]);
+	if (kept != NONE)
+		unit->unit.desired_weapon_index = (short)kept;
+	else if (unit->unit.desired_weapon_index == NONE)
+		unit->unit.desired_weapon_index = unit_inventory_next_weapon(unit_index, NONE, 0);
+}
+
+/* the host gives a living player their role's equipment: a zombie its skull
+alone (out of any vehicle, without grenades or powerups), a human what they
+spawned with, without a skull */
+static void infection_equip(
+	long player_index)
+{
+	struct player_datum *player = player_get(player_index);
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index);
+	struct distributed_infection_player *role = infection_player(player_index);
+	struct unit_datum *unit;
+	long weapon_index;
+	short inventory_slot;
+
+	if (network_game_distributed_client() || !role || player->quit_out_of_game || player->unit_index == NONE ||
+		infection.missing_skull)
+	{
+		return;
+	}
+	unit = unit_get(player->unit_index);
+	if (TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+		return;
+	if (infection.equipped_unit[slot] == player->unit_index)
+	{
+		if (role->role == _distributed_infection_role_human)
+		{
+			infection_strip_weapons(player->unit_index, NONE, TRUE);
+			return;
+		}
+		/* (a zombie still holding its skull keeps it; any other weapon goes) */
+		for (inventory_slot = 0; inventory_slot < MAXIMUM_WEAPONS_PER_UNIT; inventory_slot++)
+		{
+			weapon_index = unit->unit.weapon_object_indices[inventory_slot];
+			if (infection_weapon_is_skull(weapon_index))
+			{
+				if (infection.skull[slot] != weapon_index)
+					infection_delete_skull(slot);
+				infection.skull[slot] = weapon_index;
+				infection_strip_weapons(player->unit_index, weapon_index, FALSE);
+				return;
+			}
+		}
+	}
+	infection.equipping = TRUE;
+	infection_strip_weapons(player->unit_index, NONE, role->role == _distributed_infection_role_human);
+	infection_delete_skull(slot);
+	if (role->role == _distributed_infection_role_zombie)
+	{
+		if (unit->object.parent_object_index != NONE)
+			unit_exit_seat_end(player->unit_index);
+		csmemset(unit->unit.grenade_counts, 0, sizeof(unit->unit.grenade_counts));
+		if (unit->unit.equipment_object_index != NONE)
+		{
+			object_delete(unit->unit.equipment_object_index);
+			unit->unit.equipment_object_index = NONE;
+		}
+		weapon_index = NONE;
+		if (get_ball_definition_index() != NONE)
+		{
+			struct object_placement_data placement;
+
+			object_placement_data_new(&placement, get_ball_definition_index(), NONE);
+			placement.owner_team_index = 1;
+			weapon_index = object_new(&placement);
+		}
+		if (weapon_index == NONE || !unit_add_weapon_to_inventory(player->unit_index, weapon_index, 2))
+		{
+			if (weapon_index != NONE)
+				object_delete(weapon_index);
+			infection.missing_skull = TRUE;
+		}
+		else
+		{
+			infection.skull[slot] = weapon_index;
+		}
+	}
+	infection.equipping = FALSE;
+	infection.equipped_unit[slot] = player->unit_index;
+	infection.killed_unit[slot] = NONE;
+}
+
+/* a player new to the round: a human before the zombies are chosen, a
+zombie after */
+static void infection_player_added(
+	long player_index)
+{
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index);
+	struct distributed_infection_player *role;
+
+	if (infection.slayer.player_added)
+		infection.slayer.player_added(player_index);
+	if (!VALID_INDEX(slot, HALO_PORT_MAXIMUM_NETWORK_PLAYERS))
+		return;
+	role = &infection.state.players[slot];
+	if (!network_game_distributed_client())
+	{
+		infection_delete_skull(slot);
+		csmemset(role, 0, sizeof(*role));
+		role->identity = infection_player_identity(player_index);
+		role->role = infection.state.phase >= _distributed_infection_active ? _distributed_infection_role_zombie :
+			_distributed_infection_role_human;
+		infection.participant[slot] = player_index;
+		infection.equipped_unit[slot] = NONE;
+		infection.killed_unit[slot] = NONE;
+		infection.state.revision++;
+	}
+	infection_reconcile_player(player_index);
+}
+
+void infection_postspawn(
+	long player_index)
+{
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index);
+
+	if (!VALID_INDEX(slot, HALO_PORT_MAXIMUM_NETWORK_PLAYERS))
+		return;
+	if (!network_game_distributed_client() && infection.participant[slot] != player_index)
+		infection_player_added(player_index);
+	infection_reconcile_player(player_index);
+	infection.equipped_unit[slot] = NONE;
+	infection_equip(player_index);
+}
+
+static void infection_player_killed_player(
+	long killing_player_index,
+	long killing_object_index,
+	long dead_player_index,
+	boolean friendly_fire)
+{
+	struct distributed_infection_player *dead = infection_player(dead_player_index);
+	struct distributed_infection_player *killer = infection_player(killing_player_index);
+	struct player_datum *player = player_get(dead_player_index);
+	long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(dead_player_index);
+	long unit_index = player->unit_index != NONE ? player->unit_index : player->dead_unit_index;
+
+	(void)killing_object_index;
+	if (network_game_distributed_client() || infection.state.phase != _distributed_infection_active || !dead ||
+		player->quit_out_of_game || infection.killed_unit[slot] != NONE)
+	{
+		return;
+	}
+	infection.killed_unit[slot] = unit_index == NONE ? 0 : unit_index;
+	if (killer && killer != dead && killer->role != dead->role && killer->score < INFECTION_MAXIMUM_SCORE)
+		killer->score++;
+	/* (a human killed by a zombie, themselves or the world turns; one killed
+	by a human teammate does not) */
+	if (dead->role == _distributed_infection_role_human &&
+		!(friendly_fire && killer && killer != dead && killer->role == dead->role))
+	{
+		dead->role = _distributed_infection_role_zombie;
+		platform_log("infection: player %ld infected", slot);
+	}
+	infection_reconcile_player(dead_player_index);
+	/* (the body's skull is deleted on the player's next tick, once the
+	unit's death has dropped what it held) */
+	infection.equipped_unit[slot] = NONE;
+	infection.state.revision++;
+}
+
+/* the round's result: 0 the humans won, 1 the zombies, 2 no one (everyone
+left), NONE still on. Turning the last human wins over the time running
+out on the same tick. */
+static long infection_round_result(
+	long humans,
+	long zombies,
+	long elapsed,
+	long limit)
+{
+	if (!humans && !zombies)
+		return 2;
+	if (!humans)
+		return 1;
+	if (!zombies || (limit > 0 && elapsed >= limit))
+		return 0;
+	return NONE;
+}
+
+static long infection_time_limit_ticks(
+	void)
+{
+	return game_variant_options_get()->time_limit * 60L * TICKS_PER_SECOND;
+}
+
+static void infection_update(
+	void)
+{
+	struct game_variant_options const *options = game_variant_options_get();
+	struct data_iterator iterator;
+	struct player_datum *player;
+	boolean present[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	long candidates[HALO_PORT_MAXIMUM_NETWORK_PLAYERS];
+	long humans = 0;
+	long zombies = 0;
+	long count = 0;
+	long index;
+	long now = game_time_get();
+
+	if (infection.slayer.update)
+		infection.slayer.update();
+	if (network_game_distributed_client() || infection.state.phase == _distributed_infection_finished)
+		return;
+	csmemset(present, 0, sizeof(present));
+	data_iterator_new(&iterator, player_data);
+	while ((player = (struct player_datum *)data_iterator_next(&iterator)) != NULL)
+	{
+		long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(iterator.datum_index);
+		struct unit_datum *unit;
+
+		if (player->quit_out_of_game || !VALID_INDEX(slot, HALO_PORT_MAXIMUM_NETWORK_PLAYERS))
+			continue;
+		present[slot] = TRUE;
+		if (infection.participant[slot] != iterator.datum_index)
+			infection_player_added(iterator.datum_index);
+		infection_reconcile_player(iterator.datum_index);
+		if (infection.state.players[slot].role == _distributed_infection_role_human)
+			humans++;
+		else
+			zombies++;
+		/* (the first zombies are chosen of the living: a full map can leave
+		players waiting to spawn) */
+		unit = player->unit_index != NONE ? unit_try_and_get(player->unit_index) : NULL;
+		if (unit && !TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+			candidates[count++] = iterator.datum_index;
+	}
+	for (index = 0; index < HALO_PORT_MAXIMUM_NETWORK_PLAYERS; index++)
+	{
+		if (!present[index] && infection.participant[index] != NONE)
+		{
+			infection_delete_skull(index);
+			infection.participant[index] = NONE;
+			infection.equipped_unit[index] = NONE;
+			infection.killed_unit[index] = NONE;
+			csmemset(&infection.state.players[index], 0, sizeof(infection.state.players[index]));
+			infection.state.revision++;
+		}
+	}
+	if (infection.missing_skull)
+	{
+		platform_log("infection: no skull to give (the map has no Oddball ball), the round ends");
+		infection_finish(NONE);
+		return;
+	}
+	if (infection.state.phase == _distributed_infection_active)
+	{
+		long result = infection_round_result(humans, zombies, now - infection.state.phase_tick,
+			infection_time_limit_ticks());
+
+		if (result != NONE)
+		{
+			platform_log("infection: result %ld, %ld humans, %ld zombies", result, humans, zombies);
+			infection_finish(result == 2 ? NONE : result);
+		}
+		return;
+	}
+	if (count < 2)
+	{
+		if (infection.state.phase != _distributed_infection_waiting)
+			infection.state.revision++;
+		infection.state.phase = _distributed_infection_waiting;
+		infection.state.phase_tick = now;
+		return;
+	}
+	if (infection.state.phase == _distributed_infection_waiting)
+	{
+		infection.state.phase = _distributed_infection_countdown;
+		infection.state.phase_tick = now;
+		infection.state.revision++;
+		platform_log("infection: countdown, %ld players", count);
+	}
+	if (now - infection.state.phase_tick < options->infection_countdown * TICKS_PER_SECOND)
+		return;
+	infection.state.phase = _distributed_infection_active;
+	infection.state.phase_tick = now;
+	/* the first zombies, drawn without repeats, leaving a human */
+	for (index = 0; index < MIN(count - 1, options->infection_initial_zombies); index++)
+	{
+		long pick = index + local_random_range(0, (short)(count - index));
+		long chosen = candidates[pick];
+		long slot = DATUM_INDEX_TO_ABSOLUTE_INDEX(chosen);
+
+		candidates[pick] = candidates[index];
+		candidates[index] = chosen;
+		infection.state.players[slot].role = _distributed_infection_role_zombie;
+		infection.equipped_unit[slot] = NONE;
+		infection_reconcile_player(chosen);
+		infection_equip(chosen);
+	}
+	infection.state.revision++;
+	platform_log("infection: active, %ld players, %ld zombies", count,
+		MIN(count - 1, (long)options->infection_initial_zombies));
+}
+
+long infection_remaining_ticks(
+	void)
+{
+	long limit = infection_time_limit_ticks();
+
+	return infection.state.phase == _distributed_infection_active ?
+		MAX(0, limit - (game_time_get() - infection.state.phase_tick)) : limit;
+}
+
+static boolean infection_initialize_for_new_map(
+	void)
+{
+	struct game_variant *variant = game_engine_get_variant();
+
+	csmemset(&infection.state, 0, sizeof(infection.state));
+	csmemset(infection.participant, 0xFF, sizeof(infection.participant));
+	csmemset(infection.equipped_unit, 0xFF, sizeof(infection.equipped_unit));
+	csmemset(infection.killed_unit, 0xFF, sizeof(infection.killed_unit));
+	csmemset(infection.skull, 0xFF, sizeof(infection.skull));
+	csmemset(infection.shield_unit, 0xFF, sizeof(infection.shield_unit));
+	infection.state.winner = NONE;
+	infection.state.game_number = network_game_get_game() ? network_game_get_number_of_games_played() : 0;
+	infection.missing_skull = get_ball_definition_index() == NONE;
+	infection.equipping = FALSE;
+	/* (everyone respawns; the variant's traits give zombies no infinite
+	grenades nor camouflage) */
+	variant->universal_variant.lives = 0;
+	variant->universal_variant.odd_man_out = FALSE;
+	SET_FLAG(variant->universal_variant.flags, _game_variant_infinite_grenades_bit, FALSE);
+	SET_FLAG(variant->universal_variant.flags, _game_variant_always_invisible_bit, FALSE);
+	return infection.slayer.initialize_for_new_map ? infection.slayer.initialize_for_new_map() : TRUE;
+}
+
+/* a skull is picked up only as it is given; a zombie picks up nothing else
+(and readying the skull it holds asks this too) */
+static boolean infection_allow_pick_up(
+	long unit_index,
+	long weapon_index)
+{
+	short slot;
+
+	if (infection.equipping)
+		return TRUE;
+	if (infection_weapon_is_skull(weapon_index))
+	{
+		if (infection_unit_is_zombie(unit_index))
+		{
+			for (slot = 0; slot < MAXIMUM_WEAPONS_PER_UNIT; slot++)
+			{
+				if (unit_get(unit_index)->unit.weapon_object_indices[slot] == weapon_index)
+					return TRUE;
+			}
+		}
+		return FALSE;
+	}
+	return !infection_unit_is_zombie(unit_index);
+}
+
+static boolean infection_picking_up(
+	long weapon_index,
+	long player_index)
+{
+	(void)weapon_index;
+	(void)player_index;
+	return infection.equipping;
+}
+
+/* a skull dropped (its zombie killed, or forced out of a hand): given again
+on the next tick, if its zombie lives */
+static void infection_weapon_dropped(
+	long weapon_index)
+{
+	long slot;
+
+	if (network_game_distributed_client() || infection.equipping)
+		return;
+	for (slot = 0; slot < HALO_PORT_MAXIMUM_NETWORK_PLAYERS; slot++)
+	{
+		if (infection.skull[slot] == weapon_index)
+		{
+			infection.equipped_unit[slot] = NONE;
+			break;
+		}
+	}
+}
+
+static void infection_player_update_each_tick(
+	long player_index)
+{
+	struct player_datum *player = player_get(player_index);
+
+	infection_reconcile_player(player_index);
+	if (network_game_distributed_client())
+		return;
+	/* (a dead zombie's skull deleted once its unit's death has dropped it) */
+	if (player->quit_out_of_game || player->unit_index == NONE ||
+		TEST_FLAG(unit_get(player->unit_index)->object.damage_flags, _object_dead_bit))
+	{
+		infection_delete_skull(DATUM_INDEX_TO_ABSOLUTE_INDEX(player_index));
+	}
+	else
+	{
+		infection_equip(player_index);
+	}
+}
+
+static long infection_get_player_score(
+	long player_index,
+	enum get_score_type score_type)
+{
+	struct distributed_infection_player *role = infection_player(player_index);
+	long slot;
+	long score = 0;
+
+	if (!role)
+		return 0;
+	if (score_type != _get_score_team)
+		return role->score;
+	for (slot = 0; slot < HALO_PORT_MAXIMUM_NETWORK_PLAYERS; slot++)
+	{
+		if (infection.state.players[slot].role == role->role)
+			score += infection.state.players[slot].score;
+	}
+	return score;
+}
+
+static wchar_t *infection_format_player_score(
+	long player_index,
+	wchar_t *text)
+{
+	usprintf(text, L"%ld", infection_get_player_score(player_index, _get_score_individual));
+	return text;
+}
+
+/* (a team's score, whatever its name says) */
+static wchar_t *infection_format_team_score(
+	long team_index,
+	wchar_t *text)
+{
+	usprintf(text, L"%ld", game_engine_get_team_score(team_index));
+	return text;
+}
+
+static long infection_did_player_win(
+	long player_index)
+{
+	struct distributed_infection_player *role = infection_player(player_index);
+
+	if (infection.state.winner == NONE || !role)
+		return NONE;
+	return (role->role == _distributed_infection_role_zombie ? 1 : 0) == infection.state.winner;
+}
+
+struct game_engine *infection_engine_get(
+	struct game_engine const *slayer)
+{
+	infection.slayer = *slayer;
+	infection.engine = *slayer;
+	infection.engine.initialize_for_new_map = infection_initialize_for_new_map;
+	infection.engine.player_added = infection_player_added;
+	infection.engine.player_update_each_tick = infection_player_update_each_tick;
+	infection.engine.prespawn_player_update = infection_reconcile_player;
+	infection.engine.update = infection_update;
+	infection.engine.allow_pick_up = infection_allow_pick_up;
+	infection.engine.picking_up = infection_picking_up;
+	infection.engine.weapon_dropped = infection_weapon_dropped;
+	infection.engine.player_killed_player = infection_player_killed_player;
+	infection.engine.get_player_score = infection_get_player_score;
+	infection.engine.format_player_score = infection_format_player_score;
+	infection.engine.format_team_name = infection_format_team_score;
+	infection.engine.format_message = NULL;
+	infection.engine.did_player_win = infection_did_player_win;
+	return &infection.engine;
+}
+
+/* ---- the state the host sends */
+
+/* a state a client may take: of this game, no older than its own, every
+value in range */
+static boolean infection_state_valid(
+	struct distributed_infection_state const *state,
+	long game_number,
+	long revision)
+{
+	short index;
+
+	if (state->game_number != game_number || state->revision < revision || state->revision < 0 ||
+		state->phase < _distributed_infection_waiting || state->phase > _distributed_infection_finished ||
+		state->phase_tick < 0 || state->winner < NONE || state->winner > 1 ||
+		(state->phase != _distributed_infection_finished && state->winner != NONE))
+	{
+		return FALSE;
+	}
+	for (index = 0; index < HALO_PORT_MAXIMUM_NETWORK_PLAYERS; index++)
+	{
+		struct distributed_infection_player const *player = &state->players[index];
+
+		if (player->role > _distributed_infection_role_zombie || player->score < 0 ||
+			player->score > INFECTION_MAXIMUM_SCORE || (player->role && !player->identity) ||
+			player->reserved[0] || player->reserved[1] || player->reserved[2])
+		{
+			return FALSE;
+		}
+	}
+	return TRUE;
+}
+
+long infection_write_network_state(
+	byte *buffer,
+	long size)
+{
+	if (size < (long)sizeof(infection.state))
+		return 0;
+	csmemcpy(buffer, &infection.state, sizeof(infection.state));
+	return sizeof(infection.state);
+}
+
+boolean infection_read_network_state(
+	byte const *buffer,
+	long size,
+	boolean first)
+{
+	struct distributed_infection_state state;
+	struct data_iterator iterator;
+
+	if (!network_game_distributed_client() || size != (long)sizeof(state))
+		return FALSE;
+	csmemcpy(&state, buffer, sizeof(state));
+	if (!infection_state_valid(&state, network_game_get_number_of_games_played(), first ? 0 : infection.state.revision))
+		return FALSE;
+	infection.state = state;
+	data_iterator_new(&iterator, player_data);
+	while (data_iterator_next(&iterator))
+		infection_reconcile_player(iterator.datum_index);
+	return TRUE;
+}
diff --git a/port/linux/game/infection.h b/port/linux/game/infection.h
new file mode 100644
index 00000000..48bb1811
--- /dev/null
+++ b/port/linux/game/infection.h
@@ -0,0 +1,39 @@
+/* infection.h: Infection, a mode of team Slayer (port/linux/game/infection.c) */
+#ifndef HALO_INFECTION_H
+#define HALO_INFECTION_H
+
+struct game_engine;
+union real_vector3d;
+
+/* the game being played is Infection (game_modes_mode's) */
+boolean infection_enabled(void);
+/* Slayer's engine with Infection's rules (game_modes_engine) */
+struct game_engine *infection_engine_get(struct game_engine const *slayer);
+/* a player spawned: a zombie's skull (game_modes_postspawn) */
+void infection_postspawn(long player_index);
+
+/* a living zombie's unit */
+boolean infection_unit_is_zombie(long unit_index);
+/* a player may drop the weapon (a zombie keeps its skull: players.c, units.c) */
+boolean infection_allow_weapon_drop(long unit_index, long weapon_index);
+/* the skull may be deleted (weapons.c's and objects.c's checks that a
+game's objective is not) */
+boolean infection_can_delete_skull(long object_index);
+/* a unit's melee damage multiplier: a zombie's skull's */
+real infection_melee_multiplier(long unit_index);
+/* a zombie's melee hits a human riding in an open seat, not the vehicle
+(unit_cause_player_melee_damage) */
+boolean infection_melee_rider_target(long attacker_index, long target_index);
+/* ... which the host checks of a client's report: its own line from the
+attacker's head to the rider (network_damage.c) */
+boolean infection_melee_rider_visible(long attacker_index, long target_index, union real_vector3d const *direction);
+/* a player's team, speed and shields as their role has them (a unit
+attached: network_player_attach_unit) */
+void infection_reconcile_player(long player_index);
+/* the round's time left (the score's title) */
+long infection_remaining_ticks(void);
+/* the state the host sends its clients (game_engine_write_network_state) */
+long infection_write_network_state(byte *buffer, long size);
+boolean infection_read_network_state(byte const *buffer, long size, boolean first);
+
+#endif
diff --git a/port/linux/game/map_share.c b/port/linux/game/map_share.c
index e6542704..46f9026c 100644
--- a/port/linux/game/map_share.c
+++ b/port/linux/game/map_share.c
@@ -113,6 +113,9 @@ enum
 	INPUT_BYTES = 0x6000,
 	OUTPUT_BYTES = 0xC000,
 	MAXIMUM_FRAME_BYTES = INPUT_BYTES - 4,
+	/* reads of a connection a call at most, while it has more (64 input
+	buffers: 1.5 MB) */
+	MAXIMUM_READS_PER_CALL = 64,
 	/* pieces asked of one connection at once, and of all of them; pieces
 	another machine may ask of this one at once */
 	REQUESTS_PER_CONNECTION = 2,
@@ -2353,9 +2356,11 @@ static void frame_hashes(
 static void connection_read(
 	struct connection *connection)
 {
+	long reads = 0;
+
 	for (;;)
 	{
-		long result;
+		long result = 0;
 		long offset = 0;
 
 		if (connection->input_size < INPUT_BYTES)
@@ -2417,8 +2422,10 @@ static void connection_read(
 			csmemmove(connection->input, connection->input + offset, connection->input_size - offset);
 			connection->input_size -= offset;
 		}
-		/* (nothing more to read, or a frame not whole yet) */
-		if (connection->input_size < INPUT_BYTES)
+		/* (nothing more to read, or a frame not whole yet; while the last
+		read brought bytes, on: one buffer a call held a download to about a
+		block a frame, whatever the host sent) */
+		if (connection->input_size < INPUT_BYTES && (result <= 0 || ++reads >= MAXIMUM_READS_PER_CALL))
 			return;

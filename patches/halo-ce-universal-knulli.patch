+of a press held as the vote ends, till it is let go. The D-pad votes only
+while it is the game's: not input.dpad_controls' (walking and turning:
+first_dpad_free), nor the spawn menu's, nor with Back held (the scores,
+and Back + D-pad Down opens the spawn menu) */
+static void vote_input(XINPUT_GAMEPAD *pad, const struct platform_input_state *input, BOOL console_active)
+{
+	static unsigned long keys_held;
+	static WORD sides_held, sides_kept;
+	const WORD sides = XINPUT_GAMEPAD_DPAD_LEFT | XINPUT_GAMEPAD_DPAD_RIGHT;
+	unsigned long keys = keyboard_bound_actions(input) &
+		((1UL << HALO_KEYBOARD_VOTE_YES) | (1UL << HALO_KEYBOARD_VOTE_NO));
+	WORD sides_down = (WORD)(pad->wButtons & sides);
+	WORD down = first_dpad_free && !spawn_menu_has(0) && !spawn_menu_keeps(0) &&
+		!(pad->wButtons & XINPUT_GAMEPAD_BACK) ? sides_down : 0;
+
+	sides_kept &= sides_down;
+	if (network_vote_pad_open())
+	{
+		if (!console_active && (keys & ~keys_held))
+			network_vote_choose((keys & ~keys_held & (1UL << HALO_KEYBOARD_VOTE_YES)) != 0);
+		else if (down & ~sides_held)
+			network_vote_choose((down & ~sides_held & XINPUT_GAMEPAD_DPAD_LEFT) != 0);
+		sides_kept |= down;
+	}
+	pad->wButtons &= (WORD)~sides_kept;
+	keys_held = keys;
+	sides_held = sides_down;

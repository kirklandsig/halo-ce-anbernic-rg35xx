+				edits[count].skip = declaration_lengths[index];
+				edits[count].placed = explicit_placements[index].placed;
+				edits[count].length = placed_lengths[index];
+				count++;
+				break;
+			}
+		}
+		/* "uniform <sampler type> texN;", up to the first that is not */
+		if (samplers && !strncmp(at + 8, "sampler", 7))
+		{
+			const char *name = strstr(at, " tex");

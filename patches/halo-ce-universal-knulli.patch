+	LOG_REAL(variant, "mark_rotation_j", mark->correction.rotation.v.j);
+	LOG_REAL(variant, "mark_rotation_k", mark->correction.rotation.v.k);
+	LOG_REAL(variant, "mark_rotation_w", mark->correction.rotation.w);
+	LOG_VECTOR(variant, "mark_translation", mark->correction.translation);
+	LOG_INT(variant, "have_peak", air->have_peak);
+	LOG_INT(variant, "host_peak", air->host_peak);
+	LOG_INT(variant, "host_verdict", air->host_verdict);
+	LOG_REAL(variant, "peak", air->peak);
+	LOG_INT(variant, "enclosure", air->enclosure);
+	LOG_INT(variant, "cabin_unit", cabin->unit_index);
+	LOG_INT(variant, "cabin_vehicle", cabin->vehicle_index);
+	LOG_INT(variant, "standing", cabin->standing);
+	LOG_INT(variant, "misses", cabin->misses);
+	LOG_INT(variant, "jump", cabin->jump);
+	LOG_INT(variant, "host", cabin->host);
+	LOG_INT(variant, "host_legacy", cabin->host_legacy);
+	LOG_INT(variant, "cabin_host_verdict", cabin->host_verdict);
+	LOG_INT(variant, "host_phase", cabin->host_phase);
+	LOG_INT(variant, "body_axis", cabin->body_axis);
+	LOG_INT(variant, "take_off", cabin->take_off);
+	LOG_INT(variant, "have_anchor", cabin->have_anchor);
+	LOG_POINT(variant, "anchor", cabin->anchor);
+	LOG_INT(variant, "exception", cabin->exception);
+	LOG_INT(variant, "failure_logged", cabin->failure_logged);
+	LOG_INT(variant, "failure_log_tick", cabin->failure_log_tick);
+	LOG_INT(variant, "failure_seen_tick", cabin->failure_seen_tick);
+	LOG_INT(variant, "contacts", vehicle_riding_contact_take(SLOT, contacts));
+	LOG_REAL(variant, "kept_dyaw", vehicle_riding_kept_dyaw(0));
+}
+
+/* a biped everything of whose riding state is stale, as after a ride */
+static void stale_everything(void)
+{
+	real_vector3d const normal = { 0.f, 0.f, 1.f };
+	struct vehicle_riding_mark *mark = vehicle_riding_player_mark(SLOT);
+	struct vehicle_riding_air *air = vehicle_riding_player_air(SLOT);
+	struct vehicle_riding_cabin *cabin = vehicle_riding_player_cabin(SLOT);
+
+	rider.biped.riding_ticks = RIDING_TICKS;
+	rider.biped.riding_falling = 1;
+	rider.biped.riding_object_index = VEHICLE;
+	rider.biped.riding_vehicle_updates = 7;
+	rider.biped.riding_vehicle_position.x = 1.f;
+	rider.biped.riding_vehicle_forward.i = 1.f;
+	rider.biped.riding_vehicle_up.k = 1.f;
+	rider.biped.riding_velocity.i = .5f;
+	rider.biped.riding_local_point.z = 2.f;
+	rider.biped.riding_node_index = 4;
+	rider.biped.riding_pad = 1;
+	rider.biped.riding_body_position.y = 3.f;
+	rider.biped.riding_body_forward.j = 1.f;
+	rider.biped.riding_body_up.k = 1.f;
+	mark->role = _vehicle_riding_role_followed;
+	mark->time = 9;
+	air->have_peak = TRUE;
+	air->peak = 2.f;
+	air->enclosure = _vehicle_riding_enclosure_enclosed;
+	cabin->unit_index = BIPED;
+	cabin->vehicle_index = VEHICLE;
+	cabin->standing = _vehicle_riding_enclosure_enclosed;
+	cabin->have_anchor = TRUE;
+	vehicle_riding_look(0, TRUE, .3f);
+	CHECK(vehicle_riding_contact_record(SLOT, VEHICLE, &normal), "no contact recorded");
+}
+
+/* the hooks, as the game builds them (variant 1) and with the fast path off (variant 0); whether it was taken */
+static boolean tick(int variant, struct biped_physics *physics)
+{
+	boolean idle;
+
+	memset(physics, 0xA5, sizeof(*physics));
+	idle = variant ? idle_tick(BIPED, &rider, NULL, physics) : reference_tick(BIPED, &rider, NULL, physics);
+	log_physics(variant, physics);
+	log_biped(variant);
+	log_player(variant);
+	return idle;
+}
+
+/* one scenario twice from the same world; each stale function puts one thing out of its cleared place, `index`
+the field of several */
+typedef void (*scenario)(int index);
+
+static boolean ran_fast[2][4];
+
+static void scenario_ticks(boolean player, boolean riding, scenario stale, int index, int ticks)
+{
+	int variant;
+
+	for (variant = 0; variant < 2; variant++)
+	{
+		struct biped_physics physics;
+		int at;
+
+		world(player, riding);
+		log_length[variant] = 0;
+		log_text[variant][0] = 0;
+		if (stale)
+			stale(index);
+		for (at = 0; at < ticks; at++)
+			ran_fast[variant][at] = tick(variant, &physics);
+	}
+	CHECK(!strcmp(log_text[0], log_text[1]), "the fast path left another world (field %d):\n  full: %s\n  fast: %s", index,
+		log_text[0], log_text[1]);
+}
+
+static void stale_none(int index) { (void)index; }
+
+static void stale_state(int index)
+{
+	switch (index)
+	{
+	case 0: rider.biped.riding_ticks = 3; break;
+	case 1: rider.biped.riding_falling = 1; break;
+	case 2: rider.biped.riding_object_index = VEHICLE; break;
+	case 3: rider.biped.riding_vehicle_updates = 7; break;
+	case 4: rider.biped.riding_vehicle_position.x = 1.f; break;
+	case 5: rider.biped.riding_vehicle_forward.i = 1.f; break;
+	case 6: rider.biped.riding_vehicle_up.k = 1.f; break;
+	case 7: rider.biped.riding_velocity.j = .5f; break;
+	case 8: rider.biped.riding_local_point.z = 2.f; break;
+	case 9: rider.biped.riding_node_index = 4; break;
+	case 10: rider.biped.riding_body_position.y = 3.f; break;
+	case 11: rider.biped.riding_body_forward.j = 1.f; break;
+	case 12: rider.biped.riding_body_up.k = 1.f; break;
+	}
+}
+enum { STALE_STATE_FIELDS = 13 };
+
+static void stale_pad(int index) { (void)index; rider.biped.riding_pad = 1; }
+
+static void stale_mark(int index)
+{
+	struct vehicle_riding_mark *mark = vehicle_riding_player_mark(SLOT);
+
+	switch (index)
+	{
+	case 0: mark->role = _vehicle_riding_role_followed; break;
+	case 1: mark->time = 9; break;
+	case 2: mark->correction.vehicle_index = VEHICLE; break;
+	case 3: mark->correction.rotation.v.i = .5f; break;
+	case 4: mark->correction.rotation.w = .5f; break;
+	case 5: mark->correction.translation.k = 1.f; break;
+	}
+}
+enum { STALE_MARK_FIELDS = 6 };
+
+static void stale_contact(int index)
+{
+	real_vector3d const normal = { 0.f, 0.f, 1.f };
+
+	(void)index;
+	CHECK(vehicle_riding_contact_record(SLOT, VEHICLE, &normal), "no contact recorded");
+}
+
+static void stale_cabin(int index)
+{
+	struct vehicle_riding_cabin *cabin = vehicle_riding_player_cabin(SLOT);
+
+	switch (index)
+	{
+	case 0: cabin->unit_index = BIPED; break;
+	case 1: cabin->vehicle_index = VEHICLE; break;
+	case 2: cabin->standing = _vehicle_riding_enclosure_enclosed; break;
+	case 3: cabin->misses = 1; break;
+	case 4: cabin->jump = _vehicle_riding_enclosure_enclosed; break;
+	case 5: cabin->host = TRUE; break;
+	case 6: cabin->host_legacy = TRUE; break;
+	case 7: cabin->host_verdict = _vehicle_riding_enclosure_enclosed; break;
+	case 8: cabin->host_phase = _vehicle_riding_cabin_sample_jump; break;
+	case 9: cabin->body_axis = TRUE; break;
+	case 10: cabin->take_off = TRUE; break;
+	case 11: cabin->have_anchor = TRUE; break;
+	case 12: cabin->anchor.z = 1.f; break;
+	case 13: cabin->exception = TRUE; break;
+	case 14: cabin->failure_logged = TRUE; break;
+	case 15: cabin->failure_log_tick = 5; break;
+	case 16: cabin->failure_seen_tick = 5; break;
+	}
+}
+enum { STALE_CABIN_FIELDS = 17 };
+
+static void stale_air(int index)
+{
+	struct vehicle_riding_air *air = vehicle_riding_player_air(SLOT);
+
+	switch (index)
+	{
+	case 0: air->have_peak = TRUE; break;
+	case 1: air->host_peak = TRUE; break;
+	case 2: air->host_verdict = TRUE; break;
+	case 3: air->peak = 2.f; break;
+	case 4: air->enclosure = _vehicle_riding_enclosure_enclosed; break;
+	}
+}
+enum { STALE_AIR_FIELDS = 5 };
+
+static void stale_dyaw(int index)
+{
+	(void)index;
+	vehicle_riding_look(0, TRUE, .3f);
+}
+
+/* (riding was on, and the switch goes off: a map script, or the host's message) */
+/* a cleared float that holds -0 instead: the full path writes +0, so the fast path may not be taken */
+static real const negative_zero = -0.f;
+
+static void stale_negative_fields(int index)
+{
+	real *fields[] = {
+		&rider.biped.riding_vehicle_position.x, &rider.biped.riding_vehicle_position.y, &rider.biped.riding_vehicle_position.z,
+		&rider.biped.riding_vehicle_forward.i, &rider.biped.riding_vehicle_forward.j, &rider.biped.riding_vehicle_forward.k,
+		&rider.biped.riding_vehicle_up.i, &rider.biped.riding_vehicle_up.j, &rider.biped.riding_vehicle_up.k,
+		&rider.biped.riding_velocity.i, &rider.biped.riding_velocity.j, &rider.biped.riding_velocity.k,
+		&rider.biped.riding_local_point.x, &rider.biped.riding_local_point.y, &rider.biped.riding_local_point.z,
+		&rider.biped.riding_body_position.x, &rider.biped.riding_body_position.y, &rider.biped.riding_body_position.z,
+		&rider.biped.riding_body_forward.i, &rider.biped.riding_body_forward.j, &rider.biped.riding_body_forward.k,
+		&rider.biped.riding_body_up.i, &rider.biped.riding_body_up.j, &rider.biped.riding_body_up.k,
+	};
+
+	*fields[index] = negative_zero;
+}
+enum { STALE_NEGATIVE_FIELDS = 24 };
+
+static void stale_negative_tables(int index)
+{
+	struct vehicle_riding_mark *mark = vehicle_riding_player_mark(SLOT);
+	struct vehicle_riding_air *air = vehicle_riding_player_air(SLOT);
+	struct vehicle_riding_cabin *cabin = vehicle_riding_player_cabin(SLOT);
+	real *fields[] = {
+		&mark->correction.rotation.v.i, &mark->correction.rotation.v.j, &mark->correction.rotation.v.k,
+		&mark->correction.translation.i, &mark->correction.translation.j, &mark->correction.translation.k,
+		&air->peak, &cabin->anchor.x, &cabin->anchor.y, &cabin->anchor.z,
+	};
+
+	*fields[index] = negative_zero;
+}
+enum { STALE_NEGATIVE_TABLES = 10 };
+
+static void stale_negative_dyaw(int index)
+{
+	(void)index;
+	vehicle_riding_look(0, TRUE, negative_zero);
+}
+
+static void stale_all(int index)
+{
+	(void)index;
+	stale_everything();
+	map_slot_storage = FALSE;
+}
+
+/* a case: one stale thing at a time, off, and the fast path not taken for it */
+static void only(scenario stale, int fields)
+{
+	int index;
+
+	for (index = 0; index < fields; index++)
+	{
+		scenario_ticks(TRUE, FALSE, stale, index, 1);
+		CHECK(!ran_fast[1][0], "the fast path taken with field %d stale", index);
+	}
+}
+
+/* the seated hook from the same world, with the fast path off (variant 0) and as built (1) */
+static void seated_ticks(scenario stale, int index)
+{
+	int variant;
+
+	for (variant = 0; variant < 2; variant++)
+	{
+		struct biped_physics physics;
+
+		world(TRUE, TRUE);
+		log_length[variant] = 0;
+		log_text[variant][0] = 0;
+		if (stale)
+			stale(index);
+		memset(&physics, 0, sizeof(physics));
+		if (variant)
+			biped_riding_seated(BIPED, &rider);
+		else
+			reference_seated(BIPED, &rider);
+		log_biped(variant);
+		log_player(variant);
+	}
+	CHECK(!strcmp(log_text[0], log_text[1]), "the seated fast path left another world (field %d):\n  full: %s\n  fast: %s",
+		index, log_text[0], log_text[1]);
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc > 1 ? argv[1] : "";
+
+	CASE("riding-on-reached")
+	{
+		/* (the map's slot cleared, so riding follows the stored decision of the setting) */
+		world(TRUE, TRUE);
+		map_slot_storage = NONE;
+		CHECK(vehicle_riding_enabled(), "riding is not on under the fixture's own on setup");
+		return 0;
+	}
+	CASE("riding-off-reached")
+	{
+		world(TRUE, FALSE);
+		map_slot_storage = NONE;
+		CHECK(vehicle_riding_enabled(), "riding is not on before the setting goes off");
+		config_riding = 0;
+#ifndef FIXTURE_NO_DECIDE_OFF
+		vehicle_riding_map_decide();
+#endif
+		CHECK(!vehicle_riding_enabled(), "riding is still on after the setting went off and the map decided again");
+		return 0;
+	}
+	CASE("off-clean-player")
+	{
+		scenario_ticks(TRUE, FALSE, stale_none, 0, 1);
+		CHECK(ran_fast[1][0] && !ran_fast[0][0], "the fast path not taken on a clean player (or taken in the reference)");
+		return 0;
+	}
+	CASE("off-ai-biped")
+	{
+		scenario_ticks(FALSE, TRUE, stale_none, 0, 1);
+		CHECK(ran_fast[1][0] && !ran_fast[0][0], "the fast path not taken on an AI biped");
+		return 0;
+	}
+	CASE("off-seated")
+	{
+		/* (a clean seat; then the same with the mark stale, which the full path clears) */
+		seated_ticks(stale_none, 0);
+		seated_ticks(stale_mark, 1);
+		seated_ticks(stale_state, 0);
+		seated_ticks(stale_cabin, 2);
+		seated_ticks(stale_dyaw, 0);
+		return 0;
+	}
+	CASE("off-after-ride")
+	{
+		/* tick 1 clears everything (the full path), tick 2 finds it clear (the fast path); both as the reference */
+		scenario_ticks(TRUE, TRUE, stale_all, 0, 2);
+		CHECK(!ran_fast[1][0] && ran_fast[1][1], "ticks %d, %d: the first must be full and the second fast",
+			ran_fast[1][0], ran_fast[1][1]);
+		return 0;
+	}
+	CASE("off-stale-state-only") { only(stale_state, STALE_STATE_FIELDS); return 0; }
+	CASE("off-stale-pad-only") { only(stale_pad, 1); return 0; }
+	CASE("off-stale-mark-only") { only(stale_mark, STALE_MARK_FIELDS); return 0; }
+	CASE("off-stale-contact-only") { only(stale_contact, 1); return 0; }
+	CASE("off-stale-cabin-only") { only(stale_cabin, STALE_CABIN_FIELDS); return 0; }
+	CASE("off-stale-air-only") { only(stale_air, STALE_AIR_FIELDS); return 0; }
+	CASE("off-stale-dyaw-only") { only(stale_dyaw, 1); return 0; }
+	CASE("off-negative-zero-fields") { only(stale_negative_fields, STALE_NEGATIVE_FIELDS); return 0; }
+	CASE("off-negative-zero-tables") { only(stale_negative_tables, STALE_NEGATIVE_TABLES); return 0; }
+	CASE("off-negative-zero-dyaw") { only(stale_negative_dyaw, 1); return 0; }
+	CASE("off-negative-zero-seated")
+	{
+		/* (the seat's full path writes +0 over each of them too) */
+		int index;
+
+		for (index = 0; index < STALE_NEGATIVE_FIELDS; index++)
+			seated_ticks(stale_negative_fields, index);
+		for (index = 0; index < STALE_NEGATIVE_TABLES; index++)
+			seated_ticks(stale_negative_tables, index);
+		seated_ticks(stale_negative_dyaw, 0);
+		return 0;
+	}
+	CASE("off-work-skipped")
+	{
+		struct biped_physics physics;
+
+		world(TRUE, FALSE);
+		tick(0, &physics);
+		CHECK(get_calls > 0 && set_calls > 0 && air_begin_calls > 0 && cabin_begin_calls > 0,
+			"the full path does not do the work this counts (get %ld, set %ld, air %ld, cabin %ld)", get_calls, set_calls,
+			air_begin_calls, cabin_begin_calls);
+		world(TRUE, FALSE);
+		tick(1, &physics);
+		CHECK(get_calls == 0, "biped_riding_get called %ld times", get_calls);
+		CHECK(set_calls == 0, "biped_riding_set called %ld times", set_calls);
+		CHECK(air_begin_calls == 0, "vehicle_riding_air_begin called %ld times", air_begin_calls);
+		CHECK(cabin_begin_calls == 0, "vehicle_riding_cabin_begin called %ld times", cabin_begin_calls);
+		return 0;
+	}
+	CASE("deferred-reads-fields")
+	{
+		static char const ticks[] = { -1, 0, 1, RIDING_TICKS };
+		int tick_at;
+		int applies;
+
+		for (tick_at = 0; tick_at < 4; tick_at++)
+		{
+			for (applies = 0; applies < 2; applies++)
+			{
+				struct vehicle_riding_state state;
+
+				world(TRUE, TRUE);
+				rider.biped.riding_ticks = ticks[tick_at];
+				if (!applies)
+					rider.object.damage_flags |= (unsigned)FLAG(_object_dead_bit);
+				vehicle_riding_clear(&state);
+				state.ticks = ticks[tick_at];
+				get_calls = 0;
+				CHECK(biped_riding_deferred(BIPED) == vehicle_riding_deferred(&state, applies), "ticks %d, applies %d",
+					ticks[tick_at], applies);
+				CHECK(get_calls == 0, "biped_riding_get called %ld times", get_calls);
+			}
+		}
+		return 0;
+	}
+	CASE("collision-reads-fields")
+	{
+		static char const ticks[] = { -1, 0, 1, RIDING_TICKS };
+		static long const ridden[] = { VEHICLE, VEHICLE + 1 };
+		real_vector3d const normal = { 0.f, 0.f, 1.f };
+		real_point3d const base = { 0.f, 0.f, 0.f };
+		int tick_at;
+		int applies;
+		int object;
+
+		for (tick_at = 0; tick_at < 4; tick_at++)
+		{
+			for (applies = 0; applies < 2; applies++)
+			{
+				for (object = 0; object < 2; object++)
+				{
+					struct vehicle_riding_state state;
+
+					world(TRUE, TRUE);
+					rider.biped.riding_ticks = ticks[tick_at];
+					rider.biped.riding_object_index = ridden[object];
+					if (!applies)
+						rider.object.damage_flags |= (unsigned)FLAG(_object_dead_bit);
+					vehicle_riding_clear(&state);
+					state.ticks = ticks[tick_at];
+					state.object_index = ridden[object];
+					get_calls = 0;
+					CHECK(biped_riding_collision_head(BIPED, VEHICLE, &normal, &base, 1.f) ==
+						vehicle_riding_collision_window(&state, applies, VEHICLE), "ticks %d, applies %d, object %d",
+						ticks[tick_at], applies, object);
+					if (!applies || ticks[tick_at] <= 0)
+						CHECK(get_calls == 0, "biped_riding_get called %ld times (ticks %d, applies %d)", get_calls,
+							ticks[tick_at], applies);
+				}
+			}
+		}
+		return 0;
+	}
+	CASE("falling-reads-fields")
+	{
+		static char const ticks[] = { 0, 1, RIDING_TICKS };
+		int tick_at;
+		int falling;
+
+		for (tick_at = 0; tick_at < 3; tick_at++)
+		{
+			for (falling = 0; falling < 2; falling++)
+			{
+				struct vehicle_riding_state state;
+
+				world(TRUE, TRUE);
+				rider.object.translational_velocity.k = -.3f;
+				rider.biped.riding_ticks = ticks[tick_at];
+				rider.biped.riding_falling = (char)falling;
+				rider.biped.riding_velocity.k = -.5f;
+				vehicle_riding_clear(&state);
+				state.ticks = ticks[tick_at];
+				state.falling = (char)falling;
+				state.velocity.k = -.5f;
+				get_calls = 0;
+				CHECK(biped_riding_falling_velocity(&rider) == vehicle_riding_falling_velocity(&state, -.3f),
+					"ticks %d, falling %d", ticks[tick_at], falling);
+				if (ticks[tick_at] != RIDING_TICKS && !falling)
+					CHECK(get_calls == 0, "biped_riding_get called %ld times", get_calls);
+			}
+		}
+		return 0;
+	}
+	fprintf(stderr, "unknown case: %s\n", case_name);
+	return 2;
+}
diff --git a/tools/harness/tests/riding_map_message.c b/tools/harness/tests/riding_map_message.c
new file mode 100644
index 00000000..37f808b5
--- /dev/null
+++ b/tools/harness/tests/riding_map_message.c
@@ -0,0 +1,116 @@
+#include "harness.h"
+typedef unsigned short word;
+enum { _game_connection_local, _game_connection_network_client, _game_connection_network_server };
+#include "message_ids.inc"
+enum { _distributed_to_clients_reliably };
+struct distributed_message_header { word header; byte type, count; long game_time; };
+#define GET_MESSAGE_TYPE(h) (((h)>>2)&3)
+static int connection = _game_connection_network_server, playing = 1, menu, unreliable, sends;
+static short map_value = NONE, received = NONE;
+static byte wire[64];
+static word wire_size;
+static long last_machine = NONE;
+static boolean network_connection_last_read_was_unreliable(void) { return unreliable; }
+static int game_connection(void) { return connection; }
+static int game_in_progress(void) { return playing; }
+static int main_menu_is_active(void) { return menu; }
+static short vehicle_riding_map(void) { return map_value; }
+static void vehicle_riding_map_received(short map) { received = map; }
+struct distributed_riding_latched { real damage_speed, teleport_step, moved_alone, air_grip; word look_carry, cabin_grace; };
+static struct distributed_riding_latched latched = { .5f, 6.f, .3f, .2f, 1, 7 }, received_values;
+static int received_count, forgotten;
+static void vehicle_riding_latched_get(struct distributed_riding_latched *out) { *out = latched; }
+static void vehicle_riding_latched_received(struct distributed_riding_latched const *in) { received_values = *in; received_count++; }
+static void vehicle_riding_latched_forget(void) { forgotten++; }
+static void distributed_send(void *data, byte type, int count, word size, int destination)
+{
+    struct distributed_message_header *h = (void *)wire;
+    CHECK(destination == _distributed_to_clients_reliably, "not reliable broadcast");
+    CHECK(size <= sizeof(wire), "wire overflow");
+    memcpy(wire, data, size); h->header = 8; h->type = type; h->count = count; wire_size = size; sends++;
+}
+static void distributed_send_to_machine_reliably(long machine, void *data, byte type, int count, word size)
+{ last_machine = machine; distributed_send(data, type, count, size, _distributed_to_clients_reliably); }
+#include "under_test.inc"
+static void receive(int from, int value, int count, int size, int reserved)
+{
+    struct distributed_riding_map_message m = {{8, _distributed_message_vehicle_riding_map, count, 0}, value, reserved};
+    m.values = latched;
+    network_riding_map_handle_message(from, (word *)&m, size);
+}
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2, "case");
+    char const *case_name = argv[1];
+    network_riding_map_reset();
+    CASE("replication") {
+        network_riding_map_update(); CHECK(sends == 1 && wire_size == 32 && ((struct distributed_riding_map_message *)wire)->map == 0, "none not sent");
+        network_riding_map_update(); CHECK(sends == 1, "none spam");
+        network_riding_map_send(7); CHECK(sends == 2 && last_machine == 7 && ((struct distributed_riding_map_message *)wire)->map == 0, "none late join missing");
+        map_value = TRUE; network_riding_map_update();
+        CHECK(sends == 3 && wire_size == 32 && ((struct distributed_riding_map_message *)wire)->map == 2, "on wire layout");
+        CHECK(network_riding_map_handles_message((word *)wire, wire_size), "dispatch missing");
+        CHECK(!network_riding_map_handles_message((word *)wire, 7), "short dispatch");
+        network_riding_map_update(); CHECK(sends == 3, "unchanged spam");
+        network_riding_map_send(7); CHECK(sends == 4 && last_machine == 7, "late join missing");
+        map_value = FALSE; network_riding_map_update();
+        CHECK(sends == 5 && ((struct distributed_riding_map_message *)wire)->map == 1 && !((struct distributed_riding_map_message *)wire)->reserved, "off wire layout");
+        connection = _game_connection_network_client; network_riding_map_update(); network_riding_map_send(7);
+        CHECK(sends == 5, "client sent");
+        connection = _game_connection_network_server; map_value = TRUE; playing = 0; network_riding_map_update();
+        playing = 1; menu = 1; network_riding_map_update(); CHECK(sends == 5, "outside game sent");
+    }
+    else CASE("values") {
+        struct distributed_riding_map_message *m = (struct distributed_riding_map_message *)wire;
+        network_riding_map_update();
+        CHECK(sends == 1 && m->map == 0, "sent only with a map choice");
+        CHECK(m->values.damage_speed == .5f && m->values.teleport_step == 6.f && m->values.moved_alone == .3f &&
+            m->values.air_grip == .2f && m->values.look_carry == 1 && m->values.cabin_grace == 7, "values not on the wire");
+        network_riding_map_update(); CHECK(sends == 1, "unchanged values resent");
+        latched.air_grip = .9f; network_riding_map_update();
+        CHECK(sends == 2 && m->values.air_grip == .9f, "changed latch not resent");
+        latched.damage_speed = 2.f; network_riding_map_send(7);
+        CHECK(sends == 3 && last_machine == 7 && m->values.damage_speed == 2.f && m->values.air_grip == .9f, "joiner not given latched values");
+    }
+    else CASE("admission") {
+        connection = _game_connection_network_client;
+        receive(NONE, 1, 1, 32, 0); CHECK(received == FALSE, "off not received");
+        receive(NONE, 2, 1, 32, 0); CHECK(received == TRUE, "on not received");
+        received = NONE; unreliable = 1; receive(NONE, 2, 1, 32, 0); CHECK(received == NONE, "datagram accepted");
+        unreliable = 0; receive(3, 2, 1, 32, 0); CHECK(received == NONE, "client spoof accepted");
+        receive(NONE, 2, 0, 32, 0); CHECK(received == NONE, "count zero accepted");
+        receive(NONE, 2, 2, 32, 0); CHECK(received == NONE, "count two accepted");
+        receive(NONE, 3, 1, 32, 0); CHECK(received == NONE, "invalid map accepted");
+        receive(NONE, 2, 1, 32, 1); CHECK(received == NONE, "reserved accepted");
+        for (int n = 0; n < 32; n++) { receive(NONE, 2, 1, n, 0); CHECK(received == NONE, "truncation accepted"); }
+        receive(NONE, 2, 1, 33, 0); CHECK(received == NONE, "trailing bytes accepted");
+        connection = _game_connection_network_server; receive(NONE, 2, 1, 32, 0); CHECK(received == NONE, "host accepted");
+        connection = _game_connection_network_client; playing = 0; receive(NONE, 2, 1, 32, 0); CHECK(received == NONE, "outside game accepted");
+        playing = 1; menu = 1; receive(NONE, 2, 1, 32, 0); CHECK(received == NONE, "menu accepted");
+        menu = 0; receive(NONE, 0, 1, 32, 0); CHECK(received == NONE, "none decode");
+    }
+    else CASE("client-values") {
+        struct distributed_riding_map_message m = {{8, _distributed_message_vehicle_riding_map, 1, 0}, 2, 0};
+        connection = _game_connection_network_client;
+        m.values = latched; m.values.air_grip = .77f;
+        network_riding_map_handle_message(NONE, (word *)&m, 32);
+        CHECK(received_count == 1 && received_values.air_grip == .77f && received_values.cabin_grace == 7 &&
+            received_values.damage_speed == .5f, "host values not handed on");
+        m.values.look_carry = 2; network_riding_map_handle_message(NONE, (word *)&m, 32);
+        CHECK(received_count == 1, "bad look carry accepted");
+        unreliable = 1; m.values.look_carry = 1; network_riding_map_handle_message(NONE, (word *)&m, 32);
+        CHECK(received_count == 1, "datagram values accepted");
+        unreliable = 0; connection = _game_connection_network_server; network_riding_map_handle_message(NONE, (word *)&m, 32);
+        CHECK(received_count == 1, "host took values");
+        connection = _game_connection_network_client; forgotten = 0; network_riding_map_reset();
+        CHECK(forgotten == 1, "host values kept past the game");
+    }
+    else CASE("reset") {
+        connection = _game_connection_network_client; receive(NONE, 2, 1, 32, 0);
+        CHECK(received == TRUE, "setup"); network_riding_map_reset(); CHECK(received == NONE, "client not reset");
+        connection = _game_connection_network_server; map_value = TRUE; network_riding_map_update();
+        CHECK(sends == 1, "host setup"); network_riding_map_reset(); network_riding_map_update(); CHECK(sends == 2, "host not reset");
+    }
+    else return 2;
+    return 0;
+}
diff --git a/tools/harness/tests/riding_turn.c b/tools/harness/tests/riding_turn.c
new file mode 100644
index 00000000..a177d5b6
--- /dev/null
+++ b/tools/harness/tests/riding_turn.c
@@ -0,0 +1,174 @@
+/*
+RIDING_TURN.C (test)
+
+The rider's turn and the support it keeps, taken from the port files by
+test_riding_turn.py: the eight vectors turned by one sine and cosine, and the
+claimed support that asks nothing of a support that rides nothing.
+*/
+
+#include "harness.h"
+#include <math.h>
+
+#define VEHICLE 0x10000001
+#define OTHER_VEHICLE 0x10000002
+
+static long cos_calls, sin_calls, claim_calls;
+#define cos(angle) (cos_calls++, (cos)(angle))
+#define sin(angle) (sin_calls++, (sin)(angle))
+
+struct biped_datum
+{
+	struct { real_vector3d forward; } object;
+	struct
+	{
+		real_vector3d desired_facing_vector, desired_aiming_vector, aiming_vector, desired_looking_vector, looking_vector;
+	} unit;
+};
+struct biped_physics
+{
+	real_vector3d forward, aiming;
+	long riding_object_index;
+	real minimum_normal_k;
+};
+struct collision_plane
+{
+	long object_index;
+	struct { real_vector3d n; real d; } plane;
+};
+
+#include "under_test.inc"
+
+static real_vector3d *field(struct biped_datum *biped, struct biped_physics *physics, short index)
+{
+	real_vector3d *all[8];
+
+	all[0] = &biped->object.forward;
+	all[1] = &biped->unit.desired_facing_vector;
+	all[2] = &biped->unit.desired_aiming_vector;
+	all[3] = &biped->unit.aiming_vector;
+	all[4] = &biped->unit.desired_looking_vector;
+	all[5] = &biped->unit.looking_vector;
+	all[6] = &physics->forward;
+	all[7] = &physics->aiming;
+	return all[index];
+}
+
+static void collision(struct collision_plane *plane, long object_index, real k)
+{
+	memset(plane, 0, sizeof(*plane));
+	plane->object_index = object_index;
+	plane->plane.n.k = k;
+}
+
+int main(int argc, char **argv)
+{
+	char const *case_name = argc > 1 ? argv[1] : "";
+	struct biped_datum biped;
+	struct biped_physics physics;
+	struct collision_plane planes[3];
+
+	memset(&biped, 0, sizeof(biped));
+	memset(&physics, 0, sizeof(physics));
+	CASE("turn-eight-matches-one")
+	{
+		real const angles[6] = { 0.f, -0.f, 1e-7f, 0.3f, -2.9f, 3.14159265f };
+		real_vector3d const samples[8] = {
+			{ 1.f, 0.f, .5f }, { 0.f, -0.f, 0.f }, { -0.f, 0.f, -0.f }, { 3e38f, -3e38f, 1.f },
+			{ .6f, .8f, 0.f }, { (real)NAN, .5f, .25f }, { 1e-30f, -1e-30f, 7.f }, { -.25f, 1.5f, -1.f } };
+		short angle, index;
+
+		for (angle = 0; angle < 6; angle++)
+		{
+			real_vector3d together[8], apart[8];
+			real_vector3d *pointers[8];
+
+			memcpy(together, samples, sizeof(together));
+			memcpy(apart, samples, sizeof(apart));
+			for (index = 0; index < 8; index++)
+			{
+				pointers[index] = &together[index];
+				vehicle_riding_turn_vector(&apart[index], angles[angle]);
+			}
+			vehicle_riding_turn_vectors(pointers, 8, angles[angle]);
+			CHECK(!memcmp(together, apart, sizeof(together)), "angle %d: the eight turned differ in bits", angle);
+		}
+		return 0;
+	}
+	CASE("turn-trig-once")
+	{
+		cos_calls = sin_calls = 0;
+		biped_riding_turn(&biped, &physics, .3f);
+		CHECK(cos_calls == 1 && sin_calls == 1, "%ld cos and %ld sin for one turn", cos_calls, sin_calls);
+		return 0;
+	}
+	CASE("turn-all-eight")
+	{
+		short index;
+
+		for (index = 0; index < 8; index++)
+		{
+			real_vector3d *vector = field(&biped, &physics, index);
+
+			vector->i = 1.f;
+			vector->j = 0.f;
+			vector->k = .5f;
+		}
+		biped_riding_turn(&biped, &physics, .3f);
+		for (index = 0; index < 8; index++)
+		{
+			real_vector3d *vector = field(&biped, &physics, index);
+
+			CHECK(vector->i == (real)(cos)(.3) && vector->j == (real)(sin)(.3) && vector->k == .5f, "field %d not turned", index);
+		}
+		return 0;
+	}
+	CASE("claim-none-no-fill")
+	{
+		physics.riding_object_index = NONE;
+		physics.minimum_normal_k = .7f;
+		collision(&planes[0], OTHER_VEHICLE, 1.f);
+		collision(&planes[1], VEHICLE, .95f);
+		collision(&planes[2], NONE, 1.f);
+		claim_calls = 0;
+		CHECK(biped_riding_claimed_support(&physics, planes, 3, 0) == 0, "not riding: not the best");
+		CHECK(biped_riding_claimed_support(&physics, planes, 3, NONE) == NONE, "not riding: no best kept");
+		CHECK(claim_calls == 0, "%ld claims asked of a support that rides nothing", claim_calls);
+		return 0;
+	}
+	CASE("claim-ridden-best")
+	{
+		long objects[3] = { OTHER_VEHICLE, VEHICLE, NONE };
+		real normal_ks[3] = { 1.f, .95f, 1.f };
+
+		physics.riding_object_index = VEHICLE;
+		physics.minimum_normal_k = .7f;
+		collision(&planes[0], OTHER_VEHICLE, 1.f);
+		collision(&planes[1], VEHICLE, .95f);
+		collision(&planes[2], NONE, 1.f);
+		CHECK(biped_riding_claimed_support(&physics, planes, 3, 1) == 1, "the ridden best lost");
+		CHECK(biped_riding_claimed_support(&physics, planes, 3, 1) ==
+			(vehicle_riding_claim)(VEHICLE, 3, objects, normal_ks, .7f, 1), "the ridden best differs from the full claim");
+		return 0;
+	}
+	CASE("claim-competing-decks")
+	{
+		long objects[3] = { OTHER_VEHICLE, VEHICLE, NONE };
+		real normal_ks[3] = { 1.f, .95f, 1.f };
+		short best;
+
+		physics.riding_object_index = VEHICLE;
+		physics.minimum_normal_k = .7f;
+		collision(&planes[0], OTHER_VEHICLE, 1.f);
+		collision(&planes[1], VEHICLE, .95f);
+		collision(&planes[2], NONE, 1.f);
+		for (best = NONE; best < 3; best++)
+			CHECK(biped_riding_claimed_support(&physics, planes, 3, best) ==
+				(vehicle_riding_claim)(VEHICLE, 3, objects, normal_ks, .7f, best), "best %d differs from the full claim", best);
+		CHECK(biped_riding_claimed_support(&physics, planes, 3, 0) == 1, "the ridden deck lost its rider");
+		planes[1].plane.n.k = .2f;
+		CHECK(biped_riding_claimed_support(&physics, planes, 3, 0) == 0, "a wall kept the rider");
+		return 0;
+	}
+	fprintf(stderr, "no such case: %s\n", case_name);
+	return 2;
+}
diff --git a/tools/harness/tests/script_stale_objects.c b/tools/harness/tests/script_stale_objects.c
new file mode 100644
index 00000000..361ba7ae
--- /dev/null
+++ b/tools/harness/tests/script_stale_objects.c
@@ -0,0 +1,659 @@
+/*
+SCRIPT_STALE_OBJECTS.C
+
+A script holding an object that has been deleted. The script runtime runs here on
+the real data arrays (memory/data.c), so a deleted object's index is refused as it
+is in the game. datum_get's report in a release build, after which the game reads
+through a NULL and crashes, is a failed CHECK here.
+*/
+
+/* the real data arrays, not the harness's */
+#define data_array harness_data_array
+#define datum_header harness_datum_header
+#define game_state_data_new harness_game_state_data_new
+#define datum_new harness_datum_new
+#define datum_get harness_datum_get
+#define datum_delete harness_datum_delete
+#include "harness.h"
+#undef data_array
+#undef datum_header
+#undef game_state_data_new
+#undef datum_new
+#undef datum_get
+#undef datum_delete
+
+#define HALO_RELEASE
+typedef unsigned short word;
+#define match_vassert(file, line, condition, message) ((void)0)
+#define match_hs_assert(file, line, thread_index, condition, reason) ((void)0)
+#define csprintf(buffer, ...) snprintf(buffer, sizeof(buffer), "an index is unused or changed")
+#define _error_silent 0
+#define error(...) ((void)0)
+#define BIT_VECTOR_SET_FLAG(vector, bit, enable) ((void)0)
+#define MAXIMUM_TRIGGER_VOLUMES_PER_SCENARIO 256
+#define MAX(a, b) ((a)>(b) ? (a) : (b))
+
+static void release_assert_failed(char const *message, char const *file, int line, boolean halt)
+{
+	CHECK(FALSE, "%s", message);
+}
+
+#include "types.inc"
+
+typedef long (*hs_typecasting_procedure)(long value);
+
+/* the fake world: objects with what the code under test reads */
+struct object_datum
+{
+	struct
+	{
+		short type;
+		unsigned long damage_flags;
+		real_point3d bounding_sphere_center;
+	} object;
+};
+#define unit_datum object_datum
+struct animation { short frame_count; };
+struct animation_graph { struct { struct animation elements[1]; } animations; };
+struct scenery_datum
+{
+	struct
+	{
+		struct
+		{
+			struct
+			{
+				long animation_graph_index;
+				struct { short index, frame_index; } state;
+			} animation;
+		} object;
+	} object;
+	unsigned long flags;
+};
+union fake_object { struct object_datum object; struct scenery_datum scenery; };
+enum { _object_die_act_of_god_bit, _object_die_act_of_god_silent_bit };
+enum { MAXIMUM_FAKE_OBJECTS = 16, MAXIMUM_FAKE_NAMES = 4, MAXIMUM_FAKE_FUNCTIONS = 16 };
+
+struct data_array *object_header_data, *object_list_header_data, *object_list_data;
+struct data_array *hs_thread_data, *hs_syntax_data, *hs_global_data;
+static union fake_object fake_objects[MAXIMUM_FAKE_OBJECTS];
+static long fake_names[MAXIMUM_FAKE_NAMES];
+static short global_types[16];
+static long hs_external_global_count = 0;
+static hs_typecasting_procedure typecasting_procedures[NUMBER_OF_HS_TYPES][NUMBER_OF_HS_TYPES];
+static long function_storage[MAXIMUM_FAKE_FUNCTIONS][16];
+static unsigned long hs_debug_data[8];
+static struct animation_graph fake_animation_graph;
+static boolean volume_holds_everything = TRUE;
+static int volume_tests;
+
+struct hs_script { short return_type; };
+static struct { struct { struct hs_script elements[1]; } hs_scripts; } fake_scenario;
+#define global_scenario_get() (&fake_scenario)
+#define TAG_BLOCK_GET_ELEMENT(block, index, type) (&(block)->elements[index])
+#define animation_graph_definition_get(index) (&fake_animation_graph)
+
+#define hs_function_get(index) ((struct hs_function_definition *)function_storage[index])
+#define hs_global_get_type(designator) global_types[HS_GLOBAL_DESIGNATOR_TO_INDEX(designator)]
+#define hs_global_reconcile_read(designator) ((void)0)
+#define hs_thread_format(thread_index) ""
+#define hs_runtime_waiting_on_call() FALSE
+#define coop_scripts_empty_player_list(list) FALSE
+#define coop_scripts_any_player_will_do(list) FALSE
+#define coop_scripts_gather_in_volume(volume, list) ((void)0)
+#define reference_list_port_full(array) ((void)0)
+

+		u = vector(0.f, 0.f, m + RIDING_CABIN_AXIS_BAND + .00001f);
+		u.i = (real)sqrt(1. - (double)(u.k*u.k));
+		vehicle_riding_cabin_axis(&cabin, &u, m, &axis);
